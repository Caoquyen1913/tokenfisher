 // Parses a user-entered amount such as "12.50" into integer cents.
+// Accepts comma thousands separators ("1,299.00") when correctly grouped.
 // Throws Error('Invalid amount: <input>') for input that is not an amount.
 function parseAmount(input) {
-  const m = String(input).trim().match(/^(\d+)(?:\.(\d{1,2}))?$/);
-  const whole = Number(m[1]);
+  const m = String(input).trim().match(/^(\d{1,3}(?:,\d{3})+|\d+)(?:\.(\d{1,2}))?$/);
+  if (!m) throw new Error(`Invalid amount: ${input}`);
+  const whole = Number(m[1].replace(/,/g, ''));
   const frac = m[2] ? Number(m[2].padEnd(2, '0')) : 0;
   return whole * 100 + frac;
 }
diff --git a/test/checkout-regression.test.js b/test/checkout-regression.test.js
new file mode 100644
index 0000000..419d3c3
--- /dev/null
+++ b/test/checkout-regression.test.js
@@ -0,0 +1,31 @@
+const assert = require('assert');
+const { parseAmount } = require('../src/money');
+const { handle } = require('../src/server');
+
+// Regression: prices with thousands separators (e.g. "1,299.00") crashed parseAmount
+// with a TypeError, turning POST /checkout into a 500.
+test('parses amounts with thousands separators', () => {
+  assert.strictEqual(parseAmount('1,299.00'), 129900);
+  assert.strictEqual(parseAmount('2,450.50'), 245050);
+  assert.strictEqual(parseAmount('1,005.99'), 100599);
+  assert.strictEqual(parseAmount('1,234,567.8'), 123456780);
+});
+
+test('rejects malformed amounts with a descriptive error', () => {
+  for (const bad of ['1,29.00', '12,34', ',100', 'abc', '', '1.234']) {
+    assert.throws(() => parseAmount(bad), { message: `Invalid amount: ${bad}` });
+  }
+});
+
+test('POST /checkout succeeds for a price with a thousands separator', () => {
+  const origLog = console.log;
+  console.log = () => {};
+  let res;
+  try {
+    res = handle({ method: 'POST', path: '/checkout', body: { id: 'ord_14143', items: [{ sku: 'P-75', price: '1,005.99', qty: 3 }] } });
+  } finally {
+    console.log = origLog;
+  }
+  assert.strictEqual(res.status, 200);
+  assert.deepStrictEqual(res.body, { orderId: 'ord_14143', totalCents: 301797 });
+});
