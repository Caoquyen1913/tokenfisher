diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..3c0f1c8
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,103 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function setup(qty = 10) {
+  let now = 1000;
+  const s = createStore({ clock: () => now });
+  s.addItem('A', qty);
+  return { s, tick: (ms) => { now += ms; } };
+}
+
+test('reserve reduces available but not physical stock', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  assert.strictEqual(typeof id, 'string');
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('A'), 6);
+});
+test('reserve ids are unique', () => {
+  const { s } = setup();
+  assert.notStrictEqual(s.reserve('A', 1, 100), s.reserve('A', 1, 100));
+});
+test('reserve validates qty and availability', () => {
+  const { s } = setup(5);
+  assert.throws(() => s.reserve('A', 0, 100), /INVALID_QTY/);
+  assert.throws(() => s.reserve('A', 1.5, 100), /INVALID_QTY/);
+  assert.throws(() => s.reserve('A', 6, 100), /INSUFFICIENT_STOCK/);
+  s.reserve('A', 5, 100);
+  assert.throws(() => s.reserve('A', 1, 100), /INSUFFICIENT_STOCK/);
+});
+test('reservation expires exactly at creation + ttl', () => {
+  const { s, tick } = setup();
+  s.reserve('A', 4, 100);
+  tick(99);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  tick(1);
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('confirm turns reservation into a sale', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 6);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm errors for unknown, released and expired', () => {
+  const { s, tick } = setup();
+  assert.throws(() => s.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const r = s.reserve('A', 1, 100);
+  s.release(r);
+  assert.throws(() => s.confirm(r), /RESERVATION_NOT_FOUND/);
+  const e = s.reserve('A', 1, 100);
+  tick(100);
+  assert.throws(() => s.confirm(e), /RESERVATION_EXPIRED/);
+  assert.strictEqual(s.getStock('A'), 10);
+});
+test('release is idempotent and frees availability', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  s.release(id);
+  s.release(id);
+  s.release('unknown');
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('removeItem cannot remove reserved stock', () => {
+  const { s, tick } = setup(10);
+  s.reserve('A', 7, 100);
+  assert.throws(() => s.removeItem('A', 4), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 3);
+  assert.strictEqual(s.getStock('A'), 7);
+  tick(100);
+  s.removeItem('A', 7);
+  assert.strictEqual(s.getStock('A'), 0);
+});
+
+test('API reservation flow', () => {
+  const { s } = setup();
+  const api = createApi(s);
+  const res = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 4, ttlMs: 100 } });
+  assert.strictEqual(res.status, 201);
+  const { id } = res.body;
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }).body, { sku: 'A', stock: 10, available: 6 });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'A', stock: 6 } });
+  assert.strictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }).status, 404);
+});
+test('API reservation errors', () => {
+  const { s, tick } = setup(5);
+  const api = createApi(s);
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 9, ttlMs: 100 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 100 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 1, ttlMs: 100 } }).body;
+  tick(100);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('API DELETE reservation returns 204 and frees stock', () => {
+  const { s } = setup();
+  const api = createApi(s);
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 4, ttlMs: 100 } }).body;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'GET', path: '/stock/A' }).body.available, 10);
+});
