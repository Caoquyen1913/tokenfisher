+++ b/src/store.js
@@ -1,25 +1,65 @@
 // In-memory inventory. `clock` is injectable so tests can control time.
 function createStore({ clock = Date.now } = {}) {
   const stock = new Map();
+  // id -> { sku, qty, expiresAt }. Expired entries are kept so confirm() can
+  // report RESERVATION_EXPIRED; they simply stop counting against availability.
+  const reservations = new Map();
+  let nextId = 1;
 
   function assertQty(qty) {
     if (!Number.isInteger(qty) || qty <= 0) throw new Error('INVALID_QTY');
   }
 
+  function isExpired(r) {
+    return clock() >= r.expiresAt;
+  }
+
+  function reserved(sku) {
+    let total = 0;
+    for (const r of reservations.values()) {
+      if (r.sku === sku && !isExpired(r)) total += r.qty;
+    }
+    return total;
+  }
+
+  function getStock(sku) {
+    return stock.get(sku) || 0;
+  }
+
+  function getAvailable(sku) {
+    return getStock(sku) - reserved(sku);
+  }
+
   return {
     clock,
     addItem(sku, qty) {
       assertQty(qty);
-      stock.set(sku, (stock.get(sku) || 0) + qty);
+      stock.set(sku, getStock(sku) + qty);
     },
     removeItem(sku, qty) {
       assertQty(qty);
-      const current = stock.get(sku) || 0;
-      if (qty > current) throw new Error('INSUFFICIENT_STOCK');
-      stock.set(sku, current - qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      stock.set(sku, getStock(sku) - qty);
+    },
+    getStock,
+    getAvailable,
+    reserve(sku, qty, ttlMs) {
+      assertQty(qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      const id = `res-${nextId++}`;
+      reservations.set(id, { sku, qty, expiresAt: clock() + ttlMs });
+      return id;
+    },
+    confirm(id) {
+      const r = reservations.get(id);
+      if (!r) throw new Error('RESERVATION_NOT_FOUND');
+      if (isExpired(r)) throw new Error('RESERVATION_EXPIRED');
+      reservations.delete(id);
+      stock.set(r.sku, getStock(r.sku) - r.qty);
+      return { sku: r.sku, stock: getStock(r.sku) };
     },
-    getStock(sku) {
-      return stock.get(sku) || 0;
+    release(id) {
+      reservations.delete(id);
     },
   };
 }
diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..2a71429
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,120 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function setup(qty = 10) {
+  let now = 1000;
+  const clock = () => now;
+  const s = createStore({ clock });
+  if (qty) s.addItem('A', qty);
+  return { s, advance: (ms) => { now += ms; } };
+}
+
+test('reserve returns unique string ids', () => {
+  const { s } = setup();
+  const a = s.reserve('A', 1, 100);
+  const b = s.reserve('A', 1, 100);
+  assert.strictEqual(typeof a, 'string');
+  assert.notStrictEqual(a, b);
+});
+test('reserve validates qty', () => {
+  const { s } = setup();
+  for (const q of [0, -1, 1.5, '2', undefined]) assert.throws(() => s.reserve('A', q, 100), /INVALID_QTY/);
+});
+test('reserve rejects more than available', () => {
+  const { s } = setup(5);
+  s.reserve('A', 3, 100);
+  assert.throws(() => s.reserve('A', 3, 100), /INSUFFICIENT_STOCK/);
+  assert.throws(() => s.reserve('B', 1, 100), /INSUFFICIENT_STOCK/);
+  s.reserve('A', 2, 100);
+  assert.strictEqual(s.getAvailable('A'), 0);
+});
+test('reservations reduce available but not physical stock', () => {
+  const { s } = setup();
+  s.reserve('A', 4, 100);
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.strictEqual(s.getAvailable('nope'), 0);
+});
+test('reservation expires exactly at creation + ttl', () => {
+  const { s, advance } = setup();
+  const id = s.reserve('A', 4, 100);
+  advance(99);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  advance(1);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+  assert.strictEqual(s.getStock('A'), 10);
+});
+test('expired stock can be reserved again', () => {
+  const { s, advance } = setup(5);
+  s.reserve('A', 5, 10);
+  advance(10);
+  s.reserve('A', 5, 10);
+  assert.strictEqual(s.getAvailable('A'), 0);
+});
+test('confirm turns reservation into sale', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  assert.deepStrictEqual(s.confirm(id), { sku: 'A', stock: 6 });
+  assert.strictEqual(s.getStock('A'), 6);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm unknown or released id is not found', () => {
+  const { s } = setup();
+  assert.throws(() => s.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const id = s.reserve('A', 1, 100);
+  s.release(id);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('release frees stock and is idempotent', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  s.release(id);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  s.release(id);
+  s.release('unknown');
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('removeItem cannot take reserved stock', () => {
+  const { s, advance } = setup();
+  s.reserve('A', 7, 100);
+  assert.throws(() => s.removeItem('A', 4), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 3);
+  assert.strictEqual(s.getStock('A'), 7);
+  advance(100);
+  s.removeItem('A', 7);
+  assert.strictEqual(s.getStock('A'), 0);
+});
+
+test('API: GET /stock includes available', () => {
+  const { s } = setup();
+  const api = createApi(s);
+  s.reserve('A', 3, 100);
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }).body, { sku: 'A', stock: 10, available: 7 });
+});
+test('API: create, confirm and release reservations', () => {
+  const { s, advance } = setup();
+  const api = createApi(s);
+  const created = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 4, ttlMs: 100 } });
+  assert.strictEqual(created.status, 201);
+  assert.strictEqual(typeof created.body.id, 'string');
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${created.body.id}/confirm` }), { status: 200, body: { sku: 'A', stock: 6 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${created.body.id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 100 } }).body;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(s.getAvailable('A'), 6);
+
+  const exp = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 50 } }).body.id;
+  advance(50);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${exp}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('API: reservation errors', () => {
+  const api = createApi(setup(2).s);
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 100 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations/nope/confirm' }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+});
