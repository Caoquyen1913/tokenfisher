diff --git a/src/strings.js b/src/strings.js
index 107e994..c8226c7 100644
--- a/src/strings.js
+++ b/src/strings.js
@@ -2,8 +2,21 @@ function capitalize(text) {
   return text ? text[0].toUpperCase() + text.slice(1) : text;
 }
 
+// Latin letters that NFD does not decompose into base letter + combining mark.
+const LATIN_SPECIAL = { đ: 'd', ð: 'd', ø: 'o', ł: 'l', ß: 'ss', æ: 'ae', œ: 'oe', þ: 'th', ı: 'i' };
+
+const SLUG_MAX_LENGTH = 50;
+
 function slugify(text) {
-  throw new Error('not implemented');
+  return String(text)
+    .toLowerCase()
+    .normalize('NFD')
+    .replace(/[̀-ͯ]/g, '')
+    .replace(/[đðøłßæœþı]/g, (ch) => LATIN_SPECIAL[ch])
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, SLUG_MAX_LENGTH)
+    .replace(/-+$/, '');
 }
 
 module.exports = { capitalize, slugify };
diff --git a/test/strings.test.js b/test/strings.test.js
index a282d44..35a7a74 100644
--- a/test/strings.test.js
+++ b/test/strings.test.js
@@ -1,5 +1,43 @@
 const assert = require('assert');
-const { capitalize } = require('../src/strings');
+const { capitalize, slugify } = require('../src/strings');
 
 test('capitalize first letter', () => assert.strictEqual(capitalize('hello'), 'Hello'));
 test('capitalize empty string', () => assert.strictEqual(capitalize(''), ''));
+
+test('slugify lowercases and joins words with hyphens', () =>
+  assert.strictEqual(slugify('Hello World'), 'hello-world'));
+test('slugify removes Vietnamese diacritics', () =>
+  assert.strictEqual(slugify('Tiếng Việt có dấu'), 'tieng-viet-co-dau'));
+test('slugify maps đ and Đ to d', () =>
+  assert.strictEqual(slugify('Đường đi'), 'duong-di'));
+test('slugify removes other Latin diacritics', () =>
+  assert.strictEqual(slugify('Crème Brûlée à la Señor'), 'creme-brulee-a-la-senor'));
+test('slugify handles decomposed (NFD) input', () =>
+  assert.strictEqual(slugify('Vie\u0302\u0323t'), 'viet'));
+test('slugify collapses runs of non-alphanumerics into one hyphen', () =>
+  assert.strictEqual(slugify('a  --  b!!!c___d'), 'a-b-c-d'));
+test('slugify keeps digits', () => assert.strictEqual(slugify('Top 10 of 2024'), 'top-10-of-2024'));
+test('slugify strips leading and trailing hyphens', () =>
+  assert.strictEqual(slugify('  ...Hello, world!?  '), 'hello-world'));
+test('slugify returns empty string for empty or symbol-only input', () => {
+  assert.strictEqual(slugify(''), '');
+  assert.strictEqual(slugify('!@#$%^&*'), '');
+});
+test('slugify limits length to 50 characters', () => {
+  const slug = slugify('a'.repeat(80));
+  assert.strictEqual(slug, 'a'.repeat(50));
+});
+test('slugify does not end with a hyphen when cut at 50', () => {
+  // The 50th character of the full slug is a hyphen.
+  const slug = slugify('a'.repeat(49) + ' bbbb');
+  assert.strictEqual(slug, 'a'.repeat(49));
+});
+test('slugify keeps a 50-character slug intact', () => {
+  const input = 'x'.repeat(24) + ' ' + 'y'.repeat(25);
+  assert.strictEqual(slugify(input), 'x'.repeat(24) + '-' + 'y'.repeat(25));
+});
+test('slugify output is never longer than 50 and never has edge hyphens', () => {
+  const slug = slugify('Hướng dẫn sử dụng thư viện chuỗi cho người mới bắt đầu học lập trình');
+  assert.ok(slug.length <= 50, slug);
+  assert.match(slug, /^[a-z0-9]+(-[a-z0-9]+)*$/);
+});
