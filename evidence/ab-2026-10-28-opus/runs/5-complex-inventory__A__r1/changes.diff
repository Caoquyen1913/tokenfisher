diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..c18ef9c
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,142 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function setup(initial = 10) {
+  let now = 1000;
+  const clock = { advance: (ms) => (now += ms) };
+  const s = createStore({ clock: () => now });
+  s.addItem('A', initial);
+  return { s, clock };
+}
+
+test('reserve returns unique string ids', () => {
+  const { s } = setup();
+  const a = s.reserve('A', 1, 1000);
+  const b = s.reserve('A', 1, 1000);
+  assert.strictEqual(typeof a, 'string');
+  assert.notStrictEqual(a, b);
+});
+test('reserve validates qty', () => {
+  const { s } = setup();
+  for (const q of [0, -1, 1.5, '2', undefined]) assert.throws(() => s.reserve('A', q, 1000), /INVALID_QTY/);
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('reserve rejects more than available', () => {
+  const { s } = setup(5);
+  s.reserve('A', 3, 1000);
+  assert.throws(() => s.reserve('A', 3, 1000), /INSUFFICIENT_STOCK/);
+  assert.throws(() => s.reserve('B', 1, 1000), /INSUFFICIENT_STOCK/);
+  s.reserve('A', 2, 1000);
+  assert.strictEqual(s.getAvailable('A'), 0);
+});
+test('getAvailable subtracts active reservations; getStock stays physical', () => {
+  const { s } = setup();
+  s.reserve('A', 4, 1000);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('nope'), 0);
+});
+test('reservation expires exactly at creation + ttl', () => {
+  const { s, clock } = setup();
+  const id = s.reserve('A', 4, 1000);
+  clock.advance(999);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  clock.advance(1);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+  assert.strictEqual(s.getStock('A'), 10);
+});
+test('expired stock can be reserved again', () => {
+  const { s, clock } = setup(5);
+  s.reserve('A', 5, 100);
+  clock.advance(100);
+  s.reserve('A', 5, 100);
+  assert.strictEqual(s.getAvailable('A'), 0);
+});
+test('confirm sells the reserved qty and removes the reservation', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 1000);
+  assert.deepStrictEqual(s.confirm(id), { sku: 'A', stock: 6 });
+  assert.strictEqual(s.getStock('A'), 6);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm just before expiry succeeds', () => {
+  const { s, clock } = setup();
+  const id = s.reserve('A', 2, 50);
+  clock.advance(49);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 8);
+});
+test('confirm unknown or released id is not found', () => {
+  const { s } = setup();
+  assert.throws(() => s.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const id = s.reserve('A', 2, 1000);
+  s.release(id);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('release frees stock and is idempotent', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 1000);
+  s.release(id);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  s.release(id);
+  s.release('nope');
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('removeItem cannot take reserved stock', () => {
+  const { s, clock } = setup();
+  s.reserve('A', 7, 1000);
+  assert.throws(() => s.removeItem('A', 4), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 3);
+  assert.strictEqual(s.getStock('A'), 7);
+  clock.advance(1000);
+  s.removeItem('A', 7);
+  assert.strictEqual(s.getStock('A'), 0);
+});
+test('reservations are per sku', () => {
+  const { s } = setup();
+  s.addItem('B', 3);
+  s.reserve('B', 3, 1000);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  assert.strictEqual(s.getAvailable('B'), 0);
+});
+
+function apiSetup() {
+  const { s, clock } = setup();
+  return { api: createApi(s), clock };
+}
+
+test('GET /stock includes available', () => {
+  const { api } = apiSetup();
+  api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 1000 } });
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }), { status: 200, body: { sku: 'A', stock: 10, available: 7 } });
+});
+test('POST /reservations status codes', () => {
+  const { api } = apiSetup();
+  const ok = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 1000 } });
+  assert.strictEqual(ok.status, 201);
+  assert.strictEqual(typeof ok.body.id, 'string');
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 8, ttlMs: 1000 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 1000 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+});
+test('POST /reservations/:id/confirm status codes', () => {
+  const { api, clock } = apiSetup();
+  const reserve = (qty) => api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty, ttlMs: 100 } }).body.id;
+  const id = reserve(3);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'A', stock: 7 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+  const late = reserve(1);
+  clock.advance(100);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${late}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('DELETE /reservations/:id returns 204 and frees stock', () => {
+  const { api } = apiSetup();
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 1000 } }).body;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: '/reservations/nope' }).status, 204);
+  assert.strictEqual(api({ method: 'GET', path: '/stock/A' }).body.available, 10);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+});
