 // In-memory inventory. `clock` is injectable so tests can control time.
 function createStore({ clock = Date.now } = {}) {
   const stock = new Map();
+  // id -> { sku, qty, expiresAt }. Removed on confirm/release; expired ones stay
+  // so confirm can report RESERVATION_EXPIRED, but no longer count as reserved.
+  const reservations = new Map();
+  let nextId = 1;
 
   function assertQty(qty) {
     if (!Number.isInteger(qty) || qty <= 0) throw new Error('INVALID_QTY');
   }
 
+  function isExpired(r) {
+    return clock() >= r.expiresAt;
+  }
+
+  function reserved(sku) {
+    let total = 0;
+    for (const r of reservations.values()) {
+      if (r.sku === sku && !isExpired(r)) total += r.qty;
+    }
+    return total;
+  }
+
+  function getAvailable(sku) {
+    return (stock.get(sku) || 0) - reserved(sku);
+  }
+
   return {
     clock,
     addItem(sku, qty) {
@@ -14,13 +34,32 @@ function createStore({ clock = Date.now } = {}) {
     },
     removeItem(sku, qty) {
       assertQty(qty);
-      const current = stock.get(sku) || 0;
-      if (qty > current) throw new Error('INSUFFICIENT_STOCK');
-      stock.set(sku, current - qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      stock.set(sku, (stock.get(sku) || 0) - qty);
     },
     getStock(sku) {
       return stock.get(sku) || 0;
     },
+    getAvailable,
+    reserve(sku, qty, ttlMs) {
+      assertQty(qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      const id = `res-${nextId++}`;
+      reservations.set(id, { sku, qty, expiresAt: clock() + ttlMs });
+      return id;
+    },
+    // Returns the reservation's sku.
+    confirm(id) {
+      const r = reservations.get(id);
+      if (!r) throw new Error('RESERVATION_NOT_FOUND');
+      if (isExpired(r)) throw new Error('RESERVATION_EXPIRED');
+      reservations.delete(id);
+      stock.set(r.sku, (stock.get(r.sku) || 0) - r.qty);
+      return r.sku;
+    },
+    release(id) {
+      reservations.delete(id);
+    },
   };
 }
 
diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..18931b4
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,112 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function setup(qty = 10) {
+  let now = 1000;
+  const s = createStore({ clock: () => now });
+  s.addItem('A', qty);
+  return { s, advance: (ms) => { now += ms; } };
+}
+
+test('reserve returns unique string ids', () => {
+  const { s } = setup();
+  const a = s.reserve('A', 1, 100);
+  const b = s.reserve('A', 1, 100);
+  assert.strictEqual(typeof a, 'string');
+  assert.notStrictEqual(a, b);
+});
+test('reserve validates qty', () => {
+  const { s } = setup();
+  for (const q of [0, -1, 1.5, '2', undefined]) assert.throws(() => s.reserve('A', q, 100), /INVALID_QTY/);
+});
+test('reserve rejects more than available', () => {
+  const { s } = setup(5);
+  s.reserve('A', 3, 100);
+  assert.throws(() => s.reserve('A', 3, 100), /INSUFFICIENT_STOCK/);
+  assert.throws(() => s.reserve('B', 1, 100), /INSUFFICIENT_STOCK/);
+  s.reserve('A', 2, 100);
+  assert.strictEqual(s.getAvailable('A'), 0);
+});
+test('available excludes active reservations; stock stays physical', () => {
+  const { s } = setup(10);
+  s.reserve('A', 4, 100);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('unknown'), 0);
+});
+test('reservation expires exactly at creation + ttl', () => {
+  const { s, advance } = setup(10);
+  const id = s.reserve('A', 4, 100);
+  advance(99);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  advance(1);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+  assert.strictEqual(s.getStock('A'), 10);
+});
+test('confirm reduces physical stock and removes reservation', () => {
+  const { s } = setup(10);
+  const id = s.reserve('A', 4, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 6);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm throws NOT_FOUND for unknown or released ids', () => {
+  const { s } = setup();
+  assert.throws(() => s.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const id = s.reserve('A', 1, 100);
+  s.release(id);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('release frees stock and is idempotent', () => {
+  const { s } = setup(10);
+  const id = s.reserve('A', 4, 100);
+  s.release(id);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  s.release(id);
+  s.release('nope');
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('removeItem cannot take reserved stock', () => {
+  const { s, advance } = setup(10);
+  s.reserve('A', 8, 100);
+  assert.throws(() => s.removeItem('A', 3), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 2);
+  assert.strictEqual(s.getStock('A'), 8);
+  advance(100);
+  s.removeItem('A', 3);
+  assert.strictEqual(s.getStock('A'), 5);
+});
+
+test('API: GET /stock includes available', () => {
+  const { s } = setup(10);
+  const api = createApi(s);
+  api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } });
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }), { status: 200, body: { sku: 'A', stock: 10, available: 7 } });
+});
+test('API: reservation lifecycle and errors', () => {
+  const { s, advance } = setup(10);
+  const api = createApi(s);
+  const reserve = (qty, ttlMs) => api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty, ttlMs } });
+  const confirm = (id) => api({ method: 'POST', path: `/reservations/${id}/confirm` });
+
+  const created = reserve(3, 100);
+  assert.strictEqual(created.status, 201);
+  assert.strictEqual(typeof created.body.id, 'string');
+  assert.deepStrictEqual(reserve(8, 100), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(reserve(0, 100), { status: 400, body: { error: 'INVALID_QTY' } });
+  assert.deepStrictEqual(confirm(created.body.id), { status: 200, body: { sku: 'A', stock: 7 } });
+  assert.deepStrictEqual(confirm(created.body.id), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+
+  const expiring = reserve(1, 50).body.id;
+  advance(50);
+  assert.deepStrictEqual(confirm(expiring), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+
+  const released = reserve(2, 100).body.id;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${released}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${released}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: '/reservations/unknown' }).status, 204);
+  assert.strictEqual(s.getAvailable('A'), 7);
+});
