 // Parses a user-entered amount such as "12.50" into integer cents.
 // Throws Error('Invalid amount: <input>') for input that is not an amount.
 function parseAmount(input) {
-  const m = String(input).trim().match(/^(\d+)(?:\.(\d{1,2}))?$/);
-  const whole = Number(m[1]);
+  // Accepts optional thousands separators, e.g. "2,450.50".
+  const m = String(input).trim().match(/^(\d{1,3}(?:,\d{3})+|\d+)(?:\.(\d{1,2}))?$/);
+  if (!m) throw new Error(`Invalid amount: ${input}`);
+  const whole = Number(m[1].replace(/,/g, ''));
   const frac = m[2] ? Number(m[2].padEnd(2, '0')) : 0;
   return whole * 100 + frac;
 }
diff --git a/test/checkout-thousands.test.js b/test/checkout-thousands.test.js
new file mode 100644
index 0000000..f83b9f8
--- /dev/null
+++ b/test/checkout-thousands.test.js
@@ -0,0 +1,21 @@
+const assert = require('assert');
+const { parseAmount } = require('../src/money');
+const { checkout } = require('../src/checkout');
+
+// Regression: prices with thousands separators (seen in prod logs) crashed checkout with a 500.
+test('parses amounts with thousands separators', () => {
+  assert.strictEqual(parseAmount('2,450.50'), 245050);
+  assert.strictEqual(parseAmount('1,005.99'), 100599);
+  assert.strictEqual(parseAmount('1,234,567'), 123456700);
+});
+test('checkout handles thousands-separated prices', () => {
+  assert.deepStrictEqual(
+    checkout({ id: 'o2', items: [{ sku: 'P-76', price: '1,299.00', qty: 2 }] }),
+    { orderId: 'o2', totalCents: 259800 }
+  );
+});
+test('rejects malformed amounts with a clear error', () => {
+  for (const bad of ['abc', '', '1,23.00', '12,3456', '1.234', ',100']) {
+    assert.throws(() => parseAmount(bad), /Invalid amount/);
+  }
+});
