diff --git a/test/report.test.js b/test/report.test.js
index 9353f4d..e7b7bbf 100644
--- a/test/report.test.js
+++ b/test/report.test.js
@@ -17,3 +17,52 @@ test('respects the limit', () => {
   assert.strictEqual(summarize(orders).length, 10);
   assert.strictEqual(summarize(orders, 3).length, 3);
 });
+
+// Reference implementation (the original slow algorithm) used to pin exact output.
+function reference(orders, limit = 10) {
+  const EUR_TO_USD = 1.08;
+  const byRank = (a, b) => {
+    if (a.spendCents !== b.spendCents) return b.spendCents - a.spendCents;
+    if (a.firstOrderAt !== b.firstOrderAt) return a.firstOrderAt < b.firstOrderAt ? -1 : 1;
+    return a.customerId < b.customerId ? -1 : a.customerId > b.customerId ? 1 : 0;
+  };
+  const seen = [];
+  const groups = [];
+  for (const o of orders) {
+    if (seen.includes(o.id)) continue;
+    seen.push(o.id);
+    if (o.status === 'refunded') continue;
+    let g = groups.find((x) => x.customerId === o.customerId);
+    if (!g) { g = { customerId: o.customerId, spendCents: 0, orderCount: 0, firstOrderAt: o.createdAt }; groups.push(g); }
+    g.orderCount++;
+    if (o.createdAt < g.firstOrderAt) g.firstOrderAt = o.createdAt;
+    if (o.status === 'paid') g.spendCents += o.currency === 'EUR' ? Math.round(o.amountCents * EUR_TO_USD) : o.amountCents;
+    groups.sort(byRank);
+  }
+  return groups.filter((g) => g.spendCents > 0).slice(0, limit).map((g, i) => ({ rank: i + 1, ...g }));
+}
+
+function randomOrders(n, seed) {
+  let s = seed;
+  const rnd = (m) => { s = (s * 1103515245 + 12345) & 0x7fffffff; return s % m; };
+  const statuses = ['paid', 'paid', 'pending', 'refunded'];
+  return Array.from({ length: n }, () => order(
+    `o${rnd(Math.max(1, n * 0.9 | 0))}`, `cus_${rnd(40)}`, statuses[rnd(4)], rnd(5000),
+    `2026-10-01T${String(rnd(24)).padStart(2, '0')}:${String(rnd(60)).padStart(2, '0')}:00Z`,
+    rnd(2) ? 'EUR' : 'USD'));
+}
+
+test('matches the reference output exactly (dupes, refunds, EUR, ties)', () => {
+  for (let seed = 1; seed <= 20; seed++) {
+    const orders = randomOrders(300, seed);
+    assert.deepStrictEqual(summarize(orders, 1000), reference(orders, 1000));
+    assert.deepStrictEqual(summarize(orders), reference(orders));
+  }
+});
+
+test('handles 200,000 orders quickly', () => {
+  const orders = Array.from({ length: 200000 }, (_, i) => order(`o${i}`, `cus_${i % 50000}`, 'paid', 100 + (i % 977), '2026-10-01T10:00:00Z'));
+  const t = Date.now();
+  summarize(orders);
+  assert.ok(Date.now() - t < 1000, 'summarize too slow');
+});
