diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..f64a58e
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,125 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function setup(stock = 10) {
+  let now = 1000;
+  const clock = { tick: (ms) => { now += ms; } };
+  const store = createStore({ clock: () => now });
+  store.addItem('A', stock);
+  return { store, clock };
+}
+
+test('reserve returns unique string ids and lowers availability only', () => {
+  const { store } = setup();
+  const a = store.reserve('A', 3, 1000);
+  const b = store.reserve('A', 2, 1000);
+  assert.strictEqual(typeof a, 'string');
+  assert.notStrictEqual(a, b);
+  assert.strictEqual(store.getAvailable('A'), 5);
+  assert.strictEqual(store.getStock('A'), 10);
+});
+test('reserve validates qty', () => {
+  const { store } = setup();
+  for (const qty of [0, -1, 1.5, '2', undefined]) {
+    assert.throws(() => store.reserve('A', qty, 1000), /INVALID_QTY/);
+  }
+});
+test('reserve cannot exceed available stock', () => {
+  const { store } = setup(5);
+  store.reserve('A', 4, 1000);
+  assert.throws(() => store.reserve('A', 2, 1000), /INSUFFICIENT_STOCK/);
+  assert.throws(() => store.reserve('B', 1, 1000), /INSUFFICIENT_STOCK/);
+  store.reserve('A', 1, 1000);
+  assert.strictEqual(store.getAvailable('A'), 0);
+});
+test('reservation expires exactly at creation + ttl', () => {
+  const { store, clock } = setup();
+  const id = store.reserve('A', 4, 100);
+  clock.tick(99);
+  assert.strictEqual(store.getAvailable('A'), 6);
+  clock.tick(1);
+  assert.strictEqual(store.getAvailable('A'), 10);
+  assert.throws(() => store.confirm(id), /RESERVATION_EXPIRED/);
+  assert.strictEqual(store.getStock('A'), 10);
+});
+test('expired stock can be reserved again', () => {
+  const { store, clock } = setup(3);
+  store.reserve('A', 3, 50);
+  clock.tick(50);
+  store.reserve('A', 3, 50);
+  assert.strictEqual(store.getAvailable('A'), 0);
+});
+test('confirm sells reserved stock and removes the reservation', () => {
+  const { store } = setup();
+  const id = store.reserve('A', 4, 1000);
+  store.confirm(id);
+  assert.strictEqual(store.getStock('A'), 6);
+  assert.strictEqual(store.getAvailable('A'), 6);
+  assert.throws(() => store.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm rejects unknown and released ids', () => {
+  const { store } = setup();
+  assert.throws(() => store.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const id = store.reserve('A', 1, 1000);
+  store.release(id);
+  assert.throws(() => store.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('release frees stock and is idempotent', () => {
+  const { store } = setup();
+  const id = store.reserve('A', 4, 1000);
+  store.release(id);
+  assert.strictEqual(store.getAvailable('A'), 10);
+  store.release(id);
+  store.release('unknown');
+  assert.strictEqual(store.getAvailable('A'), 10);
+  assert.strictEqual(store.getStock('A'), 10);
+});
+test('removeItem cannot take reserved stock', () => {
+  const { store, clock } = setup();
+  store.reserve('A', 7, 100);
+  assert.throws(() => store.removeItem('A', 4), /INSUFFICIENT_STOCK/);
+  store.removeItem('A', 3);
+  assert.strictEqual(store.getStock('A'), 7);
+  assert.strictEqual(store.getAvailable('A'), 0);
+  clock.tick(100);
+  store.removeItem('A', 7);
+  assert.strictEqual(store.getStock('A'), 0);
+});
+test('default clock is Date.now', () => {
+  const s = createStore();
+  s.addItem('A', 1);
+  s.reserve('A', 1, 60000);
+  assert.strictEqual(s.getAvailable('A'), 0);
+});
+
+test('API: GET /stock includes available', () => {
+  const { store } = setup();
+  const api = createApi(store);
+  store.reserve('A', 3, 1000);
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }), { status: 200, body: { sku: 'A', stock: 10, available: 7 } });
+});
+test('API: reservation lifecycle', () => {
+  const { store, clock } = setup();
+  const api = createApi(store);
+  const created = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 4, ttlMs: 100 } });
+  assert.strictEqual(created.status, 201);
+  assert.strictEqual(typeof created.body.id, 'string');
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 7, ttlMs: 100 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 100 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${created.body.id}/confirm` }), { status: 200, body: { sku: 'A', stock: 6 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${created.body.id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+
+  const expiring = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 1, ttlMs: 100 } }).body.id;
+  clock.tick(100);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${expiring}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('API: DELETE /reservations/:id returns 204 and releases', () => {
+  const { store } = setup();
+  const api = createApi(store);
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 4, ttlMs: 100 } }).body;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: '/reservations/unknown' }).status, 204);
+  assert.strictEqual(store.getAvailable('A'), 10);
+});
