diff --git a/src/strings.js b/src/strings.js
index 107e994..dda7704 100644
--- a/src/strings.js
+++ b/src/strings.js
@@ -2,8 +2,18 @@ function capitalize(text) {
   return text ? text[0].toUpperCase() + text.slice(1) : text;
 }
 
+const MAX_SLUG_LENGTH = 50;
+
 function slugify(text) {
-  throw new Error('not implemented');
+  return String(text)
+    .toLowerCase()
+    .replace(/đ/g, 'd')
+    .normalize('NFD')
+    .replace(/[̀-ͯ]/g, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, MAX_SLUG_LENGTH)
+    .replace(/-+$/, '');
 }
 
 module.exports = { capitalize, slugify };
diff --git a/test/strings.test.js b/test/strings.test.js
index a282d44..d9b03d5 100644
--- a/test/strings.test.js
+++ b/test/strings.test.js
@@ -1,5 +1,28 @@
 const assert = require('assert');
-const { capitalize } = require('../src/strings');
+const { capitalize, slugify } = require('../src/strings');
 
 test('capitalize first letter', () => assert.strictEqual(capitalize('hello'), 'Hello'));
 test('capitalize empty string', () => assert.strictEqual(capitalize(''), ''));
+
+test('slugify lowercases and hyphenates words', () => assert.strictEqual(slugify('Hello World'), 'hello-world'));
+test('slugify strips Vietnamese diacritics', () => assert.strictEqual(slugify('Xin chào Việt Nam'), 'xin-chao-viet-nam'));
+test('slugify maps đ and Đ to d', () => assert.strictEqual(slugify('Đường đi'), 'duong-di'));
+test('slugify strips other Latin diacritics', () => assert.strictEqual(slugify('Crème Brûlée à la façon'), 'creme-brulee-a-la-facon'));
+test('slugify collapses runs of non-alphanumerics', () => assert.strictEqual(slugify('a  --  b__c!!!d'), 'a-b-c-d'));
+test('slugify trims leading and trailing hyphens', () => assert.strictEqual(slugify('  --Hello!--  '), 'hello'));
+test('slugify keeps digits', () => assert.strictEqual(slugify('Top 10 of 2024'), 'top-10-of-2024'));
+test('slugify of empty or symbol-only input is empty', () => {
+  assert.strictEqual(slugify(''), '');
+  assert.strictEqual(slugify('!!! ---'), '');
+});
+test('slugify truncates to 50 characters', () => {
+  const slug = slugify('a'.repeat(80));
+  assert.strictEqual(slug, 'a'.repeat(50));
+});
+test('slugify truncation never leaves a trailing hyphen', () => {
+  const text = 'a'.repeat(49) + ' bbb';
+  assert.strictEqual(slugify(text), 'a'.repeat(49));
+  const slug = slugify('word '.repeat(20));
+  assert.ok(slug.length <= 50);
+  assert.ok(!slug.endsWith('-'));
+});
