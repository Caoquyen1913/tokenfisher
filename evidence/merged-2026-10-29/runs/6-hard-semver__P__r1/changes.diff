+test('satisfies: non-matching versions and invalid input return false', () => {
+  for (const [ver, range] of no) assert.strictEqual(satisfies(ver, range), false, `${ver} should not satisfy "${range}"`);
+});
+
+test('satisfies: never throws', () => {
+  for (const x of [{}, [], Symbol('s'), () => {}, NaN]) {
+    assert.doesNotThrow(() => satisfies(x, '*'));
+    assert.doesNotThrow(() => satisfies('1.0.0', x));
+  }
+});
