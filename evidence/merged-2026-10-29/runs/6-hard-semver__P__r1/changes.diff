+const no = [
+  ['1.2.4', '1.2.3'], ['1.2.3', '>1.2.3'], ['1.2.3', '<1.2.3'], ['2.0.0', '1'], ['1.3.0', '1.2'], ['1.3.0', '~1.2.3'],
