+  ['1.0.0-rc.1', '<1.0.0'], ['1.0.0-alpha', '>1.0.0-alpha.1'], ['1.0.0-alpha.1', '<1.0.0-alpha'], ['2.0.0-beta', '<2.0.0'],
+  ['1.2.3-beta.1', '~1.2.3-beta.2'], ['1.0.0-1', '>1.0.0-alpha'], ['1.0.0-rc.1', '>=1.0.0 || >2.0.0-a'],
