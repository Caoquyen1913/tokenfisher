--- a/src/semver.js
+++ b/src/semver.js
@@ -1,6 +1,190 @@
 // See docs/SPEC.md.
+const IDS = '[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*';
+const NUM = '0|[1-9]\\d*';
+const PART = `${NUM}|[xX*]`;
+const VERSION_RE = new RegExp(`^v?(${NUM})\\.(${NUM})\\.(${NUM})(?:-(${IDS}))?(?:\\+${IDS})?$`);
+const PARTIAL_RE = new RegExp(
+  `^v?(${PART})(?:\\.(${PART})(?:\\.(${PART})(?:-(${IDS}))?(?:\\+${IDS})?)?)?$`
+);
+const OP_RE = /^(<=|>=|<|>|=|~|\^)?(.*)$/;
+
+class InvalidError extends Error {}
+
+function parseVersion(str) {
+  const m = VERSION_RE.exec(str);
+  if (!m) return null;
+  return {
+    major: BigInt(m[1]),
+    minor: BigInt(m[2]),
+    patch: BigInt(m[3]),
+    pre: m[4] ? m[4].split('.') : [],
+  };
+}
+
+function cmpNum(a, b) {
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function cmpPre(a, b) {
+  if (!a.length && !b.length) return 0;
+  if (!a.length) return 1;
+  if (!b.length) return -1;
+  for (let i = 0; i < Math.min(a.length, b.length); i++) {
+    if (a[i] === b[i]) continue;
+    const an = /^\d+$/.test(a[i]);
+    const bn = /^\d+$/.test(b[i]);
+    if (an && bn) return cmpNum(BigInt(a[i]), BigInt(b[i]));
+    if (an) return -1;
+    if (bn) return 1;
+    return a[i] < b[i] ? -1 : 1;
+  }
+  return cmpNum(a.length, b.length);
+}
+
+function compare(a, b) {
+  return (
+    cmpNum(a.major, b.major) ||
+    cmpNum(a.minor, b.minor) ||
+    cmpNum(a.patch, b.patch) ||
+    cmpPre(a.pre, b.pre)
+  );
+}
+
+// Partial version: `n` is the number of leading numeric positions given (0-3).
+function parsePartial(str) {
+  const m = PARTIAL_RE.exec(str);
+  if (!m) throw new InvalidError(str);
+  const nums = [];
+  for (let i = 1; i <= 3; i++) {
+    if (m[i] === undefined || /^[xX*]$/.test(m[i])) break;
+    nums.push(BigInt(m[i]));
+  }
+  if (m[4] && nums.length < 3) throw new InvalidError(str);
+  return { n: nums.length, nums, pre: m[4] ? m[4].split('.') : [] };
+}
+
+const ver = (major, minor, patch, pre = []) => ({ major, minor, patch, pre });
+const lower = (p) => ver(p.nums[0] || 0n, p.nums[1] || 0n, p.nums[2] || 0n, p.pre);
+// Exclusive upper bound that bumps position `n - 1` (n = 1: major, n = 2: minor).
+const bump = (p) =>
+  p.n === 1 ? ver(p.nums[0] + 1n, 0n, 0n) : ver(p.nums[0], p.nums[1] + 1n, 0n);
+
+const NONE = [{ op: 'none' }];
+const GE0 = []; // matches any non-prerelease version
+
+function exactOrRange(p) {
+  if (p.n === 0) return GE0;
+  if (p.n === 3) return [{ op: '=', v: lower(p) }];
+  return [{ op: '>=', v: lower(p) }, { op: '<', v: bump(p) }];
+}
+
+function operator(op, p) {
+  switch (op) {
+    case '':
+    case '=':
+      return exactOrRange(p);
+    case '>':
+      if (p.n === 0) return NONE;
+      if (p.n === 3) return [{ op: '>', v: lower(p) }];
+      return [{ op: '>=', v: bump(p) }];
+    case '>=':
+      return p.n === 0 ? GE0 : [{ op: '>=', v: lower(p) }];
+    case '<':
+      return p.n === 0 ? NONE : [{ op: '<', v: lower(p) }];
+    case '<=':
+      if (p.n === 0) return GE0;
+      if (p.n === 3) return [{ op: '<=', v: lower(p) }];
+      return [{ op: '<', v: bump(p) }];
+    case '~':
+      if (p.n === 0) return GE0;
+      return [{ op: '>=', v: lower(p) }, { op: '<', v: p.n === 1 ? bump(p) : ver(p.nums[0], p.nums[1] + 1n, 0n) }];
+    case '^': {
+      if (p.n === 0) return GE0;
+      const [M, m = 0n, pa = 0n] = p.nums;
+      let upper;
+      if (M > 0n || p.n === 1) upper = ver(M + 1n, 0n, 0n);
+      else if (m > 0n || p.n === 2) upper = ver(0n, m + 1n, 0n);
+      else upper = ver(0n, 0n, pa + 1n);
+      return [{ op: '>=', v: lower(p) }, { op: '<', v: upper }];
+    }
+    default:
+      throw new InvalidError(op);
+  }
+}
+
+function hyphen(a, b) {
+  const lo = parsePartial(a);
+  const hi = parsePartial(b);
+  const out = lo.n === 0 ? [] : [{ op: '>=', v: lower(lo) }];
+  if (hi.n === 3) out.push({ op: '<=', v: lower(hi) });
+  else if (hi.n > 0) out.push({ op: '<', v: bump(hi) });
+  return out;
+}
+
+function parseSet(str) {
+  const raw = str.trim() === '' ? [] : str.trim().split(/\s+/);
+  const tokens = [];
+  for (let i = 0; i < raw.length; i++) {
+    if (/^(<=|>=|<|>|=)$/.test(raw[i])) {
+      if (i + 1 >= raw.length || /^[<>=]/.test(raw[i + 1])) throw new InvalidError(str);
+      tokens.push(raw[i] + raw[++i]);
+    } else {
+      tokens.push(raw[i]);
+    }
+  }
+  const comps = [];
+  for (let i = 0; i < tokens.length; i++) {
+    if (tokens[i + 1] === '-') {
+      if (i + 2 >= tokens.length) throw new InvalidError(str);
+      comps.push(...hyphen(tokens[i], tokens[i + 2]));
+      i += 2;
+    } else {
+      const [, op = '', rest] = OP_RE.exec(tokens[i]);
+      comps.push(...operator(op, parsePartial(rest)));
+    }
+  }
+  return comps;
+}
+
+function parseRange(range) {
+  return range.split('||').map(parseSet);
+}
+
+function test(v, c) {
+  if (c.op === 'none') return false;
+  const d = compare(v, c.v);
+  switch (c.op) {
+    case '>': return d > 0;
+    case '>=': return d >= 0;
+    case '<': return d < 0;
+    case '<=': return d <= 0;
+    default: return d === 0;
+  }
+}
+
+function setMatches(v, comps) {
+  if (!comps.every((c) => test(v, c))) return false;
+  if (!v.pre.length) return true;
+  return comps.some(
+    (c) =>
+      c.v &&
+      c.v.pre.length &&
+      c.v.major === v.major &&
+      c.v.minor === v.minor &&
+      c.v.patch === v.patch
+  );
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    if (typeof version !== 'string' || typeof range !== 'string') return false;
+    const v = parseVersion(version.trim());
+    if (!v) return false;
+    return parseRange(range).some((comps) => setMatches(v, comps));
+  } catch (e) {
+    if (e instanceof InvalidError) return false;
+    throw e;
+  }
 }
 
 module.exports = { satisfies };
diff --git a/test/satisfies.test.js b/test/satisfies.test.js
