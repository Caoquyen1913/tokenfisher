@@ -0,0 +1,132 @@
+const assert = require('assert');
+const { satisfies } = require('../src/semver');
+
+const yes = (v, r) => test(`${v} satisfies "${r}"`, () => assert.strictEqual(satisfies(v, r), true));
+const no = (v, r) => test(`${v} does not satisfy "${r}"`, () => assert.strictEqual(satisfies(v, r), false));
+
+// versions
+yes('1.2.3', '1.2.3');
+yes('v1.2.3', '=1.2.3');
+yes('  1.2.3  ', '1.2.3');
+yes('1.2.3+build.5', '1.2.3+other');
+no('01.2.3', '*');
+no('1.2', '*');
+no('1.2.3.4', '*');
+no('1.2.3-', '*');
+no('', '*');
+no('1.2.3', 'foo');
+no('1.2.3', '>=');
+no('1.2.3', '1.2.3 -');
+no('1.2.3', '>1.0.0 ||| <2');
+test('never throws on non-strings', () => assert.strictEqual(satisfies(null, undefined), false));
+
+// ordering
+yes('1.0.0', '>1.0.0-rc.1');
+yes('1.0.0-rc.1', '<1.0.0-rc.2');
+yes('1.0.0-alpha.1', '>1.0.0-alpha');
+yes('1.0.0-alpha.beta', '>1.0.0-alpha.1');
+yes('1.0.0-beta.11', '>1.0.0-beta.2');
+yes('1.0.0-beta', '>1.0.0-alpha.9');
+no('1.0.0-alpha', '>1.0.0-alpha.1');
+yes('1.0.0-rc.1', '<=1.0.0-rc.1');
+yes('10.0.0', '>9.0.0');
+yes('1.2.3', '>=1.2.3 <1.2.4');
+
+// sets and whitespace
+yes('2.0.0', '1.x || 2.x');
+no('3.0.0', '1.x || 2.x');
+yes('1.5.0', '>= 1.2.3 < 2');
+no('1.0.0', '>=1.2.3 <2');
+yes('5.0.0', '');
+yes('5.0.0', '*');
+yes('5.0.0', 'x');
+yes('1.2.3', '1.0.0 ||');
+
+// x-ranges
+yes('1.9.9', '1');
+yes('1.0.0', '1.x');
+no('2.0.0', '1');
+yes('1.2.9', '1.2');
+no('1.3.0', '1.2.x');
+yes('1.2.3', '1.2.*');
+yes('1.2.3', '=1.2');
+
+// operators with partials
+yes('2.0.0', '>1');
+no('1.9.9', '>1');
+yes('1.3.0', '>1.2');
+no('1.2.9', '>1.2');
+yes('1.0.0', '>=1');
+no('0.9.9', '>=1');
+yes('1.2.0', '>=1.2');
+no('1.0.0', '<1');
+yes('0.9.9', '<1');
+no('1.2.0', '<1.2');
+yes('1.9.9', '<=1');
+no('2.0.0', '<=1');
+yes('1.2.9', '<=1.2');
+no('1.3.0', '<=1.2');
+no('1.0.0', '>*');
+yes('1.0.0', '>=*');
+
+// tilde
+yes('1.2.9', '~1.2.3');
+no('1.3.0', '~1.2.3');
+no('1.2.2', '~1.2.3');
+yes('1.2.0', '~1.2');
+no('1.3.0', '~1.2');
+yes('1.9.0', '~1');
+no('2.0.0', '~1');
+yes('1.2.3-beta.5', '~1.2.3-beta.2');
+no('1.2.3-beta.1', '~1.2.3-beta.2');
+no('1.2.4-beta.5', '~1.2.3-beta.2');
+
+// caret
+yes('1.9.9', '^1.2.3');
+no('2.0.0', '^1.2.3');
+yes('0.2.9', '^0.2.3');
+no('0.3.0', '^0.2.3');
+yes('0.0.3', '^0.0.3');
+no('0.0.4', '^0.0.3');
+yes('1.9.0', '^1.2');
+yes('1.9.0', '^1');
+no('2.0.0', '^1');
+yes('0.2.9', '^0.2');
+no('0.3.0', '^0.2');
+yes('0.0.9', '^0.0');
+no('0.1.0', '^0.0');
+yes('0.9.9', '^0');
+yes('0.9.9', '^0.x');
+no('1.0.0', '^0');
+yes('1.5.0', '^1.2.3-beta.2');
+yes('1.2.3-beta.4', '^1.2.3-beta.2');
+no('2.0.0', '^1.2.3-beta.2');
+
+// hyphen
+yes('1.2.3', '1.2.3 - 2.3.4');
+yes('2.3.4', '1.2.3 - 2.3.4');
+no('2.3.5', '1.2.3 - 2.3.4');
+yes('1.2.0', '1.2 - 2.3.4');
+no('1.1.9', '1.2 - 2.3.4');
+yes('2.3.9', '1.2.3 - 2.3');
+no('2.4.0', '1.2.3 - 2.3');
+yes('2.9.9', '1.2.3 - 2');
+no('3.0.0', '1.2.3 - 2');
+yes('1.5.0', '1.2.3 - 2.3.4 || 5.0.0');
+yes('5.0.0', '1.2.3 - 2.3.4 || 5.0.0');
+
+// prereleases
+yes('1.2.3-alpha.7', '>1.2.3-alpha.3');
+no('3.4.5-alpha.9', '>1.2.3-alpha.3');
+no('1.2.4-beta', '^1.2.3');
+no('1.2.3-beta', '*');
+no('1.2.3-beta', '>=1.0.0');
+yes('1.2.3-beta', '>=1.2.3-alpha');
+yes('1.2.3-beta', '1.2.3-beta');
+no('1.2.3-beta', '1.2.3-alpha');
+yes('1.2.3-beta', '<1.2.3 || 1.2.3-beta');
+no('1.2.3-beta', '<1.2.3 || >=1.2.3-gamma');
+no('2.0.0-alpha', '^1.2.3');
+no('2.0.0-alpha', '<2.0.0');
+yes('2.0.0-alpha', '<2.0.0-beta');
+yes('1.2.3-alpha.5', '>=1.2.3-alpha.1 <1.2.4');
