+test('zero-decimal currencies (JPY, KRW) are charged in whole units', () => {
+  const jpy = buildChargePayload({ id: 'i3', number: 'INV-3', currency: 'JPY', total: 1500 }, customer);
+  assert.strictEqual(jpy.amount, 1500);
+  assert.strictEqual(jpy.currency, 'jpy');
+  const krw = buildChargePayload({ id: 'i4', number: 'INV-4', currency: 'KRW', total: 20000 }, customer);
+  assert.strictEqual(krw.amount, 20000);
+});
+
+test('three-decimal currency (KWD) is charged in fils', () => {
+  const p = buildChargePayload({ id: 'i5', number: 'INV-5', currency: 'KWD', total: 1.5 }, customer);
+  assert.strictEqual(p.amount, 1500);
+});
