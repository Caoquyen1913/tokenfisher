diff --git a/test/reference-summarize.js b/test/reference-summarize.js
new file mode 100644
index 0000000..274c5b9
--- /dev/null
+++ b/test/reference-summarize.js
@@ -0,0 +1,41 @@
+// Frozen copy of the original (quadratic) summarize(), used as the oracle in report.test.js.
+// Do not optimize: its output is the contract the dashboard and finance exports rely on.
+// Top-customers report for the finance dashboard.
+// orders: [{ id, customerId, status, amountCents, currency: 'USD' | 'EUR', createdAt: ISO-8601 string }]
+const EUR_TO_USD = 1.08;
+
+function byRank(a, b) {
+  if (a.spendCents !== b.spendCents) return b.spendCents - a.spendCents;
+  if (a.firstOrderAt !== b.firstOrderAt) return a.firstOrderAt < b.firstOrderAt ? -1 : 1;
+  return a.customerId < b.customerId ? -1 : a.customerId > b.customerId ? 1 : 0;
+}
+
+function summarize(orders, limit = 10) {
+  const seen = [];
+  const groups = [];
+  for (const order of orders) {
+    // Upstream retries can deliver the same order twice.
+    if (seen.includes(order.id)) continue;
+    seen.push(order.id);
+    if (order.status === 'refunded') continue;
+
+    let group = groups.find((g) => g.customerId === order.customerId);
+    if (!group) {
+      group = { customerId: order.customerId, spendCents: 0, orderCount: 0, firstOrderAt: order.createdAt };
+      groups.push(group);
+    }
+    group.orderCount++;
+    if (order.createdAt < group.firstOrderAt) group.firstOrderAt = order.createdAt;
+    if (order.status === 'paid') {
+      group.spendCents += order.currency === 'EUR' ? Math.round(order.amountCents * EUR_TO_USD) : order.amountCents;
+    }
+    // Keep the leaderboard sorted as we go.
+    groups.sort(byRank);
+  }
+  return groups
+    .filter((g) => g.spendCents > 0)
+    .slice(0, limit)
+    .map((g, i) => ({ rank: i + 1, ...g }));
+}
+
+module.exports = { summarize };
diff --git a/test/report.test.js b/test/report.test.js
index 9353f4d..8f5ae9d 100644
--- a/test/report.test.js
+++ b/test/report.test.js
@@ -17,3 +17,74 @@ test('respects the limit', () => {
   assert.strictEqual(summarize(orders).length, 10);
   assert.strictEqual(summarize(orders, 3).length, 3);
 });
+
+const { summarize: reference } = require('./reference-summarize');
+
+// Small deterministic PRNG so failures are reproducible.
+function rng(seed) {
+  return () => {
+    seed = (seed * 1664525 + 1013904223) >>> 0;
+    return seed / 2 ** 32;
+  };
+}
+
+function randomOrders(rand, n, customers) {
+  const statuses = ['paid', 'paid', 'paid', 'pending', 'refunded', 'failed'];
+  const orders = [];
+  for (let i = 0; i < n; i++) {
+    // Re-deliver an earlier order (sometimes with different fields) to exercise de-duplication.
+    if (orders.length && rand() < 0.1) {
+      const prev = orders[Math.floor(rand() * orders.length)];
+      orders.push(rand() < 0.5 ? prev : { ...prev, status: 'paid', amountCents: 999 });
+      continue;
+    }
+    orders.push(order(
+      `o${i}`,
+      `cus_${Math.floor(rand() * customers)}`,
+      statuses[Math.floor(rand() * statuses.length)],
+      // Few distinct amounts and timestamps so spend and first-order ties are common.
+      [100, 250, 500, 1000][Math.floor(rand() * 4)],
+      `2026-10-01T${String(10 + Math.floor(rand() * 3)).padStart(2, '0')}:00:00Z`,
+      rand() < 0.3 ? 'EUR' : 'USD',
+    ));
+  }
+  return orders;
+}
+
+test('matches the original implementation exactly on randomized orders', () => {
+  const rand = rng(42);
+  for (let round = 0; round < 300; round++) {
+    const orders = randomOrders(rand, 1 + Math.floor(rand() * 200), 1 + Math.floor(rand() * 40));
+    for (const limit of [undefined, 0, 1, 5, 10, 1000]) {
+      assert.deepStrictEqual(summarize(orders, limit), reference(orders, limit), `round ${round}, limit ${limit}`);
+    }
+  }
+});
+
+test('matches the original implementation on edge cases', () => {
+  const cases = [
+    [],
+    // Duplicate id: the second delivery is ignored even if the first was refunded.
+    [order('o1', 'cus_a', 'refunded', 500, '2026-10-01T10:00:00Z'), order('o1', 'cus_a', 'paid', 500, '2026-10-01T10:00:00Z')],
+    // Pending/failed orders count toward orderCount and firstOrderAt but not spend.
+    [order('o1', 'cus_a', 'pending', 500, '2026-10-01T09:00:00Z'), order('o2', 'cus_a', 'paid', 500, '2026-10-01T10:00:00Z'), order('o3', 'cus_b', 'paid', 500, '2026-10-01T09:30:00Z')],
+    // Full tie on spend and first order: broken by customerId.
+    [order('o1', 'cus_b', 'paid', 500, '2026-10-01T10:00:00Z'), order('o2', 'cus_a', 'paid', 500, '2026-10-01T10:00:00Z')],
+    // EUR rounding.
+    [order('o1', 'cus_a', 'paid', 333, '2026-10-01T10:00:00Z', 'EUR'), order('o2', 'cus_b', 'paid', 360, '2026-10-01T10:00:00Z')],
+    // Malformed input takes the exact fallback path.
+    [order('o1', 1, 'paid', 500, '2026-10-01T10:00:00Z'), order('o2', '1', 'paid', 500, '2026-10-01T10:00:00Z')],
+    [order('o1', 'cus_a', 'paid', NaN, '2026-10-01T10:00:00Z'), order('o2', 'cus_b', 'paid', Infinity, '2026-10-01T10:00:00Z'), order('o3', 'cus_c', 'paid', Infinity, '2026-10-01T10:00:00Z')],
+  ];
+  for (const [i, orders] of cases.entries()) {
+    assert.deepStrictEqual(summarize(orders), reference(orders), `case ${i}`);
+  }
+});
+
+test('summarizes 200,000 orders in well under a second', () => {
+  const orders = randomOrders(rng(7), 200000, 50000);
+  const start = process.hrtime.bigint();
+  summarize(orders);
+  const ms = Number(process.hrtime.bigint() - start) / 1e6;
+  assert.ok(ms < 1000, `took ${ms.toFixed(0)} ms`);
+});
