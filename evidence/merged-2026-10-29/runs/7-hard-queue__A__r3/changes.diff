diff --git a/test/queue.test.js b/test/queue.test.js
index be49570..6c64f20 100644
--- a/test/queue.test.js
+++ b/test/queue.test.js
@@ -15,3 +15,86 @@ test('starts jobs in order with concurrency 1', async () => {
   await Promise.all(['a', 'b', 'c'].map((x) => q.add(async () => { order.push(x); await sleep(1); })));
   assert.deepStrictEqual(order, ['a', 'b', 'c']);
 });
+
+test('a failing job rejects only its own promise and the queue keeps going', async () => {
+  const q = createQueue({ concurrency: 1 });
+  const failing = q.add(async () => { throw new Error('boom'); });
+  const after = q.add(async () => 'ok');
+  await assert.rejects(failing, /boom/);
+  assert.strictEqual(await after, 'ok');
+  await q.onIdle();
+  assert.strictEqual(q.running, 0);
+  assert.strictEqual(q.pending, 0);
+});
+
+test('handles synchronous throws and plain return values', async () => {
+  const q = createQueue({ concurrency: 1 });
+  const thrown = q.add(() => { throw new Error('sync'); });
+  const plain = q.add(() => 42);
+  await assert.rejects(thrown, /sync/);
+  assert.strictEqual(await plain, 42);
+  await q.onIdle();
+});
+
+test('onIdle waits for running jobs, not just pending ones', async () => {
+  const q = createQueue({ concurrency: 2 });
+  let done = 0;
+  q.add(async () => { await sleep(20); done++; });
+  q.add(async () => { await sleep(20); done++; });
+  await q.onIdle();
+  assert.strictEqual(done, 2);
+  assert.strictEqual(q.running, 0);
+});
+
+test('onIdle resolves immediately when already idle', async () => {
+  const q = createQueue();
+  await q.onIdle();
+});
+
+test('onIdle resolves after the last job fails', async () => {
+  const q = createQueue({ concurrency: 2 });
+  q.add(async () => { await sleep(5); throw new Error('x'); }).catch(() => {});
+  await q.onIdle();
+  assert.strictEqual(q.running, 0);
+});
+
+test('respects the concurrency limit', async () => {
+  const q = createQueue({ concurrency: 3 });
+  let active = 0;
+  let peak = 0;
+  const job = async () => { active++; peak = Math.max(peak, active); await sleep(5); active--; };
+  await Promise.all(Array.from({ length: 10 }, () => q.add(job)));
+  assert.strictEqual(peak, 3);
+});
+
+test('resume() fills all free slots', async () => {
+  const q = createQueue({ concurrency: 4 });
+  q.pause();
+  let active = 0;
+  let peak = 0;
+  const job = async () => { active++; peak = Math.max(peak, active); await sleep(10); active--; };
+  const all = Promise.all(Array.from({ length: 8 }, () => q.add(job)));
+  assert.strictEqual(q.running, 0);
+  assert.strictEqual(q.pending, 8);
+  q.resume();
+  assert.strictEqual(q.running, 4);
+  await all;
+  assert.strictEqual(peak, 4);
+});
+
+test('pause() lets running jobs finish but starts no new ones', async () => {
+  const q = createQueue({ concurrency: 2 });
+  const started = [];
+  const job = (n) => async () => { started.push(n); await sleep(10); };
+  const p1 = q.add(job(1));
+  const p2 = q.add(job(2));
+  q.add(job(3));
+  q.pause();
+  await Promise.all([p1, p2]);
+  await sleep(10);
+  assert.deepStrictEqual(started, [1, 2]);
+  assert.strictEqual(q.pending, 1);
+  q.resume();
+  await q.onIdle();
+  assert.deepStrictEqual(started, [1, 2, 3]);
+});
