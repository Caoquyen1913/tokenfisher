diff --git a/test/equivalence.test.js b/test/equivalence.test.js
new file mode 100644
index 0000000..b7bee63
--- /dev/null
+++ b/test/equivalence.test.js
@@ -0,0 +1,70 @@
+const assert = require('assert');
+const { summarize } = require('../src/report');
+const { summarize: reference } = require('./fixtures/report.reference');
+
+// Deterministic PRNG so failures are reproducible.
+function rng(seed) {
+  let s = seed >>> 0;
+  return () => {
+    s = (s + 0x6d2b79f5) >>> 0;
+    let t = s;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+// Small id/amount/timestamp pools force collisions: duplicate ids, spend ties,
+// firstOrderAt ties, refunds of first deliveries, zero/negative spend, EUR rounding.
+function randomOrders(rand, n, customers) {
+  const pick = (arr) => arr[Math.floor(rand() * arr.length)];
+  const statuses = ['paid', 'paid', 'paid', 'refunded', 'pending', 'failed'];
+  const amounts = [0, 100, 250, 500, 999, 1000, 1234, -100];
+  const times = ['2026-10-01T09:00:00Z', '2026-10-01T10:00:00Z', '2026-10-01T10:00:00Z', '2026-10-01T23:59:59Z', '2026-09-30T12:00:00Z'];
+  return Array.from({ length: n }, () => ({
+    id: `o${Math.floor(rand() * n * 0.8)}`,
+    customerId: `cus_${Math.floor(rand() * customers)}`,
+    status: pick(statuses),
+    amountCents: pick(amounts),
+    currency: rand() < 0.3 ? 'EUR' : 'USD',
+    createdAt: pick(times),
+  }));
+}
+
+test('matches the original implementation exactly on randomized orders', () => {
+  const rand = rng(42);
+  for (let round = 0; round < 300; round++) {
+    const orders = randomOrders(rand, 1 + Math.floor(rand() * 200), 1 + Math.floor(rand() * 40));
+    const limit = [undefined, 0, 1, 3, 10, 50][round % 6];
+    assert.deepStrictEqual(summarize(orders, limit), reference(orders, limit), `round ${round}`);
+  }
+});
+
+test('matches the original on malformed data (non-string ids, NaN amounts)', () => {
+  const orders = [
+    { id: 1, customerId: 7, status: 'paid', amountCents: 300, currency: 'USD', createdAt: '2026-10-01T10:00:00Z' },
+    { id: 2, customerId: NaN, status: 'paid', amountCents: 300, currency: 'USD', createdAt: '2026-10-01T10:00:00Z' },
+    { id: 3, customerId: NaN, status: 'paid', amountCents: 400, currency: 'USD', createdAt: '2026-10-01T09:00:00Z' },
+    { id: 4, customerId: 'cus_a', status: 'paid', amountCents: undefined, currency: 'USD', createdAt: '2026-10-01T10:00:00Z' },
+    { id: 5, customerId: 'cus_b', status: 'paid', amountCents: 200, currency: 'EUR', createdAt: '2026-10-01T10:00:00Z' },
+    { id: 1, customerId: 'cus_b', status: 'paid', amountCents: 999, currency: 'USD', createdAt: '2026-10-01T10:00:00Z' },
+  ];
+  assert.deepStrictEqual(summarize(orders), reference(orders));
+});
+
+test('summarizes 200,000 orders in well under a second', () => {
+  const rand = rng(7);
+  const orders = Array.from({ length: 200000 }, (_, i) => ({
+    id: `o${i % 190000}`, // ~5% retried deliveries
+    customerId: `cus_${Math.floor(rand() * 50000)}`,
+    status: rand() < 0.1 ? 'refunded' : 'paid',
+    amountCents: Math.floor(rand() * 100000),
+    currency: rand() < 0.3 ? 'EUR' : 'USD',
+    createdAt: new Date(Date.UTC(2026, 9, 1) + Math.floor(rand() * 86400000)).toISOString(),
+  }));
+  const start = process.hrtime.bigint();
+  const report = summarize(orders);
+  const ms = Number(process.hrtime.bigint() - start) / 1e6;
+  assert.strictEqual(report.length, 10);
+  assert.ok(ms < 1000, `took ${ms.toFixed(0)} ms`);
+});
diff --git a/test/fixtures/report.reference.js b/test/fixtures/report.reference.js
new file mode 100644
index 0000000..9eef9de
--- /dev/null
+++ b/test/fixtures/report.reference.js
@@ -0,0 +1,39 @@
+// Frozen copy of the original summarize() (commit 029fbb0), used as the reference
+// implementation in test/equivalence.test.js. Do not modify.
+const EUR_TO_USD = 1.08;
+
+function byRank(a, b) {
+  if (a.spendCents !== b.spendCents) return b.spendCents - a.spendCents;
+  if (a.firstOrderAt !== b.firstOrderAt) return a.firstOrderAt < b.firstOrderAt ? -1 : 1;
+  return a.customerId < b.customerId ? -1 : a.customerId > b.customerId ? 1 : 0;
+}
+
+function summarize(orders, limit = 10) {
+  const seen = [];
+  const groups = [];
+  for (const order of orders) {
+    // Upstream retries can deliver the same order twice.
+    if (seen.includes(order.id)) continue;
+    seen.push(order.id);
+    if (order.status === 'refunded') continue;
+
+    let group = groups.find((g) => g.customerId === order.customerId);
+    if (!group) {
+      group = { customerId: order.customerId, spendCents: 0, orderCount: 0, firstOrderAt: order.createdAt };
+      groups.push(group);
+    }
+    group.orderCount++;
+    if (order.createdAt < group.firstOrderAt) group.firstOrderAt = order.createdAt;
+    if (order.status === 'paid') {
+      group.spendCents += order.currency === 'EUR' ? Math.round(order.amountCents * EUR_TO_USD) : order.amountCents;
+    }
+    // Keep the leaderboard sorted as we go.
+    groups.sort(byRank);
+  }
+  return groups
+    .filter((g) => g.spendCents > 0)
+    .slice(0, limit)
+    .map((g, i) => ({ rank: i + 1, ...g }));
+}
+
+module.exports = { summarize };
