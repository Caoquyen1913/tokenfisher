     if (!Number.isInteger(qty) || qty <= 0) throw new Error('INVALID_QTY');
   }
 
+  // id -> { sku, qty, expiresAt }. Expired entries are kept so confirm() can tell
+  // "expired" from "unknown"; they simply stop counting against availability.
+  const reservations = new Map();
+  let nextId = 1;
+
+  function isExpired(r) {
+    return clock() >= r.expiresAt;
+  }
+
+  function getAvailable(sku) {
+    let reserved = 0;
+    for (const r of reservations.values()) {
+      if (r.sku === sku && !isExpired(r)) reserved += r.qty;
+    }
+    return (stock.get(sku) || 0) - reserved;
+  }
