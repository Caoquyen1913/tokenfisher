+++ b/src/store.js
@@ -1,25 +1,65 @@
 // In-memory inventory. `clock` is injectable so tests can control time.
 function createStore({ clock = Date.now } = {}) {
   const stock = new Map();
+  // id -> { sku, qty, expiresAt }. Expired entries stay until confirmed/released
+  // so confirm() can tell "expired" apart from "not found".
+  const reservations = new Map();
+  let nextId = 1;
 
   function assertQty(qty) {
     if (!Number.isInteger(qty) || qty <= 0) throw new Error('INVALID_QTY');
   }
 
+  function isExpired(r) {
+    return clock() >= r.expiresAt;
+  }
+
+  function reserved(sku) {
+    let total = 0;
+    for (const r of reservations.values()) {
+      if (r.sku === sku && !isExpired(r)) total += r.qty;
+    }
+    return total;
+  }
+
+  function getStock(sku) {
+    return stock.get(sku) || 0;
+  }
+
+  function getAvailable(sku) {
+    return getStock(sku) - reserved(sku);
+  }
+
   return {
     clock,
     addItem(sku, qty) {
       assertQty(qty);
-      stock.set(sku, (stock.get(sku) || 0) + qty);
+      stock.set(sku, getStock(sku) + qty);
     },
     removeItem(sku, qty) {
       assertQty(qty);
-      const current = stock.get(sku) || 0;
-      if (qty > current) throw new Error('INSUFFICIENT_STOCK');
-      stock.set(sku, current - qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      stock.set(sku, getStock(sku) - qty);
+    },
+    getStock,
+    getAvailable,
+    reserve(sku, qty, ttlMs) {
+      assertQty(qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      const id = `res-${nextId++}`;
+      reservations.set(id, { sku, qty, expiresAt: clock() + ttlMs });
+      return id;
+    },
+    confirm(id) {
+      const r = reservations.get(id);
+      if (!r) throw new Error('RESERVATION_NOT_FOUND');
+      if (isExpired(r)) throw new Error('RESERVATION_EXPIRED');
+      reservations.delete(id);
+      stock.set(r.sku, getStock(r.sku) - r.qty);
+      return { sku: r.sku, stock: getStock(r.sku) };
     },
-    getStock(sku) {
-      return stock.get(sku) || 0;
+    release(id) {
+      reservations.delete(id);
     },
   };
 }
diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..a93db33
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,123 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function setup(stock = 10) {
+  let now = 1000;
+  const s = createStore({ clock: () => now });
+  s.addItem('A', stock);
+  return { s, advance: (ms) => { now += ms; } };
+}
+
+test('reserve returns unique string ids and reduces availability only', () => {
+  const { s } = setup();
+  const a = s.reserve('A', 3, 1000);
+  const b = s.reserve('A', 2, 1000);
+  assert.strictEqual(typeof a, 'string');
+  assert.notStrictEqual(a, b);
+  assert.strictEqual(s.getAvailable('A'), 5);
+  assert.strictEqual(s.getStock('A'), 10);
+});
+test('reserve validates qty', () => {
+  const { s } = setup();
+  for (const q of [0, -1, 1.5, '2', undefined]) assert.throws(() => s.reserve('A', q, 1000), /^Error: INVALID_QTY$/);
+});
+test('reserve rejects more than available', () => {
+  const { s } = setup();
+  s.reserve('A', 8, 1000);
+  assert.throws(() => s.reserve('A', 3, 1000), /^Error: INSUFFICIENT_STOCK$/);
+  assert.throws(() => s.reserve('B', 1, 1000), /^Error: INSUFFICIENT_STOCK$/);
+  s.reserve('A', 2, 1000);
+  assert.strictEqual(s.getAvailable('A'), 0);
+});
+test('reservation expires exactly at creation + ttl', () => {
+  const { s, advance } = setup();
+  s.reserve('A', 4, 100);
+  advance(99);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  advance(1);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  s.reserve('A', 10, 100);
+});
+test('confirm sells reserved stock', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 6);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.throws(() => s.confirm(id), /^Error: RESERVATION_NOT_FOUND$/);
+});
+test('confirm of unknown or released id is not found', () => {
+  const { s } = setup();
+  assert.throws(() => s.confirm('nope'), /^Error: RESERVATION_NOT_FOUND$/);
+  const id = s.reserve('A', 1, 100);
+  s.release(id);
+  assert.throws(() => s.confirm(id), /^Error: RESERVATION_NOT_FOUND$/);
+});
+test('confirm of expired reservation throws and leaves stock', () => {
+  const { s, advance } = setup();
+  const id = s.reserve('A', 4, 100);
+  advance(100);
+  assert.throws(() => s.confirm(id), /^Error: RESERVATION_EXPIRED$/);
+  assert.strictEqual(s.getStock('A'), 10);
+});
+test('release frees stock and is idempotent', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  s.release(id);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  s.release(id);
+  s.release('unknown');
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('removeItem cannot take reserved stock', () => {
+  const { s, advance } = setup();
+  s.reserve('A', 7, 100);
+  assert.throws(() => s.removeItem('A', 4), /^Error: INSUFFICIENT_STOCK$/);
+  s.removeItem('A', 3);
+  assert.strictEqual(s.getStock('A'), 7);
+  advance(100);
+  s.removeItem('A', 7);
+  assert.strictEqual(s.getStock('A'), 0);
+});
+test('reservations are per sku', () => {
+  const { s } = setup();
+  s.addItem('B', 5);
+  s.reserve('A', 10, 100);
+  assert.strictEqual(s.getAvailable('B'), 5);
+});
+
+function apiSetup() {
+  const { s, advance } = setup();
+  return { api: createApi(s), advance };
+}
+
+test('GET /stock includes available', () => {
+  const { api } = apiSetup();
+  api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } });
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }), { status: 200, body: { sku: 'A', stock: 10, available: 7 } });
+});
+test('POST /reservations status codes', () => {
+  const { api } = apiSetup();
+  const ok = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } });
+  assert.strictEqual(ok.status, 201);
+  assert.strictEqual(typeof ok.body.id, 'string');
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 8, ttlMs: 100 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 100 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+});
+test('POST /reservations/:id/confirm status codes', () => {
+  const { api, advance } = apiSetup();
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } }).body;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'A', stock: 7 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+  const { id: id2 } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 1, ttlMs: 100 } }).body;
+  advance(100);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id2}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('DELETE /reservations/:id returns 204 and frees stock', () => {
+  const { api } = apiSetup();
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } }).body;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'GET', path: '/stock/A' }).body.available, 10);
+});
