diff --git a/src/queue.js b/src/queue.js
index 0645d89..4da8b35 100644
--- a/src/queue.js
+++ b/src/queue.js
@@ -15,19 +15,31 @@ function createQueue({ concurrency = 1 } = {}) {
   let idleWaiters = [];
 
   function next() {
-    if (paused || running >= concurrency || pending.length === 0) return;
-    const { fn, resolve, reject } = pending.shift();
+    while (!paused && running < concurrency && pending.length > 0) {
+      start(pending.shift());
+    }
+    checkIdle();
+  }
+
+  function start({ fn, resolve, reject }) {
     running++;
-    fn().then((value) => {
+    let result;
+    try {
+      result = Promise.resolve(fn());
+    } catch (err) {
+      result = Promise.reject(err);
+    }
+    // Free the slot before settling so callers awaiting add() see up-to-date counts.
+    const settle = (settleJob, outcome) => {
       running--;
-      resolve(value);
+      settleJob(outcome);
       next();
-      checkIdle();
-    }, reject);
+    };
+    result.then((value) => settle(resolve, value), (err) => settle(reject, err));
   }
 
   function checkIdle() {
-    if (pending.length === 0) {
+    if (pending.length === 0 && running === 0) {
       idleWaiters.forEach((wake) => wake());
