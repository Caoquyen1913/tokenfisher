diff --git a/test/queue.test.js b/test/queue.test.js
index be49570..4b9db06 100644
--- a/test/queue.test.js
+++ b/test/queue.test.js
@@ -15,3 +15,46 @@ test('starts jobs in order with concurrency 1', async () => {
   await Promise.all(['a', 'b', 'c'].map((x) => q.add(async () => { order.push(x); await sleep(1); })));
   assert.deepStrictEqual(order, ['a', 'b', 'c']);
 });
+
+test('keeps going after a job rejects or throws synchronously', async () => {
+  const q = createQueue();
+  const failures = [
+    q.add(async () => { throw new Error('async'); }).then(() => 'ok', (e) => e.message),
+    q.add(() => { throw new Error('sync'); }).then(() => 'ok', (e) => e.message),
+  ];
+  const last = q.add(() => 'plain');
+  assert.deepStrictEqual(await Promise.all(failures), ['async', 'sync']);
+  assert.strictEqual(await last, 'plain');
+  await q.onIdle();
+  assert.strictEqual(q.running, 0);
+});
+
+test('onIdle waits for running jobs, not just pending ones', async () => {
+  const q = createQueue({ concurrency: 2 });
+  let done = 0;
+  q.add(async () => { await sleep(20); done++; });
+  q.add(async () => { await sleep(20); done++; });
+  assert.strictEqual(q.pending, 0);
+  await q.onIdle();
+  assert.strictEqual(done, 2);
+  assert.strictEqual(q.running, 0);
+});
+
+test('onIdle resolves immediately when idle', async () => {
+  await createQueue().onIdle();
+});
+
+test('resume fills all free slots up to concurrency', async () => {
+  const q = createQueue({ concurrency: 4 });
+  q.pause();
+  let active = 0;
+  let peak = 0;
+  for (let i = 0; i < 8; i++) {
+    q.add(async () => { active++; peak = Math.max(peak, active); await sleep(10); active--; });
+  }
+  assert.strictEqual(q.running, 0);
+  q.resume();
+  assert.strictEqual(q.running, 4);
+  await q.onIdle();
+  assert.strictEqual(peak, 4);
+});
