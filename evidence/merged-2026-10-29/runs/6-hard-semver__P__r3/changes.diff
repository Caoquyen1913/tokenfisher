--- a/src/semver.js
+++ b/src/semver.js
@@ -1,6 +1,205 @@
 // See docs/SPEC.md.
+const NUM = '0|[1-9]\\d*';
+const IDS = '[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*';
+const FULL_RE = new RegExp(`^v?(${NUM})\\.(${NUM})\\.(${NUM})(?:-(${IDS}))?(?:\\+${IDS})?$`);
+const PART = `x|X|\\*|${NUM}`;
+const PARTIAL_RE = new RegExp(
+  `^v?(${PART})(?:\\.(${PART})(?:\\.(${PART})(?:-(${IDS}))?(?:\\+${IDS})?)?)?$`
+);
+
+const isWild = (s) => s === undefined || s === 'x' || s === 'X' || s === '*';
+const inc = (s) => (BigInt(s) + 1n).toString();
+
+// Numbers are kept as digit strings (no leading zeros) so huge values compare exactly.
+function cmpNum(a, b) {
+  if (a.length !== b.length) return a.length < b.length ? -1 : 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function mk(major, minor, patch, pre) {
+  return { major, minor, patch, pre: pre ? pre.split('.') : [] };
+}
+
+function parseVersion(str) {
+  if (typeof str !== 'string') return null;
+  const m = FULL_RE.exec(str.trim());
+  return m ? mk(m[1], m[2], m[3], m[4]) : null;
+}
+
+function cmpPre(a, b) {
+  const n = Math.min(a.length, b.length);
+  for (let i = 0; i < n; i++) {
+    if (a[i] === b[i]) continue;
+    const an = /^\d+$/.test(a[i]);
+    const bn = /^\d+$/.test(b[i]);
+    if (an && bn) return cmpNum(a[i], b[i]);
+    if (an) return -1;
+    if (bn) return 1;
+    return a[i] < b[i] ? -1 : 1;
+  }
+  return a.length === b.length ? 0 : a.length < b.length ? -1 : 1;
+}
+
+function compare(a, b) {
+  return (
+    cmpNum(a.major, b.major) ||
+    cmpNum(a.minor, b.minor) ||
+    cmpNum(a.patch, b.patch) ||
+    (a.pre.length === 0 && b.pre.length === 0 ? 0
+      : a.pre.length === 0 ? 1
+      : b.pre.length === 0 ? -1
+      : cmpPre(a.pre, b.pre))
+  );
+}
+
+// Parses a possibly partial version; null when invalid. Once a position is a
+// wildcard, every later position is too.
+function parsePartial(str) {
+  const m = PARTIAL_RE.exec(str);
+  if (!m) return null;
+  let [, major, minor, patch, pre] = m;
+  if (isWild(major)) minor = patch = undefined;
+  else if (isWild(minor)) patch = undefined;
+  if (isWild(major)) major = undefined;
+  if (isWild(minor)) minor = undefined;
+  if (isWild(patch)) patch = undefined;
+  if (pre !== undefined && patch === undefined) return null;
+  return { major, minor, patch, pre };
+}
+
+const ZERO = mk('0', '0', '0');
+const lt = (v) => ({ op: '<', v });
+const lte = (v) => ({ op: '<=', v });
+const gt = (v) => ({ op: '>', v });
+const gte = (v) => ({ op: '>=', v });
+const eq = (v) => ({ op: '=', v });
+const NEVER = [lt(ZERO)];
+
+// Lower bound with missing positions filled with zeros.
+function floor(p) {
+  return mk(p.major || '0', p.minor || '0', p.patch || '0', p.pre);
+}
+
+// Exclusive upper bound of everything matching the partial (null: unbounded).
+function ceil(p) {
+  if (p.major === undefined) return null;
+  if (p.minor === undefined) return mk(inc(p.major), '0', '0');
+  return mk(p.major, inc(p.minor), '0');
+}
+
+// Both bounds of a partial treated as an x-range (full versions are exact).
+function xrange(p) {
+  if (p.major === undefined) return [];
+  if (p.patch !== undefined) return [eq(floor(p))];
+  return [gte(floor(p)), lt(ceil(p))];
+}
+
+function tilde(p) {
+  if (p.major === undefined) return [];
+  return [gte(floor(p)), lt(ceil(p))];
+}
+
+function caret(p) {
+  if (p.major === undefined) return [];
+  const lo = gte(floor(p));
+  if (p.major !== '0') return [lo, lt(mk(inc(p.major), '0', '0'))];
+  if (p.minor === undefined) return [lo, lt(mk('1', '0', '0'))];
+  if (p.minor !== '0') return [lo, lt(mk('0', inc(p.minor), '0'))];
+  if (p.patch === undefined) return [lo, lt(mk('0', '1', '0'))];
+  return [lo, lt(mk('0', '0', inc(p.patch)))];
+}
+
+function withOperator(op, p) {
+  if (op === '' || op === '=') return xrange(p);
+  if (op === '~') return tilde(p);
+  if (op === '^') return caret(p);
+  const full = p.patch !== undefined;
+  const any = p.major === undefined;
+  switch (op) {
+    case '>':
+      if (any) return NEVER;
+      return [full ? gt(floor(p)) : gte(ceil(p))];
+    case '>=':
+      return any ? [] : [gte(floor(p))];
+    case '<':
+      return any ? NEVER : [lt(floor(p))];
+    case '<=':
+      if (any) return [];
+      return [full ? lte(floor(p)) : lt(ceil(p))];
+  }
+  return null;
+}
+
+function parseHyphen(a, b) {
+  const lo = parsePartial(a);
+  const hi = parsePartial(b);
+  if (!lo || !hi) return null;
+  const out = lo.major === undefined ? [] : [gte(floor(lo))];
+  if (hi.patch !== undefined) out.push(lte(floor(hi)));
+  else if (hi.major !== undefined) out.push(lt(ceil(hi)));
+  return out;
+}
+
+// Returns a comparator array, or null when the set is invalid.
+function parseSet(set) {
+  set = set.trim();
+  if (set === '') return [];
+  const h = /^(\S+)\s+-\s+(\S+)$/.exec(set);
+  if (h) return parseHyphen(h[1], h[2]);
+  const out = [];
+  for (const tok of set.replace(/(<=|>=|<|>|=|~|\^)\s+/g, '$1').split(/\s+/)) {
+    const m = /^(<=|>=|<|>|=|~|\^)?(.*)$/.exec(tok);
+    const p = parsePartial(m[2]);
+    if (!p) return null;
+    const cs = withOperator(m[1] || '', p);
+    if (!cs) return null;
+    out.push(...cs);
+  }
+  return out;
+}
+
+function parseRange(range) {
+  if (typeof range !== 'string') return null;
+  const sets = [];
+  for (const s of range.split('||')) {
+    const set = parseSet(s);
+    if (!set) return null;
+    sets.push(set);
+  }
+  return sets;
+}
+
+function test(c, v) {
+  const d = compare(v, c.v);
+  switch (c.op) {
+    case '<': return d < 0;
+    case '<=': return d <= 0;
+    case '>': return d > 0;
+    case '>=': return d >= 0;
+    default: return d === 0;
+  }
+}
+
+function setMatches(set, v) {
+  if (!set.every((c) => test(c, v))) return false;
+  if (v.pre.length === 0) return true;
+  return set.some(
+    (c) =>
+      c.v.pre.length > 0 &&
+      c.v.major === v.major && c.v.minor === v.minor && c.v.patch === v.patch
+  );
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    const v = parseVersion(version);
+    if (!v) return false;
+    const sets = parseRange(range);
+    if (!sets) return false;
+    return sets.some((s) => setMatches(s, v));
+  } catch (e) {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
