+const assert = require('assert');
+const { satisfies } = require('../src/semver');
+
+const yes = (v, r) => test(`${v} satisfies "${r}"`, () => assert.strictEqual(satisfies(v, r), true));
+const no = (v, r) => test(`${v} does not satisfy "${r}"`, () => assert.strictEqual(satisfies(v, r), false));
+
+// versions
+yes('1.2.3', '1.2.3');
+yes('v1.2.3', '=v1.2.3');
+yes('  1.2.3  ', '1.2.3');
+yes('1.2.3+build.5', '1.2.3');
+yes('1.2.3', '1.2.3+other');
+no('01.2.3', '*');
+no('1.2', '*');
+no('1.2.3-', '*');
+no('1.2.3-a..b', '*');
+no('', '*');
+no(undefined, '*');
+no('1.2.3', 'not a range');
+no('1.2.3', '>=');
+no('1.2.3', null);
+no('1.2.3', '1.2.3 || >>1');
+
+// comparators
+yes('1.2.3', '>= 1.2.3');
+yes('1.2.4', '> 1.2.3');
+no('1.2.3', '>1.2.3');
+yes('1.2.2', '<1.2.3');
+yes('1.2.3', '<=1.2.3');
+no('1.2.4', '<=1.2.3');
+yes('1.5.0', '>=1.2.3 <2.0.0');
+no('2.0.0', '>=1.2.3 <2.0.0');
+yes('3.0.0', '<1.0.0 || >=3.0.0');
+yes('2.0.0', '');
+yes('2.0.0', '1.0.0 || ');
+
+// x-ranges
+yes('9.9.9', '*');
+yes('9.9.9', 'x');
+no('1.0.0-alpha', '*');
+yes('1.9.9', '1');
+yes('1.9.9', '1.x');
+no('2.0.0', '1.x.x');
+yes('1.2.9', '1.2');
+no('1.3.0', '1.2.x');
+yes('1.9.9', '=1');
+yes('2.0.0', '>1');
+no('1.9.9', '>1');
+yes('1.3.0', '>1.2');
+no('1.2.9', '>1.2');
+yes('1.0.0', '>=1');
+no('0.9.9', '>=1');
+yes('0.9.9', '<1');
+no('1.0.0', '<1');
+yes('1.2.9', '<=1.2');
+no('1.3.0', '<=1.2');
+yes('1.9.9', '<=1');
+no('2.0.0', '<=1');
+no('1.0.0', '>*');
+yes('1.0.0', '>=*');
+
+// tilde
+yes('1.2.9', '~1.2.3');
+no('1.3.0', '~1.2.3');
+no('1.2.2', '~1.2.3');
+yes('1.2.0', '~1.2');
+no('1.3.0', '~1.2');
+yes('1.9.0', '~1');
+no('2.0.0', '~1');
+yes('1.2.3-beta.2', '~1.2.3-beta.2');
+yes('1.2.3-beta.4', '~1.2.3-beta.2');
+yes('1.2.5', '~1.2.3-beta.2');
+no('1.2.4-beta.1', '~1.2.3-beta.2');
+
+// caret
+yes('1.9.9', '^1.2.3');
+no('2.0.0', '^1.2.3');
+yes('0.2.9', '^0.2.3');
+no('0.3.0', '^0.2.3');
+yes('0.0.3', '^0.0.3');
+no('0.0.4', '^0.0.3');
+yes('1.9.0', '^1.2');
+yes('1.9.0', '^1');
+yes('0.2.9', '^0.2');
+no('0.3.0', '^0.2');
+yes('0.0.9', '^0.0');
+no('0.1.0', '^0.0');
+yes('0.9.9', '^0');
+yes('0.9.9', '^0.x');
+no('1.0.0', '^0');
+yes('1.2.3-beta.2', '^1.2.3-beta.2');
+yes('1.9.0', '^1.2.3-beta.2');
+no('1.2.4-beta', '^1.2.3');
+no('1.2.3-beta.1', '^1.2.3-beta.2');
+
+// hyphen
+yes('1.2.3', '1.2.3 - 2.3.4');
+yes('2.3.4', '1.2.3 - 2.3.4');
+no('2.3.5', '1.2.3 - 2.3.4');
+yes('1.2.0', '1.2 - 2.3.4');
+no('1.1.9', '1.2 - 2.3.4');
+yes('2.3.9', '1.2.3 - 2.3');
+no('2.4.0', '1.2.3 - 2.3');
+yes('2.9.9', '1.2.3 - 2');
+no('3.0.0', '1.2.3 - 2');
+no('1.2.3', '1.2.3 -2.3.4');
+
+// ordering
+yes('1.0.0', '>1.0.0-rc.1');
+yes('1.0.0-rc.1', '<1.0.0-rc.2');
+yes('1.0.0-alpha.1', '>1.0.0-alpha');
+yes('1.0.0-alpha.beta', '>1.0.0-alpha.1');
+yes('1.0.0-beta.2', '>1.0.0-beta.1');
+yes('1.0.0-beta.11', '>1.0.0-beta.2');
+yes('1.0.0-beta', '>1.0.0-alpha');
+yes('1.0.0-b', '>1.0.0-B');
+yes('1.0.0', '>=1.0.0+build');
+yes('10.0.0', '>9.0.0');
+yes('1.0.0-rc.1', '<=1.0.0-rc.1');
+yes('1.0.0-rc.1', '>=1.0.0-rc.1 <1.0.0');
+no('1.0.0-rc.1', '>=1.0.0');
+yes('99999999999999999999.0.0', '>99999999999999999998.0.0');
+
+// prereleases
+yes('1.2.3-alpha.7', '>1.2.3-alpha.3');
+no('3.4.5-alpha.9', '>1.2.3-alpha.3');
+no('3.4.5-alpha.9', '>1.2.3-alpha.3 || 3.x');
+yes('3.4.5-alpha.9', '>1.2.3-alpha.3 || >=3.4.5-alpha.1');
+yes('1.0.0-alpha', '1.0.0-alpha');
+no('1.0.0-alpha', '<1');
+no('1.0.0-alpha', '1');
+yes('1.2.3-beta', '>=1.2.3-alpha <2.0.0');
+yes('1.2.3', '>=1.2.3-alpha <2.0.0');
