+test('a failing job rejects only itself and the queue keeps going', async () => {
+  const q = createQueue();
+  const bad = q.add(async () => { throw new Error('boom'); });
+  const syncBad = q.add(() => { throw new Error('sync'); });
+  const good = q.add(() => 'ok');
+  await assert.rejects(bad, /boom/);
+  await assert.rejects(syncBad, /sync/);
+  assert.strictEqual(await good, 'ok');
+  await q.onIdle();
+  assert.strictEqual(q.running, 0);
+  assert.strictEqual(q.pending, 0);
+});
+
+test('onIdle waits for running jobs and resolves immediately when idle', async () => {
+  const q = createQueue({ concurrency: 2 });
+  await q.onIdle();
+  let done = 0;
+  q.add(async () => { await sleep(20); done++; });
+  q.add(async () => { await sleep(5); done++; });
+  await sleep(10); // pending is empty, one job still running
+  await q.onIdle();
+  assert.strictEqual(done, 2);
+  assert.strictEqual(q.running, 0);
+});
+
+test('resume starts as many jobs as there are free slots', async () => {
+  const q = createQueue({ concurrency: 4 });
+  q.pause();
+  let active = 0;
+  let peak = 0;
+  const jobs = [];
+  for (let i = 0; i < 8; i++) {
+    jobs.push(q.add(async () => { active++; peak = Math.max(peak, active); await sleep(10); active--; }));
+  }
+  assert.strictEqual(q.running, 0);
+  assert.strictEqual(q.pending, 8);
+  q.resume();
+  assert.strictEqual(q.running, 4);
+  await Promise.all(jobs);
+  assert.strictEqual(peak, 4);
+});
+
