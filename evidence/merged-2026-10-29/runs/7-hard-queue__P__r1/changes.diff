diff --git a/test/queue.test.js b/test/queue.test.js
index be49570..e11f239 100644
--- a/test/queue.test.js
+++ b/test/queue.test.js
@@ -15,3 +15,50 @@ test('starts jobs in order with concurrency 1', async () => {
   await Promise.all(['a', 'b', 'c'].map((x) => q.add(async () => { order.push(x); await sleep(1); })));
   assert.deepStrictEqual(order, ['a', 'b', 'c']);
 });
+
+test('a failing job rejects only its own promise and the queue keeps going', async () => {
+  const q = createQueue();
+  const bad = q.add(async () => { throw new Error('boom'); });
+  const good = q.add(async () => 'ok');
+  await assert.rejects(bad, /boom/);
+  assert.strictEqual(await good, 'ok');
+  await q.onIdle();
+  assert.strictEqual(q.running, 0);
+});
+
+test('synchronous throws and plain values are handled', async () => {
+  const q = createQueue();
+  const bad = q.add(() => { throw new Error('sync'); });
+  const plain = q.add(() => 42);
+  await assert.rejects(bad, /sync/);
+  assert.strictEqual(await plain, 42);
+  await q.onIdle();
+});
+
+test('onIdle waits for running jobs, not just pending ones', async () => {
+  const q = createQueue({ concurrency: 2 });
+  let done = false;
+  q.add(async () => { await sleep(20); done = true; });
+  await q.onIdle();
+  assert.strictEqual(done, true);
+  assert.strictEqual(q.running, 0);
+});
+
+test('onIdle resolves immediately when already idle', async () => {
+  await createQueue().onIdle();
+});
+
+test('resume starts as many jobs as there are free slots', async () => {
+  const q = createQueue({ concurrency: 4 });
+  q.pause();
+  let started = 0;
+  const jobs = [];
+  for (let i = 0; i < 6; i++) jobs.push(q.add(async () => { started++; await sleep(20); }));
+  assert.strictEqual(q.pending, 6);
+  assert.strictEqual(started, 0);
+  q.resume();
+  assert.strictEqual(started, 4);
+  assert.strictEqual(q.running, 4);
+  assert.strictEqual(q.pending, 2);
+  await Promise.all(jobs);
+});
