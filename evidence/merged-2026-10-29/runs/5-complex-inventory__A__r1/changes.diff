 // In-memory inventory. `clock` is injectable so tests can control time.
 function createStore({ clock = Date.now } = {}) {
   const stock = new Map();
+  // id -> { sku, qty, expiresAt }. Expired entries are kept so confirm() can
+  // report RESERVATION_EXPIRED; they are ignored when computing availability.
+  const reservations = new Map();
+  let nextId = 1;
 
   function assertQty(qty) {
     if (!Number.isInteger(qty) || qty <= 0) throw new Error('INVALID_QTY');
   }
 
+  function isExpired(r, now) {
+    return now >= r.expiresAt;
+  }
+
+  function getAvailable(sku) {
+    const now = clock();
+    let reserved = 0;
+    for (const r of reservations.values()) {
+      if (r.sku === sku && !isExpired(r, now)) reserved += r.qty;
+    }
+    return (stock.get(sku) || 0) - reserved;
+  }
+
   return {
     clock,
     addItem(sku, qty) {
@@ -14,13 +31,31 @@ function createStore({ clock = Date.now } = {}) {
     },
     removeItem(sku, qty) {
       assertQty(qty);
-      const current = stock.get(sku) || 0;
-      if (qty > current) throw new Error('INSUFFICIENT_STOCK');
-      stock.set(sku, current - qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      stock.set(sku, (stock.get(sku) || 0) - qty);
     },
     getStock(sku) {
       return stock.get(sku) || 0;
     },
+    getAvailable,
+    reserve(sku, qty, ttlMs) {
+      assertQty(qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      const id = `res-${nextId++}`;
+      reservations.set(id, { sku, qty, expiresAt: clock() + ttlMs });
+      return id;
+    },
+    confirm(id) {
+      const r = reservations.get(id);
+      if (!r) throw new Error('RESERVATION_NOT_FOUND');
+      if (isExpired(r, clock())) throw new Error('RESERVATION_EXPIRED');
+      reservations.delete(id);
+      stock.set(r.sku, (stock.get(r.sku) || 0) - r.qty);
+      return r.sku;
+    },
+    release(id) {
+      reservations.delete(id);
+    },
   };
 }
 
diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..4e24ef7
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,139 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+// Store with a manually advanced clock.
+function setup(initial = { A: 10 }) {
+  let now = 1000;
+  const s = createStore({ clock: () => now });
+  for (const [sku, qty] of Object.entries(initial)) s.addItem(sku, qty);
+  return { s, advance: (ms) => { now += ms; } };
+}
+
+test('reserve returns unique string ids', () => {
+  const { s } = setup();
+  const a = s.reserve('A', 1, 100);
+  const b = s.reserve('A', 1, 100);
+  assert.strictEqual(typeof a, 'string');
+  assert.notStrictEqual(a, b);
+});
+test('reserve validates qty', () => {
+  const { s } = setup();
+  for (const qty of [0, -1, 1.5, '2', undefined]) {
+    assert.throws(() => s.reserve('A', qty, 100), /INVALID_QTY/);
+  }
+});
+test('reserve rejects more than available', () => {
+  const { s } = setup();
+  s.reserve('A', 7, 100);
+  assert.throws(() => s.reserve('A', 4, 100), /INSUFFICIENT_STOCK/);
+  assert.throws(() => s.reserve('B', 1, 100), /INSUFFICIENT_STOCK/);
+  s.reserve('A', 3, 100);
+  assert.strictEqual(s.getAvailable('A'), 0);
+});
+test('reservations reduce available but not physical stock', () => {
+  const { s } = setup();
+  s.reserve('A', 4, 100);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('nope'), 0);
+});
+test('reservation expires exactly at creation + ttl', () => {
+  const { s, advance } = setup();
+  s.reserve('A', 4, 100);
+  advance(99);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  advance(1);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  s.reserve('A', 10, 100); // expired stock can be reserved again
+});
+test('confirm sells reserved stock', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 6);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm rejects unknown and released ids', () => {
+  const { s } = setup();
+  assert.throws(() => s.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const id = s.reserve('A', 1, 100);
+  s.release(id);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm rejects expired reservation and leaves stock alone', () => {
+  const { s, advance } = setup();
+  const id = s.reserve('A', 4, 100);
+  advance(100);
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('release frees stock and is idempotent', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  s.release(id);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  s.release(id);
+  s.release('nope');
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('removeItem cannot remove reserved stock', () => {
+  const { s, advance } = setup();
+  s.reserve('A', 4, 100);
+  assert.throws(() => s.removeItem('A', 7), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 6);
+  assert.strictEqual(s.getStock('A'), 4);
+  advance(100);
+  s.removeItem('A', 4);
+  assert.strictEqual(s.getStock('A'), 0);
+});
+test('time is read only from the clock option', () => {
+  const realNow = Date.now;
+  Date.now = () => { throw new Error('Date.now used'); };
+  try {
+    const { s, advance } = setup();
+    const id = s.reserve('A', 1, 50);
+    advance(10);
+    s.getAvailable('A');
+    s.confirm(id);
+  } finally {
+    Date.now = realNow;
+  }
+});
+
+test('API: GET /stock includes available', () => {
+  const { s } = setup();
+  const api = createApi(s);
+  s.reserve('A', 3, 100);
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }), { status: 200, body: { sku: 'A', stock: 10, available: 7 } });
+});
+test('API: POST /reservations', () => {
+  const { s } = setup();
+  const api = createApi(s);
+  const ok = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } });
+  assert.strictEqual(ok.status, 201);
+  assert.strictEqual(typeof ok.body.id, 'string');
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 8, ttlMs: 100 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 100 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+});
+test('API: confirm reservation', () => {
+  const { s, advance } = setup();
+  const api = createApi(s);
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } }).body;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'A', stock: 7 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+  const late = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 1, ttlMs: 100 } }).body.id;
+  advance(100);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${late}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('API: DELETE /reservations/:id', () => {
+  const { s } = setup();
+  const api = createApi(s);
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } }).body;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: '/reservations/nope' }).status, 204);
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
