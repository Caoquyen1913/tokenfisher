diff --git a/test/charge.test.js b/test/charge.test.js
index 321f791..798dac1 100644
--- a/test/charge.test.js
+++ b/test/charge.test.js
@@ -14,3 +14,22 @@ test('EUR invoice is charged in cents', () => {
   assert.strictEqual(p.amount, 9999);
   assert.strictEqual(p.idempotency_key, 'inv_i2');
 });
+
+// Regression: the payload lower-cases the currency for the gateway; converting with
+// that code missed the registry and used 2 decimals, charging 100x for JPY/KRW.
+test('JPY invoice is charged in whole yen', () => {
+  const p = buildChargePayload({ id: 'i3', number: 'INV-3', currency: 'JPY', total: 1500 }, customer);
+  assert.strictEqual(p.amount, 1500);
+  assert.strictEqual(p.currency, 'jpy');
+});
+
+test('KRW invoice is charged in whole won', () => {
+  const p = buildChargePayload({ id: 'i4', number: 'INV-4', currency: 'KRW', total: 25000 }, customer);
+  assert.strictEqual(p.amount, 25000);
+  assert.strictEqual(p.currency, 'krw');
+});
+
+test('BHD invoice is charged in fils (3 decimals)', () => {
+  const p = buildChargePayload({ id: 'i5', number: 'INV-5', currency: 'BHD', total: 1.234 }, customer);
+  assert.strictEqual(p.amount, 1234);
+});
