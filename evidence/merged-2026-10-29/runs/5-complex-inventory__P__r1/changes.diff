+++ b/src/store.js
@@ -1,11 +1,26 @@
 // In-memory inventory. `clock` is injectable so tests can control time.
 function createStore({ clock = Date.now } = {}) {
   const stock = new Map();
+  const reservations = new Map(); // id -> { sku, qty, expiresAt }
+  let nextId = 1;
 
   function assertQty(qty) {
     if (!Number.isInteger(qty) || qty <= 0) throw new Error('INVALID_QTY');
   }
 
+  function reservedQty(sku) {
+    const now = clock();
+    let total = 0;
+    for (const r of reservations.values()) {
+      if (r.sku === sku && now < r.expiresAt) total += r.qty;
+    }
+    return total;
+  }
+
+  function getAvailable(sku) {
+    return (stock.get(sku) || 0) - reservedQty(sku);
+  }
+
   return {
     clock,
     addItem(sku, qty) {
@@ -14,13 +29,31 @@ function createStore({ clock = Date.now } = {}) {
     },
     removeItem(sku, qty) {
       assertQty(qty);
-      const current = stock.get(sku) || 0;
-      if (qty > current) throw new Error('INSUFFICIENT_STOCK');
-      stock.set(sku, current - qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      stock.set(sku, (stock.get(sku) || 0) - qty);
     },
     getStock(sku) {
       return stock.get(sku) || 0;
     },
+    getAvailable,
+    reserve(sku, qty, ttlMs) {
+      assertQty(qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      const id = `res-${nextId++}`;
+      reservations.set(id, { sku, qty, expiresAt: clock() + ttlMs });
+      return id;
+    },
+    confirm(id) {
+      const r = reservations.get(id);
+      if (!r) throw new Error('RESERVATION_NOT_FOUND');
+      if (clock() >= r.expiresAt) throw new Error('RESERVATION_EXPIRED');
+      reservations.delete(id);
+      stock.set(r.sku, (stock.get(r.sku) || 0) - r.qty);
+      return { sku: r.sku, stock: stock.get(r.sku) };
+    },
+    release(id) {
+      reservations.delete(id);
+    },
   };
 }
 
diff --git a/test/api.test.js b/test/api.test.js
index 3ef8a0b..09e6e7d 100644
--- a/test/api.test.js
+++ b/test/api.test.js
@@ -17,3 +17,38 @@ test('POST /stock rejects bad qty', () => {
   assert.deepStrictEqual(api({ method: 'POST', path: '/stock', body: { sku: 'x', qty: -1 } }), { status: 400, body: { error: 'INVALID_QTY' } });
 });
 test('unknown route is 404', () => assert.strictEqual(createApi(createStore())({ method: 'GET', path: '/nope' }).status, 404));
+
+function reservingApi() {
+  const t = { now: 0 };
+  const api = createApi(createStore({ clock: () => t.now }));
+  api({ method: 'POST', path: '/stock', body: { sku: 'A', qty: 5 } });
+  return { api, t };
+}
+
+test('GET /stock includes available', () => {
+  const { api } = reservingApi();
+  const { body } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 100 } });
+  assert.ok(body.id);
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }).body, { sku: 'A', stock: 5, available: 3 });
+});
+test('POST /reservations errors', () => {
+  const { api } = reservingApi();
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 9, ttlMs: 100 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 100 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+});
+test('confirm reservation via API', () => {
+  const { api, t } = reservingApi();
+  const id = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 100 } }).body.id;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'A', stock: 3 } });
+  assert.strictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }).status, 404);
+  const id2 = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 1, ttlMs: 100 } }).body.id;
+  t.now = 100;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id2}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('DELETE /reservations/:id releases and is idempotent', () => {
+  const { api } = reservingApi();
+  const id = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 5, ttlMs: 100 } }).body.id;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'GET', path: '/stock/A' }).body.available, 5);
+});
diff --git a/test/store.test.js b/test/store.test.js
index 8b80ad0..55bafe6 100644
--- a/test/store.test.js
+++ b/test/store.test.js
@@ -27,3 +27,82 @@ test('quantities must be positive integers', () => {
   assert.throws(() => s.addItem('A', 0), /INVALID_QTY/);
   assert.throws(() => s.addItem('A', 1.5), /INVALID_QTY/);
 });
+
+function clocked(start = 1000) {
+  const t = { now: start };
+  const s = createStore({ clock: () => t.now });
+  return { s, t };
+}
+
+test('reserve reduces available but not physical stock', () => {
+  const { s } = clocked();
+  s.addItem('A', 10);
+  const id = s.reserve('A', 4, 100);
+  assert.strictEqual(typeof id, 'string');
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('A'), 6);
+});
+test('reserve ids are unique', () => {
+  const { s } = clocked();
+  s.addItem('A', 10);
+  assert.notStrictEqual(s.reserve('A', 1, 100), s.reserve('A', 1, 100));
+});
+test('reserve validates qty and availability', () => {
+  const { s } = clocked();
+  s.addItem('A', 5);
+  assert.throws(() => s.reserve('A', 0, 100), /INVALID_QTY/);
+  assert.throws(() => s.reserve('A', 1.5, 100), /INVALID_QTY/);
+  assert.throws(() => s.reserve('A', 6, 100), /INSUFFICIENT_STOCK/);
+  s.reserve('A', 3, 100);
+  assert.throws(() => s.reserve('A', 3, 100), /INSUFFICIENT_STOCK/);
+});
+test('reservation expires exactly at creation + ttl', () => {
+  const { s, t } = clocked();
+  s.addItem('A', 5);
+  s.reserve('A', 5, 100);
+  t.now = 1099;
+  assert.strictEqual(s.getAvailable('A'), 0);
+  t.now = 1100;
+  assert.strictEqual(s.getAvailable('A'), 5);
+});
+test('confirm converts reservation to a sale', () => {
+  const { s } = clocked();
+  s.addItem('A', 5);
+  const id = s.reserve('A', 2, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 3);
+  assert.strictEqual(s.getAvailable('A'), 3);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm errors for unknown, released and expired ids', () => {
+  const { s, t } = clocked();
+  s.addItem('A', 5);
+  assert.throws(() => s.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const r = s.reserve('A', 1, 100);
+  s.release(r);
+  assert.throws(() => s.confirm(r), /RESERVATION_NOT_FOUND/);
+  const e = s.reserve('A', 1, 100);
+  t.now += 100;
+  assert.throws(() => s.confirm(e), /RESERVATION_EXPIRED/);
+  assert.strictEqual(s.getStock('A'), 5);
+});
+test('release frees stock and is idempotent', () => {
+  const { s } = clocked();
+  s.addItem('A', 5);
+  const id = s.reserve('A', 5, 100);
+  s.release(id);
+  s.release(id);
+  s.release('unknown');
+  assert.strictEqual(s.getAvailable('A'), 5);
+});
+test('removeItem cannot remove reserved stock', () => {
+  const { s, t } = clocked();
+  s.addItem('A', 5);
+  s.reserve('A', 3, 100);
+  assert.throws(() => s.removeItem('A', 3), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 2);
+  assert.strictEqual(s.getStock('A'), 3);
+  t.now += 100;
+  s.removeItem('A', 3);
+  assert.strictEqual(s.getStock('A'), 0);
+});
