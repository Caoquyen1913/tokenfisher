diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..c0aef43
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,104 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function setup(qty = 10) {
+  const time = { now: 1000 };
+  const s = createStore({ clock: () => time.now });
+  s.addItem('A', qty);
+  return { s, time };
+}
+
+test('reserve reduces available but not stock', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  assert.strictEqual(typeof id, 'string');
+  assert.notStrictEqual(id, s.reserve('A', 1, 100));
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('A'), 5);
+});
+test('reserve validates qty and availability', () => {
+  const { s } = setup(3);
+  for (const q of [0, -1, 1.5, '2', undefined]) assert.throws(() => s.reserve('A', q, 10), /INVALID_QTY/);
+  assert.throws(() => s.reserve('A', 4, 10), /INSUFFICIENT_STOCK/);
+  assert.throws(() => s.reserve('nope', 1, 10), /INSUFFICIENT_STOCK/);
+});
+test('reservation expires at exactly creation + ttl', () => {
+  const { s, time } = setup();
+  s.reserve('A', 4, 100);
+  time.now = 1099;
+  assert.strictEqual(s.getAvailable('A'), 6);
+  time.now = 1100;
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('confirm converts reservation to sale', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 6);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm errors', () => {
+  const { s, time } = setup();
+  assert.throws(() => s.confirm('zzz'), /RESERVATION_NOT_FOUND/);
+  const r = s.reserve('A', 1, 10);
+  s.release(r);
+  assert.throws(() => s.confirm(r), /RESERVATION_NOT_FOUND/);
+  const e = s.reserve('A', 1, 10);
+  time.now += 10;
+  assert.throws(() => s.confirm(e), /RESERVATION_EXPIRED/);
+  assert.strictEqual(s.getStock('A'), 10);
+});
+test('release frees stock and is idempotent', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  s.release(id);
+  s.release(id);
+  s.release('unknown');
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('removeItem cannot remove reserved stock', () => {
+  const { s, time } = setup();
+  s.reserve('A', 4, 100);
+  assert.throws(() => s.removeItem('A', 7), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 6);
+  assert.strictEqual(s.getStock('A'), 4);
+  time.now += 100;
+  s.removeItem('A', 4);
+  assert.strictEqual(s.getStock('A'), 0);
+});
+
+function api(qty = 10) {
+  const { s, time } = setup(qty);
+  return { h: createApi(s), time };
+}
+test('API: GET /stock includes available', () => {
+  const { h } = api();
+  h({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 50 } });
+  assert.deepStrictEqual(h({ method: 'GET', path: '/stock/A' }).body, { sku: 'A', stock: 10, available: 7 });
+});
+test('API: POST /reservations statuses', () => {
+  const { h } = api(2);
+  const ok = h({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 1, ttlMs: 50 } });
+  assert.strictEqual(ok.status, 201);
+  assert.strictEqual(typeof ok.body.id, 'string');
+  assert.deepStrictEqual(h({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 5, ttlMs: 50 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(h({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 50 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+});
+test('API: confirm statuses', () => {
+  const { h, time } = api();
+  const id = h({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 50 } }).body.id;
+  assert.deepStrictEqual(h({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'A', stock: 7 } });
+  assert.deepStrictEqual(h({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+  const e = h({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 1, ttlMs: 5 } }).body.id;
+  time.now += 5;
+  assert.deepStrictEqual(h({ method: 'POST', path: `/reservations/${e}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('API: DELETE /reservations/:id returns 204', () => {
+  const { h } = api();
+  const id = h({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 50 } }).body.id;
+  assert.strictEqual(h({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(h({ method: 'DELETE', path: '/reservations/unknown' }).status, 204);
+  assert.strictEqual(h({ method: 'GET', path: '/stock/A' }).body.available, 10);
+});
