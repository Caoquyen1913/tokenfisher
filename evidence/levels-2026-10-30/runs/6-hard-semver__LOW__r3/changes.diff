 // See docs/SPEC.md.
+// Numeric parts are BigInts so arbitrarily large versions compare exactly.
+
+const NUM = '0|[1-9]\\d*';
+const IDENT = '[0-9A-Za-z-]+';
+const IDENTS = `${IDENT}(?:\\.${IDENT})*`;
+const VERSION_RE = new RegExp(`^v?(${NUM})\\.(${NUM})\\.(${NUM})(?:-(${IDENTS}))?(?:\\+${IDENTS})?$`);
+const XPART = `${NUM}|[xX*]`;
+const PARTIAL_RE = new RegExp(
+  `^v?(${XPART})(?:\\.(${XPART})(?:\\.(${XPART})(?:-(${IDENTS}))?(?:\\+${IDENTS})?)?)?$`
+);
+
+function parseVersion(str) {
+  const m = VERSION_RE.exec(str);
+  if (!m) return null;
+  return { major: BigInt(m[1]), minor: BigInt(m[2]), patch: BigInt(m[3]), pre: m[4] ? m[4].split('.') : [] };
+}
+
+function make(major, minor, patch, pre = []) {
+  return { major, minor, patch, pre };
+}
+
+function cmpBig(a, b) {
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function compareIdent(a, b) {
+  const an = /^\d+$/.test(a);
+  const bn = /^\d+$/.test(b);
+  if (an && bn) return cmpBig(BigInt(a), BigInt(b));
+  if (an) return -1;
+  if (bn) return 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function compare(a, b) {
+  const main = cmpBig(a.major, b.major) || cmpBig(a.minor, b.minor) || cmpBig(a.patch, b.patch);
+  if (main) return main;
+  // No prerelease ranks above any prerelease.
+  if (!a.pre.length || !b.pre.length) return Math.sign(b.pre.length) - Math.sign(a.pre.length);
+  for (let i = 0; i < Math.min(a.pre.length, b.pre.length); i++) {
+    const c = compareIdent(a.pre[i], b.pre[i]);
+    if (c) return c;
+  }
+  return Math.sign(a.pre.length - b.pre.length);
+}
+
+// Parses a possibly partial version. Positions after the first wildcard are
+// treated as wildcards too. Returns null when invalid.
+function parsePartial(str) {
+  const m = PARTIAL_RE.exec(str);
+  if (!m) return null;
+  const parts = [m[1], m[2], m[3]];
+  const nums = [];
+  for (const p of parts) {
+    if (p === undefined || /^[xX*]$/.test(p)) break;
+    nums.push(BigInt(p));
+  }
+  if (m[4] && nums.length < 3) return null; // prerelease needs a full version
+  return { nums, pre: m[4] ? m[4].split('.') : [] };
+}
+
+const ANY = [];
+const NONE = [{ op: '<', ver: make(0n, 0n, 0n) }];
+
+// Lower bound of a partial version, filled with zeros.
+function lower(p) {
+  const [M = 0n, m = 0n, pa = 0n] = p.nums;
+  return make(M, m, pa, p.pre);
+}
+
+// The first version past everything matched by a partial version (nums.length 1 or 2).
+function nextUp(p) {
+  const [M, m] = p.nums;
+  return p.nums.length === 1 ? make(M + 1n, 0n, 0n) : make(M, m + 1n, 0n);
+}
+
+// Turns one token (operator + partial version) into plain comparators.
+function desugar(op, p) {
+  const n = p.nums.length;
+  if (op === '~') {
+    if (n === 0) return ANY;
+    const upper = n === 1 ? make(p.nums[0] + 1n, 0n, 0n) : make(p.nums[0], p.nums[1] + 1n, 0n);
+    return [{ op: '>=', ver: lower(p) }, { op: '<', ver: upper }];
+  }
+  if (op === '^') {
+    if (n === 0) return ANY;
+    const [M, m, pa] = p.nums;
+    let upper;
+    if (M > 0n || n === 1) upper = make(M + 1n, 0n, 0n);
+    else if (m > 0n || n === 2) upper = make(0n, m + 1n, 0n);
+    else upper = make(0n, 0n, pa + 1n);
+    return [{ op: '>=', ver: lower(p) }, { op: '<', ver: upper }];
+  }
+  if (n === 3) return [{ op, ver: lower(p) }];
+  if (n === 0) return op === '<' || op === '>' ? NONE : ANY;
+  switch (op) {
+    case '=': return [{ op: '>=', ver: lower(p) }, { op: '<', ver: nextUp(p) }];
+    case '>': return [{ op: '>=', ver: nextUp(p) }];
+    case '>=': return [{ op: '>=', ver: lower(p) }];
+    case '<': return [{ op: '<', ver: lower(p) }];
+    case '<=': return [{ op: '<', ver: nextUp(p) }];
+  }
+  return null;
+}
+
+// Parses one comparator set into a list of comparators, or null if invalid.
+function parseSet(str) {
+  const tokens = str.replace(/(<=|>=|<|>|=|~|\^)\s+/g, '$1').trim().split(/\s+/).filter(Boolean);
+  const out = [];
+  for (let i = 0; i < tokens.length; i++) {
+    if (tokens[i + 1] === '-') {
+      const a = parsePartial(tokens[i]);
+      const b = i + 2 < tokens.length ? parsePartial(tokens[i + 2]) : null;
+      if (!a || !b) return null;
+      out.push({ op: '>=', ver: lower(a) });
+      if (b.nums.length === 3) out.push({ op: '<=', ver: lower(b) });
+      else if (b.nums.length > 0) out.push({ op: '<', ver: nextUp(b) });
+      i += 2;
+      continue;
+    }
+    const m = /^(<=|>=|<|>|=|~|\^)?(.*)$/.exec(tokens[i]);
+    const p = parsePartial(m[2]);
+    if (!p) return null;
+    out.push(...desugar(m[1] || '=', p));
+  }
+  return out;
+}
+
+function test(c, v) {
+  const r = compare(v, c.ver);
+  switch (c.op) {
+    case '<': return r < 0;
+    case '<=': return r <= 0;
+    case '>': return r > 0;
+    case '>=': return r >= 0;
+    case '=': return r === 0;
+  }
+  return false;
+}
+
+function satisfiesSet(set, v) {
+  if (!set.every((c) => test(c, v))) return false;
+  if (!v.pre.length) return true;
+  return set.some((c) => c.ver.pre.length && c.ver.major === v.major && c.ver.minor === v.minor && c.ver.patch === v.patch);
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    if (typeof version !== 'string' || typeof range !== 'string') return false;
+    const v = parseVersion(version.trim());
+    if (!v) return false;
+    const sets = range.split('||').map(parseSet);
+    if (sets.some((s) => s === null)) return false;
+    return sets.some((s) => satisfiesSet(s, v));
+  } catch {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
