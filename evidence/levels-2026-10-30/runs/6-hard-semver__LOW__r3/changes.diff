+const assert = require('assert');
+const { satisfies } = require('../src/semver');
+
+function yes(range, ...versions) {
+  for (const v of versions) assert.strictEqual(satisfies(v, range), true, `${v} should satisfy "${range}"`);
+}
+function no(range, ...versions) {
+  for (const v of versions) assert.strictEqual(satisfies(v, range), false, `${v} should not satisfy "${range}"`);
+}
+
+test('exact and plain comparators', () => {
+  yes('1.2.3', '1.2.3', 'v1.2.3', '  1.2.3  ', '1.2.3+build.5');
+  yes('=1.2.3', '1.2.3');
+  yes('v1.2.3', '1.2.3');
+  no('1.2.3', '1.2.4', '1.2.3-rc.1');
+  yes('>1.2.3', '1.2.4', '2.0.0');
+  no('>1.2.3', '1.2.3');
+  yes('>=1.2.3', '1.2.3', '1.3.0');
+  no('>=1.2.3', '1.2.2');
+  yes('<1.2.3', '1.2.2', '0.0.0');
+  no('<1.2.3', '1.2.3');
+  yes('<=1.2.3', '1.2.3');
+  no('<=1.2.3', '1.2.4');
+  yes('>= 1.2.3', '1.2.3');
+  yes('1.2.3+abc', '1.2.3+xyz');
+});
+
+test('comparator sets and ||', () => {
+  yes('>=1.2.3 <2.0.0', '1.2.3', '1.9.9');
+  no('>=1.2.3 <2.0.0', '2.0.0', '1.2.2');
+  yes('1.x || >=2.5.0', '1.0.0', '2.5.0', '3.0.0');
+  no('1.x || >=2.5.0', '2.4.9');
+  yes('<1.0.0||>2.0.0', '0.5.0', '2.0.1');
+  no('<1.0.0||>2.0.0', '1.5.0');
+  yes('  >=1.0.0\t<2.0.0  ', '1.5.0');
+});
+
+test('ordering of prereleases', () => {
+  // Expressed via comparators; all prerelease pairs share the tuple.
+  const order = ['1.0.0-alpha', '1.0.0-alpha.1', '1.0.0-alpha.beta', '1.0.0-beta', '1.0.0-beta.2', '1.0.0-beta.11', '1.0.0-rc.1'];
+  for (let i = 0; i < order.length; i++) {
+    for (let j = 0; j < order.length; j++) {
+      assert.strictEqual(satisfies(order[i], `<${order[j]}`), i < j, `${order[i]} < ${order[j]}`);
+      assert.strictEqual(satisfies(order[i], `>${order[j]}`), i > j, `${order[i]} > ${order[j]}`);
+    }
+  }
+  yes('>1.0.0-rc.1', '1.0.0');
+  yes('<1.0.0', '0.9.9');
+  yes('>1.0.0-1', '1.0.0-a', '1.0.0-2');
+  yes('<1.0.0-a', '1.0.0-999');
+  yes('>1.0.0-A', '1.0.0-a'); // ASCII order
+  yes('>=1.0.0-alpha <1.0.0-alpha.0', '1.0.0-alpha');
+  yes('>1.0.0-9', '1.0.0-10'); // numeric, not lexical
+  yes('>9.0.0', '10.0.0');
+  yes('>1.2.9', '1.2.10');
+  yes('>99999999999999999999.0.0', '99999999999999999999.0.1');
+});
+
+test('x-ranges and partials without operator', () => {
+  for (const r of ['*', '', 'x', 'X', '  ']) yes(r, '0.0.0', '1.2.3', '99.0.0');
+  for (const r of ['1', '1.x', '1.X', '1.*', '1.x.x', '=1']) {
+    yes(r, '1.0.0', '1.9.9');
+    no(r, '0.9.9', '2.0.0');
+  }
+  for (const r of ['1.2', '1.2.x', '1.2.*', '=1.2']) {
+    yes(r, '1.2.0', '1.2.9');
+    no(r, '1.1.9', '1.3.0');
+  }
+});
+
+test('partials with operators', () => {
+  yes('>1', '2.0.0'); no('>1', '1.9.9');
+  yes('>1.2', '1.3.0'); no('>1.2', '1.2.9');
+  yes('>=1', '1.0.0'); no('>=1', '0.9.9');
+  yes('>=1.2', '1.2.0'); no('>=1.2', '1.1.9');
+  yes('<1', '0.9.9'); no('<1', '1.0.0');
+  yes('<1.2', '1.1.9'); no('<1.2', '1.2.0');
+  yes('<=1', '1.9.9'); no('<=1', '2.0.0');
+  yes('<=1.2', '1.2.9'); no('<=1.2', '1.3.0');
+  yes('>=1.x', '1.0.0'); yes('>1.x', '2.0.0'); no('>1.x', '1.5.0');
+  yes('>=*', '0.0.0');
+  no('>*', '1.0.0');
+  no('<*', '0.0.0');
+});
+
+test('tilde ranges', () => {
+  yes('~1.2.3', '1.2.3', '1.2.9'); no('~1.2.3', '1.2.2', '1.3.0');
+  yes('~1.2', '1.2.0', '1.2.9'); no('~1.2', '1.1.9', '1.3.0');
+  yes('~1', '1.0.0', '1.9.9'); no('~1', '2.0.0', '0.9.9');
+  yes('~1.x', '1.5.0'); no('~1.x', '2.0.0');
+  yes('~ 1.2.3', '1.2.5');
+  yes('~1.2.3-beta.2', '1.2.3-beta.2', '1.2.3-beta.4', '1.2.3', '1.2.9');
+  no('~1.2.3-beta.2', '1.2.3-beta.1', '1.2.4-beta.2', '1.3.0');
+  yes('~*', '3.0.0');
+});
+
+test('caret ranges', () => {
+  yes('^1.2.3', '1.2.3', '1.9.9'); no('^1.2.3', '1.2.2', '2.0.0');
+  yes('^0.2.3', '0.2.3', '0.2.9'); no('^0.2.3', '0.3.0', '0.2.2');
+  yes('^0.0.3', '0.0.3'); no('^0.0.3', '0.0.4', '0.0.2');
+  yes('^1.2', '1.2.0', '1.9.9'); no('^1.2', '1.1.9', '2.0.0');
+  yes('^1', '1.0.0', '1.9.9'); no('^1', '2.0.0');
+  yes('^0.2', '0.2.0', '0.2.9'); no('^0.2', '0.3.0');
+  yes('^0.0', '0.0.0', '0.0.9'); no('^0.0', '0.1.0');
+  yes('^0', '0.0.0', '0.9.9'); no('^0', '1.0.0');
+  yes('^0.x', '0.9.9'); no('^0.x', '1.0.0');
+  yes('^0.0.x', '0.0.5'); no('^0.0.x', '0.1.0');
+  yes('^1.2.x', '1.9.0'); no('^1.2.x', '1.1.0');
+  yes('^1.2.3-beta.2', '1.2.3-beta.2', '1.2.3-beta.10', '1.2.3', '1.9.9');
+  no('^1.2.3-beta.2', '1.2.3-beta.1', '1.2.4-beta.3', '2.0.0');
+  yes('^*', '0.0.1');
+});
+
+test('hyphen ranges', () => {
+  yes('1.2.3 - 2.3.4', '1.2.3', '2.3.4'); no('1.2.3 - 2.3.4', '1.2.2', '2.3.5');
+  yes('1.2 - 2.3.4', '1.2.0'); no('1.2 - 2.3.4', '1.1.9');
+  yes('1.2.3 - 2.3', '2.3.9'); no('1.2.3 - 2.3', '2.4.0');
+  yes('1.2.3 - 2', '2.9.9'); no('1.2.3 - 2', '3.0.0');
+  yes('1 - 2', '1.0.0', '2.9.9'); no('1 - 2', '0.9.9', '3.0.0');
+  yes('1.2.3 - 2.3.4 || 5.0.0', '5.0.0');
+  yes('1.2.3 - 2.3.4 >=2.0.0', '2.1.0'); // hyphen only applies to the whole set
+  no('1.2.3 - 2.3.4 >=2.0.0', '1.5.0');
+  no('1.2.3-2.3.4', '1.2.3'); // no spaces: a prerelease, not a range
+  yes('1.2.3-2.3.4', '1.2.3-2.3.4');
+});
+
+test('prerelease matching rule', () => {
+  yes('>1.2.3-alpha.3', '1.2.3-alpha.7', '3.4.5');
+  no('>1.2.3-alpha.3', '3.4.5-alpha.9');
+  no('^1.2.3', '1.2.4-beta');
+  no('*', '1.0.0-beta');
+  no('', '1.0.0-beta');
+  no('<2.0.0', '2.0.0-beta', '1.0.0-beta');
+  yes('1.0.0-beta', '1.0.0-beta', '1.0.0-beta+build');
+  yes('<1.0.0 || >=2.0.0-rc.1', '2.0.0-rc.2');
+  no('<1.0.0 || >=2.0.0-rc.1', '0.9.0-rc.1');
+  yes('>=1.2.3-alpha <1.2.3', '1.2.3-beta');
+});
+
+test('invalid input returns false and never throws', () => {
+  const badVersions = ['', '1', '1.2', '01.2.3', '1.02.3', '1.2.03', '1.2.3-', '1.2.3-a..b', '1.2.3+', 'x.2.3',
+    '1.2.3.4', 'a.b.c', '-1.2.3', 'V1.2.3', '1.2.3-a_b', '1.2.x', null, undefined, 123, {}];
+  for (const v of badVersions) assert.strictEqual(satisfies(v, '*'), false, `version ${String(v)}`);
+  const badRanges = ['>>1.2.3', '1.2.3.4', 'foo', '01.2.3', '~>1.2.3', '1.x.3-beta', '1.2-beta', '>=1.2.3 - 2.0.0',
+    '1.2.3 -2.0.0', '1.2.3 | 2.0.0', '1 - 2 - 3', '- 1.2.3', '1.2.3 -', '>', null, undefined, 5];
+  for (const r of badRanges) assert.strictEqual(satisfies('1.2.3', r), false, `range ${String(r)}`);
+  assert.strictEqual(satisfies('1.2.3', '1.2.3 || foo'), false);
+});
