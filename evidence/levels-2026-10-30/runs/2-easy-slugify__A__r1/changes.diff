diff --git a/src/strings.js b/src/strings.js
index 107e994..08693d5 100644
--- a/src/strings.js
+++ b/src/strings.js
@@ -2,8 +2,20 @@ function capitalize(text) {
   return text ? text[0].toUpperCase() + text.slice(1) : text;
 }
 
+// Latin letters that NFD does not decompose into base letter + combining mark.
+const LATIN_EXTRAS = { 'đ': 'd', 'ð': 'd', 'ł': 'l', 'ø': 'o', 'ħ': 'h', 'ı': 'i', 'ß': 'ss', 'æ': 'ae', 'œ': 'oe', 'þ': 'th' };
+const MAX_SLUG_LENGTH = 50;
+
 function slugify(text) {
-  throw new Error('not implemented');
+  return String(text)
+    .toLowerCase()
+    .normalize('NFD')
+    .replace(/[̀-ͯ]/g, '')
+    .replace(/[đðłøħıßæœþ]/g, (ch) => LATIN_EXTRAS[ch])
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, MAX_SLUG_LENGTH)
+    .replace(/-+$/, '');
 }
 
 module.exports = { capitalize, slugify };
diff --git a/test/strings.test.js b/test/strings.test.js
index a282d44..ddd5d03 100644
--- a/test/strings.test.js
+++ b/test/strings.test.js
@@ -1,5 +1,30 @@
 const assert = require('assert');
-const { capitalize } = require('../src/strings');
+const { capitalize, slugify } = require('../src/strings');
 
 test('capitalize first letter', () => assert.strictEqual(capitalize('hello'), 'Hello'));
 test('capitalize empty string', () => assert.strictEqual(capitalize(''), ''));
+
+test('slugify lowercases and joins words with hyphens', () => assert.strictEqual(slugify('Hello World'), 'hello-world'));
+test('slugify removes Vietnamese diacritics', () =>
+  assert.strictEqual(slugify('Tiếng Việt có dấu'), 'tieng-viet-co-dau'));
+test('slugify maps đ and Đ to d', () => assert.strictEqual(slugify('Đường đi'), 'duong-di'));
+test('slugify removes other Latin diacritics', () =>
+  assert.strictEqual(slugify('Crème Brûlée à la Señor Müller'), 'creme-brulee-a-la-senor-muller'));
+test('slugify collapses runs of non-alphanumerics into one hyphen', () =>
+  assert.strictEqual(slugify('a  --  b!!!c___d'), 'a-b-c-d'));
+test('slugify trims leading and trailing hyphens', () => assert.strictEqual(slugify('  --Hello!--  '), 'hello'));
+test('slugify keeps digits', () => assert.strictEqual(slugify('Top 10 Tips 2024'), 'top-10-tips-2024'));
+test('slugify returns empty string for no slug characters', () => {
+  assert.strictEqual(slugify(''), '');
+  assert.strictEqual(slugify('!!! ---'), '');
+});
+test('slugify limits length to 50', () => assert.strictEqual(slugify('a'.repeat(80)), 'a'.repeat(50)));
+test('slugify cut at 50 does not end with a hyphen', () => {
+  // The full slug is 49 a's + '-bbbb', so a plain cut at 50 would end with the hyphen.
+  const slug = slugify('a'.repeat(49) + ' bbbb');
+  assert.strictEqual(slug, 'a'.repeat(49));
+});
+test('slugify cut at 50 keeps a hyphen-free 50th character', () => {
+  const slug = slugify('a'.repeat(48) + ' bbbb');
+  assert.strictEqual(slug, 'a'.repeat(48) + '-b');
+});
