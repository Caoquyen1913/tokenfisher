+  return lookup(code) !== undefined;
 }
 
 function symbol(code) {
-  return CURRENCIES[code] ? CURRENCIES[code].symbol : code;
+  const c = lookup(code);
+  return c ? c.symbol : code;
 }
 
 module.exports = { exponent, isSupported, symbol, DEFAULT_EXPONENT };
