+// Lookups ignore case: gateway and CRM codes arrive lower-case ("jpy"), and a miss
+// would silently fall back to DEFAULT_EXPONENT (100x for zero-decimal currencies).
+function lookup(code) {
+  const key = String(code).trim().toUpperCase();
+  return Object.prototype.hasOwnProperty.call(CURRENCIES, key) ? CURRENCIES[key] : undefined;
+}
+
 function exponent(code) {
-  const c = CURRENCIES[code];
+  const c = lookup(code);
   return c ? c.exponent : DEFAULT_EXPONENT;
 }
 
