diff --git a/test/store.test.js b/test/store.test.js
index 8b80ad0..3ef3f61 100644
--- a/test/store.test.js
+++ b/test/store.test.js
@@ -27,3 +27,61 @@ test('quantities must be positive integers', () => {
   assert.throws(() => s.addItem('A', 0), /INVALID_QTY/);
   assert.throws(() => s.addItem('A', 1.5), /INVALID_QTY/);
 });
+
+function timed() {
+  let t = 1000;
+  const s = createStore({ clock: () => t });
+  s.addItem('R', 10);
+  return { s, advance: (ms) => { t += ms; } };
+}
+test('reserve reduces available but not stock', () => {
+  const { s } = timed();
+  const a = s.reserve('R', 4, 100);
+  const b = s.reserve('R', 1, 100);
+  assert.notStrictEqual(a, b);
+  assert.strictEqual(typeof a, 'string');
+  assert.strictEqual(s.getStock('R'), 10);
+  assert.strictEqual(s.getAvailable('R'), 5);
+});
+test('reserve validates qty and availability', () => {
+  const { s } = timed();
+  assert.throws(() => s.reserve('R', 0, 100), /INVALID_QTY/);
+  assert.throws(() => s.reserve('R', 1.5, 100), /INVALID_QTY/);
+  assert.throws(() => s.reserve('R', 11, 100), /INSUFFICIENT_STOCK/);
+});
+test('reservation expires at exactly ttl', () => {
+  const { s, advance } = timed();
+  const id = s.reserve('R', 4, 100);
+  advance(99);
+  assert.strictEqual(s.getAvailable('R'), 6);
+  advance(1);
+  assert.strictEqual(s.getAvailable('R'), 10);
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+});
+test('confirm converts reservation to sale once', () => {
+  const { s } = timed();
+  const id = s.reserve('R', 4, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('R'), 6);
+  assert.strictEqual(s.getAvailable('R'), 6);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+  assert.throws(() => s.confirm('zzz'), /RESERVATION_NOT_FOUND/);
+});
+test('release is idempotent and frees stock', () => {
+  const { s } = timed();
+  const id = s.reserve('R', 4, 100);
+  s.release(id);
+  s.release(id);
+  s.release('zzz');
+  assert.strictEqual(s.getAvailable('R'), 10);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('removeItem cannot take reserved stock', () => {
+  const { s, advance } = timed();
+  s.reserve('R', 4, 100);
+  assert.throws(() => s.removeItem('R', 7), /INSUFFICIENT_STOCK/);
+  s.removeItem('R', 6);
+  assert.strictEqual(s.getStock('R'), 4);
+  advance(100);
+  s.removeItem('R', 4);
+});
