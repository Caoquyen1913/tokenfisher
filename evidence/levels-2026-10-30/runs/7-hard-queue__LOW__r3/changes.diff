diff --git a/test/queue.test.js b/test/queue.test.js
index be49570..81053b3 100644
--- a/test/queue.test.js
+++ b/test/queue.test.js
@@ -15,3 +15,113 @@ test('starts jobs in order with concurrency 1', async () => {
   await Promise.all(['a', 'b', 'c'].map((x) => q.add(async () => { order.push(x); await sleep(1); })));
   assert.deepStrictEqual(order, ['a', 'b', 'c']);
 });
+
+test('a rejecting job rejects only its own promise and the queue keeps going', async () => {
+  const q = createQueue();
+  const failed = q.add(async () => { throw new Error('boom'); });
+  const ok = q.add(async () => 'ok');
+  await assert.rejects(failed, /boom/);
+  assert.strictEqual(await ok, 'ok');
+  await q.onIdle();
+  assert.strictEqual(q.running, 0);
+});
+
+test('a synchronously throwing job does not break the queue', async () => {
+  const q = createQueue();
+  const failed = q.add(() => { throw new Error('sync boom'); });
+  const ok = q.add(() => 42);
+  await assert.rejects(failed, /sync boom/);
+  assert.strictEqual(await ok, 42);
+  await q.onIdle();
+});
+
+test('jobs may return plain values', async () => {
+  const q = createQueue({ concurrency: 2 });
+  assert.deepStrictEqual(await Promise.all([q.add(() => 1), q.add(() => 2)]), [1, 2]);
+});
+
+test('onIdle waits for running jobs, not just pending ones', async () => {
+  const q = createQueue({ concurrency: 2 });
+  let done = 0;
+  q.add(async () => { await sleep(20); done++; });
+  q.add(async () => { await sleep(30); done++; });
+  await q.onIdle();
+  assert.strictEqual(done, 2);
+  assert.strictEqual(q.running, 0);
+  assert.strictEqual(q.pending, 0);
+});
+
+test('onIdle resolves after a failing job', async () => {
+  const q = createQueue();
+  q.add(async () => { await sleep(5); throw new Error('x'); }).catch(() => {});
+  await q.onIdle();
+  assert.strictEqual(q.running, 0);
+});
+
+test('onIdle resolves immediately when already idle', async () => {
+  await createQueue().onIdle();
+});
+
+test('onIdle does not resolve while paused with pending jobs', async () => {
+  const q = createQueue();
+  q.pause();
+  q.add(() => 1);
+  let idle = false;
+  q.onIdle().then(() => { idle = true; });
+  await sleep(10);
+  assert.strictEqual(idle, false);
+  q.resume();
+  await sleep(0);
+  assert.strictEqual(idle, true);
+});
+
+test('resume fills every free slot', async () => {
+  const q = createQueue({ concurrency: 4 });
+  q.pause();
+  let active = 0;
+  let maxActive = 0;
+  const jobs = Array.from({ length: 8 }, () => q.add(async () => {
+    active++;
+    maxActive = Math.max(maxActive, active);
+    await sleep(10);
+    active--;
+  }));
+  assert.strictEqual(q.running, 0);
+  assert.strictEqual(q.pending, 8);
+  q.resume();
+  assert.strictEqual(q.running, 4);
+  assert.strictEqual(q.pending, 4);
+  await Promise.all(jobs);
+  assert.strictEqual(maxActive, 4);
+});
+
+test('pause lets running jobs finish but starts no new ones', async () => {
+  const q = createQueue({ concurrency: 2 });
+  const started = [];
+  const jobs = [1, 2, 3, 4].map((n) => q.add(async () => { started.push(n); await sleep(10); }));
+  q.pause();
+  await Promise.all(jobs.slice(0, 2));
+  await sleep(10);
+  assert.deepStrictEqual(started, [1, 2]);
+  assert.strictEqual(q.pending, 2);
+  q.resume();
+  await Promise.all(jobs);
+  assert.deepStrictEqual(started, [1, 2, 3, 4]);
+});
+
+test('never exceeds concurrency and starts jobs in order', async () => {
+  const q = createQueue({ concurrency: 3 });
+  const order = [];
+  let active = 0;
+  let maxActive = 0;
+  await Promise.all(Array.from({ length: 10 }, (_, i) => q.add(async () => {
+    order.push(i);
+    active++;
+    maxActive = Math.max(maxActive, active);
+    await sleep(Math.random() * 10);
+    active--;
+    if (i % 3 === 0) throw new Error('fail');
+  }).catch(() => {})));
+  assert.strictEqual(maxActive, 3);
+  assert.deepStrictEqual(order, [...Array(10).keys()]);
+});
