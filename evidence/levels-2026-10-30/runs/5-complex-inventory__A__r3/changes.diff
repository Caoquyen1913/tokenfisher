diff --git a/src/store.js b/src/store.js
index 77755be..75d8d30 100644
--- a/src/store.js
+++ b/src/store.js
@@ -1,25 +1,65 @@
 // In-memory inventory. `clock` is injectable so tests can control time.
 function createStore({ clock = Date.now } = {}) {
   const stock = new Map();
+  // id -> { sku, qty, expiresAt }. Confirmed and released reservations are deleted;
+  // expired ones are kept so confirm() can report RESERVATION_EXPIRED.
+  const reservations = new Map();
+  let nextId = 1;
 
   function assertQty(qty) {
     if (!Number.isInteger(qty) || qty <= 0) throw new Error('INVALID_QTY');
   }
 
+  function isExpired(r) {
+    return clock() >= r.expiresAt;
+  }
+
+  function reservedQty(sku) {
+    let total = 0;
+    for (const r of reservations.values()) {
+      if (r.sku === sku && !isExpired(r)) total += r.qty;
+    }
+    return total;
+  }
+
+  function getStock(sku) {
+    return stock.get(sku) || 0;
+  }
+
+  function getAvailable(sku) {
+    return getStock(sku) - reservedQty(sku);
+  }
+
   return {
     clock,
     addItem(sku, qty) {
       assertQty(qty);
-      stock.set(sku, (stock.get(sku) || 0) + qty);
+      stock.set(sku, getStock(sku) + qty);
     },
     removeItem(sku, qty) {
       assertQty(qty);
-      const current = stock.get(sku) || 0;
-      if (qty > current) throw new Error('INSUFFICIENT_STOCK');
-      stock.set(sku, current - qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      stock.set(sku, getStock(sku) - qty);
+    },
+    getStock,
+    getAvailable,
+    reserve(sku, qty, ttlMs) {
+      assertQty(qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      const id = `res-${nextId++}`;
+      reservations.set(id, { sku, qty, expiresAt: clock() + ttlMs });
+      return id;
+    },
+    confirm(id) {
+      const r = reservations.get(id);
+      if (!r) throw new Error('RESERVATION_NOT_FOUND');
+      if (isExpired(r)) throw new Error('RESERVATION_EXPIRED');
+      reservations.delete(id);
+      stock.set(r.sku, getStock(r.sku) - r.qty);
+      return { sku: r.sku, stock: getStock(r.sku) };
     },
-    getStock(sku) {
-      return stock.get(sku) || 0;
+    release(id) {
+      reservations.delete(id);
     },
   };
 }
diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..69f0ffa
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,138 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function setup(qty = 10) {
+  let now = 1000;
+  const time = { advance: (ms) => { now += ms; } };
+  const s = createStore({ clock: () => now });
+  if (qty) s.addItem('A', qty);
+  return { s, time };
+}
+
+test('reserve returns unique string ids', () => {
+  const { s } = setup();
+  const a = s.reserve('A', 1, 1000);
+  const b = s.reserve('A', 1, 1000);
+  assert.strictEqual(typeof a, 'string');
+  assert.notStrictEqual(a, b);
+});
+test('reserve rejects non-positive-integer qty', () => {
+  const { s } = setup();
+  for (const q of [0, -1, 1.5, '2', undefined]) assert.throws(() => s.reserve('A', q, 1000), /INVALID_QTY/);
+});
+test('reserve rejects qty above available', () => {
+  const { s } = setup(5);
+  s.reserve('A', 3, 1000);
+  assert.throws(() => s.reserve('A', 3, 1000), /INSUFFICIENT_STOCK/);
+  s.reserve('A', 2, 1000);
+  assert.throws(() => s.reserve('B', 1, 1000), /INSUFFICIENT_STOCK/);
+});
+test('reservations reduce available but not physical stock', () => {
+  const { s } = setup(10);
+  s.reserve('A', 4, 1000);
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.strictEqual(s.getAvailable('nope'), 0);
+});
+test('reservation expires exactly at creation + ttl', () => {
+  const { s, time } = setup(10);
+  const id = s.reserve('A', 4, 1000);
+  time.advance(999);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  time.advance(1);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+  assert.strictEqual(s.getStock('A'), 10);
+});
+test('expired stock can be reserved again', () => {
+  const { s, time } = setup(5);
+  s.reserve('A', 5, 100);
+  time.advance(100);
+  s.reserve('A', 5, 100);
+  assert.strictEqual(s.getAvailable('A'), 0);
+});
+test('confirm sells reserved stock and removes the reservation', () => {
+  const { s } = setup(10);
+  const id = s.reserve('A', 4, 1000);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 6);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm rejects unknown and released ids', () => {
+  const { s } = setup();
+  assert.throws(() => s.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const id = s.reserve('A', 1, 1000);
+  s.release(id);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('release frees stock and is idempotent', () => {
+  const { s } = setup(10);
+  const id = s.reserve('A', 4, 1000);
+  s.release(id);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  s.release(id);
+  s.release('nope');
+  assert.strictEqual(s.getStock('A'), 10);
+});
+test('release after confirm does not restore stock', () => {
+  const { s } = setup(10);
+  const id = s.reserve('A', 4, 1000);
+  s.confirm(id);
+  s.release(id);
+  assert.strictEqual(s.getStock('A'), 6);
+  assert.strictEqual(s.getAvailable('A'), 6);
+});
+test('removeItem cannot take reserved stock', () => {
+  const { s, time } = setup(10);
+  s.reserve('A', 7, 1000);
+  assert.throws(() => s.removeItem('A', 4), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 3);
+  assert.strictEqual(s.getStock('A'), 7);
+  time.advance(1000);
+  s.removeItem('A', 7);
+  assert.strictEqual(s.getStock('A'), 0);
+});
+test('reservations are per sku', () => {
+  const { s } = setup(5);
+  s.addItem('B', 5);
+  s.reserve('A', 5, 1000);
+  assert.strictEqual(s.getAvailable('B'), 5);
+});
+
+test('API: GET /stock includes available', () => {
+  const { s } = setup(10);
+  const api = createApi(s);
+  s.reserve('A', 3, 1000);
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }), { status: 200, body: { sku: 'A', stock: 10, available: 7 } });
+});
+test('API: reservation lifecycle', () => {
+  const { s, time } = setup(10);
+  const api = createApi(s);
+  const created = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 4, ttlMs: 1000 } });
+  assert.strictEqual(created.status, 201);
+  assert.strictEqual(typeof created.body.id, 'string');
+  const { id } = created.body;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'A', stock: 6 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+
+  const id2 = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 1, ttlMs: 10 } }).body.id;
+  time.advance(10);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id2}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('API: reservation errors', () => {
+  const api = createApi(setup(2).s);
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 1000 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 1000 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations/nope/confirm' }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+});
+test('API: DELETE /reservations/:id releases and returns 204', () => {
+  const { s } = setup(10);
+  const api = createApi(s);
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 4, ttlMs: 1000 } }).body;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: '/reservations/nope' }).status, 204);
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
