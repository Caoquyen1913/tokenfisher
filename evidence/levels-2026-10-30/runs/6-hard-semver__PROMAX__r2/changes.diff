+const assert = require('assert');
+const { satisfies } = require('../src/semver');
+
+const yes = (v, r) => assert.strictEqual(satisfies(v, r), true, `${v} should satisfy "${r}"`);
+const no = (v, r) => assert.strictEqual(satisfies(v, r), false, `${v} should not satisfy "${r}"`);
+
+test('invalid input returns false', () => {
+  no('1.2', '*'); no('01.2.3', '*'); no('abc', '*'); no('1.2.3', '>>1'); no('1.2.3', '1.2.3 - '); no('1.2.3', '1.2.3-');
+  no(undefined, '*'); no('1.2.3', null); no('1.2.3-', '*'); no('1.2.3+', '*');
+});
+test('versions: v prefix, whitespace, build ignored', () => {
+  yes(' v1.2.3 ', '1.2.3'); yes('1.2.3+build.5', '1.2.3'); yes('1.2.3', '=v1.2.3+x');
+});
+test('comparators', () => {
+  yes('1.2.3', '>= 1.2.3'); no('1.2.3', '> 1.2.3'); yes('1.2.3', '<=1.2.3'); no('1.2.3', '<1.2.3');
+  yes('1.2.4', '>1.2.3 <1.3.0'); yes('1.2.3', '= 1.2.3');
+});
+test('ordering of prereleases', () => {
+  yes('1.0.0', '>1.0.0-rc.1'); no('1.0.0-rc.1', '>=1.0.0');
+  yes('1.0.0-alpha.1', '>1.0.0-alpha'); yes('1.0.0-alpha.beta', '>1.0.0-alpha.1');
+  yes('1.0.0-alpha.10', '>1.0.0-alpha.9'); yes('1.0.0-b', '>1.0.0-a'); yes('1.0.0-B', '<1.0.0-a');
+});
+test('or sets', () => {
+  yes('2.0.0', '1.x || 2.x'); no('3.0.0', '1.x || 2.x'); yes('9.9.9', ''); yes('1.0.0', ' ');
+  no('1.0.0', '1.x || bad');
+});
+test('x-ranges', () => {
+  yes('5.5.5', '*'); yes('1.9.9', '1'); no('2.0.0', '1.x'); yes('1.2.9', '1.2'); no('1.3.0', '1.2.x'); yes('1.2.3', 'X');
+});
+test('operators with partial versions', () => {
+  no('1.9.9', '>1'); yes('2.0.0', '>1'); no('1.2.9', '>1.2'); yes('1.3.0', '>1.2');
+  yes('1.0.0', '>=1'); no('0.9.9', '>=1'); yes('1.2.0', '>=1.2'); no('1.0.0', '<1'); yes('0.9.9', '<1');
+  no('1.1.9', '<1.2'.replace('1.2', '1.1')); yes('1.9.9', '<=1'); no('2.0.0', '<=1');
+  yes('1.2.9', '<=1.2'); no('1.3.0', '<=1.2'); yes('1.4.0', '=1'); no('1.3.0', '=1.2');
+});
+test('tilde', () => {
+  yes('1.2.9', '~1.2.3'); no('1.3.0', '~1.2.3'); no('1.2.2', '~1.2.3'); yes('1.2.0', '~1.2'); yes('1.9.0', '~1');
+  no('2.0.0', '~1'); yes('1.2.3-beta.4', '~1.2.3-beta.2'); no('1.2.3-beta.1', '~1.2.3-beta.2'); yes('1.2.3', '~ 1.2.3-beta.2');
+});
+test('caret', () => {
+  yes('1.9.9', '^1.2.3'); no('2.0.0', '^1.2.3'); yes('0.2.9', '^0.2.3'); no('0.3.0', '^0.2.3');
+  yes('0.0.3', '^0.0.3'); no('0.0.4', '^0.0.3'); yes('1.9.0', '^1.2'); yes('1.0.0', '^1'); yes('0.2.5', '^0.2');
+  no('0.3.0', '^0.2'); yes('0.0.9', '^0.0'); no('0.1.0', '^0.0'); yes('0.9.9', '^0'); no('1.0.0', '^0.x');
+  yes('1.5.0', '^1.2.3-beta.2'); yes('1.2.3-beta.5', '^1.2.3-beta.2'); no('1.2.3-beta.1', '^1.2.3-beta.2');
+});
+test('hyphen ranges', () => {
+  yes('2.3.4', '1.2.3 - 2.3.4'); no('2.3.5', '1.2.3 - 2.3.4'); yes('1.2.0', '1.2 - 2.3.4');
