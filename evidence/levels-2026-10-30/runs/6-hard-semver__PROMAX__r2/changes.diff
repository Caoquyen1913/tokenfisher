+  yes('1.2.3-alpha.7', '>1.2.3-alpha.3'); no('3.4.5-alpha.9', '>1.2.3-alpha.3');
+  no('1.2.4-beta', '^1.2.3'); no('1.0.0-rc.1', '*'); no('1.0.0-rc.1', ''); no('1.0.0-rc.1', '1.x');
+  yes('1.2.3-beta.2', '>=1.2.3-beta.1 <2.0.0'); no('1.2.4-beta', '>=1.2.3-beta.1 <2.0.0');
+  yes('1.2.4-beta', '^1.2.3 || >=1.2.4-alpha');
+});
