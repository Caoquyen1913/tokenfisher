diff --git a/test/queue.test.js b/test/queue.test.js
index be49570..f6d9f17 100644
--- a/test/queue.test.js
+++ b/test/queue.test.js
@@ -15,3 +15,40 @@ test('starts jobs in order with concurrency 1', async () => {
   await Promise.all(['a', 'b', 'c'].map((x) => q.add(async () => { order.push(x); await sleep(1); })));
   assert.deepStrictEqual(order, ['a', 'b', 'c']);
 });
+
+test('keeps going after a job rejects or throws synchronously', async () => {
+  const q = createQueue();
+  const bad = q.add(async () => { throw new Error('boom'); });
+  const worse = q.add(() => { throw new Error('sync'); });
+  const good = q.add(() => 42);
+  await assert.rejects(bad, /boom/);
+  await assert.rejects(worse, /sync/);
+  assert.strictEqual(await good, 42);
+  await q.onIdle();
+  assert.strictEqual(q.running, 0);
+});
+
+test('onIdle waits for running jobs, even with nothing pending', async () => {
+  const q = createQueue({ concurrency: 2 });
+  let done = false;
+  q.add(async () => { await sleep(20); done = true; });
+  await q.onIdle();
+  assert.strictEqual(done, true);
+  await q.onIdle(); // already idle: resolves immediately
+});
+
+test('resume starts up to concurrency jobs', async () => {
+  const q = createQueue({ concurrency: 4 });
+  q.pause();
+  let active = 0, peak = 0;
+  const jobs = [];
+  for (let i = 0; i < 8; i++) {
+    jobs.push(q.add(async () => { active++; peak = Math.max(peak, active); await sleep(10); active--; }));
+  }
+  assert.strictEqual(q.running, 0);
+  assert.strictEqual(q.pending, 8);
+  q.resume();
+  assert.strictEqual(q.running, 4);
+  await Promise.all(jobs);
+  assert.strictEqual(peak, 4);
+});
