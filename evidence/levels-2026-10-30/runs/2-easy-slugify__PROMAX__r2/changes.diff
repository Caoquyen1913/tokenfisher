 const assert = require('assert');
-const { capitalize } = require('../src/strings');
+const { capitalize, slugify } = require('../src/strings');
 
 test('capitalize first letter', () => assert.strictEqual(capitalize('hello'), 'Hello'));
 test('capitalize empty string', () => assert.strictEqual(capitalize(''), ''));
+
+test('slugify basic', () => assert.strictEqual(slugify('Hello, World!'), 'hello-world'));
+test('slugify Vietnamese diacritics and đ', () => {
+  assert.strictEqual(slugify('Đường Nguyễn Huệ'), 'duong-nguyen-hue');
+  assert.strictEqual(slugify('đẹp quá'), 'dep-qua');
+});
+test('slugify other Latin diacritics', () => assert.strictEqual(slugify('Café Crème Ñandú'), 'cafe-creme-nandu'));
+test('slugify collapses runs and trims hyphens', () => assert.strictEqual(slugify('  --a___b  c--  '), 'a-b-c'));
+test('slugify empty / symbols only', () => {
+  assert.strictEqual(slugify(''), '');
+  assert.strictEqual(slugify('!!!'), '');
+});
+test('slugify truncates to 50', () => assert.strictEqual(slugify('a'.repeat(80)), 'a'.repeat(50)));
+test('slugify cut slug does not end with hyphen', () => {
+  const r = slugify('a'.repeat(49) + ' bcd');
+  assert.strictEqual(r, 'a'.repeat(49));
+  assert.ok(slugify('word '.repeat(20)).length <= 50 && !slugify('word '.repeat(20)).endsWith('-'));
+});
