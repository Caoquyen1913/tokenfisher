@@ -3,7 +3,16 @@ function capitalize(text) {
 }
 
 function slugify(text) {
-  throw new Error('not implemented');
+  return String(text == null ? '' : text)
+    .replace(/đ/g, 'd')
+    .replace(/Đ/g, 'D')
+    .normalize('NFD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, 50)
+    .replace(/-+$/, '');
 }
 
 module.exports = { capitalize, slugify };
