+const { capitalize, slugify } = require('../src/strings');
 
 test('capitalize first letter', () => assert.strictEqual(capitalize('hello'), 'Hello'));
 test('capitalize empty string', () => assert.strictEqual(capitalize(''), ''));
+
+test('slugify lowercases and hyphenates', () => assert.strictEqual(slugify('Hello World'), 'hello-world'));
+test('slugify strips Vietnamese diacritics', () => assert.strictEqual(slugify('Đường Nguyễn Huệ'), 'duong-nguyen-hue'));
+test('slugify handles other Latin diacritics', () => assert.strictEqual(slugify('Crème Brûlée à la Zoë'), 'creme-brulee-a-la-zoe'));
+test('slugify collapses runs of symbols', () => assert.strictEqual(slugify('a  --  b!!!c'), 'a-b-c'));
+test('slugify trims leading and trailing hyphens', () => assert.strictEqual(slugify('  --Hello!--  '), 'hello'));
+test('slugify empty and symbol-only input', () => {
+  assert.strictEqual(slugify(''), '');
+  assert.strictEqual(slugify('!!!'), '');
+});
+test('slugify keeps digits', () => assert.strictEqual(slugify('Top 10 of 2024'), 'top-10-of-2024'));
+test('slugify caps at 50 chars', () => assert.strictEqual(slugify('a'.repeat(80)), 'a'.repeat(50)));
+test('slugify cut at 50 does not end with hyphen', () => {
+  const s = slugify('a'.repeat(49) + ' bbb');
+  assert.strictEqual(s, 'a'.repeat(49));
+  assert.ok(!s.endsWith('-') && s.length <= 50);
+});
