+const assert = require('assert');
+const { satisfies } = require('../src/semver');
+
+// Each case: [range, versions that satisfy it, versions that do not].
+function check(range, yes, no) {
+  for (const v of yes) assert.strictEqual(satisfies(v, range), true, `${v} should satisfy "${range}"`);
+  for (const v of no) assert.strictEqual(satisfies(v, range), false, `${v} should not satisfy "${range}"`);
+}
+
+test('plain versions and comparators', () => {
+  check('1.2.3', ['1.2.3', 'v1.2.3', ' 1.2.3 ', '1.2.3+build.5'], ['1.2.4', '1.2.2']);
+  check('=1.2.3', ['1.2.3'], ['1.2.4']);
+  check('>1.2.3', ['1.2.4', '2.0.0'], ['1.2.3', '1.0.0']);
+  check('>=1.2.3', ['1.2.3', '1.3.0'], ['1.2.2']);
+  check('<1.2.3', ['1.2.2', '0.0.0'], ['1.2.3']);
+  check('<=1.2.3', ['1.2.3', '1.2.2'], ['1.2.4']);
+  check('>= 1.2.3', ['1.2.3'], ['1.2.2']);
+  check('1.2.3+build', ['1.2.3'], ['1.2.4']);
+});
+
+test('ordering of prereleases', () => {
+  const ordered = ['1.0.0-alpha', '1.0.0-alpha.1', '1.0.0-alpha.beta', '1.0.0-beta', '1.0.0-beta.2', '1.0.0-beta.11', '1.0.0-rc.1', '1.0.0'];
+  // `<1.0.0` admits no prerelease: the comparator has none on that tuple (see SPEC "Prereleases").
+  for (let i = 0; i < ordered.length - 1; i++) {
+    assert.strictEqual(satisfies(ordered[i], `<${ordered[i + 1]}`), ordered[i + 1].includes('-'), `${ordered[i]} < ${ordered[i + 1]}`);
+    assert.strictEqual(satisfies(ordered[i + 1], `>${ordered[i]}`), true, `${ordered[i + 1]} > ${ordered[i]}`);
+  }
+  check('>1.0.0-rc.1', ['1.0.0', '1.0.0-rc.2'], ['1.0.0-rc.1', '1.0.0-rc.0']);
+  check('1.0.0-alpha', ['1.0.0-alpha+b'], ['1.0.0']);
+});
+
+test('numbers compare numerically, including very large ones', () => {
+  check('>1.2.9', ['1.2.10'], []);
+  check('>9007199254740993.0.0', ['9007199254740994.0.0'], ['9007199254740993.0.0']);
+});
+
+test('X-ranges without operator', () => {
+  check('*', ['0.0.0', '1.2.3', '99.0.0'], ['1.2.3-alpha']);
+  check('', ['1.2.3'], ['1.2.3-alpha']);
+  check('1', ['1.0.0', '1.9.9'], ['2.0.0', '0.9.9']);
+  check('1.x', ['1.0.0', '1.9.9'], ['2.0.0']);
+  check('1.X', ['1.5.0'], ['2.0.0']);
+  check('1.2', ['1.2.0', '1.2.9'], ['1.3.0', '1.1.9']);
+  check('1.2.x', ['1.2.0'], ['1.3.0']);
+  check('1.2.*', ['1.2.7'], ['1.3.0']);
+});
+
+test('X-ranges with operator', () => {
+  check('>1', ['2.0.0'], ['1.9.9']);
+  check('>1.2', ['1.3.0'], ['1.2.9']);
+  check('>=1', ['1.0.0'], ['0.9.9']);
+  check('>=1.2', ['1.2.0'], ['1.1.9']);
+  check('<1', ['0.9.9'], ['1.0.0']);
+  check('<1.2', ['1.1.9'], ['1.2.0']);
+  check('<=1', ['1.9.9'], ['2.0.0']);
+  check('<=1.2', ['1.2.9'], ['1.3.0']);
+  check('=1', ['1.0.0', '1.9.9'], ['2.0.0']);
+  check('=1.2', ['1.2.5'], ['1.3.0']);
+  check('>=*', ['0.0.0'], []);
+  check('<*', [], ['0.0.0', '1.2.3']);
+});
+
+test('tilde', () => {
+  check('~1.2.3', ['1.2.3', '1.2.9'], ['1.3.0', '1.2.2']);
+  check('~1.2', ['1.2.0', '1.2.9'], ['1.3.0']);
+  check('~1', ['1.0.0', '1.9.9'], ['2.0.0']);
+  check('~1.2.3-beta.2', ['1.2.3-beta.2', '1.2.3-beta.10', '1.2.3', '1.2.5'], ['1.2.3-beta.1', '1.2.4-beta', '1.3.0']);
+});
+
+test('caret', () => {
+  check('^1.2.3', ['1.2.3', '1.9.9'], ['2.0.0', '1.2.2', '1.2.4-beta']);
+  check('^0.2.3', ['0.2.3', '0.2.9'], ['0.3.0', '0.2.2']);
+  check('^0.0.3', ['0.0.3'], ['0.0.4', '0.0.2']);
+  check('^1.2', ['1.2.0', '1.9.9'], ['2.0.0', '1.1.9']);
+  check('^1', ['1.0.0', '1.9.9'], ['2.0.0']);
+  check('^0.2', ['0.2.0', '0.2.9'], ['0.3.0']);
+  check('^0.0', ['0.0.0', '0.0.9'], ['0.1.0']);
+  check('^0', ['0.0.0', '0.9.9'], ['1.0.0']);
+  check('^0.x', ['0.9.9'], ['1.0.0']);
+  check('^1.2.3-beta.2', ['1.2.3-beta.2', '1.2.3-beta.3', '1.9.0'], ['1.2.3-beta.1', '2.0.0', '1.3.0-beta']);
+});
+
+test('hyphen ranges', () => {
+  check('1.2.3 - 2.3.4', ['1.2.3', '2.3.4'], ['1.2.2', '2.3.5']);
+  check('1.2 - 2.3.4', ['1.2.0'], ['1.1.9', '2.3.5']);
+  check('1.2.3 - 2.3', ['2.3.9'], ['2.4.0', '1.2.2']);
+  check('1.2.3 - 2', ['2.9.9'], ['3.0.0']);
+});
+
+test('comparator sets and unions', () => {
+  check('>=1.2.3 <2.0.0', ['1.2.3', '1.9.9'], ['2.0.0', '1.2.2']);
+  check('1.x || >=2.5.0 || 5.0.0 - 7.2.3', ['1.2.3', '2.5.0', '6.0.0', '8.0.0'], ['2.0.0']);
+  check('<1.0.0||>=2.0.0', ['0.5.0', '2.0.0'], ['1.5.0']);
+  check('  >1.0.0\t<1.5.0  ', ['1.2.0'], ['1.5.0']);
+});
+
+test('prereleases need a comparator with a prerelease on the same tuple', () => {
+  check('>1.2.3-alpha.3', ['1.2.3-alpha.7', '1.2.3', '3.4.5'], ['3.4.5-alpha.9', '1.2.3-alpha.3']);
+  check('>=1.2.3-alpha <1.3.0 || 2.x', ['1.2.3-beta'], ['1.2.4-beta', '2.0.0-rc.1']);
+});
+
+test('invalid versions return false', () => {
+  for (const v of ['1.2', '01.2.3', '1.02.3', '1.2.3-', '1.2.3-a..b', '1.2.3+', 'x.2.3', 'a.b.c', '', ' ', undefined, null, 123, {}]) {
+    assert.strictEqual(satisfies(v, '*'), false, `${String(v)} is invalid`);
+  }
+});
+
+test('invalid ranges return false', () => {
+  for (const r of ['>>1.2.3', '~>1.2.3', '1.2.3.4', '01.2', '1.x.3', '1.2-beta', 'abc', '1.2.3 -2.0.0', '>=1.2.3 || foo', undefined, null, 1]) {
+    assert.strictEqual(satisfies('1.2.3', r), false, `"${String(r)}" is invalid`);
+  }
+});
