 const assert = require('assert');
-const { capitalize } = require('../src/strings');
+const { capitalize, slugify } = require('../src/strings');
 
 test('capitalize first letter', () => assert.strictEqual(capitalize('hello'), 'Hello'));
 test('capitalize empty string', () => assert.strictEqual(capitalize(''), ''));
+
+test('slugify lowercases and joins words', () => assert.strictEqual(slugify('Hello World'), 'hello-world'));
+test('slugify removes Vietnamese diacritics', () =>
+  assert.strictEqual(slugify('Tiếng Việt có dấu'), 'tieng-viet-co-dau'));
+test('slugify maps đ and Đ to d', () => assert.strictEqual(slugify('Đường đi'), 'duong-di'));
+test('slugify removes other Latin diacritics', () =>
+  assert.strictEqual(slugify('Crème Brûlée à São Paulo'), 'creme-brulee-a-sao-paulo'));
+test('slugify collapses runs of other characters into one hyphen', () =>
+  assert.strictEqual(slugify('a  --  b!!!c_d/e'), 'a-b-c-d-e'));
+test('slugify trims leading and trailing hyphens', () => assert.strictEqual(slugify('  --Hi there!--  '), 'hi-there'));
+test('slugify keeps digits', () => assert.strictEqual(slugify('Version 2.0 (2024)'), 'version-2-0-2024'));
+test('slugify of empty or symbol-only text is empty', () => {
+  assert.strictEqual(slugify(''), '');
+  assert.strictEqual(slugify('!@#$%^&*'), '');
+});
+test('slugify caps length at 50', () => {
+  assert.strictEqual(slugify('a'.repeat(80)), 'a'.repeat(50));
+  assert.strictEqual(slugify('a'.repeat(50)), 'a'.repeat(50));
+});
+test('slugify cut at 50 does not end with a hyphen', () => {
+  // 49 letters then a separator: the cut lands right on the hyphen.
+  const slug = slugify('a'.repeat(49) + ' bcdef');
+  assert.strictEqual(slug, 'a'.repeat(49));
+});
+test('slugify cut at 50 counts the ASCII result, not the input', () => {
+  const slug = slugify('Đ'.repeat(60));
+  assert.strictEqual(slug, 'd'.repeat(50));
+});
