@@ -8,3 +8,23 @@ test('formats cents', () => assert.strictEqual(formatCents(1250), '12.50'));
 test('checkout sums items', () => {
   assert.deepStrictEqual(checkout({ id: 'o1', items: [{ sku: 'A', price: '2.50', qty: 2 }] }), { orderId: 'o1', totalCents: 500 });
