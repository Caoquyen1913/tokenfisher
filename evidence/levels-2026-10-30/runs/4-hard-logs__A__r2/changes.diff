+
+// Regression: prices with thousands separators (e.g. "1,299.00") crashed parseAmount
+// with "Cannot read properties of null" and caused intermittent 500s on POST /checkout.
+test('parses amounts with thousands separators', () => {
+  assert.strictEqual(parseAmount('1,299.00'), 129900);
+  assert.strictEqual(parseAmount('2,450.50'), 245050);
+  assert.strictEqual(parseAmount('1,005.99'), 100599);
+  assert.strictEqual(parseAmount('1,234,567'), 123456700);
+});
+test('rejects malformed amounts with a descriptive error', () => {
+  for (const bad of ['', 'abc', '1,29.00', '12,3456', '1.234', ',100']) {
+    assert.throws(() => parseAmount(bad), /^Error: Invalid amount: /);
+  }
+});
+test('checkout handles a price with a thousands separator', () => {
+  assert.deepStrictEqual(
+    checkout({ id: 'ord_14143', items: [{ sku: 'P-75', price: '1,005.99', qty: 3 }] }),
+    { orderId: 'ord_14143', totalCents: 301797 },
+  );
+});
