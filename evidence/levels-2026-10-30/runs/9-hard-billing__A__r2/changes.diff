diff --git a/test/charge.test.js b/test/charge.test.js
index 321f791..f4fbace 100644
--- a/test/charge.test.js
+++ b/test/charge.test.js
@@ -14,3 +14,29 @@ test('EUR invoice is charged in cents', () => {
   assert.strictEqual(p.amount, 9999);
   assert.strictEqual(p.idempotency_key, 'inv_i2');
 });
+
+// Regression: the lower-cased gateway code was used for the exponent lookup,
+// so zero-decimal currencies fell back to 2 decimals and were charged 100x.
+test('JPY invoice is charged in whole yen, not 100x', () => {
+  const p = buildChargePayload({ id: 'i3', number: 'INV-3', currency: 'JPY', total: 1500 }, customer);
+  assert.strictEqual(p.amount, 1500);
+  assert.strictEqual(p.currency, 'jpy');
+});
+
+test('KRW invoice is charged in whole won, not 100x', () => {
+  const p = buildChargePayload({ id: 'i4', number: 'INV-4', currency: 'KRW', total: 25000 }, customer);
+  assert.strictEqual(p.amount, 25000);
+  assert.strictEqual(p.currency, 'krw');
+});
+
+test('KWD invoice is charged in fils (3 decimals)', () => {
+  const p = buildChargePayload({ id: 'i5', number: 'INV-5', currency: 'KWD', total: 12.345 }, customer);
+  assert.strictEqual(p.amount, 12345);
+});
+
+test('minor-unit conversion ignores currency code case', () => {
+  const { toMinor } = require('../src/lib/money/minor');
+  assert.strictEqual(toMinor(1500, 'jpy'), 1500);
+  assert.strictEqual(toMinor(1500, 'JPY'), 1500);
+  assert.strictEqual(toMinor(12.5, 'usd'), 1250);
+});
