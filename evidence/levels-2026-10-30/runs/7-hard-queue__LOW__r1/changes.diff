diff --git a/test/queue.test.js b/test/queue.test.js
index be49570..e6aeada 100644
--- a/test/queue.test.js
+++ b/test/queue.test.js
@@ -15,3 +15,71 @@ test('starts jobs in order with concurrency 1', async () => {
   await Promise.all(['a', 'b', 'c'].map((x) => q.add(async () => { order.push(x); await sleep(1); })));
   assert.deepStrictEqual(order, ['a', 'b', 'c']);
 });
+
+test('keeps going after a job rejects', async () => {
+  const q = createQueue({ concurrency: 1 });
+  const failed = q.add(async () => { await sleep(1); throw new Error('boom'); });
+  const ok = q.add(async () => 'ok');
+  await assert.rejects(failed, /boom/);
+  assert.strictEqual(await ok, 'ok');
+  await q.onIdle();
+  assert.strictEqual(q.running, 0);
+  assert.strictEqual(q.pending, 0);
+});
+
+test('handles jobs that throw synchronously or return plain values', async () => {
+  const q = createQueue({ concurrency: 1 });
+  const thrown = q.add(() => { throw new Error('sync'); });
+  const plain = q.add(() => 42);
+  await assert.rejects(thrown, /sync/);
+  assert.strictEqual(await plain, 42);
+  await q.onIdle();
+  assert.strictEqual(q.running, 0);
+});
+
+test('onIdle waits for running jobs to finish', async () => {
+  const q = createQueue({ concurrency: 2 });
+  let done = 0;
+  q.add(async () => { await sleep(20); done++; });
+  q.add(async () => { await sleep(20); done++; });
+  await q.onIdle();
+  assert.strictEqual(done, 2);
+  assert.strictEqual(q.running, 0);
+});
+
+test('onIdle resolves immediately when already idle', async () => {
+  const q = createQueue();
+  await q.onIdle();
+});
+
+test('resume fills all free slots', async () => {
+  const q = createQueue({ concurrency: 4 });
+  q.pause();
+  let active = 0;
+  let maxActive = 0;
+  const jobs = Array.from({ length: 8 }, () => q.add(async () => {
+    active++;
+    maxActive = Math.max(maxActive, active);
+    await sleep(10);
+    active--;
+  }));
+  assert.strictEqual(q.pending, 8);
+  q.resume();
+  assert.strictEqual(q.running, 4);
+  await Promise.all(jobs);
+  assert.strictEqual(maxActive, 4);
+});
+
+test('pause lets running jobs finish but starts no new ones', async () => {
+  const q = createQueue({ concurrency: 2 });
+  const started = [];
+  const jobs = [1, 2, 3, 4].map((n) => q.add(async () => { started.push(n); await sleep(10); }));
+  q.pause();
+  await sleep(30);
+  assert.deepStrictEqual(started, [1, 2]);
+  assert.strictEqual(q.running, 0);
+  assert.strictEqual(q.pending, 2);
+  q.resume();
+  await Promise.all(jobs);
+  assert.deepStrictEqual(started, [1, 2, 3, 4]);
+});
