diff --git a/test/api.test.js b/test/api.test.js
index 3ef8a0b..9f38c3e 100644
--- a/test/api.test.js
+++ b/test/api.test.js
@@ -17,3 +17,37 @@ test('POST /stock rejects bad qty', () => {
   assert.deepStrictEqual(api({ method: 'POST', path: '/stock', body: { sku: 'x', qty: -1 } }), { status: 400, body: { error: 'INVALID_QTY' } });
 });
 test('unknown route is 404', () => assert.strictEqual(createApi(createStore())({ method: 'GET', path: '/nope' }).status, 404));
+
+function timedApi() {
+  let now = 0;
+  const api = createApi(createStore({ clock: () => now }));
+  api({ method: 'POST', path: '/stock', body: { sku: 'x', qty: 5 } });
+  return { api, advance: (ms) => { now += ms; } };
+}
+
+test('reservation lifecycle via API', () => {
+  const { api } = timedApi();
+  const res = api({ method: 'POST', path: '/reservations', body: { sku: 'x', qty: 2, ttlMs: 100 } });
+  assert.strictEqual(res.status, 201);
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/x' }).body, { sku: 'x', stock: 5, available: 3 });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${res.body.id}/confirm` }), { status: 200, body: { sku: 'x', stock: 3 } });
+  assert.strictEqual(api({ method: 'POST', path: `/reservations/${res.body.id}/confirm` }).status, 404);
+});
+test('POST /reservations errors', () => {
+  const { api } = timedApi();
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'x', qty: 6, ttlMs: 100 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'x', qty: 0, ttlMs: 100 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+});
+test('confirm expired reservation is 410', () => {
+  const { api, advance } = timedApi();
+  const { body } = api({ method: 'POST', path: '/reservations', body: { sku: 'x', qty: 1, ttlMs: 100 } });
+  advance(100);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${body.id}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('DELETE /reservations/:id releases and is idempotent', () => {
+  const { api } = timedApi();
+  const { body } = api({ method: 'POST', path: '/reservations', body: { sku: 'x', qty: 5, ttlMs: 100 } });
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${body.id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${body.id}` }).status, 204);
+  assert.strictEqual(api({ method: 'GET', path: '/stock/x' }).body.available, 5);
+});
diff --git a/test/store.test.js b/test/store.test.js
index 8b80ad0..e9d5643 100644
--- a/test/store.test.js
+++ b/test/store.test.js
@@ -27,3 +27,78 @@ test('quantities must be positive integers', () => {
   assert.throws(() => s.addItem('A', 0), /INVALID_QTY/);
   assert.throws(() => s.addItem('A', 1.5), /INVALID_QTY/);
 });
+
+function timed() {
+  let now = 1000;
+  const s = createStore({ clock: () => now });
+  return { s, advance: (ms) => { now += ms; } };
+}
+
+test('reserve reduces available but not physical stock', () => {
+  const { s } = timed();
+  s.addItem('A', 10);
+  const id = s.reserve('A', 4, 100);
+  assert.strictEqual(typeof id, 'string');
+  assert.notStrictEqual(id, s.reserve('A', 1, 100));
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('A'), 5);
+});
+test('reserve validates qty and availability', () => {
+  const { s } = timed();
+  s.addItem('A', 3);
+  assert.throws(() => s.reserve('A', 0, 100), /INVALID_QTY/);
+  assert.throws(() => s.reserve('A', 1.5, 100), /INVALID_QTY/);
+  assert.throws(() => s.reserve('A', 4, 100), /INSUFFICIENT_STOCK/);
+  s.reserve('A', 3, 100);
+  assert.throws(() => s.reserve('A', 1, 100), /INSUFFICIENT_STOCK/);
+});
+test('reservation expires at exactly creation + ttl', () => {
+  const { s, advance } = timed();
+  s.addItem('A', 5);
+  s.reserve('A', 5, 100);
+  advance(99);
+  assert.strictEqual(s.getAvailable('A'), 0);
+  advance(1);
+  assert.strictEqual(s.getAvailable('A'), 5);
+});
+test('confirm converts reservation into a sale', () => {
+  const { s } = timed();
+  s.addItem('A', 5);
+  const id = s.reserve('A', 2, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 3);
+  assert.strictEqual(s.getAvailable('A'), 3);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm errors for unknown, released and expired', () => {
+  const { s, advance } = timed();
+  s.addItem('A', 5);
+  assert.throws(() => s.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const r = s.reserve('A', 1, 100);
+  s.release(r);
+  assert.throws(() => s.confirm(r), /RESERVATION_NOT_FOUND/);
+  const e = s.reserve('A', 1, 100);
+  advance(100);
+  assert.throws(() => s.confirm(e), /RESERVATION_EXPIRED/);
+  assert.strictEqual(s.getStock('A'), 5);
+});
+test('release is idempotent and frees stock', () => {
+  const { s } = timed();
+  s.addItem('A', 5);
+  const id = s.reserve('A', 5, 100);
+  s.release(id);
+  s.release(id);
+  s.release('unknown');
+  assert.strictEqual(s.getAvailable('A'), 5);
+});
+test('removeItem cannot remove reserved stock', () => {
+  const { s, advance } = timed();
+  s.addItem('A', 5);
+  s.reserve('A', 3, 100);
+  assert.throws(() => s.removeItem('A', 3), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 2);
+  assert.strictEqual(s.getStock('A'), 3);
+  advance(100);
+  s.removeItem('A', 3);
+  assert.strictEqual(s.getStock('A'), 0);
+});
