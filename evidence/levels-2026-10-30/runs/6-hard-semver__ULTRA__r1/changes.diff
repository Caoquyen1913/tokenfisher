 // See docs/SPEC.md.
+const ID = '[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*';
+const NUM = '0|[1-9]\\d*';
+const FULL_RE = new RegExp(`^v?(${NUM})\\.(${NUM})\\.(${NUM})(?:-(${ID}))?(?:\\+${ID})?$`);
+const PARTIAL_RE = new RegExp(
+  `^v?(x|X|\\*|${NUM})(?:\\.(x|X|\\*|${NUM})(?:\\.(x|X|\\*|${NUM})(?:-(${ID}))?(?:\\+${ID})?)?)?$`
+);
+const OP_RE = /^(<=|>=|<|>|=|~|\^)?(.*)$/;
+const NEVER = { op: 'never' };
+
+const mk = (a, b, c, pre = []) => ({ n: [a, b, c], pre });
+
+function parseVersion(s) {
+  const m = typeof s === 'string' && FULL_RE.exec(s.trim());
+  if (!m) return null;
+  return mk(BigInt(m[1]), BigInt(m[2]), BigInt(m[3]), m[4] ? m[4].split('.') : []);
+}
+
+// Returns {n: [major, minor, patch] (null = wildcard), pre} or null.
+function parsePartial(s) {
+  const m = PARTIAL_RE.exec(s);
+  if (!m) return null;
+  const n = [1, 2, 3].map((i) => (m[i] === undefined || /^[xX*]$/.test(m[i]) ? null : BigInt(m[i])));
+  if (n[0] === null) n[1] = n[2] = null;
+  if (n[1] === null) n[2] = null;
+  if (m[4] && n[2] === null) return null;
+  return { n, pre: m[4] ? m[4].split('.') : [] };
+}
+
+function cmpId(a, b) {
+  const an = /^\d+$/.test(a);
+  const bn = /^\d+$/.test(b);
+  if (an && bn) {
+    const x = BigInt(a);
+    const y = BigInt(b);
+    return x < y ? -1 : x > y ? 1 : 0;
+  }
+  if (an) return -1;
+  if (bn) return 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function compare(a, b) {
+  for (let i = 0; i < 3; i++) {
+    if (a.n[i] !== b.n[i]) return a.n[i] < b.n[i] ? -1 : 1;
+  }
+  if (!a.pre.length && !b.pre.length) return 0;
+  if (!a.pre.length) return 1;
+  if (!b.pre.length) return -1;
+  const len = Math.min(a.pre.length, b.pre.length);
+  for (let i = 0; i < len; i++) {
+    const c = cmpId(a.pre[i], b.pre[i]);
+    if (c) return c;
+  }
+  return Math.sign(a.pre.length - b.pre.length);
+}
+
+const lower = (v) => ({ op: '>=', v });
+const upper = (v) => ({ op: '<', v });
+
+// Comparators for a partial version with no operator (also `=`, and `~`/`^` with wildcards).
+function xRange([M, m, p], pre) {
+  if (M === null) return [];
+  if (m === null) return [lower(mk(M, 0n, 0n)), upper(mk(M + 1n, 0n, 0n))];
+  if (p === null) return [lower(mk(M, m, 0n)), upper(mk(M, m + 1n, 0n))];
+  return [{ op: '=', v: mk(M, m, p, pre) }];
+}
+
+function desugar(op, { n: [M, m, p], pre }) {
+  const nz = (x) => (x === null ? 0n : x);
+  switch (op) {
+    case '':
+    case '=':
+      return xRange([M, m, p], pre);
+    case '>':
+      if (M === null) return [NEVER];
+      if (m === null) return [lower(mk(M + 1n, 0n, 0n))];
+      if (p === null) return [lower(mk(M, m + 1n, 0n))];
+      return [{ op: '>', v: mk(M, m, p, pre) }];
+    case '>=':
+      if (M === null) return [];
+      return [lower(mk(M, nz(m), nz(p), pre))];
+    case '<':
+      if (M === null) return [NEVER];
+      return [upper(mk(M, nz(m), nz(p), pre))];
+    case '<=':
+      if (M === null) return [];
+      if (m === null) return [upper(mk(M + 1n, 0n, 0n))];
+      if (p === null) return [upper(mk(M, m + 1n, 0n))];
+      return [{ op: '<=', v: mk(M, m, p, pre) }];
+    case '~':
+      if (M === null) return [];
+      if (m === null) return [lower(mk(M, 0n, 0n)), upper(mk(M + 1n, 0n, 0n))];
+      return [lower(mk(M, m, nz(p), pre)), upper(mk(M, m + 1n, 0n))];
+    case '^':
+      if (M === null) return [];
+      if (m === null) return [lower(mk(M, 0n, 0n)), upper(mk(M + 1n, 0n, 0n))];
+      if (M > 0n) return [lower(mk(M, m, nz(p), pre)), upper(mk(M + 1n, 0n, 0n))];
+      if (m > 0n || p === null) return [lower(mk(0n, m, nz(p), pre)), upper(mk(0n, m + 1n, 0n))];
+      return [lower(mk(0n, 0n, p, pre)), upper(mk(0n, 0n, p + 1n))];
+    default:
+      return null;
+  }
+}
+
+function hyphen(a, b) {
+  const A = parsePartial(a);
+  const B = parsePartial(b);
+  if (!A || !B) return null;
+  const out = [];
+  if (A.n[0] !== null) out.push(lower(mk(A.n[0], A.n[1] ?? 0n, A.n[2] ?? 0n, A.pre)));
+  const [M, m, p] = B.n;
+  if (M === null) return out;
+  if (m === null) out.push(upper(mk(M + 1n, 0n, 0n)));
+  else if (p === null) out.push(upper(mk(M, m + 1n, 0n)));
+  else out.push({ op: '<=', v: mk(M, m, p, B.pre) });
+  return out;
+}
+
+// Parses one comparator set into a list of primitive comparators, or null if invalid.
+function parseSet(src) {
+  const tokens = src.replace(/(<=|>=|<|>|=|~|\^)\s+/g, '$1').split(/\s+/).filter(Boolean);
+  const out = [];
+  for (let i = 0; i < tokens.length; i++) {
+    let cs;
+    if (tokens[i + 1] === '-') {
+      if (i + 2 >= tokens.length) return null;
+      cs = hyphen(tokens[i], tokens[i + 2]);
+      i += 2;
+    } else {
+      const [, op = '', rest] = OP_RE.exec(tokens[i]);
+      const P = parsePartial(rest);
+      cs = P && desugar(op, P);
+    }
+    if (!cs) return null;
+    out.push(...cs);
+  }
+  return out;
+}
+
+function test(v, c) {
+  switch (c.op) {
+    case '=': return compare(v, c.v) === 0;
+    case '>': return compare(v, c.v) > 0;
+    case '>=': return compare(v, c.v) >= 0;
+    case '<': return compare(v, c.v) < 0;
+    case '<=': return compare(v, c.v) <= 0;
+    default: return false;
+  }
+}
+
+function satisfiesSet(v, set) {
+  if (!set.every((c) => test(v, c))) return false;
+  if (!v.pre.length) return true;
+  return set.some((c) => c.v && c.v.pre.length && c.v.n.every((x, i) => x === v.n[i]));
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    const v = parseVersion(version);
+    if (!v || typeof range !== 'string') return false;
+    const sets = range.split('||').map(parseSet);
+    if (sets.some((s) => s === null)) return false;
+    return sets.some((s) => satisfiesSet(v, s));
+  } catch (e) {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
