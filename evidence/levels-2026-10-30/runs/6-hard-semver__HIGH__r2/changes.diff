 // See docs/SPEC.md.
+const NUM = '0|[1-9]\\d*';
+const PRE = '[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*';
+const FULL_RE = new RegExp(`^v?(${NUM})\\.(${NUM})\\.(${NUM})(?:-(${PRE}))?(?:\\+(${PRE}))?$`);
+const X = `x|X|\\*|${NUM}`;
+const PARTIAL_RE = new RegExp(`^v?(${X})(?:\\.(${X})(?:\\.(${X})(?:-(${PRE}))?(?:\\+(${PRE}))?)?)?$`);
+const OP_RE = /^(<=|>=|<|>|=|~|\^)?(.*)$/;
+const BARE_OP_RE = /^(?:<=|>=|<|>|=|~|\^)$/;
+
+function parseVersion(str) {
+  const m = FULL_RE.exec(str);
+  if (!m) return null;
+  return {
+    major: BigInt(m[1]),
+    minor: BigInt(m[2]),
+    patch: BigInt(m[3]),
+    pre: m[4] ? m[4].split('.') : [],
+  };
+}
+
+function cmpIdent(a, b) {
+  const an = /^\d+$/.test(a);
+  const bn = /^\d+$/.test(b);
+  if (an && bn) {
+    const x = BigInt(a);
+    const y = BigInt(b);
+    return x < y ? -1 : x > y ? 1 : 0;
+  }
+  if (an) return -1;
+  if (bn) return 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function cmpTuple(a, b) {
+  for (const k of ['major', 'minor', 'patch']) {
+    if (a[k] !== b[k]) return a[k] < b[k] ? -1 : 1;
+  }
+  return 0;
+}
+
+function compare(a, b) {
+  const t = cmpTuple(a, b);
+  if (t) return t;
+  if (!a.pre.length && !b.pre.length) return 0;
+  if (!a.pre.length) return 1;
+  if (!b.pre.length) return -1;
+  const n = Math.min(a.pre.length, b.pre.length);
+  for (let i = 0; i < n; i++) {
+    const c = cmpIdent(a.pre[i], b.pre[i]);
+    if (c) return c;
+  }
+  return a.pre.length === b.pre.length ? 0 : a.pre.length < b.pre.length ? -1 : 1;
+}
+
+// Partial version: parts are BigInt, or null for a wildcard / missing position.
+// Once a position is a wildcard, every later one is too.
+function parsePartial(str) {
+  const m = PARTIAL_RE.exec(str);
+  if (!m) return null;
+  const parts = [];
+  let wild = false;
+  for (let i = 1; i <= 3; i++) {
+    const s = m[i];
+    if (wild || s === undefined || s === 'x' || s === 'X' || s === '*') {
+      wild = true;
+      parts.push(null);
+    } else {
+      parts.push(BigInt(s));
+    }
+  }
+  if (m[4] !== undefined && parts[2] === null) return null;
+  return { parts, pre: m[4] ? m[4].split('.') : [] };
+}
+
+const ver = (major, minor, patch, pre = []) => ({ major, minor, patch, pre });
+const ge = (v) => ({ op: '>=', v });
+const lt = (v) => ({ op: '<', v });
+
+// Lower bound with missing positions filled with zeros.
+function lower(p) {
+  const [a, b, c] = p.parts;
+  return ver(a ?? 0n, b ?? 0n, c ?? 0n, p.pre);
+}
+
+// Exclusive upper bound that bumps the position at `idx` (0 major, 1 minor, 2 patch).
+function bump(p, idx) {
+  const [a, b, c] = p.parts;
+  if (idx === 0) return ver(a + 1n, 0n, 0n);
+  if (idx === 1) return ver(a, b + 1n, 0n);
+  return ver(a, b, c + 1n);
+}
+
+// Index of the last specified position, or -1 for a fully wildcard version.
+function specified(p) {
+  return p.parts.findIndex((x) => x === null) === -1 ? 2 : p.parts.findIndex((x) => x === null) - 1;
+}
+
+// X-range / exact: the version itself, widened over wildcard positions.
+function range(p) {
+  const n = specified(p);
+  if (n < 0) return [];
+  if (n === 2) return [{ op: '=', v: lower(p) }];
+  return [ge(lower(p)), lt(bump(p, n))];
+}
+
+function tilde(p) {
+  const n = specified(p);
+  if (n < 0) return [];
+  return [ge(lower(p)), lt(bump(p, n === 0 ? 0 : 1))];
+}
+
+function caret(p) {
+  const n = specified(p);
+  if (n < 0) return [];
+  const [a, b] = p.parts;
+  let idx;
+  if (a > 0n) idx = 0;
+  else if (n === 0) idx = 0;
+  else if (b > 0n) idx = 1;
+  else if (n === 1) idx = 1;
+  else idx = 2;
+  return [ge(lower(p)), lt(bump(p, idx))];
+}
+
+const NONE = [lt(ver(0n, 0n, 0n))];
+
+function primitive(op, p) {
+  const n = specified(p);
+  switch (op) {
+    case '':
+    case '=':
+      return range(p);
+    case '~':
+      return tilde(p);
+    case '^':
+      return caret(p);
+    case '>':
+      if (n < 0) return NONE;
+      return n === 2 ? [{ op: '>', v: lower(p) }] : [ge(bump(p, n))];
+    case '>=':
+      return n < 0 ? [] : [ge(lower(p))];
+    case '<':
+      return n < 0 ? NONE : [lt(lower(p))];
+    case '<=':
+      if (n < 0) return [];
+      return n === 2 ? [{ op: '<=', v: lower(p) }] : [lt(bump(p, n))];
+    default:
+      return null;
+  }
+}
+
+function hyphen(a, b) {
+  const pa = parsePartial(a);
+  const pb = parsePartial(b);
+  if (!pa || !pb) return null;
+  const out = [];
+  if (specified(pa) >= 0) out.push(ge(lower(pa)));
+  const n = specified(pb);
+  if (n === 2) out.push({ op: '<=', v: lower(pb) });
+  else if (n >= 0) out.push(lt(bump(pb, n)));
+  return out;
+}
+
+// Returns an array of comparators ({op, v}), or null if the set is invalid.
+function parseSet(str) {
+  const tokens = str.trim() === '' ? [] : str.trim().split(/\s+/);
+  const items = [];
+  for (let i = 0; i < tokens.length; i++) {
+    if (tokens[i] === '-') {
+      const prev = items.pop();
+      if (typeof prev !== 'string' || i + 1 >= tokens.length) return null;
+      items.push({ a: prev, b: tokens[++i] });
+    } else {
+      items.push(tokens[i]);
+    }
+  }
+  const comparators = [];
+  for (let i = 0; i < items.length; i++) {
+    const item = items[i];
+    let prims;
+    if (typeof item === 'object') {
+      prims = hyphen(item.a, item.b);
+    } else {
+      let tok = item;
+      if (BARE_OP_RE.test(tok)) {
+        if (i + 1 >= items.length || typeof items[i + 1] !== 'string') return null;
+        tok += items[++i];
+      }
+      const [, op = '', rest] = OP_RE.exec(tok);
+      const p = parsePartial(rest);
+      prims = p && primitive(op, p);
+    }
+    if (!prims) return null;
+    comparators.push(...prims);
+  }
+  return comparators;
+}
+
+function test(c, v) {
+  const r = compare(v, c.v);
+  switch (c.op) {
+    case '>': return r > 0;
+    case '>=': return r >= 0;
+    case '<': return r < 0;
+    case '<=': return r <= 0;
+    default: return r === 0;
+  }
+}
+
+function matchesSet(comparators, v) {
+  if (!comparators.every((c) => test(c, v))) return false;
+  if (!v.pre.length) return true;
+  return comparators.some((c) => c.v.pre.length && cmpTuple(c.v, v) === 0);
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    if (typeof version !== 'string' || typeof range !== 'string') return false;
+    const v = parseVersion(version.trim());
+    if (!v) return false;
+    const sets = range.split('||').map(parseSet);
+    if (sets.some((s) => s === null)) return false;
+    return sets.some((s) => matchesSet(s, v));
+  } catch (e) {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
