+const assert = require('assert');
+const { satisfies } = require('../src/semver');
+
+const yes = (v, r) => assert.strictEqual(satisfies(v, r), true, `${v} should satisfy "${r}"`);
+const no = (v, r) => assert.strictEqual(satisfies(v, r), false, `${v} should not satisfy "${r}"`);
+
+test('versions: v prefix, whitespace, build ignored', () => {
+  yes('v1.2.3', '1.2.3');
+  yes('  1.2.3  ', ' =1.2.3 ');
+  yes('1.2.3+build.5', '1.2.3+other');
+  yes('1.2.3+build', '>=1.2.3 <1.2.4');
+});
+
+test('invalid input returns false and never throws', () => {
+  for (const v of ['', '1', '1.2', '01.2.3', '1.02.3', '1.2.3-', '1.2.3-a..b', '1.2.x', 'abc', '1.2.3 4', null, undefined, 5]) no(v, '*');
+  for (const r of ['foo', '>=', '>= foo', '1.2.3 -', '- 1.2.3', '1.2.3 - 2 - 3', '>1.2.3 - 2', '01.2.3', '1.x.3-beta', '||foo', '>>1', '~>1', null, undefined, 5]) no('1.2.3', r);
+});
+
+test('ordering of comparators', () => {
+  yes('1.2.3', '>=1.2.3');
+  no('1.2.3', '>1.2.3');
+  yes('1.10.0', '>1.9.9');
+  yes('1.2.3', '<=1.2.3');
+  no('1.2.3', '<1.2.3');
+  yes('1.2.3', '>= 1.2.3');
+  yes('1.2.3', '> 1.2.2 < 1.2.4');
+  yes('1.0.0', '1.0.0');
+  no('1.0.1', '=1.0.0');
+});
+
+test('prerelease ordering', () => {
+  yes('1.0.0', '>1.0.0-rc.1');
+  yes('1.0.0-rc.1', '<1.0.0-rc.1 || 1.0.0-rc.1');
+  yes('1.0.0-alpha.1', '>1.0.0-alpha');
+  no('1.0.0-alpha', '>1.0.0-alpha.1');
+  yes('1.0.0-alpha.2', '>1.0.0-alpha.1');
+  yes('1.0.0-alpha.10', '>1.0.0-alpha.9');
+  yes('1.0.0-alpha', '>1.0.0-1');
+  yes('1.0.0-beta', '>1.0.0-alpha');
+  yes('1.0.0-b', '>1.0.0-B');
+  yes('1.0.0-alpha.beta', '>1.0.0-alpha.1');
+  no('1.0.0-rc.1', '>=1.0.0');
+});
+
+test('|| and AND', () => {
+  yes('2.0.0', '1.x || 2.x');
+  no('3.0.0', '1.x || 2.x');
+  yes('1.5.0', '<1.0.0 || >=1.5.0 <2.0.0');
+  yes('5.0.0', '');
+  yes('5.0.0', '   ');
+  yes('5.0.0', '1.0.0 || ');
+});
+
+test('x-ranges', () => {
+  for (const r of ['*', 'x', 'X', '', '>=*', '<=*']) yes('9.9.9', r);
+  no('9.9.9', '<*');
+  no('9.9.9', '>*');
+  yes('1.9.9', '1');
+  yes('1.9.9', '1.x');
+  yes('1.9.9', '1.X.x');
+  no('2.0.0', '1');
+  no('0.9.9', '1.*');
+  yes('1.2.9', '1.2');
+  yes('1.2.9', '1.2.x');
+  no('1.3.0', '1.2');
+  yes('1.2.9', '=1.2');
+});
+
+test('x-ranges with operators', () => {
+  no('1.9.9', '>1');
+  yes('2.0.0', '>1');
+  no('1.2.9', '>1.2');
+  yes('1.3.0', '>1.2');
+  yes('1.0.0', '>=1');
+  no('0.9.9', '>=1');
+  yes('1.2.0', '>=1.2');
+  no('1.0.0', '<1');
+  yes('0.9.9', '<1');
+  no('1.2.0', '<1.2');
+  yes('1.1.9', '<1.2');
+  yes('1.9.9', '<=1');
+  no('2.0.0', '<=1');
+  yes('1.2.9', '<=1.2');
+  no('1.3.0', '<=1.2');
+});
+
+test('tilde', () => {
+  yes('1.2.3', '~1.2.3');
+  yes('1.2.9', '~1.2.3');
+  no('1.3.0', '~1.2.3');
+  no('1.2.2', '~1.2.3');
+  yes('1.2.0', '~1.2');
+  no('1.3.0', '~1.2');
+  yes('1.9.0', '~1');
+  no('2.0.0', '~1');
+  yes('1.2.3-beta.2', '~1.2.3-beta.2');
+  yes('1.2.3-beta.4', '~1.2.3-beta.2');
+  yes('1.2.5', '~1.2.3-beta.2');
+  no('1.3.0', '~1.2.3-beta.2');
+  yes('1.2.0', '~ 1.2');
+  yes('3.0.0', '~*');
+});
+
+test('caret', () => {
+  yes('1.9.9', '^1.2.3');
+  no('2.0.0', '^1.2.3');
+  no('1.2.2', '^1.2.3');
+  yes('0.2.9', '^0.2.3');
+  no('0.3.0', '^0.2.3');
+  yes('0.0.3', '^0.0.3');
+  no('0.0.4', '^0.0.3');
+  yes('1.9.0', '^1.2');
+  yes('1.9.0', '^1');
+  no('2.0.0', '^1');
+  yes('0.2.9', '^0.2');
+  no('0.3.0', '^0.2');
+  yes('0.0.9', '^0.0');
+  no('0.1.0', '^0.0');
+  yes('0.9.9', '^0');
+  no('1.0.0', '^0');
+  yes('0.9.9', '^0.x');
+  no('1.0.0', '^0.x');
+  yes('1.2.3-beta.2', '^1.2.3-beta.2');
+  yes('1.5.0', '^1.2.3-beta.2');
+  no('2.0.0', '^1.2.3-beta.2');
+  yes('1.2.3', '^ 1.2.3');
+});
+
+test('hyphen ranges', () => {
+  yes('1.2.3', '1.2.3 - 2.3.4');
+  yes('2.3.4', '1.2.3 - 2.3.4');
+  no('2.3.5', '1.2.3 - 2.3.4');
+  no('1.2.2', '1.2.3 - 2.3.4');
+  yes('1.2.0', '1.2 - 2.3.4');
+  no('1.1.9', '1.2 - 2.3.4');
+  yes('2.3.9', '1.2.3 - 2.3');
+  no('2.4.0', '1.2.3 - 2.3');
+  yes('2.9.9', '1.2.3 - 2');
+  no('3.0.0', '1.2.3 - 2');
+  yes('1.5.0', 'v1.2.3 - v2.3.4');
+  yes('1.5.0', '1.2.3 - 2.3.4 || 5.0.0');
+  yes('5.0.0', '1.2.3 - 2.3.4 || 5.0.0');
+});
+
+test('prerelease rule', () => {
+  yes('1.2.3-alpha.7', '>1.2.3-alpha.3');
+  no('3.4.5-alpha.9', '>1.2.3-alpha.3');
+  no('1.2.4-beta', '^1.2.3');
+  no('1.2.4-beta', '*');
+  no('1.0.0-alpha', '');
+  no('1.0.0-alpha', '>=0.0.0');
+  yes('1.2.3-alpha.7', '>1.2.3-alpha.3 <2.0.0');
+  no('1.2.3-alpha.7', '>1.2.3-alpha.3 <1.2.3-alpha.5');
+  yes('1.2.3-alpha.4', '>1.2.3-alpha.3 <1.2.3-alpha.5');
+  yes('1.2.3-beta', '1.2.3-beta');
+  no('1.2.3-beta', '1.2.3');
+  no('1.2.3-beta', '^1.2.3');
+  yes('1.2.3-beta.3', '^1.2.3-beta.2');
+  no('1.2.4-beta.3', '^1.2.3-beta.2');
+  // the rule applies per comparator set
+  yes('1.2.4-beta', '^1.2.3 || >=1.2.4-alpha <1.2.5');
+  no('1.2.4-beta', '^1.2.3 || >=1.2.5-alpha');
+  no('1.2.3-alpha', '>=1.2.3-beta || ^1.2.4');
+});
