diff --git a/test/queue.test.js b/test/queue.test.js
index be49570..639df1e 100644
--- a/test/queue.test.js
+++ b/test/queue.test.js
@@ -15,3 +15,78 @@ test('starts jobs in order with concurrency 1', async () => {
   await Promise.all(['a', 'b', 'c'].map((x) => q.add(async () => { order.push(x); await sleep(1); })));
   assert.deepStrictEqual(order, ['a', 'b', 'c']);
 });
+
+test('a failing job rejects only its own promise and the queue keeps going', async () => {
+  const q = createQueue({ concurrency: 1 });
+  const failing = q.add(async () => { await sleep(1); throw new Error('boom'); });
+  const after = q.add(async () => 'ok');
+  await assert.rejects(failing, /boom/);
+  assert.strictEqual(await after, 'ok');
+  await q.onIdle();
+  assert.strictEqual(q.running, 0);
+  assert.strictEqual(q.pending, 0);
+});
+
+test('handles jobs that throw synchronously or return plain values', async () => {
+  const q = createQueue({ concurrency: 1 });
+  const thrower = q.add(() => { throw new Error('sync'); });
+  const plain = q.add(() => 42);
+  await assert.rejects(thrower, /sync/);
+  assert.strictEqual(await plain, 42);
+  await q.onIdle();
+  assert.strictEqual(q.running, 0);
+});
+
+test('onIdle waits for running jobs, not just an empty pending list', async () => {
+  const q = createQueue({ concurrency: 2 });
+  let done = 0;
+  q.add(async () => { await sleep(10); done++; });
+  q.add(async () => { await sleep(30); done++; });
+  await q.onIdle();
+  assert.strictEqual(done, 2);
+  assert.strictEqual(q.running, 0);
+});
+
+test('onIdle resolves immediately when already idle', async () => {
+  const q = createQueue();
+  await q.onIdle();
+});
+
+test('never runs more than `concurrency` jobs at once', async () => {
+  const q = createQueue({ concurrency: 3 });
+  let active = 0;
+  let peak = 0;
+  const job = async () => { active++; peak = Math.max(peak, active); await sleep(5); active--; };
+  await Promise.all(Array.from({ length: 10 }, () => q.add(job)));
+  assert.strictEqual(peak, 3);
+});
+
+test('resume() fills every free slot', async () => {
+  const q = createQueue({ concurrency: 4 });
+  q.pause();
+  let active = 0;
+  let peak = 0;
+  const jobs = Array.from({ length: 8 }, () => q.add(async () => { active++; peak = Math.max(peak, active); await sleep(10); active--; }));
+  assert.strictEqual(q.pending, 8);
+  assert.strictEqual(q.running, 0);
+  q.resume();
+  assert.strictEqual(q.running, 4);
+  assert.strictEqual(q.pending, 4);
+  await Promise.all(jobs);
+  assert.strictEqual(peak, 4);
+});
+
+test('pause() lets running jobs finish but starts no new ones', async () => {
+  const q = createQueue({ concurrency: 2 });
+  const started = [];
+  const jobs = [1, 2, 3, 4].map((n) => q.add(async () => { started.push(n); await sleep(5); }));
+  q.pause();
+  await Promise.all(jobs.slice(0, 2));
+  await sleep(10);
+  assert.deepStrictEqual(started, [1, 2]);
+  assert.strictEqual(q.running, 0);
+  assert.strictEqual(q.pending, 2);
+  q.resume();
+  await Promise.all(jobs);
+  assert.deepStrictEqual(started, [1, 2, 3, 4]);
+});
