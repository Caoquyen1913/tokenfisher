 // See docs/SPEC.md.
+const NUM = '0|[1-9]\\d*';
+const IDS = '[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*';
+const VERSION_RE = new RegExp(`^v?(${NUM})\\.(${NUM})\\.(${NUM})(?:-(${IDS}))?(?:\\+${IDS})?$`);
+const PARTIAL_RE = new RegExp(
+  `^v?(${NUM}|[xX*])(?:\\.(${NUM}|[xX*])(?:\\.(${NUM}|[xX*])(?:-(${IDS}))?(?:\\+${IDS})?)?)?$`
+);
+
+function parseVersion(str) {
+  const m = VERSION_RE.exec(String(str).trim());
+  if (!m) return null;
+  return { major: BigInt(m[1]), minor: BigInt(m[2]), patch: BigInt(m[3]), pre: m[4] ? m[4].split('.') : [] };
+}
+
+const cmp = (a, b) => (a < b ? -1 : a > b ? 1 : 0);
+
+function compareIds(a, b) {
+  const an = /^\d+$/.test(a);
+  const bn = /^\d+$/.test(b);
+  if (an && bn) return cmp(BigInt(a), BigInt(b));
+  if (an) return -1;
+  if (bn) return 1;
+  return cmp(a, b);
+}
+
+function compareVersions(a, b) {
+  for (const k of ['major', 'minor', 'patch']) {
+    const c = cmp(a[k], b[k]);
+    if (c) return c;
+  }
+  // A release is greater than any of its prereleases.
+  if (!a.pre.length && b.pre.length) return 1;
+  if (a.pre.length && !b.pre.length) return -1;
+  for (let i = 0; i < Math.min(a.pre.length, b.pre.length); i++) {
+    const c = compareIds(a.pre[i], b.pre[i]);
+    if (c) return c;
+  }
+  return cmp(a.pre.length, b.pre.length);
+}
+
+const ver = (major, minor, patch, pre = []) => ({ major, minor, patch, pre });
+
+// Parses a possibly partial version; null if invalid. Missing/wildcard parts are null.
+function parsePartial(str) {
+  const m = PARTIAL_RE.exec(str);
+  if (!m) return null;
+  const parts = [m[1], m[2], m[3]].map((p) => (p === undefined || /^[xX*]$/.test(p) ? null : BigInt(p)));
+  // Once a position is a wildcard or missing, the following ones must be too.
+  for (let i = 1; i < 3; i++) {
+    if (parts[i - 1] === null && parts[i] !== null) return null;
+  }
+  if (m[4] !== undefined && parts[2] === null) return null;
+  return { major: parts[0], minor: parts[1], patch: parts[2], pre: m[4] ? m[4].split('.') : [] };
+}
+
+const NEVER = [{ op: '<', v: ver(0n, 0n, 0n) }, { op: '>', v: ver(0n, 0n, 0n) }];
+const lower = (v) => ({ op: '>=', v });
+const upper = (v) => ({ op: '<', v });
+
+// Comparators for `>=A <B` style bounds covering all of a partial version.
+function xRange(p) {
+  if (p.major === null) return [];
+  if (p.minor === null) return [lower(ver(p.major, 0n, 0n)), upper(ver(p.major + 1n, 0n, 0n))];
+  if (p.patch === null) return [lower(ver(p.major, p.minor, 0n)), upper(ver(p.major, p.minor + 1n, 0n))];
+  return [{ op: '=', v: ver(p.major, p.minor, p.patch, p.pre) }];
+}
+
+function lowerOf(p) {
+  return ver(p.major ?? 0n, p.minor ?? 0n, p.patch ?? 0n, p.pre);
+}
+
+function tilde(p) {
+  if (p.major === null) return [];
+  const lo = lower(lowerOf(p));
+  if (p.minor === null) return [lo, upper(ver(p.major + 1n, 0n, 0n))];
+  return [lo, upper(ver(p.major, p.minor + 1n, 0n))];
+}
+
+function caret(p) {
+  if (p.major === null) return [];
+  const lo = lower(lowerOf(p));
+  let hi;
+  if (p.major > 0n) hi = ver(p.major + 1n, 0n, 0n);
+  else if (p.minor === null) hi = ver(1n, 0n, 0n);
+  else if (p.patch === null || p.minor > 0n) hi = ver(0n, p.minor + 1n, 0n);
+  else hi = ver(0n, 0n, p.patch + 1n);
+  return [lo, upper(hi)];
+}
+
+function withOperator(op, p) {
+  if (op === '' || op === '=') return xRange(p);
+  const full = p.major !== null && p.minor !== null && p.patch !== null;
+  if (full) return [{ op, v: lowerOf(p) }];
+  if (p.major === null) return op === '>=' || op === '<=' ? [] : NEVER;
+  const next = p.minor === null ? ver(p.major + 1n, 0n, 0n) : ver(p.major, p.minor + 1n, 0n);
+  switch (op) {
+    case '>': return [lower(next)];
+    case '>=': return [lower(lowerOf(p))];
+    case '<': return [upper(lowerOf(p))];
+    default: return [upper(next)]; // '<='
+  }
+}
+
+function hyphen(a, b) {
+  const out = [];
+  if (a.major !== null) out.push(lower(lowerOf(a)));
+  if (b.major !== null) {
+    if (b.minor !== null && b.patch !== null) out.push({ op: '<=', v: lowerOf(b) });
+    else if (b.minor === null) out.push(upper(ver(b.major + 1n, 0n, 0n)));
+    else out.push(upper(ver(b.major, b.minor + 1n, 0n)));
+  }
+  return out;
+}
+
+// Returns an array of comparators ({op, v}) or null if the set is invalid.
+function parseSet(set) {
+  const tokens = set
+    .replace(/(>=|<=|>|<|=)\s+(?=[^<>=\s])/g, '$1')
+    .split(/\s+/)
+    .filter(Boolean);
+  const out = [];
+  for (let i = 0; i < tokens.length; i++) {
+    const t = tokens[i];
+    if (tokens[i + 1] === '-') {
+      const a = parsePartial(t);
+      const b = tokens[i + 2] === undefined ? null : parsePartial(tokens[i + 2]);
+      if (!a || !b) return null;
+      out.push(...hyphen(a, b));
+      i += 2;
+      continue;
+    }
+    const m = /^(>=|<=|>|<|=|~|\^)?(.*)$/.exec(t);
+    const p = parsePartial(m[2]);
+    if (!p) return null;
+    if (m[1] === '~') out.push(...tilde(p));
+    else if (m[1] === '^') out.push(...caret(p));
+    else out.push(...withOperator(m[1] || '', p));
+  }
+  return out;
+}
+
+function matches(v, { op, v: c }) {
+  const r = compareVersions(v, c);
+  switch (op) {
+    case '>': return r > 0;
+    case '>=': return r >= 0;
+    case '<': return r < 0;
+    case '<=': return r <= 0;
+    default: return r === 0;
+  }
+}
+
+function satisfiesSet(v, comps) {
+  if (!comps.every((c) => matches(v, c))) return false;
+  if (!v.pre.length) return true;
+  return comps.some(
+    (c) => c.v.pre.length && c.v.major === v.major && c.v.minor === v.minor && c.v.patch === v.patch
+  );
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    if (typeof version !== 'string' || typeof range !== 'string') return false;
+    const v = parseVersion(version);
+    if (!v) return false;
+    const sets = range.split('||').map(parseSet);
+    if (sets.some((s) => s === null)) return false;
+    return sets.some((s) => satisfiesSet(v, s));
+  } catch (e) {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
