@@ -3,3 +3,35 @@ const { capitalize } = require('../src/strings');
 
 test('capitalize first letter', () => assert.strictEqual(capitalize('hello'), 'Hello'));
 test('capitalize empty string', () => assert.strictEqual(capitalize(''), ''));
+
+const { slugify } = require('../src/strings');
+
+test('slugify lowercases and hyphenates', () => assert.strictEqual(slugify('Hello World'), 'hello-world'));
+test('slugify removes Vietnamese diacritics', () =>
+  assert.strictEqual(slugify('Tiếng Việt có dấu'), 'tieng-viet-co-dau'));
+test('slugify maps đ and Đ to d', () => assert.strictEqual(slugify('Đường đi'), 'duong-di'));
+test('slugify removes other Latin diacritics', () =>
+  assert.strictEqual(slugify('Crème Brûlée à la Señor Ångström'), 'creme-brulee-a-la-senor-angstrom'));
+test('slugify folds non-decomposing Latin letters', () =>
+  assert.strictEqual(slugify('Straße Øl Łódź Æon'), 'strasse-ol-lodz-aeon'));
+test('slugify collapses runs of other characters to one hyphen', () =>
+  assert.strictEqual(slugify('a  --__!!  b...c'), 'a-b-c'));
+test('slugify trims leading and trailing hyphens', () => assert.strictEqual(slugify('  --Hello!-- '), 'hello'));
+test('slugify keeps digits', () => assert.strictEqual(slugify('Version 2.0 (2024)'), 'version-2-0-2024'));
+test('slugify returns empty for no slug characters', () => {
+  assert.strictEqual(slugify(''), '');
+  assert.strictEqual(slugify('!!! ---'), '');
+  assert.strictEqual(slugify('日本語'), '');
+});
+test('slugify caps length at 50', () => {
+  const s = slugify('a'.repeat(80));
+  assert.strictEqual(s, 'a'.repeat(50));
+});
+test('slugify cut at 50 does not end with a hyphen', () => {
+  // 49 letters then a space: the 50th slug character would be a hyphen.
+  const s = slugify('a'.repeat(49) + ' bcd');
+  assert.strictEqual(s, 'a'.repeat(49));
+  assert.ok(s.length <= 50 && !s.endsWith('-'));
+});
+test('slugify cut at 50 keeps exactly 50 when the cut lands mid-word', () =>
+  assert.strictEqual(slugify('a'.repeat(48) + ' bcd'), 'a'.repeat(48) + '-b'));
