+
+// Frozen copy of the original (pre-optimization) summarize: the exact-output oracle.
+function referenceSummarize(orders, limit = 10) {
+  const byRank = (a, b) => {
+    if (a.spendCents !== b.spendCents) return b.spendCents - a.spendCents;
+    if (a.firstOrderAt !== b.firstOrderAt) return a.firstOrderAt < b.firstOrderAt ? -1 : 1;
+    return a.customerId < b.customerId ? -1 : a.customerId > b.customerId ? 1 : 0;
+  };
+  const seen = [];
+  const groups = [];
+  for (const o of orders) {
+    if (seen.includes(o.id)) continue;
+    seen.push(o.id);
+    if (o.status === 'refunded') continue;
+    let g = groups.find((x) => x.customerId === o.customerId);
+    if (!g) {
+      g = { customerId: o.customerId, spendCents: 0, orderCount: 0, firstOrderAt: o.createdAt };
+      groups.push(g);
+    }
+    g.orderCount++;
+    if (o.createdAt < g.firstOrderAt) g.firstOrderAt = o.createdAt;
+    if (o.status === 'paid') g.spendCents += o.currency === 'EUR' ? Math.round(o.amountCents * 1.08) : o.amountCents;
+    groups.sort(byRank);
+  }
+  return groups.filter((g) => g.spendCents > 0).slice(0, limit).map((g, i) => ({ rank: i + 1, ...g }));
+}
+
+// Deterministic PRNG so failures are reproducible.
+function rng(seed) {
+  return () => { seed = (seed * 1103515245 + 12345) % 2147483648; return seed / 2147483648; };
+}
+
+function randomOrders(rand, n, customers) {
+  const statuses = ['paid', 'paid', 'paid', 'pending', 'refunded', 'failed'];
+  const pick = (xs) => xs[Math.floor(rand() * xs.length)];
+  const orders = [];
+  for (let i = 0; i < n; i++) {
+    if (orders.length && rand() < 0.1) { orders.push({ ...pick(orders), status: pick(statuses) }); continue; } // retried id
+    orders.push(order(
+      `o${i}`,
+      `cus_${Math.floor(rand() * customers)}`,
+      pick(statuses),
+      pick([0, 100, 250, 999, 1000, Math.floor(rand() * 5000)]), // few distinct amounts -> spend ties
+      `2026-10-0${1 + Math.floor(rand() * 3)}T0${Math.floor(rand() * 3)}:00:00Z`, // few distinct times -> date ties
+      rand() < 0.3 ? 'EUR' : 'USD',
+    ));
+  }
+  return orders;
+}
+
+test('matches the original implementation exactly (ranking, ties, dedup, refunds, EUR)', () => {
+  const rand = rng(42);
+  for (let round = 0; round < 300; round++) {
+    const orders = randomOrders(rand, 1 + Math.floor(rand() * 200), 1 + Math.floor(rand() * 40));
+    for (const limit of [undefined, 1, 5, 1000]) {
+      assert.deepStrictEqual(summarize(orders, limit), referenceSummarize(orders, limit), `round ${round}, limit ${limit}`);
+    }
+  }
+});
+
+test('matches the original on non-string ids and odd values', () => {
+  const orders = [
+    order('o1', 1, 'paid', 500, '2026-10-01T10:00:00Z'),
+    order('o2', '1', 'paid', 500, '2026-10-01T10:00:00Z'),
+    order('o3', 'cus_a', 'paid', 300, '2026-10-01T09:00:00Z'),
+    order('o4', 'cus_b', 'paid', undefined, '2026-10-01T09:00:00Z'),
+    order('o5', 'cus_c', 'paid', 300, undefined),
+    order('o6', 'cus_d', 'pending', 0, '2026-10-01T08:00:00Z'),
+  ];
+  assert.deepStrictEqual(summarize(orders), referenceSummarize(orders));
+});
+
+test('handles 200,000 orders well under a second', () => {
+  const orders = randomOrders(rng(7), 200000, 20000);
+  const start = process.hrtime.bigint();
+  summarize(orders);
+  const ms = Number(process.hrtime.bigint() - start) / 1e6;
+  assert.ok(ms < 1000, `took ${ms.toFixed(0)} ms`);
+});
