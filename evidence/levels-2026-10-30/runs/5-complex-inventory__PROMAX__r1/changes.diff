 // In-memory inventory. `clock` is injectable so tests can control time.
 function createStore({ clock = Date.now } = {}) {
   const stock = new Map();
+  const reservations = new Map(); // id -> { sku, qty, expiresAt }
+  let nextId = 1;
+
+  function isExpired(r) {
+    return clock() >= r.expiresAt;
+  }
+
+  function reservedQty(sku) {
+    let total = 0;
+    for (const r of reservations.values()) {
+      if (r.sku === sku && !isExpired(r)) total += r.qty;
+    }
+    return total;
+  }
+
+  function available(sku) {
+    return (stock.get(sku) || 0) - reservedQty(sku);
+  }
 
   function assertQty(qty) {
     if (!Number.isInteger(qty) || qty <= 0) throw new Error('INVALID_QTY');
@@ -15,12 +33,33 @@ function createStore({ clock = Date.now } = {}) {
     removeItem(sku, qty) {
       assertQty(qty);
       const current = stock.get(sku) || 0;
-      if (qty > current) throw new Error('INSUFFICIENT_STOCK');
+      if (qty > available(sku)) throw new Error('INSUFFICIENT_STOCK');
       stock.set(sku, current - qty);
     },
     getStock(sku) {
       return stock.get(sku) || 0;
     },
+    getAvailable(sku) {
+      return available(sku);
+    },
+    reserve(sku, qty, ttlMs) {
+      assertQty(qty);
+      if (qty > available(sku)) throw new Error('INSUFFICIENT_STOCK');
+      const id = `res-${nextId++}`;
+      reservations.set(id, { sku, qty, expiresAt: clock() + ttlMs });
+      return id;
+    },
+    confirm(id) {
+      const r = reservations.get(id);
+      if (!r) throw new Error('RESERVATION_NOT_FOUND');
+      if (isExpired(r)) throw new Error('RESERVATION_EXPIRED');
+      reservations.delete(id);
+      stock.set(r.sku, (stock.get(r.sku) || 0) - r.qty);
+      return { sku: r.sku, qty: r.qty };
+    },
+    release(id) {
+      reservations.delete(id);
+    },
   };
 }
 
diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..d83d398
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,81 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function setup(qty = 10) {
+  const time = { now: 1000 };
+  const s = createStore({ clock: () => time.now });
+  s.addItem('A', qty);
+  return { s, time };
+}
+
+test('reserve reduces available but not physical stock', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  assert.strictEqual(typeof id, 'string');
+  assert.notStrictEqual(id, s.reserve('A', 1, 100));
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('A'), 5);
+});
+test('reserve validates qty and availability', () => {
+  const { s } = setup(3);
+  for (const q of [0, -1, 1.5, '2']) assert.throws(() => s.reserve('A', q, 10), /INVALID_QTY/);
+  assert.throws(() => s.reserve('A', 4, 10), /INSUFFICIENT_STOCK/);
+  s.reserve('A', 3, 10);
+  assert.throws(() => s.reserve('A', 1, 10), /INSUFFICIENT_STOCK/);
+});
+test('reservation expires at exactly creation + ttl', () => {
+  const { s, time } = setup();
+  const id = s.reserve('A', 4, 100);
+  time.now = 1099;
+  assert.strictEqual(s.getAvailable('A'), 6);
+  time.now = 1100;
+  assert.strictEqual(s.getAvailable('A'), 10);
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+});
+test('confirm converts reservation to sale once', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 6);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+  assert.throws(() => s.confirm('nope'), /RESERVATION_NOT_FOUND/);
+});
+test('release is idempotent and frees stock', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  s.release(id);
+  s.release(id);
+  s.release('nope');
+  assert.strictEqual(s.getAvailable('A'), 10);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('removeItem cannot remove reserved stock', () => {
+  const { s, time } = setup();
+  s.reserve('A', 4, 100);
+  assert.throws(() => s.removeItem('A', 7), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 6);
+  assert.strictEqual(s.getStock('A'), 4);
+  time.now = 2000;
+  s.removeItem('A', 4);
+  assert.strictEqual(s.getStock('A'), 0);
+});
+test('reservations API', () => {
+  const time = { now: 0 };
+  const api = createApi(createStore({ clock: () => time.now }));
+  api({ method: 'POST', path: '/stock', body: { sku: 'A', qty: 5 } });
+  const r = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 50 } });
+  assert.strictEqual(r.status, 201);
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }).body, { sku: 'A', stock: 5, available: 3 });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 9, ttlMs: 50 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 50 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${r.body.id}/confirm` }), { status: 200, body: { sku: 'A', stock: 3 } });
+  assert.strictEqual(api({ method: 'POST', path: `/reservations/${r.body.id}/confirm` }).status, 404);
+  const r2 = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 1, ttlMs: 50 } });
+  time.now = 50;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${r2.body.id}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+  const r3 = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 1, ttlMs: 50 } });
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${r3.body.id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: '/reservations/zzz' }).status, 204);
+});
