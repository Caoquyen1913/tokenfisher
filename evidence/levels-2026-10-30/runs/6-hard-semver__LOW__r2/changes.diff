+const assert = require('assert');
+const { satisfies } = require('../src/semver');
+
+// Each case is [version, range, expected].
+function check(cases) {
+  for (const [v, r, want] of cases) {
+    assert.strictEqual(satisfies(v, r), want, `satisfies(${JSON.stringify(v)}, ${JSON.stringify(r)}) should be ${want}`);
+  }
+}
+
+test('invalid versions and ranges return false without throwing', () => {
+  check([
+    ['1.2', '*', false],
+    ['01.2.3', '*', false],
+    ['1.02.3', '*', false],
+    ['1.2.3-', '*', false],
+    ['1.2.3-a..b', '*', false],
+    ['1.2.3+', '*', false],
+    ['a.b.c', '*', false],
+    ['', '*', false],
+    [null, '*', false],
+    [undefined, '*', false],
+    [123, '*', false],
+    ['1.2.3', null, false],
+    ['1.2.3', 42, false],
+    ['1.2.3', 'foo', false],
+    ['1.2.3', '>=1.0.0 || foo', false],
+    ['1.2.3', '1.2.3 -', false],
+    ['1.2.3', '- 1.2.3', false],
+    ['1.2.3', '>=01.2.3', false],
+    ['1.2.3', '1.x-beta', false],
+  ]);
+});
+
+test('version syntax: leading v, whitespace, build metadata', () => {
+  check([
+    ['v1.2.3', '1.2.3', true],
+    ['  1.2.3  ', '1.2.3', true],
+    ['1.2.3+build.5', '1.2.3', true],
+    ['1.2.3', '=1.2.3+other', true],
+    ['1.2.3', 'v1.2.3', true],
+    ['1.2.3', '=v1.2.3', true],
+    ['1.2.3-beta+b1', '1.2.3-beta+b2', true],
+  ]);
+});
+
+test('plain comparators', () => {
+  check([
+    ['1.2.3', '1.2.3', true],
+    ['1.2.4', '1.2.3', false],
+    ['1.2.3', '=1.2.3', true],
+    ['1.2.3', '>1.2.2', true],
+    ['1.2.3', '>1.2.3', false],
+    ['1.2.3', '>=1.2.3', true],
+    ['1.2.2', '>=1.2.3', false],
+    ['1.2.2', '<1.2.3', true],
+    ['1.2.3', '<1.2.3', false],
+    ['1.2.3', '<=1.2.3', true],
+    ['1.2.4', '<=1.2.3', false],
+    ['1.2.3', '>= 1.2.3', true],
+    ['1.2.3', '< 2', true],
+    ['10.0.0', '>9.0.0', true],
+    ['1.10.0', '>1.9.0', true],
+  ]);
+});
+
+test('comparator sets and ||', () => {
+  check([
+    ['1.5.0', '>=1.2.3 <2.0.0', true],
+    ['2.0.0', '>=1.2.3 <2.0.0', false],
+    ['1.0.0', '>=1.2.3 <2.0.0', false],
+    ['1.5.0', '  >=1.2.3   <2.0.0  ', true],
+    ['3.0.0', '1.x || >=3', true],
+    ['2.5.0', '1.x || >=3', false],
+    ['1.4.0', '1.x || >=3', true],
+    ['2.0.0', '<1 || >2', false],
+  ]);
+});
+
+test('X-ranges and partial versions without operator', () => {
+  check([
