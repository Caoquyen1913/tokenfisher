 // See docs/SPEC.md.
+const NUM = '0|[1-9]\\d*';
+const IDS = '[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*';
+const VERSION_RE = new RegExp(`^v?(${NUM})\\.(${NUM})\\.(${NUM})(?:-(${IDS}))?(?:\\+${IDS})?$`);
+const XR = `${NUM}|[xX*]`;
+const PARTIAL_RE = new RegExp(`^v?(${XR})(?:\\.(${XR})(?:\\.(${XR})(?:-(${IDS}))?(?:\\+${IDS})?)?)?$`);
+const OP_RE = /^(<=|>=|<|>|=|~|\^)?(.*)$/;
+
+// Versions are { major, minor, patch, pre } with BigInt numbers and pre an array of identifiers.
+function parseVersion(str) {
+  if (typeof str !== 'string') return null;
+  const m = VERSION_RE.exec(str.trim());
+  if (!m) return null;
+  return { major: BigInt(m[1]), minor: BigInt(m[2]), patch: BigInt(m[3]), pre: m[4] ? m[4].split('.') : [] };
+}
+
+// A partial version: major/minor/patch are BigInt, or null from the first wildcard or missing position on.
+function parsePartial(str) {
+  const m = PARTIAL_RE.exec(str);
+  if (!m) return null;
+  const parts = [m[1], m[2], m[3]];
+  const nums = [];
+  for (const p of parts) {
+    if (p === undefined || p === 'x' || p === 'X' || p === '*' || nums[nums.length - 1] === null) nums.push(null);
+    else nums.push(BigInt(p));
+  }
+  const pre = m[4] ? m[4].split('.') : [];
+  // A prerelease only makes sense on a full version.
+  if (pre.length && nums[2] === null) return null;
+  return { major: nums[0], minor: nums[1], patch: nums[2], pre };
+}
+
+const ver = (major, minor, patch, pre = []) => ({ major, minor, patch, pre });
+
+function compareIdent(a, b) {
+  const an = /^\d+$/.test(a);
+  const bn = /^\d+$/.test(b);
+  if (an && bn) {
+    const x = BigInt(a);
+    const y = BigInt(b);
+    return x < y ? -1 : x > y ? 1 : 0;
+  }
+  if (an) return -1;
+  if (bn) return 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function compare(a, b) {
+  for (const k of ['major', 'minor', 'patch']) {
+    if (a[k] !== b[k]) return a[k] < b[k] ? -1 : 1;
+  }
+  // A version without a prerelease is greater than one with a prerelease.
+  if (!a.pre.length || !b.pre.length) return Math.sign(b.pre.length - a.pre.length);
+  for (let i = 0; i < Math.min(a.pre.length, b.pre.length); i++) {
+    const c = compareIdent(a.pre[i], b.pre[i]);
+    if (c) return c;
+  }
+  return Math.sign(a.pre.length - b.pre.length);
+}
+
+const sameTuple = (a, b) => a.major === b.major && a.minor === b.minor && a.patch === b.patch;
+
+const NEVER = { op: 'never' };
+
+// Expands one comparator token (operator + partial version) into a list of plain comparators.
+function expand(op, p) {
+  const { major: M, minor: m, patch: pt } = p;
+  const full = ver(M, m, pt, p.pre);
+  switch (op) {
+    case '':
+    case '=':
+      if (M === null) return [];
+      if (m === null) return [{ op: '>=', v: ver(M, 0n, 0n) }, { op: '<', v: ver(M + 1n, 0n, 0n) }];
+      if (pt === null) return [{ op: '>=', v: ver(M, m, 0n) }, { op: '<', v: ver(M, m + 1n, 0n) }];
+      return [{ op: '=', v: full }];
+    case '>':
+      if (M === null) return [NEVER];
+      if (m === null) return [{ op: '>=', v: ver(M + 1n, 0n, 0n) }];
+      if (pt === null) return [{ op: '>=', v: ver(M, m + 1n, 0n) }];
+      return [{ op: '>', v: full }];
+    case '>=':
+      if (M === null) return [];
+      return [{ op: '>=', v: ver(M, m ?? 0n, pt ?? 0n, p.pre) }];
+    case '<':
+      if (M === null) return [NEVER];
+      return [{ op: '<', v: ver(M, m ?? 0n, pt ?? 0n, p.pre) }];
+    case '<=':
+      if (M === null) return [];
+      if (m === null) return [{ op: '<', v: ver(M + 1n, 0n, 0n) }];
+      if (pt === null) return [{ op: '<', v: ver(M, m + 1n, 0n) }];
+      return [{ op: '<=', v: full }];
+    case '~':
+      if (M === null) return [];
+      if (m === null) return expand('', p);
+      return [{ op: '>=', v: ver(M, m, pt ?? 0n, p.pre) }, { op: '<', v: ver(M, m + 1n, 0n) }];
+    case '^': {
+      if (M === null) return [];
+      if (m === null) return expand('', p);
+      const lower = { op: '>=', v: ver(M, m, pt ?? 0n, p.pre) };
+      let upper;
+      if (M > 0n) upper = ver(M + 1n, 0n, 0n);
+      else if (m > 0n || pt === null) upper = ver(0n, m + 1n, 0n);
+      else upper = ver(0n, 0n, pt + 1n);
+      return [lower, { op: '<', v: upper }];
+    }
+  }
+  return null;
+}
+
+function hyphen(a, b) {
+  const out = [];
+  if (a.major !== null) out.push({ op: '>=', v: ver(a.major, a.minor ?? 0n, a.patch ?? 0n, a.pre) });
+  return out.concat(expand('<=', b));
+}
+
+// Parses one comparator set into a list of comparators, or null if invalid.
+function parseSet(str) {
+  const raw = str.trim().split(/\s+/).filter(Boolean);
+  // Join a bare operator with the version that follows it (`>= 1.2.3`).
+  const tokens = [];
+  for (let i = 0; i < raw.length; i++) {
+    if (/^(<=|>=|<|>|=|~|\^)$/.test(raw[i]) && i + 1 < raw.length) tokens.push(raw[i] + raw[++i]);
+    else tokens.push(raw[i]);
+  }
+  const comps = [];
+  for (let i = 0; i < tokens.length; i++) {
+    if (tokens[i + 1] === '-') {
+      const a = parsePartial(tokens[i]);
+      const b = tokens[i + 2] === undefined ? null : parsePartial(tokens[i + 2]);
+      if (!a || !b) return null;
+      comps.push(...hyphen(a, b));
+      i += 2;
+      continue;
+    }
+    const [, op = '', rest] = OP_RE.exec(tokens[i]);
+    const p = parsePartial(rest);
+    if (!p) return null;
+    comps.push(...expand(op, p));
+  }
+  return comps;
+}
+
+function test(c, v) {
+  if (c.op === 'never') return false;
+  const r = compare(v, c.v);
+  switch (c.op) {
+    case '=': return r === 0;
+    case '<': return r < 0;
+    case '<=': return r <= 0;
+    case '>': return r > 0;
+    case '>=': return r >= 0;
+  }
+  return false;
+}
+
+function satisfiesSet(v, comps) {
+  if (!comps.every((c) => test(c, v))) return false;
+  if (!v.pre.length) return true;
+  return comps.some((c) => c.v && c.v.pre.length && sameTuple(c.v, v));
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    const v = parseVersion(version);
+    if (!v || typeof range !== 'string') return false;
+    const sets = range.split('||').map(parseSet);
+    if (sets.some((s) => s === null)) return false;
+    return sets.some((s) => satisfiesSet(v, s));
+  } catch (e) {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
