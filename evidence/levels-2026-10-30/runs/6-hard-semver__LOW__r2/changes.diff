+    ['9.9.9', '', true],
+    ['9.9.9', '   ', true],
+    ['9.9.9', 'x', true],
+    ['9.9.9', 'X', true],
+    ['1.0.0', '1', true],
+    ['1.9.9', '1.x', true],
+    ['2.0.0', '1', false],
+    ['0.9.9', '1.X', false],
+    ['1.2.0', '1.2', true],
+    ['1.2.9', '1.2.x', true],
+    ['1.2.9', '1.2.*', true],
+    ['1.3.0', '1.2', false],
