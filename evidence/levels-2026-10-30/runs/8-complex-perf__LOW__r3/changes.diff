+  assert.deepStrictEqual(summarize(orders), [
+    { rank: 1, customerId: 'cus_a', spendCents: 1000, orderCount: 1, firstOrderAt: '2026-10-01T08:00:00Z' },
+    { rank: 2, customerId: 'cus_b', spendCents: 1000, orderCount: 1, firstOrderAt: '2026-10-01T09:00:00Z' },
+    { rank: 3, customerId: 'cus_c', spendCents: 1000, orderCount: 1, firstOrderAt: '2026-10-01T09:00:00Z' },
+    { rank: 4, customerId: 'cus_e', spendCents: 200, orderCount: 2, firstOrderAt: '2026-10-01T06:00:00Z' },
+  ]);
+});
+
+test('handles a day of orders (200,000) quickly', () => {
+  const orders = randomOrders(rng(1), 200000, { customers: 50000 });
+  const start = process.hrtime.bigint();
+  const report = summarize(orders);
+  const ms = Number(process.hrtime.bigint() - start) / 1e6;
+  assert.strictEqual(report.length, 10);
+  assert.ok(ms < 1000, `took ${ms.toFixed(0)} ms`);
+});
