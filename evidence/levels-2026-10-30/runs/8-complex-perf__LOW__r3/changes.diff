+
+// Verbatim copy of the original (quadratic) summarize(): the reference the dashboard and
+// finance exports were built against. Do not "fix" it; the output must keep matching.
+function referenceSummarize(orders, limit = 10) {
+  const EUR_TO_USD = 1.08;
+  const byRank = (a, b) => {
+    if (a.spendCents !== b.spendCents) return b.spendCents - a.spendCents;
+    if (a.firstOrderAt !== b.firstOrderAt) return a.firstOrderAt < b.firstOrderAt ? -1 : 1;
+    return a.customerId < b.customerId ? -1 : a.customerId > b.customerId ? 1 : 0;
+  };
+  const seen = [];
+  const groups = [];
+  for (const order of orders) {
+    if (seen.includes(order.id)) continue;
+    seen.push(order.id);
+    if (order.status === 'refunded') continue;
+    let group = groups.find((g) => g.customerId === order.customerId);
+    if (!group) {
+      group = { customerId: order.customerId, spendCents: 0, orderCount: 0, firstOrderAt: order.createdAt };
+      groups.push(group);
+    }
+    group.orderCount++;
+    if (order.createdAt < group.firstOrderAt) group.firstOrderAt = order.createdAt;
+    if (order.status === 'paid') {
+      group.spendCents += order.currency === 'EUR' ? Math.round(order.amountCents * EUR_TO_USD) : order.amountCents;
+    }
+    groups.sort(byRank);
+  }
+  return groups.filter((g) => g.spendCents > 0).slice(0, limit).map((g, i) => ({ rank: i + 1, ...g }));
+}
+
+// Deterministic PRNG so failures are reproducible.
+function rng(seed) {
+  return () => ((seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648);
+}
+
+function randomOrders(rand, n, { customers, malformed = false }) {
+  const statuses = ['paid', 'paid', 'paid', 'refunded', 'pending', 'failed'];
+  const amounts = [0, 100, 250, 999, 1000, 1001, 5000, -300];
+  const times = ['2026-10-01T08:00:00Z', '2026-10-01T09:30:00Z', '2026-10-01T09:30:00Z', '2026-10-01T23:59:59Z', '2026-09-30T12:00:00Z'];
+  const pick = (xs) => xs[Math.floor(rand() * xs.length)];
+  const orders = [];
+  for (let i = 0; i < n; i++) {
+    const id = rand() < 0.15 && i > 0 ? orders[Math.floor(rand() * i)].id : `o${i}`; // retried duplicates
+    let customerId = `cus_${Math.floor(rand() * customers)}`;
+    let amountCents = pick(amounts);
+    let createdAt = pick(times);
+    if (malformed) {
+      const r = rand();
+      if (r < 0.05) customerId = Math.floor(rand() * 3);
+      else if (r < 0.08) customerId = NaN;
+      else if (r < 0.11) amountCents = undefined;
+      else if (r < 0.13) createdAt = null;
+    }
+    orders.push({ id, customerId, status: pick(statuses), amountCents, currency: rand() < 0.4 ? 'EUR' : 'USD', createdAt });
+  }
+  return orders;
+}
+
+test('matches the original implementation exactly (ordering, ties, dedup, refunds, EUR)', () => {
+  const rand = rng(42);
+  for (let round = 0; round < 300; round++) {
+    const orders = randomOrders(rand, 1 + Math.floor(rand() * 200), { customers: 1 + Math.floor(rand() * 40) });
+    const limit = [undefined, 1, 3, 10, 50][round % 5];
+    assert.deepStrictEqual(summarize(orders, limit), referenceSummarize(orders, limit), `round ${round}`);
+  }
+});
+
+test('matches the original implementation on malformed input too', () => {
+  const rand = rng(7);
+  for (let round = 0; round < 200; round++) {
+    const orders = randomOrders(rand, 1 + Math.floor(rand() * 120), { customers: 1 + Math.floor(rand() * 15), malformed: true });
+    assert.deepStrictEqual(summarize(orders, 50), referenceSummarize(orders, 50), `round ${round}`);
+  }
+});
+
