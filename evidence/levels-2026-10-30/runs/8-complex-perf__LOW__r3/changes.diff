+    order('o2', 'cus_a', 'paid', 926, '2026-10-01T08:00:00Z', 'EUR'), // retry, ignored
+    order('o3', 'cus_c', 'paid', 1000, '2026-10-01T09:00:00Z'),
+    order('o4', 'cus_d', 'refunded', 99999, '2026-10-01T07:00:00Z'),
+    order('o5', 'cus_d', 'pending', 500, '2026-10-01T07:00:00Z'),
+    order('o6', 'cus_e', 'paid', 200, '2026-10-01T10:00:00Z'),
+    order('o7', 'cus_e', 'pending', 0, '2026-10-01T06:00:00Z'),
