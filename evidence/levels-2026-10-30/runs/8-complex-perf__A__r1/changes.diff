diff --git a/test/report-equivalence.test.js b/test/report-equivalence.test.js
new file mode 100644
index 0000000..88ee557
--- /dev/null
+++ b/test/report-equivalence.test.js
@@ -0,0 +1,92 @@
+const assert = require('assert');
+const { summarize } = require('../src/report');
+
+// Frozen copy of the original summarize() (one re-sort per order). The dashboard and finance
+// exports depend on its exact output, so the fast implementation must match it field for
+// field, including order and object key order.
+function referenceSummarize(orders, limit = 10) {
+  const byRank = (a, b) => {
+    if (a.spendCents !== b.spendCents) return b.spendCents - a.spendCents;
+    if (a.firstOrderAt !== b.firstOrderAt) return a.firstOrderAt < b.firstOrderAt ? -1 : 1;
+    return a.customerId < b.customerId ? -1 : a.customerId > b.customerId ? 1 : 0;
+  };
+  const seen = [];
+  const groups = [];
+  for (const order of orders) {
+    if (seen.includes(order.id)) continue;
+    seen.push(order.id);
+    if (order.status === 'refunded') continue;
+    let group = groups.find((g) => g.customerId === order.customerId);
+    if (!group) {
+      group = { customerId: order.customerId, spendCents: 0, orderCount: 0, firstOrderAt: order.createdAt };
+      groups.push(group);
+    }
+    group.orderCount++;
+    if (order.createdAt < group.firstOrderAt) group.firstOrderAt = order.createdAt;
+    if (order.status === 'paid') {
+      group.spendCents += order.currency === 'EUR' ? Math.round(order.amountCents * 1.08) : order.amountCents;
+    }
+    groups.sort(byRank);
+  }
+  return groups
+    .filter((g) => g.spendCents > 0)
+    .slice(0, limit)
+    .map((g, i) => ({ rank: i + 1, ...g }));
+}
+
+// Deterministic PRNG so failures are reproducible.
+function rng(seed) {
+  return () => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return seed / 2147483648;
+  };
+}
+
+// Small value ranges force collisions: duplicate ids (incl. a refunded copy arriving first),
+// spend ties, firstOrderAt ties, pending-only customers, EUR rounding, out-of-order timestamps.
+function randomOrders(rand, n, customers) {
+  const statuses = ['paid', 'paid', 'paid', 'pending', 'refunded'];
+  const amounts = [100, 250, 463, 500, 1000];
+  return Array.from({ length: n }, () => ({
+    id: `o${Math.floor(rand() * n * 0.8)}`,
+    customerId: `cus_${Math.floor(rand() * customers)}`,
+    status: statuses[Math.floor(rand() * statuses.length)],
+    amountCents: amounts[Math.floor(rand() * amounts.length)],
+    currency: rand() < 0.3 ? 'EUR' : 'USD',
+    createdAt: `2026-10-0${1 + Math.floor(rand() * 3)}T1${Math.floor(rand() * 3)}:00:00Z`,
+  }));
+}
+
+test('matches the original implementation exactly on randomized orders', () => {
+  const rand = rng(42);
+  for (let round = 0; round < 300; round++) {
+    const orders = randomOrders(rand, 1 + Math.floor(rand() * 120), 1 + Math.floor(rand() * 25));
+    for (const limit of [undefined, 0, 1, 3, 50]) {
+      const expected = referenceSummarize(orders, limit);
+      const actual = summarize(orders, limit);
+      assert.deepStrictEqual(actual, expected, `round ${round}, limit ${limit}`);
+      assert.deepStrictEqual(actual.map((r) => Object.keys(r)), expected.map((r) => Object.keys(r)));
+    }
+  }
+});
+
+test('matches the original implementation on malformed input', () => {
+  const orders = [
+    { id: 1, customerId: 7, status: 'paid', amountCents: 100, currency: 'USD', createdAt: undefined },
+    { id: 2, customerId: '7', status: 'paid', amountCents: 100, currency: 'USD', createdAt: '2026-10-01T10:00:00Z' },
+    { id: 3, customerId: NaN, status: 'paid', amountCents: 50, currency: 'USD', createdAt: '2026-10-01T10:00:00Z' },
+    { id: 4, customerId: NaN, status: 'paid', amountCents: 50, currency: 'USD', createdAt: '2026-10-01T10:00:00Z' },
+    { id: 5, customerId: 'cus_x', status: 'paid', amountCents: undefined, currency: 'USD', createdAt: '2026-10-01T09:00:00Z' },
+    { id: 6, customerId: 'cus_y', status: 'paid', amountCents: 100, currency: 'EUR', createdAt: '2026-10-01T09:00:00Z' },
+  ];
+  assert.deepStrictEqual(summarize(orders), referenceSummarize(orders));
+});
+
+test('summarizes a full day (200,000 orders) quickly', () => {
+  const orders = randomOrders(rng(7), 200000, 20000);
+  const start = process.hrtime.bigint();
+  const report = summarize(orders);
+  const ms = Number(process.hrtime.bigint() - start) / 1e6;
+  assert.strictEqual(report.length, 10);
+  assert.ok(ms < 1000, `took ${ms.toFixed(0)} ms`);
+});
