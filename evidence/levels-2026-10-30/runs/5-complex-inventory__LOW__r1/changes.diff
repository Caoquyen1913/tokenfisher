diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..68456a5
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,112 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function setup(stock = 10) {
+  let now = 1000;
+  const clock = { advance: (ms) => { now += ms; } };
+  const store = createStore({ clock: () => now });
+  store.addItem('A', stock);
+  return { store, clock, api: createApi(store) };
+}
+
+test('reserve returns unique string ids and reduces availability only', () => {
+  const { store } = setup();
+  const a = store.reserve('A', 3, 1000);
+  const b = store.reserve('A', 2, 1000);
+  assert.strictEqual(typeof a, 'string');
+  assert.notStrictEqual(a, b);
+  assert.strictEqual(store.getAvailable('A'), 5);
+  assert.strictEqual(store.getStock('A'), 10);
+});
+test('reserve validates qty', () => {
+  const { store } = setup();
+  for (const q of [0, -1, 1.5, '2', undefined]) {
+    assert.throws(() => store.reserve('A', q, 1000), /INVALID_QTY/);
+  }
+});
+test('reserve cannot exceed available stock', () => {
+  const { store } = setup(5);
+  store.reserve('A', 4, 1000);
+  assert.throws(() => store.reserve('A', 2, 1000), /INSUFFICIENT_STOCK/);
+  assert.throws(() => store.reserve('B', 1, 1000), /INSUFFICIENT_STOCK/);
+  store.reserve('A', 1, 1000);
+  assert.strictEqual(store.getAvailable('A'), 0);
+});
+test('reservation expires exactly at creation + ttl', () => {
+  const { store, clock } = setup();
+  store.reserve('A', 4, 100);
+  clock.advance(99);
+  assert.strictEqual(store.getAvailable('A'), 6);
+  clock.advance(1);
+  assert.strictEqual(store.getAvailable('A'), 10);
+  store.reserve('A', 10, 100);
+});
+test('confirm turns a reservation into a sale', () => {
+  const { store } = setup();
+  const id = store.reserve('A', 3, 1000);
+  store.confirm(id);
+  assert.strictEqual(store.getStock('A'), 7);
+  assert.strictEqual(store.getAvailable('A'), 7);
+  assert.throws(() => store.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm rejects unknown, released and expired reservations', () => {
+  const { store, clock } = setup();
+  assert.throws(() => store.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const released = store.reserve('A', 1, 1000);
+  store.release(released);
+  assert.throws(() => store.confirm(released), /RESERVATION_NOT_FOUND/);
+  const expired = store.reserve('A', 1, 50);
+  clock.advance(50);
+  assert.throws(() => store.confirm(expired), /RESERVATION_EXPIRED/);
+  assert.strictEqual(store.getStock('A'), 10);
+});
+test('release frees stock and is idempotent', () => {
+  const { store } = setup();
+  const id = store.reserve('A', 4, 1000);
+  store.release(id);
+  store.release(id);
+  store.release('unknown');
+  assert.strictEqual(store.getAvailable('A'), 10);
+});
+test('removeItem cannot remove reserved stock', () => {
+  const { store, clock } = setup();
+  store.reserve('A', 6, 100);
+  assert.throws(() => store.removeItem('A', 5), /INSUFFICIENT_STOCK/);
+  store.removeItem('A', 4);
+  assert.strictEqual(store.getStock('A'), 6);
+  clock.advance(100);
+  store.removeItem('A', 6);
+  assert.strictEqual(store.getStock('A'), 0);
+});
+
+test('GET /stock includes available', () => {
+  const { store, api } = setup();
+  store.reserve('A', 3, 1000);
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }), { status: 200, body: { sku: 'A', stock: 10, available: 7 } });
+});
+test('POST /reservations status codes', () => {
+  const { api } = setup(5);
+  const ok = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 1000 } });
+  assert.strictEqual(ok.status, 201);
+  assert.strictEqual(typeof ok.body.id, 'string');
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 4, ttlMs: 1000 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 1000 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+});
+test('POST /reservations/:id/confirm status codes', () => {
+  const { api, clock } = setup();
+  const reserve = (ttlMs) => api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs } }).body.id;
+  const id = reserve(1000);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'A', stock: 8 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+  const expiring = reserve(10);
+  clock.advance(10);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${expiring}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('DELETE /reservations/:id returns 204 and releases', () => {
+  const { store, api } = setup();
+  const id = store.reserve('A', 4, 1000);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(store.getAvailable('A'), 10);
+});
