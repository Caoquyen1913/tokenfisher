diff --git a/test/report.test.js b/test/report.test.js
index 9353f4d..2db31ad 100644
--- a/test/report.test.js
+++ b/test/report.test.js
@@ -17,3 +17,30 @@ test('respects the limit', () => {
   assert.strictEqual(summarize(orders).length, 10);
   assert.strictEqual(summarize(orders, 3).length, 3);
 });
+
+test('dedupes, skips refunds, converts EUR and breaks ties exactly', () => {
+  const report = summarize([
+    order('o1', 'cus_b', 'paid', 1000, '2026-10-01T10:00:00Z'),
+    order('o1', 'cus_b', 'paid', 1000, '2026-10-01T10:00:00Z'), // duplicate id
+    order('o2', 'cus_a', 'paid', 1000, '2026-10-01T09:00:00Z'), // ties cus_b on spend, earlier first order
+    order('o3', 'cus_c', 'paid', 925, '2026-10-01T08:00:00Z', 'EUR'), // 999
+    order('o4', 'cus_d', 'refunded', 5000, '2026-10-01T07:00:00Z'),
+    order('o4', 'cus_d', 'paid', 5000, '2026-10-01T07:00:00Z'), // duplicate of refunded id: ignored
+    order('o5', 'cus_e', 'pending', 700, '2026-10-01T06:00:00Z'), // counted, no spend: filtered out
+    order('o6', 'cus_b', 'pending', 1, '2026-09-30T00:00:00Z'),
+    order('o7', 'cus_z', 'paid', 1000, '2026-10-01T09:00:00Z'), // ties cus_a fully; id order decides
+  ]);
+  assert.deepStrictEqual(report, [
+    { rank: 1, customerId: 'cus_b', spendCents: 1000, orderCount: 2, firstOrderAt: '2026-09-30T00:00:00Z' },
+    { rank: 2, customerId: 'cus_a', spendCents: 1000, orderCount: 1, firstOrderAt: '2026-10-01T09:00:00Z' },
+    { rank: 3, customerId: 'cus_z', spendCents: 1000, orderCount: 1, firstOrderAt: '2026-10-01T09:00:00Z' },
+    { rank: 4, customerId: 'cus_c', spendCents: 999, orderCount: 1, firstOrderAt: '2026-10-01T08:00:00Z' },
+  ]);
+});
+
+test('handles 200,000 orders quickly', () => {
+  const orders = Array.from({ length: 200000 }, (_, i) => order(`o${i}`, `cus_${i % 5000}`, 'paid', 100 + (i % 97), '2026-10-01T10:00:00Z'));
+  const t = Date.now();
+  summarize(orders);
+  assert.ok(Date.now() - t < 1000);
+});
