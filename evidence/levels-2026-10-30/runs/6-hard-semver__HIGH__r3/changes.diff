 // See docs/SPEC.md.
+const IDENT = '[0-9A-Za-z-]+';
+const DOTTED = `${IDENT}(?:\\.${IDENT})*`;
+const NUM = '0|[1-9]\\d*';
+const PART = `(${NUM}|[xX*])`;
+const VERSION_RE = new RegExp(`^v?(${NUM})\\.(${NUM})\\.(${NUM})(?:-(${DOTTED}))?(?:\\+${DOTTED})?$`);
+const PARTIAL_RE = new RegExp(`^v?${PART}(?:\\.${PART})?(?:\\.${PART})?(?:-(${DOTTED}))?(?:\\+${DOTTED})?$`);
+const OPERATORS = ['<=', '>=', '<', '>', '='];
+
+function parseVersion(str) {
+  if (typeof str !== 'string') return null;
+  const m = VERSION_RE.exec(str.trim());
+  if (!m) return null;
+  return {
+    major: BigInt(m[1]),
+    minor: BigInt(m[2]),
+    patch: BigInt(m[3]),
+    pre: m[4] === undefined ? [] : m[4].split('.'),
+  };
+}
+
+function comparePre(a, b) {
+  if (!a.length && !b.length) return 0;
+  if (!a.length) return 1;
+  if (!b.length) return -1;
+  for (let i = 0; i < Math.min(a.length, b.length); i++) {
+    if (a[i] === b[i]) continue;
+    const an = /^\d+$/.test(a[i]);
+    const bn = /^\d+$/.test(b[i]);
+    if (an && bn) return BigInt(a[i]) < BigInt(b[i]) ? -1 : BigInt(a[i]) > BigInt(b[i]) ? 1 : 0;
+    if (an) return -1;
+    if (bn) return 1;
+    return a[i] < b[i] ? -1 : 1;
+  }
+  return a.length === b.length ? 0 : a.length < b.length ? -1 : 1;
+}
+
+function compare(a, b) {
+  for (const k of ['major', 'minor', 'patch']) {
+    if (a[k] !== b[k]) return a[k] < b[k] ? -1 : 1;
+  }
+  return comparePre(a.pre, b.pre);
+}
+
+const ver = (major, minor, patch, pre = []) => ({ major, minor, patch, pre });
+const isWild = (s) => s === undefined || /^[xX*]$/.test(s);
+
+// Parses a possibly partial version into { n, major, minor, patch, pre }, where n is the
+// number of specified (non-wildcard) positions, or null when invalid.
+function parsePartial(str) {
+  const m = PARTIAL_RE.exec(str);
+  if (!m) return null;
+  const parts = [m[1], m[2], m[3]];
+  let n = 0;
+  while (n < 3 && !isWild(parts[n])) n++;
+  if (parts.slice(n).some((p) => !isWild(p))) return null; // "1.x.3"
+  if (m[4] !== undefined && n < 3) return null;
+  const [major, minor, patch] = parts.map((p) => (isWild(p) ? 0n : BigInt(p)));
+  return { n, major, minor, patch, pre: m[4] === undefined ? [] : m[4].split('.') };
+}
+
+const NONE = [{ op: 'none' }];
+const lower = (v) => ({ op: '>=', v });
+const below = (v) => ({ op: '<', v });
+
+// First version above everything the partial `p` matches.
+function bump(p) {
+  return p.n === 1 ? ver(p.major + 1n, 0n, 0n) : ver(p.major, p.minor + 1n, 0n);
+}
+
+function expandPlain(p) {
+  if (p.n === 0) return [];
+  if (p.n === 3) return [{ op: '=', v: ver(p.major, p.minor, p.patch, p.pre) }];
+  return [lower(ver(p.major, p.minor, 0n)), below(bump(p))];
+}
+
+function expandOp(op, p) {
+  if (op === '=') return expandPlain(p);
+  if (p.n === 3) return [{ op, v: ver(p.major, p.minor, p.patch, p.pre) }];
+  if (p.n === 0) return op === '>=' || op === '<=' ? [] : NONE;
+  const floor = ver(p.major, p.minor, 0n);
+  if (op === '>') return [lower(bump(p))];
+  if (op === '>=') return [lower(floor)];
+  if (op === '<') return [below(floor)];
+  return [below(bump(p))]; // <=
+}
+
+function expandTilde(p) {
+  if (p.n === 0) return [];
+  const floor = p.n === 3 ? ver(p.major, p.minor, p.patch, p.pre) : ver(p.major, p.minor, 0n);
+  const ceil = p.n === 1 ? ver(p.major + 1n, 0n, 0n) : ver(p.major, p.minor + 1n, 0n);
+  return [lower(floor), below(ceil)];
+}
+
+function expandCaret(p) {
+  if (p.n === 0) return [];
+  const floor = p.n === 3 ? ver(p.major, p.minor, p.patch, p.pre) : ver(p.major, p.minor, 0n);
+  let ceil;
+  if (p.major > 0n || p.n === 1) ceil = ver(p.major + 1n, 0n, 0n);
+  else if (p.minor > 0n || p.n === 2) ceil = ver(0n, p.minor + 1n, 0n);
+  else ceil = ver(0n, 0n, p.patch + 1n);
+  return [lower(floor), below(ceil)];
+}
+
+function expandHyphen(a, b) {
+  const pa = parsePartial(a);
+  const pb = parsePartial(b);
+  if (!pa || !pb) return null;
+  const out = [];
+  if (pa.n > 0) out.push(lower(ver(pa.major, pa.minor, pa.patch, pa.pre)));
+  if (pb.n === 3) out.push({ op: '<=', v: ver(pb.major, pb.minor, pb.patch, pb.pre) });
+  else if (pb.n > 0) out.push(below(bump(pb)));
+  return out;
+}
+
+// Returns the comparators of one set, or null if the set is invalid.
+function parseSet(text) {
+  const raw = text.trim().split(/\s+/).filter(Boolean);
+  if (raw.length === 3 && raw[1] === '-') return expandHyphen(raw[0], raw[2]);
+
+  const tokens = [];
+  for (let i = 0; i < raw.length; i++) {
+    if (OPERATORS.includes(raw[i])) {
+      if (i + 1 >= raw.length) return null;
+      tokens.push(raw[i] + raw[++i]);
+    } else {
+      tokens.push(raw[i]);
+    }
+  }
+
+  const out = [];
+  for (const tok of tokens) {
+    let comps;
+    if (tok[0] === '~' || tok[0] === '^') {
+      const p = parsePartial(tok.slice(1));
+      if (!p) return null;
+      comps = tok[0] === '~' ? expandTilde(p) : expandCaret(p);
+    } else {
+      const written = OPERATORS.find((o) => tok.startsWith(o)) || '';
+      const p = parsePartial(tok.slice(written.length));
+      if (!p) return null;
+      comps = expandOp(written || '=', p);
+    }
+    out.push(...comps);
+  }
+  return out;
+}
+
+function parseRange(range) {
+  if (typeof range !== 'string') return null;
+  const sets = [];
+  for (const part of range.split('||')) {
+    const set = parseSet(part);
+    if (!set) return null;
+    sets.push(set);
+  }
+  return sets;
+}
+
+function test(v, c) {
+  if (c.op === 'none') return false;
+  const d = compare(v, c.v);
+  switch (c.op) {
+    case '<': return d < 0;
+    case '<=': return d <= 0;
+    case '>': return d > 0;
+    case '>=': return d >= 0;
+    default: return d === 0;
+  }
+}
+
+function matchesSet(v, set) {
+  if (!set.every((c) => test(v, c))) return false;
+  if (!v.pre.length) return true;
+  return set.some((c) => c.v && c.v.pre.length
+    && c.v.major === v.major && c.v.minor === v.minor && c.v.patch === v.patch);
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    const v = parseVersion(version);
+    const sets = parseRange(range);
+    if (!v || !sets) return false;
+    return sets.some((set) => matchesSet(v, set));
+  } catch (e) {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
