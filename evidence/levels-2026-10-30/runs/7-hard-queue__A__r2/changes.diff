+    while (!paused && running < concurrency && pending.length > 0) {
+      const { fn, resolve, reject } = pending.shift();
+      running++;
+      // new Promise() turns a plain value, a returned promise, or a synchronous throw into one promise.
+      new Promise((res) => res(fn()))
+        .then(resolve, reject)
+        .then(() => {
+          running--;
+          next();
+          checkIdle();
+        });
+    }
   }
 
   function checkIdle() {
-    if (pending.length === 0) {
+    if (pending.length === 0 && running === 0) {
