 // See docs/SPEC.md.
+const NUM = '0|[1-9]\\d*';
+const IDS = '[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*';
+const PART = `(?:${NUM}|[xX*])`;
+const PARTIAL_RE = new RegExp(
+  `^v?(${PART})(?:\\.(${PART})(?:\\.(${PART})(?:-(${IDS}))?(?:\\+(${IDS}))?)?)?$`
+);
+
+const isWild = (s) => s === undefined || s === 'x' || s === 'X' || s === '*';
+
+// Parses "1.2.3[-pre][+build]", with missing or x/X/* positions as null (wildcard).
+// Returns { major, minor, patch, pre } or null if invalid.
+function parsePartial(str) {
+  const m = PARTIAL_RE.exec(str);
+  if (!m) return null;
+  const parts = [];
+  let wild = false;
+  for (let i = 1; i <= 3; i++) {
+    wild = wild || isWild(m[i]);
+    parts.push(wild ? null : BigInt(m[i]));
+  }
+  const hasTail = m[4] !== undefined || m[5] !== undefined;
+  if (hasTail && wild) return null;
+  return { major: parts[0], minor: parts[1], patch: parts[2], pre: m[4] ? m[4].split('.') : null };
+}
+
+function parseVersion(str) {
+  if (typeof str !== 'string') return null;
+  const s = str.trim();
+  const v = parsePartial(s);
+  return v && v.patch !== null ? v : null;
+}
+
+function cmpIdentifiers(a, b) {
+  const an = /^\d+$/.test(a);
+  const bn = /^\d+$/.test(b);
+  if (an && bn) {
+    const x = BigInt(a);
+    const y = BigInt(b);
+    return x < y ? -1 : x > y ? 1 : 0;
+  }
+  if (an) return -1;
+  if (bn) return 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function cmp(a, b) {
+  for (const k of ['major', 'minor', 'patch']) {
+    if (a[k] !== b[k]) return a[k] < b[k] ? -1 : 1;
+  }
+  if (!a.pre && !b.pre) return 0;
+  if (!a.pre) return 1;
+  if (!b.pre) return -1;
+  const n = Math.min(a.pre.length, b.pre.length);
+  for (let i = 0; i < n; i++) {
+    const c = cmpIdentifiers(a.pre[i], b.pre[i]);
+    if (c) return c;
+  }
+  return Math.sign(a.pre.length - b.pre.length);
+}
+
+const ver = (major, minor, patch, pre = null) => ({ major, minor, patch, pre });
+const lower = (v) => ({ op: '>=', v });
+const upper = (v) => ({ op: '<', v });
+const NONE = { none: true };
+
+// Bounds [>=lo, <hi) covering everything matching the partial p; null entries mean unbounded.
+function bounds(p) {
+  if (p.major === null) return { lo: null, hi: null };
+  if (p.minor === null) return { lo: ver(p.major, 0n, 0n), hi: ver(p.major + 1n, 0n, 0n) };
+  if (p.patch === null) return { lo: ver(p.major, p.minor, 0n), hi: ver(p.major, p.minor + 1n, 0n) };
+  return { lo: ver(p.major, p.minor, p.patch, p.pre), hi: null };
+}
+
+function fromBounds({ lo, hi }) {
+  const out = [];
+  if (lo) out.push(lower(lo));
+  if (hi) out.push(upper(hi));
+  return out;
+}
+
+function comparatorsFor(op, p) {
+  const full = p.patch !== null;
+  const { lo, hi } = bounds(p);
+  switch (op) {
+    case '':
+    case '=':
+      return full ? [{ op: '=', v: lo }] : fromBounds({ lo, hi });
+    case '>':
+      if (full) return [{ op: '>', v: lo }];
+      return hi ? [lower(hi)] : [NONE];
+    case '>=':
+      return lo ? [lower(lo)] : [];
+    case '<':
+      return lo ? [upper(lo)] : [NONE];
+    case '<=':
+      if (full) return [{ op: '<=', v: lo }];
+      return hi ? [upper(hi)] : [];
+    case '~':
+      return fromBounds({ lo, hi: lo && tildeHi(p) });
+    case '^':
+      return fromBounds({ lo, hi: lo && caretHi(p) });
+    default:
+      return null;
+  }
+}
+
+function tildeHi(p) {
+  return p.minor === null
+    ? ver(p.major + 1n, 0n, 0n)
+    : ver(p.major, p.minor + 1n, 0n);
+}
+
+function caretHi(p) {
+  if (p.major > 0n || p.minor === null) return ver(p.major + 1n, 0n, 0n);
+  if (p.minor > 0n || p.patch === null) return ver(0n, p.minor + 1n, 0n);
+  return ver(0n, 0n, p.patch + 1n);
+}
+
+function parseSet(set) {
+  const tokens = set.replace(/(<=|>=|<|>|=)\s+/g, '$1').split(/\s+/).filter(Boolean);
+  const comparators = [];
+  for (let i = 0; i < tokens.length; i++) {
+    if (tokens[i + 1] === '-') {
+      const a = parsePartial(tokens[i]);
+      const b = tokens[i + 2] === undefined ? null : parsePartial(tokens[i + 2]);
+      if (!a || !b) return null;
+      comparators.push(...fromBounds({ lo: bounds(a).lo, hi: null }));
+      const { lo, hi } = bounds(b);
+      if (b.patch !== null) comparators.push({ op: '<=', v: lo });
+      else if (hi) comparators.push(upper(hi));
+      i += 2;
+      continue;
+    }
+    const m = /^(<=|>=|<|>|=|~|\^)?(.*)$/.exec(tokens[i]);
+    const p = parsePartial(m[2]);
+    if (!p) return null;
+    comparators.push(...comparatorsFor(m[1] || '', p));
+  }
+  return comparators;
+}
+
+function parseRange(range) {
+  if (typeof range !== 'string') return null;
+  const sets = [];
+  for (const part of range.split('||')) {
+    const set = parseSet(part.trim());
+    if (!set) return null;
+    sets.push(set);
+  }
+  return sets;
+}
+
+function testComparator(c, v) {
+  if (c.none) return false;
+  const r = cmp(v, c.v);
+  switch (c.op) {
+    case '=': return r === 0;
+    case '<': return r < 0;
+    case '<=': return r <= 0;
+    case '>': return r > 0;
+    default: return r >= 0;
+  }
+}
+
+function testSet(set, v) {
+  if (!set.every((c) => testComparator(c, v))) return false;
+  if (!v.pre) return true;
+  return set.some((c) => c.v && c.v.pre && c.v.major === v.major && c.v.minor === v.minor && c.v.patch === v.patch);
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    const v = parseVersion(version);
+    if (!v) return false;
+    const sets = parseRange(range);
+    if (!sets) return false;
+    return sets.some((set) => testSet(set, v));
+  } catch (e) {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
