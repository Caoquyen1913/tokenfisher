 // See docs/SPEC.md.
+const IDS = '[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*';
+const PART = '(x|X|\\*|0|[1-9]\\d*)';
+const PARTIAL_RE = new RegExp(
+  `^v?${PART}(?:\\.${PART}(?:\\.${PART}(?:-(${IDS}))?(?:\\+${IDS})?)?)?$`
+);
+const OP_RE = /^(<=|>=|<|>|=|~|\^)?(.*)$/;
+
+// Parses a possibly partial version. Wildcard or missing positions are null.
+function parsePartial(str) {
+  const m = PARTIAL_RE.exec(str);
+  if (!m) return null;
+  const num = (s) => (s === undefined || /^[xX*]$/.test(s) ? null : BigInt(s));
+  let [major, minor, patch] = [num(m[1]), num(m[2]), num(m[3])];
+  if (major === null) minor = patch = null;
+  if (minor === null) patch = null;
+  if (patch === null && m[4]) return null;
+  return { major, minor, patch, pre: m[4] ? m[4].split('.') : [] };
+}
+
+function parseVersion(str) {
+  if (typeof str !== 'string') return null;
+  const p = parsePartial(str.trim());
+  return p && p.patch !== null ? p : null;
+}
+
+const isNum = (id) => /^\d+$/.test(id);
+
+function cmpPre(a, b) {
+  if (!a.length || !b.length) return a.length === b.length ? 0 : a.length ? -1 : 1;
+  for (let i = 0; i < Math.min(a.length, b.length); i++) {
+    const [x, y] = [a[i], b[i]];
+    if (x === y) continue;
+    if (isNum(x) && isNum(y)) return BigInt(x) < BigInt(y) ? -1 : BigInt(x) > BigInt(y) ? 1 : 0;
+    if (isNum(x)) return -1;
+    if (isNum(y)) return 1;
+    return x < y ? -1 : 1;
+  }
+  return a.length === b.length ? 0 : a.length < b.length ? -1 : 1;
+}
+
+function cmp(a, b) {
+  for (const k of ['major', 'minor', 'patch']) {
+    if (a[k] !== b[k]) return a[k] < b[k] ? -1 : 1;
+  }
+  return cmpPre(a.pre, b.pre);
+}
+
+const ver = (major, minor, patch, pre = []) => ({ major, minor, patch, pre });
+const ANY = [];
+const NONE = [{ op: 'none' }];
+const c = (op, v) => ({ op, v });
+const zero = (p) => ver(p.major ?? 0n, p.minor ?? 0n, p.patch ?? 0n, p.pre);
+
+// First version above everything the partial `p` covers.
+function bump(p) {
+  if (p.minor === null) return ver(p.major + 1n, 0n, 0n);
+  return ver(p.major, p.minor + 1n, 0n);
+}
+
+// Both bounds of a partial: [lower, upperExclusive] (null when unbounded).
+function span(p) {
+  if (p.major === null) return [null, null];
+  return [c('>=', zero(p)), c('<', bump(p))];
+}
+
+function tilde(p) {
+  if (p.major === null) return ANY;
+  const upper = p.minor === null ? ver(p.major + 1n, 0n, 0n) : ver(p.major, p.minor + 1n, 0n);
+  return [c('>=', zero(p)), c('<', upper)];
+}
+
+function caret(p) {
+  if (p.major === null) return ANY;
+  let upper;
+  if (p.major > 0n || p.minor === null) upper = ver(p.major + 1n, 0n, 0n);
+  else if (p.minor > 0n || p.patch === null) upper = ver(0n, p.minor + 1n, 0n);
+  else upper = ver(0n, 0n, p.patch + 1n);
+  return [c('>=', zero(p)), c('<', upper)];
+}
+
+function primitive(op, p) {
+  const full = p.patch !== null;
+  switch (op) {
+    case '~': return tilde(p);
+    case '^': return caret(p);
+    case '': case '=': {
+      if (full) return [c('=', zero(p))];
+      return p.major === null ? ANY : [c('>=', zero(p)), c('<', bump(p))];
+    }
+    case '>':
+      if (full) return [c('>', zero(p))];
+      return p.major === null ? NONE : [c('>=', bump(p))];
+    case '>=': return p.major === null ? ANY : [c('>=', zero(p))];
+    case '<': return p.major === null ? NONE : [c('<', zero(p))];
+    case '<=':
+      if (full) return [c('<=', zero(p))];
+      return p.major === null ? ANY : [c('<', bump(p))];
+  }
+}
+
+function parseHyphen(a, b) {
+  const [lo, hi] = [parsePartial(a), parsePartial(b)];
+  if (!lo || !hi) return null;
+  const out = [];
+  if (lo.major !== null) out.push(c('>=', zero(lo)));
+  if (hi.patch !== null) out.push(c('<=', zero(hi)));
+  else if (hi.major !== null) out.push(c('<', bump(hi)));
+  return out;
+}
+
+// Returns a list of comparators, or null when the set is invalid.
+function parseSet(set) {
+  const hy = /^(\S+)\s+-\s+(\S+)$/.exec(set);
+  if (hy) return parseHyphen(hy[1], hy[2]);
+  const tokens = set.replace(/(<=|>=|<|>|=|~|\^)\s+/g, '$1').split(/\s+/).filter(Boolean);
+  const out = [];
+  for (const t of tokens) {
+    const [, op = '', rest] = OP_RE.exec(t);
+    const p = parsePartial(rest);
+    if (!p) return null;
+    out.push(...primitive(op, p));
+  }
+  return out;
+}
+
+function parseRange(range) {
+  if (typeof range !== 'string') return null;
+  const sets = [];
+  for (const s of range.split('||')) {
+    const set = parseSet(s.trim());
+    if (!set) return null;
+    sets.push(set);
+  }
+  return sets;
+}
+
+function test(v, { op, v: cv }) {
+  if (op === 'none') return false;
+  const r = cmp(v, cv);
+  switch (op) {
+    case '=': return r === 0;
+    case '>': return r > 0;
+    case '>=': return r >= 0;
+    case '<': return r < 0;
+    case '<=': return r <= 0;
+  }
+}
+
+function satisfiesSet(v, set) {
+  if (!set.every((cp) => test(v, cp))) return false;
+  if (!v.pre.length) return true;
+  return set.some((cp) => cp.v && cp.v.pre.length
+    && cp.v.major === v.major && cp.v.minor === v.minor && cp.v.patch === v.patch);
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    const v = parseVersion(version);
+    const sets = parseRange(range);
+    if (!v || !sets) return false;
+    return sets.some((set) => satisfiesSet(v, set));
+  } catch (e) {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
