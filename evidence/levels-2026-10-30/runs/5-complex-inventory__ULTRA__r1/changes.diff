diff --git a/test/api.test.js b/test/api.test.js
index 3ef8a0b..76a0160 100644
--- a/test/api.test.js
+++ b/test/api.test.js
@@ -17,3 +17,40 @@ test('POST /stock rejects bad qty', () => {
   assert.deepStrictEqual(api({ method: 'POST', path: '/stock', body: { sku: 'x', qty: -1 } }), { status: 400, body: { error: 'INVALID_QTY' } });
 });
 test('unknown route is 404', () => assert.strictEqual(createApi(createStore())({ method: 'GET', path: '/nope' }).status, 404));
+
+function timedApi() {
+  let t = 0;
+  const api = createApi(createStore({ clock: () => t }));
+  api({ method: 'POST', path: '/stock', body: { sku: 'A', qty: 5 } });
+  return { api, advance: (ms) => { t += ms; } };
+}
+
+test('GET /stock includes available', () => {
+  const { api } = timedApi();
+  api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 50 } });
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }).body, { sku: 'A', stock: 5, available: 3 });
+});
+test('POST /reservations statuses', () => {
+  const { api } = timedApi();
+  const ok = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 50 } });
+  assert.strictEqual(ok.status, 201);
+  assert.strictEqual(typeof ok.body.id, 'string');
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 9, ttlMs: 50 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 50 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+});
+test('confirm reservation: 200, 404, 410', () => {
+  const { api, advance } = timedApi();
+  const id = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 50 } }).body.id;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'A', stock: 3 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+  const id2 = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 1, ttlMs: 50 } }).body.id;
+  advance(50);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id2}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('DELETE /reservations/:id returns 204 and frees stock', () => {
+  const { api } = timedApi();
+  const id = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 50 } }).body.id;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: '/reservations/nope' }).status, 204);
+  assert.strictEqual(api({ method: 'GET', path: '/stock/A' }).body.available, 5);
+});
diff --git a/test/store.test.js b/test/store.test.js
index 8b80ad0..f114858 100644
--- a/test/store.test.js
+++ b/test/store.test.js
@@ -27,3 +27,66 @@ test('quantities must be positive integers', () => {
   assert.throws(() => s.addItem('A', 0), /INVALID_QTY/);
   assert.throws(() => s.addItem('A', 1.5), /INVALID_QTY/);
 });
+
+function timed() {
+  let t = 1000;
+  const s = createStore({ clock: () => t });
+  return { s, advance: (ms) => { t += ms; } };
+}
+
+test('reserve reduces available but not physical stock', () => {
+  const { s } = timed();
+  s.addItem('A', 10);
+  const id = s.reserve('A', 4, 100);
+  assert.strictEqual(typeof id, 'string');
+  assert.notStrictEqual(id, s.reserve('A', 1, 100));
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('A'), 5);
+});
+test('reserve validates qty and availability', () => {
+  const { s } = timed();
+  s.addItem('A', 3);
+  assert.throws(() => s.reserve('A', 0, 10), /INVALID_QTY/);
+  assert.throws(() => s.reserve('A', 1.5, 10), /INVALID_QTY/);
+  assert.throws(() => s.reserve('A', 4, 10), /INSUFFICIENT_STOCK/);
+});
+test('reservation expires at exactly creation + ttl', () => {
+  const { s, advance } = timed();
+  s.addItem('A', 5);
+  const id = s.reserve('A', 5, 100);
+  advance(99);
+  assert.strictEqual(s.getAvailable('A'), 0);
+  advance(1);
+  assert.strictEqual(s.getAvailable('A'), 5);
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+});
+test('confirm converts reservation into a sale once', () => {
+  const { s } = timed();
+  s.addItem('A', 5);
+  const id = s.reserve('A', 2, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 3);
+  assert.strictEqual(s.getAvailable('A'), 3);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+  assert.throws(() => s.confirm('zzz'), /RESERVATION_NOT_FOUND/);
+});
+test('release cancels, is idempotent, and blocks confirm', () => {
+  const { s } = timed();
+  s.addItem('A', 5);
+  const id = s.reserve('A', 2, 100);
+  s.release(id);
+  s.release(id);
+  s.release('unknown');
+  assert.strictEqual(s.getAvailable('A'), 5);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('removeItem cannot remove reserved stock', () => {
+  const { s, advance } = timed();
+  s.addItem('A', 5);
+  s.reserve('A', 3, 100);
+  assert.throws(() => s.removeItem('A', 3), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 2);
+  advance(100);
+  s.removeItem('A', 3);
+  assert.strictEqual(s.getStock('A'), 0);
+});
