 // See docs/SPEC.md.
+const ID = '[0-9A-Za-z-]+';
+const NUM = '0|[1-9]\\d*';
+const WILD = `x|X|\\*|${NUM}`;
+const SUFFIX = `(?:-(${ID}(?:\\.${ID})*))?(?:\\+${ID}(?:\\.${ID})*)?`;
+const VERSION_RE = new RegExp(`^v?(${NUM})\\.(${NUM})\\.(${NUM})${SUFFIX}$`);
+const PARTIAL_RE = new RegExp(`^v?(${WILD})(?:\\.(${WILD}))?(?:\\.(${WILD}))?${SUFFIX}$`);
+const OPERATOR_RE = /^(?:<=|>=|<|>|=|~|\^)$/;
+const COMPARATOR_RE = /^(<=|>=|<|>|=|~|\^)?(.*)$/;
+
+const NONE = { op: 'none' };
+
+function parseVersion(str) {
+  if (typeof str !== 'string') return null;
+  const m = VERSION_RE.exec(str.trim());
+  if (!m) return null;
+  return { major: BigInt(m[1]), minor: BigInt(m[2]), patch: BigInt(m[3]), pre: m[4] ? m[4].split('.') : null };
+}
+
+function cmpBig(a, b) {
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function cmpIdentifiers(a, b) {
+  const aNum = /^\d+$/.test(a);
+  const bNum = /^\d+$/.test(b);
+  if (aNum && bNum) return cmpBig(BigInt(a), BigInt(b));
+  if (aNum) return -1;
+  if (bNum) return 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function compareVersions(a, b) {
+  const main = cmpBig(a.major, b.major) || cmpBig(a.minor, b.minor) || cmpBig(a.patch, b.patch);
+  if (main) return main;
+  if (!a.pre && !b.pre) return 0;
+  if (!a.pre) return 1;
+  if (!b.pre) return -1;
+  const n = Math.min(a.pre.length, b.pre.length);
+  for (let i = 0; i < n; i++) {
+    const c = cmpIdentifiers(a.pre[i], b.pre[i]);
+    if (c) return c;
+  }
+  return a.pre.length < b.pre.length ? -1 : a.pre.length > b.pre.length ? 1 : 0;
+}
+
+// Partial version: missing/wildcard parts are null; `pre` only on a full version.
+function parsePartial(str) {
+  const m = PARTIAL_RE.exec(str);
+  if (!m) return null;
+  const parts = [m[1], m[2], m[3]].map((x) => (x === undefined || x === 'x' || x === 'X' || x === '*' ? null : BigInt(x)));
+  for (let i = 1; i < 3; i++) if (parts[i - 1] === null && parts[i] !== null) return null;
+  const pre = m[4] ? m[4].split('.') : null;
+  if (pre && parts[2] === null) return null;
+  return { major: parts[0], minor: parts[1], patch: parts[2], pre };
+}
+
+const mk = (major, minor, patch, pre = null) => ({ major, minor, patch, pre });
+const comp = (op, v) => ({ op, v });
+const fillLower = (p) => mk(p.major, p.minor ?? 0n, p.patch ?? 0n, p.pre);
+const nextMinor = (p) => mk(p.major, p.minor + 1n, 0n);
+const nextMajor = (p) => mk(p.major + 1n, 0n, 0n);
+
+// Upper bound (exclusive) of everything a partial version covers; null for a full version.
+function partialCeiling(p) {
+  if (p.minor === null) return nextMajor(p);
+  if (p.patch === null) return nextMinor(p);
+  return null;
+}
+
+function expandComparator(op, p) {
+  const any = p.major === null;
+  const full = p.patch !== null;
+  switch (op) {
+    case '':
+    case '=':
+      if (any) return [];
+      if (full) return [comp('=', fillLower(p))];
+      return [comp('>=', fillLower(p)), comp('<', partialCeiling(p))];
+    case '>':
+      if (any) return [NONE];
+      return [full ? comp('>', fillLower(p)) : comp('>=', partialCeiling(p))];
+    case '>=':
+      return any ? [] : [comp('>=', fillLower(p))];
+    case '<':
+      return any ? [NONE] : [comp('<', fillLower(p))];
+    case '<=':
+      if (any) return [];
+      return [full ? comp('<=', fillLower(p)) : comp('<', partialCeiling(p))];
+    case '~':
+      if (any) return [];
+      return [comp('>=', fillLower(p)), comp('<', p.minor === null ? nextMajor(p) : nextMinor(p))];
+    case '^': {
+      if (any) return [];
+      let upper;
+      if (p.major > 0n || p.minor === null) upper = nextMajor(p);
+      else if (p.minor > 0n || p.patch === null) upper = nextMinor(p);
+      else upper = mk(0n, 0n, p.patch + 1n);
+      return [comp('>=', fillLower(p)), comp('<', upper)];
+    }
+    default:
+      return null;
+  }
+}
+
+function expandHyphen(a, b) {
+  const lower = a.major === null ? [] : [comp('>=', fillLower(a))];
+  if (b.major === null) return lower;
+  const ceiling = partialCeiling(b);
+  return lower.concat(ceiling ? comp('<', ceiling) : comp('<=', fillLower(b)));
+}
+
+// Returns an array of comparators (empty = any version), or null if the set is invalid.
+function parseSet(str) {
+  const raw = str.trim().split(/\s+/).filter(Boolean);
+  const items = [];
+  for (let i = 0; i < raw.length; i++) {
+    if (OPERATOR_RE.test(raw[i])) {
+      if (i + 1 >= raw.length) return null;
+      items.push(raw[i] + raw[++i]);
+    } else {
+      items.push(raw[i]);
+    }
+  }
+  const comps = [];
+  for (let i = 0; i < items.length; i++) {
+    if (items[i + 1] === '-') {
+      if (i + 2 >= items.length) return null;
+      const a = parsePartial(items[i]);
+      const b = parsePartial(items[i + 2]);
+      if (!a || !b) return null;
+      comps.push(...expandHyphen(a, b));
+      i += 2;
+      continue;
+    }
+    const [, op = '', rest] = COMPARATOR_RE.exec(items[i]);
+    const p = parsePartial(rest);
+    const expanded = p && expandComparator(op, p);
+    if (!expanded) return null;
+    comps.push(...expanded);
+  }
+  return comps;
+}
+
+function testComparator(version, c) {
+  if (c.op === 'none') return false;
+  const cmp = compareVersions(version, c.v);
+  switch (c.op) {
+    case '=': return cmp === 0;
+    case '>': return cmp > 0;
+    case '>=': return cmp >= 0;
+    case '<': return cmp < 0;
+    case '<=': return cmp <= 0;
+    default: return false;
+  }
+}
+
+function testSet(version, comps) {
+  if (!comps.every((c) => testComparator(version, c))) return false;
+  if (!version.pre) return true;
+  return comps.some((c) => c.v && c.v.pre && c.v.major === version.major && c.v.minor === version.minor && c.v.patch === version.patch);
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    const v = parseVersion(version);
+    if (!v || typeof range !== 'string') return false;
+    const sets = range.split('||').map(parseSet);
+    if (sets.some((s) => s === null)) return false;
+    return sets.some((s) => testSet(v, s));
+  } catch (e) {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
