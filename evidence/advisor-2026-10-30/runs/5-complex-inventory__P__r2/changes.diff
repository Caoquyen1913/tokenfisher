+  assert.deepStrictEqual(c, { status: 200, body: { sku: 'A', stock: 2 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${r.body.id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+});
+test('confirm expired reservation is 410; DELETE is 204', () => {
+  const t = { now: 0 };
+  const api = createApi(createStore({ clock: () => t.now }));
+  api({ method: 'POST', path: '/stock', body: { sku: 'A', qty: 5 } });
+  const id = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 1, ttlMs: 10 } }).body.id;
+  t.now = 10;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: '/reservations/unknown' }).status, 204);
+});
diff --git a/test/store.test.js b/test/store.test.js
index 8b80ad0..ff33e0e 100644
--- a/test/store.test.js
+++ b/test/store.test.js
@@ -27,3 +27,68 @@ test('quantities must be positive integers', () => {
   assert.throws(() => s.addItem('A', 0), /INVALID_QTY/);
   assert.throws(() => s.addItem('A', 1.5), /INVALID_QTY/);
 });
+
+function timed() {
+  const t = { now: 1000 };
+  return { t, s: createStore({ clock: () => t.now }) };
+}
+
+test('reserve reduces available but not physical stock', () => {
+  const { s } = timed();
+  s.addItem('A', 10);
+  const id = s.reserve('A', 4, 100);
+  assert.strictEqual(typeof id, 'string');
+  assert.notStrictEqual(id, s.reserve('A', 1, 100));
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('A'), 5);
+});
+test('reserve validates qty and availability', () => {
+  const { s } = timed();
+  s.addItem('A', 2);
+  assert.throws(() => s.reserve('A', 0, 10), /INVALID_QTY/);
+  assert.throws(() => s.reserve('A', 1.5, 10), /INVALID_QTY/);
+  assert.throws(() => s.reserve('A', 3, 10), /INSUFFICIENT_STOCK/);
+  s.reserve('A', 2, 10);
+  assert.throws(() => s.reserve('A', 1, 10), /INSUFFICIENT_STOCK/);
+});
+test('reservation expires at exactly creation + ttl', () => {
+  const { t, s } = timed();
+  s.addItem('A', 5);
+  const id = s.reserve('A', 5, 100);
+  t.now = 1099;
+  assert.strictEqual(s.getAvailable('A'), 0);
+  t.now = 1100;
+  assert.strictEqual(s.getAvailable('A'), 5);
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+});
+test('confirm converts reservation to a sale once', () => {
+  const { s } = timed();
+  s.addItem('A', 5);
+  const id = s.reserve('A', 3, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 2);
+  assert.strictEqual(s.getAvailable('A'), 2);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+  assert.throws(() => s.confirm('nope'), /RESERVATION_NOT_FOUND/);
+});
+test('release frees stock and is idempotent', () => {
+  const { s } = timed();
+  s.addItem('A', 5);
+  const id = s.reserve('A', 5, 100);
+  s.release(id);
+  s.release(id);
+  s.release('nope');
+  assert.strictEqual(s.getAvailable('A'), 5);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('removeItem cannot take reserved stock', () => {
+  const { t, s } = timed();
+  s.addItem('A', 5);
+  s.reserve('A', 3, 100);
+  assert.throws(() => s.removeItem('A', 3), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 2);
+  assert.strictEqual(s.getStock('A'), 3);
+  t.now = 2000;
+  s.removeItem('A', 3);
+  assert.strictEqual(s.getStock('A'), 0);
+});
