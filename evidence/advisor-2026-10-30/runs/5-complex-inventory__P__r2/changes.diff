 test('unknown route is 404', () => assert.strictEqual(createApi(createStore())({ method: 'GET', path: '/nope' }).status, 404));
+
+test('reservation flow over the API', () => {
+  const t = { now: 0 };
+  const api = createApi(createStore({ clock: () => t.now }));
+  api({ method: 'POST', path: '/stock', body: { sku: 'A', qty: 5 } });
+  const r = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } });
+  assert.strictEqual(r.status, 201);
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }).body, { sku: 'A', stock: 5, available: 2 });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 100 } }), { status: 400, body: { error: 'INVALID_QTY' } });
