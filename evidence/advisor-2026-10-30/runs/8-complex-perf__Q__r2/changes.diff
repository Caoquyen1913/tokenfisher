diff --git a/test/report.test.js b/test/report.test.js
index 9353f4d..03cf9d7 100644
--- a/test/report.test.js
+++ b/test/report.test.js
@@ -17,3 +17,54 @@ test('respects the limit', () => {
   assert.strictEqual(summarize(orders).length, 10);
   assert.strictEqual(summarize(orders, 3).length, 3);
 });
+
+test('matches the reference output on a large mixed dataset', () => {
+  // Deterministic pseudo-random orders with duplicates, refunds, EUR and ties.
+  let seed = 12345;
+  const rnd = (n) => (seed = (seed * 1103515245 + 12345) % 2147483648) % n;
+  const statuses = ['paid', 'paid', 'pending', 'refunded'];
+  const orders = [];
+  for (let i = 0; i < 3000; i++) {
+    const day = String(1 + rnd(5)).padStart(2, '0');
+    orders.push(order(`o${rnd(2500)}`, `cus_${rnd(120)}`, statuses[rnd(4)], 100 * rnd(8), `2026-10-${day}T10:00:00Z`, rnd(2) ? 'EUR' : 'USD'));
+  }
+  const reference = (list, limit) => {
+    const seen = new Set();
+    const groups = new Map();
+    for (const o of list) {
+      if (seen.has(o.id)) continue;
+      seen.add(o.id);
+      if (o.status === 'refunded') continue;
+      let g = groups.get(o.customerId);
+      if (!g) groups.set(o.customerId, (g = { customerId: o.customerId, spendCents: 0, orderCount: 0, firstOrderAt: o.createdAt }));
+      g.orderCount++;
+      if (o.createdAt < g.firstOrderAt) g.firstOrderAt = o.createdAt;
+      if (o.status === 'paid') g.spendCents += o.currency === 'EUR' ? Math.round(o.amountCents * 1.08) : o.amountCents;
+    }
+    return [...groups.values()]
+      .filter((g) => g.spendCents > 0)
+      .sort((a, b) => b.spendCents - a.spendCents || (a.firstOrderAt < b.firstOrderAt ? -1 : a.firstOrderAt > b.firstOrderAt ? 1 : 0) || (a.customerId < b.customerId ? -1 : 1))
+      .slice(0, limit)
+      .map((g, i) => ({ rank: i + 1, ...g }));
+  };
+  assert.deepStrictEqual(summarize(orders, 50), reference(orders, 50));
+  assert.deepStrictEqual(Object.keys(summarize(orders)[0]), ['rank', 'customerId', 'spendCents', 'orderCount', 'firstOrderAt']);
+});
+
+test('ignores duplicate ids (even refunded first) and ties break by first order then id', () => {
+  const report = summarize([
+    order('d1', 'cus_x', 'refunded', 999, '2026-10-01T00:00:00Z'),
+    order('d1', 'cus_x', 'paid', 999, '2026-10-01T00:00:00Z'),
+    order('t1', 'cus_b', 'paid', 100, '2026-10-02T00:00:00Z'),
+    order('t2', 'cus_a', 'paid', 100, '2026-10-02T00:00:00Z'),
+    order('t3', 'cus_c', 'paid', 100, '2026-10-01T00:00:00Z'),
+  ]);
+  assert.deepStrictEqual(report.map((r) => r.customerId), ['cus_c', 'cus_a', 'cus_b']);
+});
+
+test('summarizes 200,000 orders quickly', () => {
+  const orders = Array.from({ length: 200000 }, (_, i) => order(`o${i}`, `cus_${i % 50000}`, 'paid', 100 + (i % 97), '2026-10-01T10:00:00Z'));
+  const start = Date.now();
+  summarize(orders);
+  assert.ok(Date.now() - start < 1000, 'summarize is too slow');
+});
