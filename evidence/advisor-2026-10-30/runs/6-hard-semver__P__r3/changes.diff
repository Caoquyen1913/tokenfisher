 // See docs/SPEC.md.
+const IDENT = '[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*';
+const NUM = '0|[1-9]\\d*';
+const VERSION_RE = new RegExp(`^v?(${NUM})\\.(${NUM})\\.(${NUM})(?:-(${IDENT}))?(?:\\+${IDENT})?$`);
+const PARTIAL_RE = new RegExp(
+  `^v?([xX*]|${NUM})(?:\\.([xX*]|${NUM})(?:\\.([xX*]|${NUM})(?:-(${IDENT}))?(?:\\+${IDENT})?)?)?$`
+);
+const OPERATORS = new Set(['<', '<=', '>', '>=', '=']);
+const PREFIX_RE = /^(<=|>=|<|>|=|\^|~)?(.*)$/;
+
+function parseVersion(str) {
+  if (typeof str !== 'string') return null;
+  const m = VERSION_RE.exec(str.trim());
+  if (!m) return null;
+  return { M: BigInt(m[1]), m: BigInt(m[2]), p: BigInt(m[3]), pre: m[4] ? m[4].split('.') : [] };
+}
+
+function compareIdentifiers(a, b) {
+  const aNum = /^\d+$/.test(a);
+  const bNum = /^\d+$/.test(b);
+  if (aNum && bNum) {
+    const x = BigInt(a);
+    const y = BigInt(b);
+    return x < y ? -1 : x > y ? 1 : 0;
+  }
+  if (aNum) return -1;
+  if (bNum) return 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function compareVersions(a, b) {
+  for (const k of ['M', 'm', 'p']) {
+    if (a[k] !== b[k]) return a[k] < b[k] ? -1 : 1;
+  }
+  if (!a.pre.length || !b.pre.length) return b.pre.length - a.pre.length;
+  const n = Math.min(a.pre.length, b.pre.length);
+  for (let i = 0; i < n; i++) {
+    const c = compareIdentifiers(a.pre[i], b.pre[i]);
+    if (c) return c;
+  }
+  return a.pre.length - b.pre.length;
+}
+
+// Parses a possibly partial version; wildcard or missing positions are null.
+function parsePartial(str) {
+  const m = PARTIAL_RE.exec(str);
+  if (!m) throw new Error('invalid range');
+  const part = (s) => (s === undefined || /^[xX*]$/.test(s) ? null : BigInt(s));
+  const M = part(m[1]);
+  const mi = M === null ? null : part(m[2]);
+  const p = mi === null ? null : part(m[3]);
+  if (m[4] !== undefined && p === null) throw new Error('invalid range');
+  return { M, m: mi, p, pre: m[4] ? m[4].split('.') : [] };
+}
+
+const ver = (M, m, p, pre = []) => ({ M, m, p, pre });
+const cmp = (op, v) => ({ op, v });
+const NEVER = { op: 'never' };
+
+// Lower bound (>=) of a partial version, zero-filled.
+function lower(P) {
+  if (P.M === null) return [];
+  return [cmp('>=', ver(P.M, P.m ?? 0n, P.p ?? 0n, P.pre))];
+}
+
+// Exclusive upper bound (<) just past everything a partial version matches.
+function upperExclusive(P) {
+  if (P.M === null) return [];
+  if (P.m === null) return [cmp('<', ver(P.M + 1n, 0n, 0n))];
+  if (P.p === null) return [cmp('<', ver(P.M, P.m + 1n, 0n))];
+  return [cmp('<', ver(P.M, P.m, P.p + 1n))];
+}
+
+function desugarPlain(P) {
+  if (P.M === null) return [];
+  if (P.p === null) return [...lower(P), ...upperExclusive(P)];
+  return [cmp('=', ver(P.M, P.m, P.p, P.pre))];
+}
+
+function desugarOperator(op, P) {
+  if (op === '=') return desugarPlain(P);
+  if (P.M === null) return op === '>=' || op === '<=' ? [] : [NEVER];
+  const full = P.p !== null;
+  if (full) return [cmp(op, ver(P.M, P.m, P.p, P.pre))];
+  if (op === '>=') return lower(P);
+  if (op === '<') return [cmp('<', ver(P.M, P.m ?? 0n, 0n))];
+  // '>' and '<=' both look at the first version past the partial range.
+  const next = P.m === null ? ver(P.M + 1n, 0n, 0n) : ver(P.M, P.m + 1n, 0n);
+  return [cmp(op === '>' ? '>=' : '<', next)];
+}
+
+function desugarTilde(P) {
+  if (P.M === null) return [];
+  if (P.m === null) return [...lower(P), cmp('<', ver(P.M + 1n, 0n, 0n))];
+  return [...lower(P), cmp('<', ver(P.M, P.m + 1n, 0n))];
+}
+
+function desugarCaret(P) {
+  if (P.M === null) return [];
+  const M = P.M;
+  const m = P.m ?? 0n;
+  const p = P.p ?? 0n;
+  let upper;
+  if (M > 0n) upper = ver(M + 1n, 0n, 0n);
+  else if (P.m === null) upper = ver(1n, 0n, 0n);
+  else if (m > 0n) upper = ver(0n, m + 1n, 0n);
+  else if (P.p === null) upper = ver(0n, 1n, 0n);
+  else upper = ver(0n, 0n, p + 1n);
+  return [...lower(P), cmp('<', upper)];
+}
+
+function desugarHyphen(a, b) {
+  const A = parsePartial(a);
+  const B = parsePartial(b);
+  const upper = B.p !== null ? [cmp('<=', ver(B.M, B.m, B.p, B.pre))] : upperExclusive(B);
+  return [...lower(A), ...upper];
+}
+
+function parseComparatorSet(set) {
+  const tokens = set.trim().split(/\s+/).filter(Boolean);
+  const out = [];
+  let i = 0;
+  while (i < tokens.length) {
+    if (tokens[i + 1] === '-') {
+      if (i + 2 >= tokens.length) throw new Error('invalid range');
+      out.push(...desugarHyphen(tokens[i], tokens[i + 2]));
+      i += 3;
+      continue;
+    }
+    let tok = tokens[i++];
+    if (OPERATORS.has(tok)) {
+      if (i >= tokens.length) throw new Error('invalid range');
+      tok += tokens[i++];
+    }
+    const [, op, rest] = PREFIX_RE.exec(tok);
+    const P = parsePartial(rest);
+    if (op === '~') out.push(...desugarTilde(P));
+    else if (op === '^') out.push(...desugarCaret(P));
+    else out.push(...desugarOperator(op || '=', P));
+  }
+  return out;
+}
+
+function matches(c, v) {
+  if (c.op === 'never') return false;
+  const d = compareVersions(v, c.v);
+  switch (c.op) {
+    case '<': return d < 0;
+    case '<=': return d <= 0;
+    case '>': return d > 0;
+    case '>=': return d >= 0;
+    default: return d === 0;
+  }
+}
+
+function satisfiesSet(v, set) {
+  if (!set.every((c) => matches(c, v))) return false;
+  if (!v.pre.length) return true;
+  return set.some(
+    (c) => c.v && c.v.pre.length && c.v.M === v.M && c.v.m === v.m && c.v.p === v.p
+  );
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    const v = parseVersion(version);
+    if (!v || typeof range !== 'string') return false;
+    const sets = range.split('||').map(parseComparatorSet);
+    return sets.some((set) => satisfiesSet(v, set));
+  } catch (e) {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
