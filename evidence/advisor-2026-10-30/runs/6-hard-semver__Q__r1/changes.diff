+  yes('1.0.0-alpha.beta', '>1.0.0-alpha.1');
+  yes('1.0.0-beta', '>1.0.0-alpha');
+  yes('1.0.0-B', '<1.0.0-a');
+  yes('1.0.0-beta.11', '>1.0.0-beta.2');
+  yes('1.0.0-rc.1', '<=1.0.0-rc.1');
+  no('1.0.0-rc.1', '>=1.0.0');
+  no('1.0.0-rc.1', '>=1.0.0-rc.2');
+});
+
+test('x-ranges and partials without operator', () => {
+  yes('0.0.0', '*'); yes('9.9.9', ''); yes('9.9.9', '   '); yes('1.2.3', 'x'); yes('1.2.3', 'X');
+  yes('1.5.0', '1'); yes('1.5.0', '1.x'); yes('1.5.0', '1.X.x'); yes('1.5.0', '1.*'); no('2.0.0', '1'); no('0.9.9', '1');
+  yes('1.2.9', '1.2'); yes('1.2.9', '1.2.x'); no('1.3.0', '1.2'); no('1.3.0', '1.2.*');
+  yes('1.2.3', '1.2.3');
