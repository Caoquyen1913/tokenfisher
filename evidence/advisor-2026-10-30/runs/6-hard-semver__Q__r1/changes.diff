+const assert = require('assert');
+const { satisfies } = require('../src/semver');
+
+const yes = (v, r) => assert.strictEqual(satisfies(v, r), true, `${v} should satisfy "${r}"`);
+const no = (v, r) => assert.strictEqual(satisfies(v, r), false, `${v} should not satisfy "${r}"`);
+
+test('invalid input returns false and never throws', () => {
+  for (const v of ['', '1', '1.2', '01.2.3', '1.2.3.4', '1.2.3-', '1.2.3+', 'a.b.c', '1.2.x', null, undefined, 5, {}]) no(v, '*');
+  for (const r of ['>>1', '1.2.3 -', '- 1.2.3', '>=', 'foo', '1.2.x-beta', '01.2.3', '~', '^a', '1.2.3 - >2', null, undefined, 5]) no('1.2.3', r);
+  no('1.2.3', '1.2.3 || foo');
+});
+
+test('version syntax: v prefix, whitespace, build metadata', () => {
+  yes('v1.2.3', '1.2.3');
+  yes('  1.2.3  ', ' 1.2.3 ');
+  yes('1.2.3+build.5', '1.2.3');
+  yes('1.2.3', '=v1.2.3');
+  yes('1.2.3', '1.2.3+other');
+  yes('1.0.0-alpha+001', '1.0.0-alpha');
+});
+
+test('comparators', () => {
+  yes('1.2.3', '>=1.2.3'); no('1.2.3', '>1.2.3'); yes('1.2.4', '>1.2.3');
+  yes('1.2.3', '<=1.2.3'); no('1.2.3', '<1.2.3'); yes('1.2.2', '<1.2.3');
+  yes('1.2.3', '=1.2.3'); no('1.2.4', '=1.2.3');
+  yes('1.2.3', '>= 1.2.3'); yes('1.2.3', '>=   1.2.0   <  2');
+  yes('1.10.0', '>1.9.0'); yes('10.0.0', '>9.0.0');
+});
+
+test('ordering of prereleases', () => {
