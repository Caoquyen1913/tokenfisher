+  yes('2.9.9', '1.2.3 - 2'); no('3.0.0', '1.2.3 - 2');
+  yes('1.0.0', '1 - 2'); yes('5.0.0', '1 - *');
+  yes('1.5.0', '1.2.3 - 2.0.0 || 4.0.0'); yes('4.0.0', '1.2.3 - 2.0.0 || 4.0.0');
+  yes('1.2.3-alpha.2', '1.2.3-alpha.1 - 2.0.0');
+  no('1.2.3-alpha.2', '1.2.4-alpha.1 - 2.0.0');
