+const assert = require('assert');
+const { satisfies } = require('../src/semver');
+
+function check(range, yes, no = []) {
+  test(`range ${JSON.stringify(range)}`, () => {
+    for (const v of yes) assert.strictEqual(satisfies(v, range), true, `${v} should satisfy ${range}`);
+    for (const v of no) assert.strictEqual(satisfies(v, range), false, `${v} should not satisfy ${range}`);
+  });
+}
+
+test('invalid input returns false', () => {
+  for (const v of ['', '1', '1.2', '01.2.3', '1.2.3.4', '1.2.3-', 'x.y.z', '1.2.3-a..b', null, undefined, 5]) {
+    assert.strictEqual(satisfies(v, '*'), false, String(v));
+  }
+  for (const r of ['>=', '1.2.3.4', 'foo', '^', '~ ', '>=1.2.3 foo', '1.x.3', '1.2.x-beta', null, undefined, 5]) {
+    assert.strictEqual(satisfies('1.2.3', r), false, String(r));
+  }
+});
+
+test('version syntax', () => {
+  assert.strictEqual(satisfies('v1.2.3', '1.2.3'), true);
+  assert.strictEqual(satisfies('  1.2.3  ', 'v1.2.3'), true);
+  assert.strictEqual(satisfies('1.2.3+build.5', '1.2.3+other'), true);
+  assert.strictEqual(satisfies('1.2.3-alpha+b', '=1.2.3-alpha'), true);
+  assert.strictEqual(satisfies('1.2.3+b', '>1.2.3'), false);
+});
+
+test('ordering', () => {
+  const asc = ['1.0.0-alpha', '1.0.0-alpha.1', '1.0.0-alpha.beta', '1.0.0-beta', '1.0.0-beta.2', '1.0.0-beta.11', '1.0.0-rc.1', '1.0.0'];
+  for (let i = 0; i < asc.length; i++) {
+    for (let j = 0; j < asc.length; j++) {
+      // `<1.0.0` excludes 1.0.0-* prereleases (tuple rule), so only check `<` against prerelease bounds
+      if (j < asc.length - 1) assert.strictEqual(satisfies(asc[i], `<${asc[j]}`), i < j, `${asc[i]} < ${asc[j]}`);
+      assert.strictEqual(satisfies(asc[i], `>=${asc[j]}`), i >= j, `${asc[i]} >= ${asc[j]}`);
+    }
+  }
+  assert.strictEqual(satisfies('1.10.0', '>1.9.0'), true);
+  assert.strictEqual(satisfies('9007199254740993.0.0', '>9007199254740992.0.0'), true);
+});
+
+// comparators
+check('>=1.2.3', ['1.2.3', '1.2.4', '2.0.0'], ['1.2.2']);
+check('>= 1.2.3', ['1.2.3'], ['1.2.2']);
+check('> 1.2.3 < 2.0.0', ['1.2.4'], ['1.2.3', '2.0.0']);
+check('<=1.2.3', ['1.2.3', '0.0.1'], ['1.2.4']);
+check('=1.2.3', ['1.2.3'], ['1.2.4']);
+check('1.2.3', ['1.2.3'], ['1.2.4', '1.2.2']);
+check('= 1.2.3', ['1.2.3'], ['1.2.4']);
+
+// x-ranges
+check('*', ['0.0.0', '5.6.7'], ['1.0.0-alpha']);
+check('', ['1.2.3']);
+check('  ', ['1.2.3']);
+check('x', ['1.2.3']);
+check('1', ['1.0.0', '1.9.9'], ['0.9.9', '2.0.0']);
+check('1.x', ['1.0.0', '1.9.9'], ['2.0.0']);
+check('1.2', ['1.2.0', '1.2.9'], ['1.1.9', '1.3.0']);
+check('1.2.X', ['1.2.5'], ['1.3.0']);
+check('1.*.*', ['1.5.5'], ['2.0.0']);
+
+// operators with partial versions
+check('>1', ['2.0.0'], ['1.9.9']);
+check('>1.2', ['1.3.0'], ['1.2.9']);
+check('>=1', ['1.0.0'], ['0.9.9']);
+check('>=1.2', ['1.2.0'], ['1.1.9']);
+check('<1', ['0.9.9'], ['1.0.0']);
+check('<1.2', ['1.1.9'], ['1.2.0']);
+check('<=1', ['1.9.9'], ['2.0.0']);
+check('<=1.2', ['1.2.9'], ['1.3.0']);
+check('=1', ['1.5.0'], ['2.0.0']);
+check('=1.2', ['1.2.7'], ['1.3.0']);
+check('>*', [], ['1.0.0']);
+check('<*', [], ['1.0.0']);
+check('>=*', ['1.0.0']);
+
+// tilde
+check('~1.2.3', ['1.2.3', '1.2.9'], ['1.2.2', '1.3.0']);
+check('~1.2', ['1.2.0', '1.2.9'], ['1.3.0']);
+check('~1', ['1.0.0', '1.9.9'], ['2.0.0', '0.9.9']);
+check('~1.2.3-beta.2', ['1.2.3-beta.2', '1.2.3-beta.4', '1.2.3', '1.2.9'], ['1.2.3-beta.1', '1.2.4-beta.2', '1.3.0']);
+
+// caret
+check('^1.2.3', ['1.2.3', '1.9.9'], ['1.2.2', '2.0.0']);
+check('^0.2.3', ['0.2.3', '0.2.9'], ['0.3.0', '0.2.2']);
+check('^0.0.3', ['0.0.3'], ['0.0.4', '0.0.2']);
+check('^1.2', ['1.2.0', '1.9.0'], ['2.0.0', '1.1.0']);
+check('^1', ['1.0.0'], ['2.0.0']);
+check('^0.2', ['0.2.0', '0.2.9'], ['0.3.0']);
+check('^0.0', ['0.0.0', '0.0.9'], ['0.1.0']);
+check('^0', ['0.0.0', '0.9.9'], ['1.0.0']);
+check('^0.x', ['0.5.0'], ['1.0.0']);
+check('^1.2.3-beta.2', ['1.2.3-beta.2', '1.2.3-beta.5', '1.2.3', '1.9.0'], ['1.2.3-beta.1', '1.2.4-beta.2', '2.0.0']);
+
+// hyphen
+check('1.2.3 - 2.3.4', ['1.2.3', '2.3.4', '2.0.0'], ['1.2.2', '2.3.5']);
+check('1.2 - 2.3.4', ['1.2.0'], ['1.1.9', '2.3.5']);
+check('1.2.3 - 2.3', ['2.3.9'], ['2.4.0']);
+check('1.2.3 - 2', ['2.9.9'], ['3.0.0']);
+check('1.2.3-2.3.4', [], ['1.2.3']);
+
+// unions
+check('1.x || >=3.0.0 <4.0.0', ['1.5.0', '3.2.0'], ['2.0.0', '4.0.0']);
+check('<1.0.0||>2.0.0', ['0.5.0', '2.0.1'], ['1.5.0']);
+check('1.2.3 || ', ['9.9.9']);
+
+// prereleases
+test('prerelease tuple rule', () => {
+  assert.strictEqual(satisfies('1.2.3-alpha.7', '>1.2.3-alpha.3'), true);
+  assert.strictEqual(satisfies('3.4.5-alpha.9', '>1.2.3-alpha.3'), false);
+  assert.strictEqual(satisfies('1.2.4-beta', '^1.2.3'), false);
+  assert.strictEqual(satisfies('1.2.3-beta', '*'), false);
+  assert.strictEqual(satisfies('1.2.3-beta', '1.x'), false);
+  assert.strictEqual(satisfies('1.2.3-beta', '>=1.2.3-alpha <1.2.4'), true);
+  // the tuple rule applies per comparator set
+  assert.strictEqual(satisfies('1.2.3-beta', '>=1.2.3-alpha <1.2.4 || >=2.0.0'), true);
+  assert.strictEqual(satisfies('1.2.3-beta', '>=1.0.0 || >=1.2.3-alpha'), true);
+  assert.strictEqual(satisfies('1.2.3-beta', '>=1.0.0 <2.0.0 || <1.0.0-0'), false);
+  assert.strictEqual(satisfies('1.2.3-beta', '1.2.3-beta'), true);
+  assert.strictEqual(satisfies('1.2.3-beta', '1.2.3-gamma'), false);
+  assert.strictEqual(satisfies('1.0.0-rc.1', '<1.0.0'), false);
+  assert.strictEqual(satisfies('1.0.0-rc.1', '<1.0.0-rc.2'), true);
+});
