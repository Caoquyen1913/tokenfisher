@@ -17,3 +17,44 @@ test('respects the limit', () => {
   assert.strictEqual(summarize(orders).length, 10);
   assert.strictEqual(summarize(orders, 3).length, 3);
 });
+
+// Straightforward reference implementation (the original algorithm) used to pin exact output.
+function reference(orders, limit = 10) {
+  const seen = [];
+  const groups = [];
+  for (const o of orders) {
+    if (seen.includes(o.id)) continue;
+    seen.push(o.id);
+    if (o.status === 'refunded') continue;
+    let g = groups.find((x) => x.customerId === o.customerId);
+    if (!g) { g = { customerId: o.customerId, spendCents: 0, orderCount: 0, firstOrderAt: o.createdAt }; groups.push(g); }
+    g.orderCount++;
+    if (o.createdAt < g.firstOrderAt) g.firstOrderAt = o.createdAt;
+    if (o.status === 'paid') g.spendCents += o.currency === 'EUR' ? Math.round(o.amountCents * 1.08) : o.amountCents;
+    groups.sort((a, b) => (a.spendCents !== b.spendCents ? b.spendCents - a.spendCents
+      : a.firstOrderAt !== b.firstOrderAt ? (a.firstOrderAt < b.firstOrderAt ? -1 : 1)
+        : a.customerId < b.customerId ? -1 : a.customerId > b.customerId ? 1 : 0));
+  }
+  return groups.filter((g) => g.spendCents > 0).slice(0, limit).map((g, i) => ({ rank: i + 1, ...g }));
+}
+
+test('matches reference output exactly on randomized data (ties, duplicates, refunds, EUR)', () => {
+  let seed = 12345;
+  const rnd = (n) => { seed = (seed * 1103515245 + 12345) & 0x7fffffff; return seed % n; };
+  for (let round = 0; round < 30; round++) {
+    const orders = Array.from({ length: 400 }, (_, i) => order(
+      `o${rnd(300)}`, `cus_${rnd(25)}`, ['paid', 'paid', 'pending', 'refunded'][rnd(4)],
+      rnd(4) * 100, `2026-10-0${1 + rnd(3)}T1${rnd(3)}:00:00Z`, rnd(2) ? 'EUR' : 'USD'));
+    for (const limit of [1, 5, 10, 100]) {
+      assert.deepStrictEqual(summarize(orders, limit), reference(orders, limit));
+      assert.strictEqual(JSON.stringify(summarize(orders, limit)), JSON.stringify(reference(orders, limit)));
+    }
+  }
+});
+
+test('summarizes 200,000 orders quickly', () => {
+  const orders = Array.from({ length: 200000 }, (_, i) => order(`o${i}`, `cus_${i % 50000}`, 'paid', 100 + (i % 977), '2026-10-01T10:00:00Z'));
+  const t = Date.now();
+  summarize(orders);
+  assert.ok(Date.now() - t < 1000, 'summarize took too long');
+});
