+  ['1.0.0-rc.1', '1.x'], ['1.0.0-rc.1', '>=1.0.0-alpha <1.0.0-beta'], ['1.0.0-rc.1', '1.0.0'],
+  ['1.0.0-alpha', '>1.0.0-alpha.1'], ['1.0.0-alpha.1', '<1.0.0-alpha'], ['1.0.0-9', '>1.0.0-10'],
+  ['1.0.0-alpha', '>1.0.0-alpha.beta'],
