 // See docs/SPEC.md.
+const IDENT = '[0-9A-Za-z-]+';
+const DOTTED = `${IDENT}(?:\\.${IDENT})*`;
+const NUM = '0|[1-9]\\d*';
+const VERSION_RE = new RegExp(`^v?(${NUM})\\.(${NUM})\\.(${NUM})(?:-(${DOTTED}))?(?:\\+${DOTTED})?$`);
+const WILD = `${NUM}|[xX*]`;
+const PARTIAL_RE = new RegExp(
+  `^v?(${WILD})(?:\\.(${WILD})(?:\\.(${WILD})(?:-(${DOTTED}))?(?:\\+${DOTTED})?)?)?$`
+);
+
+function parseVersion(str) {
+  if (typeof str !== 'string') return null;
+  const m = VERSION_RE.exec(str.trim());
+  if (!m) return null;
+  return { major: BigInt(m[1]), minor: BigInt(m[2]), patch: BigInt(m[3]), pre: m[4] ? m[4].split('.') : null };
+}
+
+const isNumeric = (id) => /^\d+$/.test(id);
+
+function cmpIdent(a, b) {
+  const an = isNumeric(a);
+  const bn = isNumeric(b);
+  if (an && bn) {
+    const x = BigInt(a);
+    const y = BigInt(b);
+    return x < y ? -1 : x > y ? 1 : 0;
+  }
+  if (an) return -1;
+  if (bn) return 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function cmpBig(a, b) {
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function compare(a, b) {
+  const c = cmpBig(a.major, b.major) || cmpBig(a.minor, b.minor) || cmpBig(a.patch, b.patch);
+  if (c) return c;
+  if (!a.pre && !b.pre) return 0;
+  if (!a.pre) return 1;
+  if (!b.pre) return -1;
+  const n = Math.min(a.pre.length, b.pre.length);
+  for (let i = 0; i < n; i++) {
+    const r = cmpIdent(a.pre[i], b.pre[i]);
+    if (r) return r;
+  }
+  return Math.sign(a.pre.length - b.pre.length);
+}
+
+const ver = (major, minor, patch, pre = null) => ({ major, minor, patch, pre });
+const cmp = (op, v) => ({ op, v });
+const NEVER = { op: 'never' };
+
+// Parses a possibly partial version. Missing and wildcard positions are null.
+function parsePartial(str) {
+  const m = PARTIAL_RE.exec(str);
+  if (!m) return null;
+  const part = (s) => (s === undefined || /^[xX*]$/.test(s) ? null : BigInt(s));
+  const major = part(m[1]);
+  const minor = major === null ? null : part(m[2]);
+  const patch = minor === null ? null : part(m[3]);
+  if (m[4] && patch === null) return null;
+  return { major, minor, patch, pre: m[4] ? m[4].split('.') : null };
+}
+
+// Comparators for a partial version with no operator (or `=`).
+function exact(p) {
+  if (p.major === null) return [];
+  if (p.minor === null) return [cmp('>=', ver(p.major, 0n, 0n)), cmp('<', ver(p.major + 1n, 0n, 0n))];
+  if (p.patch === null) return [cmp('>=', ver(p.major, p.minor, 0n)), cmp('<', ver(p.major, p.minor + 1n, 0n))];
+  return [cmp('=', ver(p.major, p.minor, p.patch, p.pre))];
+}
+
+function lower(p) {
+  return cmp('>=', ver(p.major ?? 0n, p.minor ?? 0n, p.patch ?? 0n, p.pre));
+}
+
+// Exclusive upper bound that covers everything matching the partial version.
+function after(p) {
+  if (p.minor === null) return cmp('<', ver(p.major + 1n, 0n, 0n));
+  return cmp('<', ver(p.major, p.minor + 1n, 0n));
+}
+
+function operator(op, p) {
+  if (op === '' || op === '=') return exact(p);
+  const any = p.major === null;
+  const full = p.patch !== null;
+  switch (op) {
+    case '>':
+      if (any) return [NEVER];
+      if (full) return [cmp('>', ver(p.major, p.minor, p.patch, p.pre))];
+      return [cmp('>=', after(p).v)];
+    case '>=':
+      return any ? [] : [lower(p)];
+    case '<':
+      return any ? [NEVER] : [cmp('<', ver(p.major, p.minor ?? 0n, p.patch ?? 0n, p.pre))];
+    case '<=':
+      if (any) return [];
+      if (full) return [cmp('<=', ver(p.major, p.minor, p.patch, p.pre))];
+      return [after(p)];
+    default:
+      return null;
+  }
+}
+
+function tilde(p) {
+  if (p.major === null) return [];
+  if (p.minor === null) return [lower(p), cmp('<', ver(p.major + 1n, 0n, 0n))];
+  return [lower(p), cmp('<', ver(p.major, p.minor + 1n, 0n))];
+}
+
+function caret(p) {
+  if (p.major === null) return [];
+  let upper;
+  if (p.major > 0n || p.minor === null) upper = ver(p.major + 1n, 0n, 0n);
+  else if (p.minor > 0n || p.patch === null) upper = ver(0n, p.minor + 1n, 0n);
+  else upper = ver(0n, 0n, p.patch + 1n);
+  return [lower(p), cmp('<', upper)];
+}
+
+function hyphen(a, b) {
+  const pa = parsePartial(a);
+  const pb = parsePartial(b);
+  if (!pa || !pb) return null;
+  const out = pa.major === null ? [] : [lower(pa)];
+  if (pb.major === null) return out;
+  out.push(pb.patch !== null ? cmp('<=', ver(pb.major, pb.minor, pb.patch, pb.pre)) : after(pb));
+  return out;
+}
+
+const TOKEN_RE = /^(<=|>=|<|>|=|~|\^)?(.*)$/;
+
+function parseSet(text) {
+  const set = text.trim();
+  const sides = set.split(/\s+-\s+/);
+  if (sides.length > 2) return null;
+  if (sides.length === 2) return hyphen(sides[0], sides[1]);
+  if (set === '') return [];
+  const tokens = set.replace(/(<=|>=|<|>|=|~|\^)\s+/g, '$1').split(/\s+/);
+  const out = [];
+  for (const token of tokens) {
+    const [, op = '', rest] = TOKEN_RE.exec(token);
+    const p = parsePartial(rest);
+    if (!p) return null;
+    const cs = op === '~' ? tilde(p) : op === '^' ? caret(p) : operator(op, p);
+    if (!cs) return null;
+    out.push(...cs);
+  }
+  return out;
+}
+
+function parseRange(range) {
+  if (typeof range !== 'string') return null;
+  const sets = [];
+  for (const part of range.split('||')) {
+    const set = parseSet(part);
+    if (!set) return null;
+    sets.push(set);
+  }
+  return sets;
+}
+
+function matches(v, c) {
+  if (c.op === 'never') return false;
+  const r = compare(v, c.v);
+  switch (c.op) {
+    case '<': return r < 0;
+    case '<=': return r <= 0;
+    case '>': return r > 0;
+    case '>=': return r >= 0;
+    default: return r === 0;
+  }
+}
+
+function satisfiesSet(v, set) {
+  if (!set.every((c) => matches(v, c))) return false;
+  if (!v.pre) return true;
+  return set.some(
+    (c) => c.v && c.v.pre && c.v.major === v.major && c.v.minor === v.minor && c.v.patch === v.patch
+  );
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    const v = parseVersion(version);
+    const sets = parseRange(range);
+    if (!v || !sets) return false;
+    return sets.some((set) => satisfiesSet(v, set));
+  } catch (e) {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
