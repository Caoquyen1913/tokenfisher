 });
 test('unknown route is 404', () => assert.strictEqual(createApi(createStore())({ method: 'GET', path: '/nope' }).status, 404));
+
+function clockedApi() {
+  const time = { now: 0 };
+  const api = createApi(createStore({ clock: () => time.now }));
+  api({ method: 'POST', path: '/stock', body: { sku: 'A', qty: 5 } });
+  return { api, time };
+}
+
+test('GET /stock includes available', () => {
+  const { api } = clockedApi();
+  api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 10 } });
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }).body, { sku: 'A', stock: 5, available: 3 });
+});
+test('POST /reservations statuses', () => {
+  const { api } = clockedApi();
+  const ok = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 10 } });
+  assert.strictEqual(ok.status, 201);
+  assert.strictEqual(typeof ok.body.id, 'string');
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 9, ttlMs: 10 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 10 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+});
+test('confirm reservation via API', () => {
+  const { api } = clockedApi();
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 10 } }).body;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'A', stock: 3 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+});
+test('confirm expired reservation is 410', () => {
+  const { api, time } = clockedApi();
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 10 } }).body;
+  time.now = 10;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('DELETE /reservations/:id is 204 and idempotent', () => {
+  const { api } = clockedApi();
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 10 } }).body;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'GET', path: '/stock/A' }).body.available, 5);
+});
diff --git a/test/store.test.js b/test/store.test.js
index 8b80ad0..9b43fd8 100644
--- a/test/store.test.js
+++ b/test/store.test.js
@@ -27,3 +27,78 @@ test('quantities must be positive integers', () => {
   assert.throws(() => s.addItem('A', 0), /INVALID_QTY/);
   assert.throws(() => s.addItem('A', 1.5), /INVALID_QTY/);
 });
+
+function clocked() {
+  const time = { now: 1000 };
+  const s = createStore({ clock: () => time.now });
+  return { s, time };
+}
+
+test('reserve reduces available but not stock', () => {
+  const { s } = clocked();
+  s.addItem('A', 10);
+  const id = s.reserve('A', 4, 100);
+  assert.strictEqual(typeof id, 'string');
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.notStrictEqual(s.reserve('A', 1, 100), id);
+});
+test('reserve validates qty and availability', () => {
+  const { s } = clocked();
+  s.addItem('A', 3);
+  assert.throws(() => s.reserve('A', 0, 100), /INVALID_QTY/);
+  assert.throws(() => s.reserve('A', 1.5, 100), /INVALID_QTY/);
+  assert.throws(() => s.reserve('A', 4, 100), /INSUFFICIENT_STOCK/);
+  s.reserve('A', 3, 100);
+  assert.throws(() => s.reserve('A', 1, 100), /INSUFFICIENT_STOCK/);
+});
+test('reservation expires at creation + ttlMs', () => {
+  const { s, time } = clocked();
+  s.addItem('A', 5);
+  s.reserve('A', 5, 100);
+  time.now = 1099;
+  assert.strictEqual(s.getAvailable('A'), 0);
+  time.now = 1100;
+  assert.strictEqual(s.getAvailable('A'), 5);
+});
+test('confirm converts reservation to a sale', () => {
+  const { s } = clocked();
+  s.addItem('A', 5);
+  const id = s.reserve('A', 2, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 3);
+  assert.strictEqual(s.getAvailable('A'), 3);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm errors for unknown, released and expired', () => {
+  const { s, time } = clocked();
+  s.addItem('A', 5);
+  assert.throws(() => s.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const r = s.reserve('A', 1, 100);
+  s.release(r);
+  assert.throws(() => s.confirm(r), /RESERVATION_NOT_FOUND/);
+  const e = s.reserve('A', 1, 100);
+  time.now = 1100;
+  assert.throws(() => s.confirm(e), /RESERVATION_EXPIRED/);
+  assert.strictEqual(s.getStock('A'), 5);
+});
+test('release restores availability and is idempotent', () => {
+  const { s } = clocked();
+  s.addItem('A', 5);
+  const id = s.reserve('A', 5, 100);
+  s.release(id);
+  s.release(id);
+  s.release('unknown');
+  assert.strictEqual(s.getAvailable('A'), 5);
+});
+test('removeItem cannot remove reserved stock', () => {
+  const { s, time } = clocked();
+  s.addItem('A', 5);
+  s.reserve('A', 3, 100);
+  assert.throws(() => s.removeItem('A', 3), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 2);
+  assert.strictEqual(s.getStock('A'), 3);
+  time.now = 1100;
+  s.removeItem('A', 3);
+  assert.strictEqual(s.getStock('A'), 0);
+});
