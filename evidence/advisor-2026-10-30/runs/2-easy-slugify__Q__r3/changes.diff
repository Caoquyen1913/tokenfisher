 const assert = require('assert');
-const { capitalize } = require('../src/strings');
+const { capitalize, slugify } = require('../src/strings');
 
 test('capitalize first letter', () => assert.strictEqual(capitalize('hello'), 'Hello'));
 test('capitalize empty string', () => assert.strictEqual(capitalize(''), ''));
+
+test('slugify lowercases and hyphenates', () => assert.strictEqual(slugify('Hello World'), 'hello-world'));
+test('slugify removes Vietnamese diacritics', () =>
+  assert.strictEqual(slugify('Xin chào Việt Nam'), 'xin-chao-viet-nam'));
+test('slugify maps đ/Đ to d', () => assert.strictEqual(slugify('Đường đi'), 'duong-di'));
+test('slugify removes other Latin diacritics', () => assert.strictEqual(slugify('Café Crème Ñandú'), 'cafe-creme-nandu'));
+test('slugify collapses runs of non-alphanumerics', () => assert.strictEqual(slugify('a  --  b!!!c'), 'a-b-c'));
+test('slugify trims leading and trailing hyphens', () => assert.strictEqual(slugify('  --Hello, World!--  '), 'hello-world'));
+test('slugify keeps digits', () => assert.strictEqual(slugify('Top 10 of 2024'), 'top-10-of-2024'));
+test('slugify empty and symbol-only input', () => {
+  assert.strictEqual(slugify(''), '');
+  assert.strictEqual(slugify('!!! ???'), '');
+});
+test('slugify truncates to 50 characters', () => {
+  const slug = slugify('a'.repeat(80));
+  assert.strictEqual(slug, 'a'.repeat(50));
+});
+test('slugify truncated slug does not end with a hyphen', () => {
+  // the hyphen lands exactly at index 49 (the 50th character)
+  const slug = slugify('a'.repeat(49) + ' ' + 'b'.repeat(10));
+  assert.strictEqual(slug, 'a'.repeat(49));
+  // hyphen at index 50 is cut off entirely
+  assert.strictEqual(slugify('a'.repeat(50) + ' b'), 'a'.repeat(50));
+});
