diff --git a/test/report.test.js b/test/report.test.js
index 9353f4d..c7fe6ee 100644
--- a/test/report.test.js
+++ b/test/report.test.js
@@ -17,3 +17,69 @@ test('respects the limit', () => {
   assert.strictEqual(summarize(orders).length, 10);
   assert.strictEqual(summarize(orders, 3).length, 3);
 });
+
+// The original quadratic implementation, kept as the reference for exact output.
+function referenceSummarize(orders, limit = 10) {
+  const byRank = (a, b) => {
+    if (a.spendCents !== b.spendCents) return b.spendCents - a.spendCents;
+    if (a.firstOrderAt !== b.firstOrderAt) return a.firstOrderAt < b.firstOrderAt ? -1 : 1;
+    return a.customerId < b.customerId ? -1 : a.customerId > b.customerId ? 1 : 0;
+  };
+  const seen = [];
+  const groups = [];
+  for (const o of orders) {
+    if (seen.includes(o.id)) continue;
+    seen.push(o.id);
+    if (o.status === 'refunded') continue;
+    let group = groups.find((g) => g.customerId === o.customerId);
+    if (!group) {
+      group = { customerId: o.customerId, spendCents: 0, orderCount: 0, firstOrderAt: o.createdAt };
+      groups.push(group);
+    }
+    group.orderCount++;
+    if (o.createdAt < group.firstOrderAt) group.firstOrderAt = o.createdAt;
+    if (o.status === 'paid') group.spendCents += o.currency === 'EUR' ? Math.round(o.amountCents * 1.08) : o.amountCents;
+    groups.sort(byRank);
+  }
+  return groups.filter((g) => g.spendCents > 0).slice(0, limit).map((g, i) => ({ rank: i + 1, ...g }));
+}
+
+function randomOrders(n, customers, seed) {
+  let s = seed;
+  const rnd = (k) => { s = (s * 1664525 + 1013904223) % 4294967296; return Math.floor((s / 4294967296) * k); };
+  const statuses = ['paid', 'paid', 'pending', 'refunded'];
+  return Array.from({ length: n }, (_, i) => order(
+    `o${rnd(Math.ceil(n * 0.9))}`, // duplicate ids happen
+    `cus_${rnd(customers)}`,
+    statuses[rnd(4)],
+    rnd(5) * 100 + 100, // few distinct amounts -> many ties
+    `2026-10-01T${String(rnd(24)).padStart(2, '0')}:00:00Z`,
+    rnd(2) ? 'EUR' : 'USD',
+  ));
+}
+
+test('matches the reference implementation exactly (ties, dupes, refunds, EUR)', () => {
+  for (const seed of [1, 2, 3, 4, 5]) {
+    const orders = randomOrders(400, 25, seed);
+    for (const limit of [1, 10, 1000]) {
+      assert.deepStrictEqual(summarize(orders, limit), referenceSummarize(orders, limit));
+    }
+  }
+});
+
+test('duplicate ids are dropped even when the first copy was refunded', () => {
+  const report = summarize([
+    order('o1', 'cus_a', 'refunded', 500, '2026-10-01T10:00:00Z'),
+    order('o1', 'cus_a', 'paid', 500, '2026-10-01T10:00:00Z'),
+    order('o2', 'cus_b', 'paid', 100, '2026-10-01T10:00:00Z'),
+  ]);
+  assert.deepStrictEqual(report.map((r) => r.customerId), ['cus_b']);
+});
+
+test('handles 200,000 orders quickly', () => {
+  const orders = randomOrders(200000, 50000, 7);
+  const start = Date.now();
+  const report = summarize(orders);
+  assert.ok(Date.now() - start < 1000, 'summarize took too long');
+  assert.strictEqual(report.length, 10);
+});
