diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..9fffd65
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,111 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function setup() {
+  let now = 1000;
+  const store = createStore({ clock: () => now });
+  store.addItem('a', 10);
+  return { store, api: createApi(store), tick: (ms) => { now += ms; } };
+}
+
+test('reserve reduces available but not physical stock', () => {
+  const { store } = setup();
+  const id = store.reserve('a', 4, 100);
+  assert.strictEqual(typeof id, 'string');
+  assert.strictEqual(store.getStock('a'), 10);
+  assert.strictEqual(store.getAvailable('a'), 6);
+  assert.notStrictEqual(store.reserve('a', 1, 100), id);
+});
+
+test('reserve validates qty and availability', () => {
+  const { store } = setup();
+  for (const q of [0, -1, 1.5, '2', undefined]) assert.throws(() => store.reserve('a', q, 100), /INVALID_QTY/);
+  assert.throws(() => store.reserve('a', 11, 100), /INSUFFICIENT_STOCK/);
+  store.reserve('a', 10, 100);
+  assert.throws(() => store.reserve('a', 1, 100), /INSUFFICIENT_STOCK/);
+  assert.throws(() => store.reserve('unknown', 1, 100), /INSUFFICIENT_STOCK/);
+});
+
+test('reservation expires at exactly creation + ttl', () => {
+  const { store, tick } = setup();
+  store.reserve('a', 4, 100);
+  tick(99);
+  assert.strictEqual(store.getAvailable('a'), 6);
+  tick(1);
+  assert.strictEqual(store.getAvailable('a'), 10);
+});
+
+test('confirm converts reservation into a sale', () => {
+  const { store } = setup();
+  const id = store.reserve('a', 4, 100);
+  store.confirm(id);
+  assert.strictEqual(store.getStock('a'), 6);
+  assert.strictEqual(store.getAvailable('a'), 6);
+  assert.throws(() => store.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+
+test('confirm errors for unknown, released and expired ids', () => {
+  const { store, tick } = setup();
+  assert.throws(() => store.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const released = store.reserve('a', 1, 100);
+  store.release(released);
+  assert.throws(() => store.confirm(released), /RESERVATION_NOT_FOUND/);
+  const expiring = store.reserve('a', 1, 100);
+  tick(100);
+  assert.throws(() => store.confirm(expiring), /RESERVATION_EXPIRED/);
+  assert.strictEqual(store.getStock('a'), 10);
+});
+
+test('release frees stock and is idempotent', () => {
+  const { store } = setup();
+  const id = store.reserve('a', 4, 100);
+  store.release(id);
+  store.release(id);
+  store.release('nope');
+  assert.strictEqual(store.getAvailable('a'), 10);
+});
+
+test('removeItem cannot remove reserved stock', () => {
+  const { store, tick } = setup();
+  store.reserve('a', 4, 100);
+  assert.throws(() => store.removeItem('a', 7), /INSUFFICIENT_STOCK/);
+  store.removeItem('a', 6);
+  assert.strictEqual(store.getStock('a'), 4);
+  tick(100);
+  store.removeItem('a', 4);
+  assert.strictEqual(store.getStock('a'), 0);
+});
+
+test('API: GET /stock includes available', () => {
+  const { api } = setup();
+  api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 3, ttlMs: 100 } });
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/a' }), { status: 200, body: { sku: 'a', stock: 10, available: 7 } });
+});
+
+test('API: POST /reservations statuses', () => {
+  const { api } = setup();
+  const ok = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 3, ttlMs: 100 } });
+  assert.strictEqual(ok.status, 201);
+  assert.strictEqual(typeof ok.body.id, 'string');
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 99, ttlMs: 100 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 0, ttlMs: 100 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+});
+
+test('API: confirm statuses', () => {
+  const { api, tick } = setup();
+  const id = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 3, ttlMs: 100 } }).body.id;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'a', stock: 7 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+  const id2 = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 1, ttlMs: 100 } }).body.id;
+  tick(100);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id2}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+
+test('API: DELETE /reservations/:id returns 204 and frees stock', () => {
+  const { api } = setup();
+  const id = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 3, ttlMs: 100 } }).body.id;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'GET', path: '/stock/a' }).body.available, 10);
+});
