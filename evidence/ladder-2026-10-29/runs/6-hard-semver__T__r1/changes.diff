 // See docs/SPEC.md.
+// Numbers are BigInts so arbitrarily large components compare and increment exactly.
+
+const NUM = '0|[1-9]\\d*';
+const IDENT = '[0-9A-Za-z-]+';
+const DOTTED = `${IDENT}(?:\\.${IDENT})*`;
+const FULL = new RegExp(`^v?(${NUM})\\.(${NUM})\\.(${NUM})(?:-(${DOTTED}))?(?:\\+(${DOTTED}))?$`);
+// A partial version: each position is a number or a wildcard; trailing positions may be missing.
+// Prerelease/build are only allowed when all three positions are numbers (checked below).
+const XPART = `${NUM}|[xX*]`;
+const PARTIAL = new RegExp(`^v?(${XPART})(?:\\.(${XPART})(?:\\.(${XPART})(?:-(${DOTTED}))?(?:\\+(${DOTTED}))?)?)?$`);
+
+function parseVersion(str) {
+  const m = FULL.exec(str);
+  if (!m) return null;
+  return { major: BigInt(m[1]), minor: BigInt(m[2]), patch: BigInt(m[3]), pre: m[4] ? m[4].split('.') : [] };
+}
+
+const isWild = (s) => s === undefined || s === 'x' || s === 'X' || s === '*';
+
+// Returns { parts: [major, minor, patch] with null for wildcards, pre } or null if invalid.
+function parsePartial(str) {
+  const m = PARTIAL.exec(str);
+  if (!m) return null;
+  const parts = [m[1], m[2], m[3]].map((s) => (isWild(s) ? null : BigInt(s)));
+  // A number after a wildcard (e.g. `1.x.3`) is meaningless.
+  const firstWild = parts.indexOf(null);
+  if (firstWild !== -1 && parts.slice(firstWild).some((p) => p !== null)) return null;
+  // Prerelease/build only make sense on a complete version.
+  if ((m[4] || m[5]) && firstWild !== -1) return null;
+  return { parts, pre: m[4] ? m[4].split('.') : [] };
+}
+
+const ver = (major, minor, patch, pre = []) => ({ major, minor, patch, pre });
+const cmp = (op, v) => ({ op, v });
+const NOTHING = [cmp('<', ver(0n, 0n, 0n))];
+
+function compareIdent(a, b) {
+  const an = /^\d+$/.test(a);
+  const bn = /^\d+$/.test(b);
+  if (an && bn) {
+    const x = BigInt(a);
+    const y = BigInt(b);
+    return x < y ? -1 : x > y ? 1 : 0;
+  }
+  if (an) return -1;
+  if (bn) return 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function compare(a, b) {
+  for (const k of ['major', 'minor', 'patch']) {
+    if (a[k] !== b[k]) return a[k] < b[k] ? -1 : 1;
+  }
+  if (!a.pre.length || !b.pre.length) return (b.pre.length > 0) - (a.pre.length > 0);
+  for (let i = 0; i < Math.min(a.pre.length, b.pre.length); i++) {
+    const c = compareIdent(a.pre[i], b.pre[i]);
+    if (c) return c;
+  }
+  return Math.sign(a.pre.length - b.pre.length);
+}
+
+// Lower and exclusive upper bound of the wildcard range covered by a partial version.
+function lower({ parts: [M, m, p], pre }) {
+  return ver(M ?? 0n, m ?? 0n, p ?? 0n, pre);
+}
+function upper({ parts: [M, m] }) {
+  return m === null ? ver(M + 1n, 0n, 0n) : ver(M, m + 1n, 0n);
+}
+
+// Expands one comparator token into a list of primitive comparators, or null if invalid.
+function expand(token) {
+  const m = /^(<=|>=|<|>|=|~|\^)?(.*)$/.exec(token);
+  const op = m[1] || '=';
+  const pv = parsePartial(m[2]);
+  if (!pv) return null;
+  const [M, mi, p] = pv.parts;
+
+  if (M === null) return op === '<' || op === '>' ? NOTHING : [];
+
+  const complete = p !== null;
+  switch (op) {
+    case '=':
+      return complete ? [cmp('=', lower(pv))] : [cmp('>=', lower(pv)), cmp('<', upper(pv))];
+    case '>':
+      return complete ? [cmp('>', lower(pv))] : [cmp('>=', upper(pv))];
+    case '>=':
+      return [cmp('>=', lower(pv))];
+    case '<':
+      return [cmp('<', lower(pv))];
+    case '<=':
+      return complete ? [cmp('<=', lower(pv))] : [cmp('<', upper(pv))];
+    case '~':
+      return [cmp('>=', lower(pv)), cmp('<', mi === null ? ver(M + 1n, 0n, 0n) : ver(M, mi + 1n, 0n))];
+    case '^': {
+      let hi;
+      if (M > 0n || mi === null) hi = ver(M + 1n, 0n, 0n);
+      else if (mi > 0n || p === null) hi = ver(0n, mi + 1n, 0n);
+      else hi = ver(0n, 0n, p + 1n);
+      return [cmp('>=', lower(pv)), cmp('<', hi)];
+    }
+  }
+  return null;
+}
+
+// Parses a comparator set into a list of primitive comparators, or null if invalid.
+function parseSet(str) {
+  const hyphen = /^(\S+)\s+-\s+(\S+)$/.exec(str);
+  if (hyphen) {
+    const a = parsePartial(hyphen[1]);
+    const b = parsePartial(hyphen[2]);
+    if (!a || !b) return null;
+    const set = [];
+    if (a.parts[0] !== null) set.push(cmp('>=', lower(a)));
+    if (b.parts[0] !== null) set.push(b.parts[2] !== null ? cmp('<=', lower(b)) : cmp('<', upper(b)));
+    return set;
+  }
+  const tokens = str.replace(/(<=|>=|<|>|=|~|\^)\s+/g, '$1').split(/\s+/).filter(Boolean);
+  const set = [];
+  for (const t of tokens) {
+    const c = expand(t);
+    if (!c) return null;
+    set.push(...c);
+  }
+  return set;
+}
+
+function test(v, { op, v: w }) {
+  const c = compare(v, w);
+  switch (op) {
+    case '<': return c < 0;
+    case '<=': return c <= 0;
+    case '>': return c > 0;
+    case '>=': return c >= 0;
+    default: return c === 0;
+  }
+}
+
+function satisfiesSet(v, set) {
+  if (!set.every((c) => test(v, c))) return false;
+  if (!v.pre.length) return true;
+  return set.some(({ v: w }) => w.pre.length && w.major === v.major && w.minor === v.minor && w.patch === v.patch);
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    if (typeof version !== 'string' || typeof range !== 'string') return false;
+    const v = parseVersion(version.trim());
+    if (!v) return false;
+    const sets = range.split('||').map((s) => parseSet(s.trim()));
+    if (sets.some((s) => s === null)) return false;
+    return sets.some((s) => satisfiesSet(v, s));
+  } catch {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
