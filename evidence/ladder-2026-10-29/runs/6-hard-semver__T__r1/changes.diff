+const assert = require('assert');
+const { satisfies } = require('../src/semver');
+
+function cases(name, range, yes, no) {
+  test(`${name}: ${JSON.stringify(range)}`, () => {
+    for (const v of yes) assert.strictEqual(satisfies(v, range), true, `${v} should satisfy ${JSON.stringify(range)}`);
+    for (const v of no) assert.strictEqual(satisfies(v, range), false, `${v} should not satisfy ${JSON.stringify(range)}`);
+  });
+}
+
+// Versions
+cases('leading v and whitespace', '1.2.3', ['v1.2.3', '  1.2.3  ', '1.2.3+build.5'], ['1.2.4']);
+test('invalid versions return false', () => {
+  for (const v of ['1.2', '01.2.3', '1.02.3', '1.2.03', '1.2.3-', '1.2.3-a..b', '1.2.3+', 'a.b.c', '', '1.2.3.4', '-1.2.3']) {
+    assert.strictEqual(satisfies(v, '*'), false, v);
+  }
+  assert.strictEqual(satisfies(null, '*'), false);
+  assert.strictEqual(satisfies(undefined, '*'), false);
+  assert.strictEqual(satisfies(123, '*'), false);
+});
+test('invalid ranges return false', () => {
+  for (const r of ['blah', '>>1.2.3', '1.2.3 - ', '01.2.3', '1.x.3', '1.2-beta', '~>1.2.3', '>=1.2.3 -']) {
+    assert.strictEqual(satisfies('1.2.3', r), false, r);
+  }
+  assert.strictEqual(satisfies('1.2.3', null), false);
+  assert.strictEqual(satisfies('1.2.3', undefined), false);
+});
+
+// Ordering
+test('prerelease ordering', () => {
+  const order = ['1.0.0-alpha', '1.0.0-alpha.1', '1.0.0-alpha.beta', '1.0.0-beta', '1.0.0-beta.2', '1.0.0-beta.11', '1.0.0-rc.1', '1.0.0'];
+  for (let i = 0; i < order.length - 1; i++) {
+    // Compare via `>` so the comparator always carries a prerelease on the same tuple.
+    assert.ok(satisfies(order[i + 1], `>${order[i]}`), `${order[i]} < ${order[i + 1]}`);
+    assert.ok(!satisfies(order[i], `>${order[i + 1]}`),`!(${order[i]} > ${order[i + 1]})`);
+  }
+  assert.ok(!satisfies('1.0.0-rc.1', '>=1.0.0-rc.2'));
+});
+cases('numeric compare', '>1.2.9', ['1.2.10', '1.10.0', '10.0.0'], ['1.2.9', '1.2.1']);
+cases('build ignored in range', '=1.2.3+abc', ['1.2.3', '1.2.3+def'], ['1.2.4']);
+cases('large numbers', '>9007199254740993.0.0', ['9007199254740994.0.0'], ['9007199254740993.0.0']);
+
+// Comparators
+cases('no operator', '1.2.3', ['1.2.3'], ['1.2.4', '1.2.2']);
+cases('=', '=1.2.3', ['1.2.3'], ['1.2.4']);
+cases('<', '<1.2.3', ['1.2.2', '0.0.0'], ['1.2.3', '1.2.4']);
+cases('<=', '<=1.2.3', ['1.2.3', '1.2.2'], ['1.2.4']);
+cases('>', '>1.2.3', ['1.2.4'], ['1.2.3']);
+cases('>=', '>=1.2.3', ['1.2.3', '2.0.0'], ['1.2.2']);
+cases('whitespace after operator', '>= 1.2.3', ['1.2.3'], ['1.2.2']);
+cases('comparator set (AND)', '>=1.2.3 <2.0.0', ['1.2.3', '1.9.9'], ['2.0.0', '1.2.2']);
+cases('|| (OR)', '<1.0.0 || >=3.0.0', ['0.5.0', '3.0.0'], ['1.0.0', '2.9.9']);
+cases('|| with spaced operators', '>= 1.0.0 < 1.1.0 || 2.x', ['1.0.5', '2.3.0'], ['1.1.0', '3.0.0']);
+
+// X-ranges
+cases('*', '*', ['0.0.0', '99.99.99'], []);
+cases('empty', '', ['0.0.0', '1.2.3'], []);
+cases('whitespace only', '   ', ['1.2.3'], []);
+cases('x', 'x', ['1.2.3'], []);
+cases('1', '1', ['1.0.0', '1.9.9'], ['0.9.9', '2.0.0']);
+cases('1.x', '1.x', ['1.0.0', '1.9.9'], ['2.0.0']);
+cases('1.X.x', '1.X.x', ['1.0.0'], ['2.0.0']);
+cases('1.*', '1.*', ['1.5.0'], ['2.0.0']);
+cases('1.2', '1.2', ['1.2.0', '1.2.99'], ['1.3.0', '1.1.9']);
+cases('1.2.x', '1.2.x', ['1.2.0', '1.2.99'], ['1.3.0']);
+cases('>1', '>1', ['2.0.0'], ['1.9.9']);
+cases('>1.2', '>1.2', ['1.3.0'], ['1.2.9']);
+cases('>1.x', '>1.x', ['2.0.0'], ['1.9.9']);
+cases('>=1', '>=1', ['1.0.0'], ['0.9.9']);
+cases('>=1.2', '>=1.2', ['1.2.0'], ['1.1.9']);
+cases('<1', '<1', ['0.9.9'], ['1.0.0']);
+cases('<1.2', '<1.2', ['1.1.9'], ['1.2.0']);
+cases('<=1', '<=1', ['1.9.9'], ['2.0.0']);
+cases('<=1.2', '<=1.2', ['1.2.9'], ['1.3.0']);
+cases('=1', '=1', ['1.0.0', '1.9.9'], ['2.0.0']);
+cases('=1.2', '=1.2', ['1.2.5'], ['1.3.0']);
+cases('>=*', '>=*', ['0.0.0', '5.0.0'], []);
+cases('>*', '>*', [], ['0.0.0', '5.0.0']);
+cases('<*', '<*', [], ['0.0.0', '5.0.0']);
+
+// Tilde
+cases('~1.2.3', '~1.2.3', ['1.2.3', '1.2.9'], ['1.2.2', '1.3.0']);
+cases('~1.2', '~1.2', ['1.2.0', '1.2.9'], ['1.3.0']);
+cases('~1', '~1', ['1.0.0', '1.9.9'], ['2.0.0']);
+cases('~0.2.3', '~0.2.3', ['0.2.3', '0.2.9'], ['0.3.0']);
+cases('~1.2.3-beta.2', '~1.2.3-beta.2', ['1.2.3-beta.2', '1.2.3-beta.4', '1.2.3', '1.2.9'], ['1.2.3-beta.1', '1.2.4-beta.3', '1.3.0']);
+cases('~ with space', '~ 1.2.3', ['1.2.5'], ['1.3.0']);
+
+// Caret
+cases('^1.2.3', '^1.2.3', ['1.2.3', '1.9.9'], ['1.2.2', '2.0.0']);
+cases('^0.2.3', '^0.2.3', ['0.2.3', '0.2.9'], ['0.2.2', '0.3.0']);
+cases('^0.0.3', '^0.0.3', ['0.0.3'], ['0.0.2', '0.0.4']);
+cases('^1.2', '^1.2', ['1.2.0', '1.9.9'], ['1.1.9', '2.0.0']);
+cases('^1', '^1', ['1.0.0', '1.9.9'], ['0.9.9', '2.0.0']);
+cases('^0.2', '^0.2', ['0.2.0', '0.2.9'], ['0.3.0']);
+cases('^0.0', '^0.0', ['0.0.0', '0.0.9'], ['0.1.0']);
+cases('^0', '^0', ['0.0.0', '0.9.9'], ['1.0.0']);
+cases('^0.x', '^0.x', ['0.0.0', '0.9.9'], ['1.0.0']);
+cases('^1.2.3-beta.2', '^1.2.3-beta.2', ['1.2.3-beta.2', '1.2.3-beta.4', '1.2.3', '1.9.9'], ['1.2.3-beta.1', '1.2.4-beta.2', '2.0.0']);
+
+// Hyphen ranges
+cases('full - full', '1.2.3 - 2.3.4', ['1.2.3', '2.3.4'], ['1.2.2', '2.3.5']);
+cases('partial A', '1.2 - 2.3.4', ['1.2.0', '2.3.4'], ['1.1.9', '2.3.5']);
+cases('partial B (minor)', '1.2.3 - 2.3', ['1.2.3', '2.3.9'], ['1.2.2', '2.4.0']);
+cases('partial B (major)', '1.2.3 - 2', ['1.2.3', '2.9.9'], ['3.0.0']);
+cases('hyphen in OR', '1.0.0 - 1.0.5 || 3.x', ['1.0.5', '3.1.0'], ['1.0.6', '2.0.0']);
+test('hyphen without spaces is not a hyphen range', () => {
+  assert.strictEqual(satisfies('1.2.3', '1.2.3-2.3.4'), false);
+  assert.strictEqual(satisfies('1.2.3-2.3.4', '1.2.3-2.3.4'), true);
+});
+
+// Prereleases
+cases('prerelease same tuple', '>1.2.3-alpha.3', ['1.2.3-alpha.7', '1.2.3', '3.4.5'], ['3.4.5-alpha.9', '1.2.3-alpha.2']);
+cases('prerelease excluded by default', '^1.2.3', [], ['1.2.4-beta']);
+cases('no prerelease satisfies *', '*', [], ['1.0.0-alpha']);
+cases('prerelease on lower bound in set', '>=1.0.0-rc.1 <2.0.0', ['1.0.0-rc.2', '1.5.0'], ['1.5.0-rc.1']);
+cases('prerelease on upper bound in set', '<2.0.0-beta', ['2.0.0-alpha', '1.0.0'], ['1.0.0-alpha', '2.0.0-beta']);
+cases('prerelease in another set only', '1.x || =1.2.3-beta', ['1.2.3-beta', '1.5.0'], ['1.2.4-beta']);
+cases('exact prerelease', '1.2.3-beta', ['1.2.3-beta', '1.2.3-beta+build'], ['1.2.3-beta.1', '1.2.3']);
