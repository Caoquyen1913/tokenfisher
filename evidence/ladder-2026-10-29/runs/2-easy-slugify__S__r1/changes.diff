diff --git a/src/strings.js b/src/strings.js
index 107e994..fb0c9ac 100644
--- a/src/strings.js
+++ b/src/strings.js
@@ -3,7 +3,15 @@ function capitalize(text) {
 }
 
 function slugify(text) {
-  throw new Error('not implemented');
+  const slug = String(text)
+    .replace(/[đĐ]/g, 'd')
+    .normalize('NFD')
+    .replace(/[̀-ͯ]/g, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+/, '')
+    .replace(/-+$/, '');
+  return slug.slice(0, 50).replace(/-+$/, '');
 }
 
 module.exports = { capitalize, slugify };
diff --git a/test/strings.test.js b/test/strings.test.js
index a282d44..74cc05b 100644
--- a/test/strings.test.js
+++ b/test/strings.test.js
@@ -1,5 +1,21 @@
 const assert = require('assert');
-const { capitalize } = require('../src/strings');
+const { capitalize, slugify } = require('../src/strings');
 
 test('capitalize first letter', () => assert.strictEqual(capitalize('hello'), 'Hello'));
 test('capitalize empty string', () => assert.strictEqual(capitalize(''), ''));
+
+test('slugify lowercases and hyphenates', () => assert.strictEqual(slugify('Hello World'), 'hello-world'));
+test('slugify strips Vietnamese diacritics', () => assert.strictEqual(slugify('Đường Nguyễn Huệ, Thành phố Hồ Chí Minh'), 'duong-nguyen-hue-thanh-pho-ho-chi-minh'));
+test('slugify handles other Latin diacritics', () => assert.strictEqual(slugify('Crème Brûlée à la façon'), 'creme-brulee-a-la-facon'));
+test('slugify collapses runs of symbols', () => assert.strictEqual(slugify('a  --  b!!!c'), 'a-b-c'));
+test('slugify trims leading and trailing hyphens', () => assert.strictEqual(slugify('  --Hi there!-- '), 'hi-there'));
+test('slugify of only symbols is empty', () => assert.strictEqual(slugify('!!!'), ''));
+test('slugify truncates to 50 chars', () => assert.strictEqual(slugify('a'.repeat(80)), 'a'.repeat(50)));
+test('slugify truncated slug does not end with hyphen', () => {
+  const s = slugify('a'.repeat(49) + ' bbb');
+  assert.strictEqual(s, 'a'.repeat(49));
+});
+test('slugify keeps exactly 50 chars ending in a letter', () => {
+  const s = slugify('a'.repeat(49) + 'b c');
+  assert.strictEqual(s, 'a'.repeat(49) + 'b');
+});
