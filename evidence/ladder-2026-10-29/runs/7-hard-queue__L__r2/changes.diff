+// Promise job queue.
+//
+// Contract:
+// - add(fn) queues a job; fn may return a promise, a plain value, or throw.
+//   add() returns a promise that settles with the job's outcome.
+// - At most `concurrency` jobs run at the same time; jobs start in the order they were added.
+// - A failing job rejects its own promise only; the queue keeps going.
+// - onIdle() resolves once nothing is pending and nothing is running (immediately if already idle).
+// - pause() stops starting new jobs (running ones finish); resume() starts as many as there are free slots.
+// - `pending` and `running` report the current counts.
+function createQueue({ concurrency = 1 } = {}) {
+  const pending = [];
+  let running = 0;
+  let paused = false;
+  let idleWaiters = [];
+
+  function next() {
+    while (!paused && running < concurrency && pending.length > 0) {
+      const { fn, resolve, reject } = pending.shift();
+      running++;
+      let result;
+      try {
+        result = Promise.resolve(fn());
+      } catch (err) {
+        result = Promise.reject(err);
+      }
+      result.then(resolve, reject).then(() => {
+        running--;
+        next();
+        checkIdle();
+      });
+    }
+  }
+
+  function checkIdle() {
+    if (pending.length === 0 && running === 0) {
+      const waiters = idleWaiters;
+      idleWaiters = [];
+      waiters.forEach((wake) => wake());
+    }
+  }
+
+  return {
+    add(fn) {
+      return new Promise((resolve, reject) => {
+        pending.push({ fn, resolve, reject });
+        next();
+      });
+    },
+    onIdle() {
+      return new Promise((resolve) => {
+        idleWaiters.push(resolve);
+        checkIdle();
+      });
+    },
+    pause() {
+      paused = true;
+    },
+    resume() {
+      paused = false;
+      next();
+    },
+    get pending() {
+      return pending.length;
+    },
+    get running() {
+      return running;
+    },
+  };
+}
+
+module.exports = { createQueue };
diff --git a/test/queue.test.js b/test/queue.test.js
index be49570..b3139f5 100644
--- a/test/queue.test.js
+++ b/test/queue.test.js
@@ -15,3 +15,41 @@ test('starts jobs in order with concurrency 1', async () => {
   await Promise.all(['a', 'b', 'c'].map((x) => q.add(async () => { order.push(x); await sleep(1); })));
   assert.deepStrictEqual(order, ['a', 'b', 'c']);
 });
+
+test('queue keeps going after a failing job (async and sync throw)', async () => {
+  const q = createQueue();
+  const bad = q.add(async () => { throw new Error('x'); });
+  const sync = q.add(() => { throw new Error('y'); });
+  const plain = q.add(() => 7);
+  await assert.rejects(bad, /x/);
+  await assert.rejects(sync, /y/);
+  assert.strictEqual(await plain, 7);
+  await q.onIdle();
+  assert.strictEqual(q.running, 0);
+});
+
+test('onIdle waits for running jobs', async () => {
+  const q = createQueue({ concurrency: 2 });
+  let done = 0;
+  q.add(async () => { await sleep(5); done++; });
+  q.add(async () => { await sleep(30); done++; });
+  await sleep(1);
+  await q.onIdle();
+  assert.strictEqual(done, 2);
+});
+
+test('onIdle resolves immediately when idle', async () => {
+  await createQueue().onIdle();
+});
+
+test('resume refills all concurrency slots', async () => {
+  const q = createQueue({ concurrency: 4 });
+  q.pause();
+  const ps = [];
+  for (let i = 0; i < 6; i++) ps.push(q.add(() => sleep(20)));
+  assert.strictEqual(q.running, 0);
+  q.resume();
+  assert.strictEqual(q.running, 4);
+  assert.strictEqual(q.pending, 2);
+  await Promise.all(ps);
+});
