--- a/src/semver.js
+++ b/src/semver.js
@@ -1,6 +1,157 @@
 // See docs/SPEC.md.
+const NUM = /^(?:0|[1-9][0-9]*)$/;
+const IDENT = /^[0-9A-Za-z-]+$/;
+const PARTIAL = /^v?([^.+-]*)(?:\.([^.+-]*))?(?:\.([^.+-]*))?(?:-([^+]*))?(?:\+(.*))?$/;
+
+function validIdents(s) {
+  return s.split('.').every((id) => IDENT.test(id));
+}
+
+// Parses "1", "1.2", "1.x", "1.2.3-pre+build". Wildcard/missing parts are null.
+function parsePartial(str) {
+  const m = PARTIAL.exec(str);
+  if (!m) return null;
+  const nums = [];
+  let wild = false;
+  for (let i = 1; i <= 3; i++) {
+    const p = m[i];
+    if (p === undefined || /^[xX*]$/.test(p)) {
+      wild = true;
+      nums.push(null);
+    } else if (wild || !NUM.test(p)) {
+      return null; // "1.x.3" or non-numeric
+    } else {
+      nums.push(BigInt(p));
+    }
+  }
+  if (m[5] !== undefined && !validIdents(m[5])) return null;
+  let pre = null;
+  if (m[4] !== undefined) {
+    if (wild || !validIdents(m[4])) return null;
+    pre = m[4].split('.');
+  }
+  return { major: nums[0], minor: nums[1], patch: nums[2], pre };
+}
+
+function parseVersion(str) {
+  if (typeof str !== 'string') return null;
+  const v = parsePartial(str.trim());
+  return v && v.patch !== null ? v : null;
+}
+
+function cmpPre(a, b) {
+  if (!a && !b) return 0;
+  if (!a) return 1;
+  if (!b) return -1;
+  for (let i = 0; i < Math.min(a.length, b.length); i++) {
+    const x = a[i], y = b[i];
+    const xn = /^[0-9]+$/.test(x), yn = /^[0-9]+$/.test(y);
+    if (xn && yn) {
+      const d = BigInt(x) - BigInt(y);
+      if (d !== 0n) return d < 0n ? -1 : 1;
+    } else if (xn !== yn) {
+      return xn ? -1 : 1;
+    } else if (x !== y) {
+      return x < y ? -1 : 1;
+    }
+  }
+  return a.length === b.length ? 0 : a.length < b.length ? -1 : 1;
+}
+
+function cmp(a, b) {
+  for (const k of ['major', 'minor', 'patch']) {
+    if (a[k] !== b[k]) return a[k] < b[k] ? -1 : 1;
+  }
+  return cmpPre(a.pre, b.pre);
+}
+
+const ver = (major, minor, patch, pre = null) => ({ major, minor, patch, pre });
+const cmpr = (op, v) => ({ op, v });
+const NONE = [cmpr('<', ver(0n, 0n, 0n, ['0']))]; // nothing is lower than 0.0.0-0
+
+// Expands one token (with optional operator) into primitive comparators.
+function expand(op, p) {
+  const { major: M, minor: m, patch: pa, pre } = p;
+  const lo = (v) => cmpr('>=', v);
+  const hi = (v) => cmpr('<', v);
+  if (M === null) return op === '>' || op === '<' ? NONE : [];
+  const zero = ver(M, m === null ? 0n : m, pa === null ? 0n : pa, pre);
+  const nextMinor = () => ver(M, m + 1n, 0n);
+  const nextMajor = () => ver(M + 1n, 0n, 0n);
+  switch (op) {
+    case '~':
+      return [lo(zero), hi(m === null ? nextMajor() : nextMinor())];
+    case '^': {
+      let up;
+      if (M > 0n || m === null) up = nextMajor();
+      else if (m > 0n || pa === null) up = M === 0n && m === null ? nextMajor() : nextMinor();
+      else up = ver(0n, 0n, pa + 1n);
+      return [lo(zero), hi(up)];
+    }
+    case '':
+    case '=':
+      if (pa !== null) return [cmpr('=', zero)];
+      return [lo(zero), hi(m === null ? nextMajor() : nextMinor())];
+    case '>':
+      if (pa !== null) return [cmpr('>', zero)];
+      return [lo(m === null ? nextMajor() : nextMinor())];
+    case '>=':
+      return [lo(zero)];
+    case '<':
+      return [hi(zero)];
+    case '<=':
+      if (pa !== null) return [cmpr('<=', zero)];
+      return [hi(m === null ? nextMajor() : nextMinor())];
+  }
+  return null;
+}
+
+function parseSet(set) {
+  set = set.trim();
+  if (set === '') return [];
+  if (/\s-\s/.test(set)) {
+    const h = /^(\S+)\s+-\s+(\S+)$/.exec(set);
+    if (!h) return null;
+    const a = parsePartial(h[1]), b = parsePartial(h[2]);
+    if (!a || !b) return null;
+    return [...expand('>=', a), ...expand('<=', b)];
+  }
+  const out = [];
+  for (const tok of set.replace(/(<=|>=|<|>|=|~|\^)\s+/g, '$1').split(/\s+/)) {
+    const m = /^(<=|>=|<|>|=|~|\^)?(.*)$/.exec(tok);
+    const p = parsePartial(m[2]);
+    if (!p) return null;
+    out.push(...expand(m[1] || '', p));
+  }
+  return out;
+}
+
+function test(v, c) {
+  const d = cmp(v, c.v);
+  switch (c.op) {
+    case '=': return d === 0;
+    case '>': return d > 0;
+    case '>=': return d >= 0;
+    case '<': return d < 0;
+    case '<=': return d <= 0;
+  }
+  return false;
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    const v = parseVersion(version);
+    if (!v || typeof range !== 'string') return false;
+    const sets = range.split('||').map(parseSet);
+    if (sets.some((s) => s === null)) return false;
+    return sets.some((set) => {
+      if (!set.every((c) => test(v, c))) return false;
+      if (!v.pre) return true;
+      return set.some((c) => c.v.pre && c.v.major === v.major && c.v.minor === v.minor && c.v.patch === v.patch);
+    });
+  } catch (e) {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
