+
+// Regression: "1,005.99" (thousands separator) made parseAmount throw a TypeError -> HTTP 500 on /checkout.
+test('parses amounts with thousands separators', () => {
+  assert.strictEqual(parseAmount('1,005.99'), 100599);
+  assert.strictEqual(parseAmount('1,234,567'), 123456700);
+});
+test('rejects malformed amounts with a descriptive error', () => {
+  assert.throws(() => parseAmount('abc'), /Invalid amount: abc/);
+  assert.throws(() => parseAmount('1,23.00'), /Invalid amount/);
+});
+test('checkout handles prices over 1000', () => {
+  assert.strictEqual(checkout({ id: 'o2', items: [{ sku: 'P', price: '1,005.99', qty: 3 }] }).totalCents, 301797);
+});
