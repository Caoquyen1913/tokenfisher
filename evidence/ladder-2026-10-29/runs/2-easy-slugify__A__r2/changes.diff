diff --git a/src/strings.js b/src/strings.js
index 107e994..f3a3ed1 100644
--- a/src/strings.js
+++ b/src/strings.js
@@ -2,8 +2,20 @@ function capitalize(text) {
   return text ? text[0].toUpperCase() + text.slice(1) : text;
 }
 
+// Latin letters that NFD does not decompose into base letter + combining mark.
+const LATIN_EXTRA = { 'đ': 'd', 'ð': 'd', 'ø': 'o', 'ł': 'l', 'ħ': 'h', 'ı': 'i', 'ß': 'ss', 'æ': 'ae', 'œ': 'oe', 'þ': 'th' };
+const MAX_SLUG_LENGTH = 50;
+
 function slugify(text) {
-  throw new Error('not implemented');
+  return String(text)
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .toLowerCase()
+    .replace(/[đðøłħıßæœþ]/g, (c) => LATIN_EXTRA[c])
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, MAX_SLUG_LENGTH)
+    .replace(/-+$/, '');
 }
 
 module.exports = { capitalize, slugify };
diff --git a/test/strings.test.js b/test/strings.test.js
index a282d44..3194bf6 100644
--- a/test/strings.test.js
+++ b/test/strings.test.js
@@ -1,5 +1,28 @@
 const assert = require('assert');
-const { capitalize } = require('../src/strings');
+const { capitalize, slugify } = require('../src/strings');
 
 test('capitalize first letter', () => assert.strictEqual(capitalize('hello'), 'Hello'));
 test('capitalize empty string', () => assert.strictEqual(capitalize(''), ''));
+
+test('slugify lowercases and joins words with hyphens', () => assert.strictEqual(slugify('Hello World'), 'hello-world'));
+test('slugify removes Vietnamese diacritics', () => assert.strictEqual(slugify('Tiếng Việt có dấu'), 'tieng-viet-co-dau'));
+test('slugify maps đ and Đ to d', () => assert.strictEqual(slugify('Đường đi'), 'duong-di'));
+test('slugify removes other Latin diacritics', () => assert.strictEqual(slugify('Crème brûlée à São Paulo'), 'creme-brulee-a-sao-paulo'));
+test('slugify handles decomposed (NFD) input', () => assert.strictEqual(slugify('Việt'), 'viet'));
+test('slugify collapses runs of other characters into one hyphen', () => assert.strictEqual(slugify('a  --  b!!!c___d'), 'a-b-c-d'));
+test('slugify trims leading and trailing hyphens', () => assert.strictEqual(slugify('  ...Hello, world!?  '), 'hello-world'));
+test('slugify keeps digits', () => assert.strictEqual(slugify('Version 2.0 (2024)'), 'version-2-0-2024'));
+test('slugify returns empty string when nothing is left', () => {
+  assert.strictEqual(slugify(''), '');
+  assert.strictEqual(slugify('!!! ---'), '');
+});
+test('slugify caps length at 50', () => assert.strictEqual(slugify('a'.repeat(80)), 'a'.repeat(50)));
+test('slugify cut at 50 does not end with a hyphen', () => {
+  // The hyphen between the two words lands exactly at position 50.
+  const slug = slugify(`${'a'.repeat(49)} ${'b'.repeat(20)}`);
+  assert.strictEqual(slug, 'a'.repeat(49));
+});
+test('slugify leaves a 50-character slug untouched', () => {
+  const input = `${'a'.repeat(24)} ${'b'.repeat(25)}`;
+  assert.strictEqual(slugify(input), `${'a'.repeat(24)}-${'b'.repeat(25)}`);
+});
