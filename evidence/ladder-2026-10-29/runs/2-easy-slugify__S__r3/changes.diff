diff --git a/src/strings.js b/src/strings.js
index 107e994..318b89a 100644
--- a/src/strings.js
+++ b/src/strings.js
@@ -3,7 +3,15 @@ function capitalize(text) {
 }
 
 function slugify(text) {
-  throw new Error('not implemented');
+  return String(text)
+    .replace(/[đĐ]/g, 'd')
+    .normalize('NFD')
+    .replace(/[̀-ͯ]/g, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+/, '')
+    .slice(0, 50)
+    .replace(/-+$/, '');
 }
 
 module.exports = { capitalize, slugify };
diff --git a/test/strings.test.js b/test/strings.test.js
index a282d44..09a1b2f 100644
--- a/test/strings.test.js
+++ b/test/strings.test.js
@@ -1,5 +1,17 @@
 const assert = require('assert');
-const { capitalize } = require('../src/strings');
+const { capitalize, slugify } = require('../src/strings');
 
 test('capitalize first letter', () => assert.strictEqual(capitalize('hello'), 'Hello'));
 test('capitalize empty string', () => assert.strictEqual(capitalize(''), ''));
+
+test('slugify basic', () => assert.strictEqual(slugify('Hello, World!'), 'hello-world'));
+test('slugify Vietnamese', () => assert.strictEqual(slugify('Đường Nguyễn Huệ, Tp. Hồ Chí Minh'), 'duong-nguyen-hue-tp-ho-chi-minh'));
+test('slugify đ/Đ', () => assert.strictEqual(slugify('đĐ'), 'dd'));
+test('slugify collapses runs and trims', () => assert.strictEqual(slugify('  --a  __ b--  '), 'a-b'));
+test('slugify empty result', () => assert.strictEqual(slugify('!!!'), ''));
+test('slugify truncates to 50', () => assert.strictEqual(slugify('a'.repeat(80)).length, 50));
+test('slugify truncation never ends with hyphen', () => {
+  const r = slugify('a'.repeat(49) + ' bbb');
+  assert.strictEqual(r, 'a'.repeat(49));
+  assert.ok(slugify('ab '.repeat(30)).length <= 50 && !slugify('ab '.repeat(30)).endsWith('-'));
+});
