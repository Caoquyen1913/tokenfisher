 // In-memory inventory. `clock` is injectable so tests can control time.
 function createStore({ clock = Date.now } = {}) {
   const stock = new Map();
+  // id -> { sku, qty, expiresAt }. Entries stay until confirmed or released,
+  // so confirming an expired one can report RESERVATION_EXPIRED.
+  const reservations = new Map();
+  let nextId = 1;
 
   function assertQty(qty) {
     if (!Number.isInteger(qty) || qty <= 0) throw new Error('INVALID_QTY');
   }
 
+  function isExpired(r, now) {
+    return now >= r.expiresAt;
+  }
+
+  function reservedQty(sku, now) {
+    let total = 0;
+    for (const r of reservations.values()) {
+      if (r.sku === sku && !isExpired(r, now)) total += r.qty;
+    }
+    return total;
+  }
+
+  function available(sku, now) {
+    return (stock.get(sku) || 0) - reservedQty(sku, now);
+  }
+
   return {
     clock,
     addItem(sku, qty) {
@@ -14,13 +34,35 @@ function createStore({ clock = Date.now } = {}) {
     },
     removeItem(sku, qty) {
       assertQty(qty);
-      const current = stock.get(sku) || 0;
-      if (qty > current) throw new Error('INSUFFICIENT_STOCK');
-      stock.set(sku, current - qty);
+      if (qty > available(sku, clock())) throw new Error('INSUFFICIENT_STOCK');
+      stock.set(sku, (stock.get(sku) || 0) - qty);
     },
     getStock(sku) {
       return stock.get(sku) || 0;
     },
+    getAvailable(sku) {
+      return available(sku, clock());
+    },
+    reserve(sku, qty, ttlMs) {
+      assertQty(qty);
+      if (typeof ttlMs !== 'number' || !(ttlMs > 0)) throw new Error('INVALID_TTL');
+      const now = clock();
+      if (qty > available(sku, now)) throw new Error('INSUFFICIENT_STOCK');
+      const id = `res-${nextId++}`;
+      reservations.set(id, { sku, qty, expiresAt: now + ttlMs });
+      return id;
+    },
+    confirm(id) {
+      const r = reservations.get(id);
+      if (!r) throw new Error('RESERVATION_NOT_FOUND');
+      if (isExpired(r, clock())) throw new Error('RESERVATION_EXPIRED');
+      reservations.delete(id);
+      stock.set(r.sku, (stock.get(r.sku) || 0) - r.qty);
+      return { sku: r.sku, stock: stock.get(r.sku) };
+    },
+    release(id) {
+      reservations.delete(id);
+    },
   };
 }
 
diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..f1f7580
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,128 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function fakeClock(start = 1000) {
+  const c = () => c.now;
+  c.now = start;
+  return c;
+}
+
+function setup(qty = 10) {
+  const clock = fakeClock();
+  const s = createStore({ clock });
+  s.addItem('A', qty);
+  return { s, clock };
+}
+
+test('reserve returns unique string ids', () => {
+  const { s } = setup();
+  const a = s.reserve('A', 1, 100);
+  const b = s.reserve('A', 1, 100);
+  assert.strictEqual(typeof a, 'string');
+  assert.notStrictEqual(a, b);
+});
+test('reserve validates qty', () => {
+  const { s } = setup();
+  for (const q of [0, -1, 1.5, '2', undefined]) assert.throws(() => s.reserve('A', q, 100), /INVALID_QTY/);
+});
+test('reserve rejects more than available', () => {
+  const { s } = setup(5);
+  s.reserve('A', 3, 100);
+  assert.throws(() => s.reserve('A', 3, 100), /INSUFFICIENT_STOCK/);
+  assert.throws(() => s.reserve('missing', 1, 100), /INSUFFICIENT_STOCK/);
+  s.reserve('A', 2, 100);
+  assert.strictEqual(s.getAvailable('A'), 0);
+});
+test('available excludes active reservations; stock stays physical', () => {
+  const { s } = setup();
+  s.reserve('A', 4, 100);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('missing'), 0);
+});
+test('reservation expires exactly at creation + ttl', () => {
+  const { s, clock } = setup();
+  s.reserve('A', 4, 100);
+  clock.now = 1099;
+  assert.strictEqual(s.getAvailable('A'), 6);
+  clock.now = 1100;
+  assert.strictEqual(s.getAvailable('A'), 10);
+  s.reserve('A', 10, 100);
+});
+test('confirm sells reserved stock', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 6);
+  assert.strictEqual(s.getAvailable('A'), 6);
+});
+test('confirm rejects unknown, released and already confirmed ids', () => {
+  const { s } = setup();
+  assert.throws(() => s.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const released = s.reserve('A', 1, 100);
+  s.release(released);
+  assert.throws(() => s.confirm(released), /RESERVATION_NOT_FOUND/);
+  const confirmed = s.reserve('A', 1, 100);
+  s.confirm(confirmed);
+  assert.throws(() => s.confirm(confirmed), /RESERVATION_NOT_FOUND/);
+  assert.strictEqual(s.getStock('A'), 9);
+});
+test('confirm rejects expired reservation without touching stock', () => {
+  const { s, clock } = setup();
+  const id = s.reserve('A', 4, 100);
+  clock.now = 1100;
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+  assert.strictEqual(s.getStock('A'), 10);
+});
+test('release frees stock and is idempotent', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 4, 100);
+  s.release(id);
+  s.release(id);
+  s.release('nope');
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('removeItem cannot take reserved stock', () => {
+  const { s, clock } = setup();
+  s.reserve('A', 4, 100);
+  assert.throws(() => s.removeItem('A', 7), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 6);
+  assert.strictEqual(s.getStock('A'), 4);
+  clock.now = 1100;
+  s.removeItem('A', 4);
+  assert.strictEqual(s.getStock('A'), 0);
+});
+
+test('GET /stock includes available', () => {
+  const { s } = setup();
+  s.reserve('A', 3, 100);
+  assert.deepStrictEqual(createApi(s)({ method: 'GET', path: '/stock/A' }), { status: 200, body: { sku: 'A', stock: 10, available: 7 } });
+});
+test('POST /reservations', () => {
+  const { s } = setup(5);
+  const api = createApi(s);
+  const ok = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 2, ttlMs: 100 } });
+  assert.strictEqual(ok.status, 201);
+  assert.strictEqual(typeof ok.body.id, 'string');
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 4, ttlMs: 100 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 100 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+});
+test('POST /reservations/:id/confirm', () => {
+  const { s, clock } = setup();
+  const api = createApi(s);
+  const id = s.reserve('A', 3, 100);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'A', stock: 7 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+  const late = s.reserve('A', 1, 100);
+  clock.now = 1100;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${late}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('DELETE /reservations/:id', () => {
+  const { s } = setup();
+  const api = createApi(s);
+  const id = s.reserve('A', 3, 100);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
