diff --git a/test/api.test.js b/test/api.test.js
index 3ef8a0b..d3b2f2f 100644
--- a/test/api.test.js
+++ b/test/api.test.js
@@ -17,3 +17,44 @@ test('POST /stock rejects bad qty', () => {
   assert.deepStrictEqual(api({ method: 'POST', path: '/stock', body: { sku: 'x', qty: -1 } }), { status: 400, body: { error: 'INVALID_QTY' } });
 });
 test('unknown route is 404', () => assert.strictEqual(createApi(createStore())({ method: 'GET', path: '/nope' }).status, 404));
+
+// --- reservations ---
+function reservationApi() {
+  const t = { now: 0 };
+  const api = createApi(createStore({ clock: () => t.now }));
+  api({ method: 'POST', path: '/stock', body: { sku: 'a', qty: 5 } });
+  return { t, api };
+}
+
+test('POST /reservations then GET shows available', () => {
+  const { api } = reservationApi();
+  const res = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 2, ttlMs: 100 } });
+  assert.strictEqual(res.status, 201);
+  assert.strictEqual(typeof res.body.id, 'string');
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/a' }).body, { sku: 'a', stock: 5, available: 3 });
+});
+
+test('POST /reservations error statuses', () => {
+  const { api } = reservationApi();
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 9, ttlMs: 1 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 0, ttlMs: 1 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+});
+
+test('confirm reservation: 200, 404, 410', () => {
+  const { t, api } = reservationApi();
+  const id = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 2, ttlMs: 100 } }).body.id;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'a', stock: 3 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+  const id2 = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 1, ttlMs: 100 } }).body.id;
+  t.now = 100;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id2}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+
+test('DELETE /reservations/:id is 204 and idempotent', () => {
+  const { api } = reservationApi();
+  const id = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 2, ttlMs: 100 } }).body.id;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: '/reservations/zzz' }).status, 204);
+  assert.strictEqual(api({ method: 'GET', path: '/stock/a' }).body.available, 5);
+});
diff --git a/test/store.test.js b/test/store.test.js
index 8b80ad0..b981795 100644
--- a/test/store.test.js
+++ b/test/store.test.js
@@ -27,3 +27,72 @@ test('quantities must be positive integers', () => {
   assert.throws(() => s.addItem('A', 0), /INVALID_QTY/);
   assert.throws(() => s.addItem('A', 1.5), /INVALID_QTY/);
 });
+
+// --- reservations ---
+function clocked(start = 1000) {
+  const t = { now: start };
+  return { t, store: createStore({ clock: () => t.now }) };
+}
+
+test('reserve reduces available but not stock', () => {
+  const { store } = clocked();
+  store.addItem('a', 10);
+  const id = store.reserve('a', 4, 100);
+  assert.strictEqual(typeof id, 'string');
+  assert.notStrictEqual(id, store.reserve('a', 1, 100));
+  assert.strictEqual(store.getStock('a'), 10);
+  assert.strictEqual(store.getAvailable('a'), 5);
+});
+
+test('reserve validates qty and availability', () => {
+  const { store } = clocked();
+  store.addItem('a', 3);
+  for (const q of [0, -1, 1.5, '2', undefined]) assert.throws(() => store.reserve('a', q, 10), /INVALID_QTY/);
+  assert.throws(() => store.reserve('a', 4, 10), /INSUFFICIENT_STOCK/);
+  assert.throws(() => store.reserve('nope', 1, 10), /INSUFFICIENT_STOCK/);
+});
+
+test('reservation expires at exactly creation + ttl', () => {
+  const { t, store } = clocked();
+  store.addItem('a', 5);
+  const id = store.reserve('a', 5, 100);
+  t.now = 1099;
+  assert.strictEqual(store.getAvailable('a'), 0);
+  t.now = 1100;
+  assert.strictEqual(store.getAvailable('a'), 5);
+  assert.throws(() => store.confirm(id), /RESERVATION_EXPIRED/);
+});
+
+test('confirm converts reservation into a sale', () => {
+  const { store } = clocked();
+  store.addItem('a', 5);
+  const id = store.reserve('a', 2, 100);
+  store.confirm(id);
+  assert.strictEqual(store.getStock('a'), 3);
+  assert.strictEqual(store.getAvailable('a'), 3);
+  assert.throws(() => store.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+
+test('release is idempotent and confirm afterwards fails', () => {
+  const { store } = clocked();
+  store.addItem('a', 5);
+  const id = store.reserve('a', 2, 100);
+  store.release(id);
+  store.release(id);
+  store.release('unknown');
+  assert.strictEqual(store.getAvailable('a'), 5);
+  assert.throws(() => store.confirm(id), /RESERVATION_NOT_FOUND/);
+  assert.throws(() => store.confirm('unknown'), /RESERVATION_NOT_FOUND/);
+});
+
+test('removeItem cannot remove reserved stock', () => {
+  const { t, store } = clocked();
+  store.addItem('a', 5);
+  store.reserve('a', 3, 100);
+  assert.throws(() => store.removeItem('a', 3), /INSUFFICIENT_STOCK/);
+  store.removeItem('a', 2);
+  assert.strictEqual(store.getStock('a'), 3);
+  t.now += 100;
+  store.removeItem('a', 3);
+  assert.strictEqual(store.getStock('a'), 0);
+});
