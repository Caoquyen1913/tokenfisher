+// In-memory inventory. `clock` is injectable so tests can control time.
+function createStore({ clock = Date.now } = {}) {
+  const stock = new Map();
+  const reservations = new Map();
+  let nextId = 1;
+
+  function reservedQty(sku) {
+    const now = clock();
+    let total = 0;
+    for (const r of reservations.values()) {
+      if (r.sku === sku && now < r.expiresAt) total += r.qty;
+    }
+    return total;
+  }
+
+  function available(sku) {
+    return (stock.get(sku) || 0) - reservedQty(sku);
+  }
+
+  function assertQty(qty) {
+    if (!Number.isInteger(qty) || qty <= 0) throw new Error('INVALID_QTY');
+  }
+
+  return {
+    clock,
+    addItem(sku, qty) {
+      assertQty(qty);
+      stock.set(sku, (stock.get(sku) || 0) + qty);
+    },
+    removeItem(sku, qty) {
+      assertQty(qty);
+      if (qty > available(sku)) throw new Error('INSUFFICIENT_STOCK');
+      stock.set(sku, (stock.get(sku) || 0) - qty);
+    },
+    getAvailable(sku) {
+      return available(sku);
+    },
+    reserve(sku, qty, ttlMs) {
+      assertQty(qty);
+      if (qty > available(sku)) throw new Error('INSUFFICIENT_STOCK');
+      const id = `res-${nextId++}`;
+      reservations.set(id, { sku, qty, expiresAt: clock() + ttlMs });
+      return id;
+    },
+    confirm(id) {
+      const r = reservations.get(id);
+      if (!r) throw new Error('RESERVATION_NOT_FOUND');
+      if (clock() >= r.expiresAt) throw new Error('RESERVATION_EXPIRED');
+      reservations.delete(id);
+      stock.set(r.sku, (stock.get(r.sku) || 0) - r.qty);
+      return { sku: r.sku, qty: r.qty };
+    },
+    release(id) {
+      reservations.delete(id);
+    },
+    getStock(sku) {
+      return stock.get(sku) || 0;
+    },
+  };
+}
+
+module.exports = { createStore };
diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..6ac264b
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,87 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function setup(qty = 10) {
+  let now = 1000;
+  const store = createStore({ clock: () => now });
+  store.addItem('a', qty);
+  return { store, tick: (ms) => { now += ms; } };
+}
+
+test('reserve reduces available but not stock', () => {
+  const { store } = setup();
+  const id = store.reserve('a', 4, 100);
+  assert.strictEqual(typeof id, 'string');
+  assert.strictEqual(store.getStock('a'), 10);
+  assert.strictEqual(store.getAvailable('a'), 6);
+  assert.notStrictEqual(store.reserve('a', 1, 100), id);
+});
+test('reserve validates', () => {
+  const { store } = setup();
+  assert.throws(() => store.reserve('a', 0, 100), /INVALID_QTY/);
+  assert.throws(() => store.reserve('a', 1.5, 100), /INVALID_QTY/);
+  assert.throws(() => store.reserve('a', 11, 100), /INSUFFICIENT_STOCK/);
+});
+test('expiry boundary frees availability', () => {
+  const { store, tick } = setup();
+  store.reserve('a', 4, 100);
+  tick(99);
+  assert.strictEqual(store.getAvailable('a'), 6);
+  tick(1);
+  assert.strictEqual(store.getAvailable('a'), 10);
+});
+test('confirm reduces stock and consumes reservation', () => {
+  const { store } = setup();
+  const id = store.reserve('a', 4, 100);
+  store.confirm(id);
+  assert.strictEqual(store.getStock('a'), 6);
+  assert.strictEqual(store.getAvailable('a'), 6);
+  assert.throws(() => store.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm errors', () => {
+  const { store, tick } = setup();
+  assert.throws(() => store.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const id = store.reserve('a', 1, 10);
+  tick(10);
+  assert.throws(() => store.confirm(id), /RESERVATION_EXPIRED/);
+  const id2 = store.reserve('a', 1, 10);
+  store.release(id2);
+  assert.throws(() => store.confirm(id2), /RESERVATION_NOT_FOUND/);
+});
+test('release is idempotent', () => {
+  const { store } = setup();
+  const id = store.reserve('a', 4, 100);
+  store.release(id);
+  store.release(id);
+  store.release('unknown');
+  assert.strictEqual(store.getAvailable('a'), 10);
+});
+test('removeItem cannot remove reserved stock', () => {
+  const { store } = setup();
+  store.reserve('a', 4, 100);
+  assert.throws(() => store.removeItem('a', 7), /INSUFFICIENT_STOCK/);
+  store.removeItem('a', 6);
+  assert.strictEqual(store.getStock('a'), 4);
+});
+test('reservation API flow', () => {
+  const { store } = setup();
+  const api = createApi(store);
+  const r = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 3, ttlMs: 100 } });
+  assert.strictEqual(r.status, 201);
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/a' }).body, { sku: 'a', stock: 10, available: 7 });
+  assert.strictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 8, ttlMs: 100 } }).status, 409);
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 0, ttlMs: 100 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${r.body.id}/confirm` }), { status: 200, body: { sku: 'a', stock: 7 } });
+  assert.strictEqual(api({ method: 'POST', path: `/reservations/${r.body.id}/confirm` }).status, 404);
+});
+test('API expired confirm is 410 and delete is 204', () => {
+  const { store, tick } = setup();
+  const api = createApi(store);
+  const id = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 3, ttlMs: 5 } }).body.id;
+  tick(5);
+  const res = api({ method: 'POST', path: `/reservations/${id}/confirm` });
+  assert.deepStrictEqual(res, { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: '/reservations/zzz' }).status, 204);
+});
