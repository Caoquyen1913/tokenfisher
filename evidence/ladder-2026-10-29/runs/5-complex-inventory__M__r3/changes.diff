 });
 test('unknown route is 404', () => assert.strictEqual(createApi(createStore())({ method: 'GET', path: '/nope' }).status, 404));
+
+function timedApi() {
+  const c = { t: 0 };
+  const api = createApi(createStore({ clock: () => c.t }));
+  api({ method: 'POST', path: '/stock', body: { sku: 'a', qty: 10 } });
+  return { c, api };
+}
+test('reservation API flow', () => {
+  const { api } = timedApi();
+  const r = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 4, ttlMs: 100 } });
+  assert.strictEqual(r.status, 201);
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/a' }).body, { sku: 'a', stock: 10, available: 6 });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${r.body.id}/confirm` }), { status: 200, body: { sku: 'a', stock: 6 } });
+  assert.strictEqual(api({ method: 'POST', path: `/reservations/${r.body.id}/confirm` }).status, 404);
+});
+test('reservation API errors', () => {
+  const { c, api } = timedApi();
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 11, ttlMs: 1 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 0, ttlMs: 1 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+  const id = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 1, ttlMs: 5 } }).body.id;
+  c.t = 5;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('DELETE /reservations/:id releases and is idempotent', () => {
+  const { api } = timedApi();
+  const id = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 4, ttlMs: 100 } }).body.id;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'GET', path: '/stock/a' }).body.available, 10);
+});
diff --git a/test/store.test.js b/test/store.test.js
index 8b80ad0..e93b05a 100644
--- a/test/store.test.js
+++ b/test/store.test.js
@@ -27,3 +27,60 @@ test('quantities must be positive integers', () => {
   assert.throws(() => s.addItem('A', 0), /INVALID_QTY/);
   assert.throws(() => s.addItem('A', 1.5), /INVALID_QTY/);
 });
+
+function timed() {
+  const c = { t: 1000 };
+  const s = createStore({ clock: () => c.t });
+  s.addItem('a', 10);
+  return { c, s };
+}
+test('reserve reduces available but not stock', () => {
+  const { s } = timed();
+  const id = s.reserve('a', 4, 100);
+  assert.strictEqual(typeof id, 'string');
+  assert.notStrictEqual(id, s.reserve('a', 1, 100));
+  assert.strictEqual(s.getStock('a'), 10);
+  assert.strictEqual(s.getAvailable('a'), 5);
+});
+test('reserve validates qty and availability', () => {
+  const { s } = timed();
+  assert.throws(() => s.reserve('a', 0, 100), /INVALID_QTY/);
+  assert.throws(() => s.reserve('a', 1.5, 100), /INVALID_QTY/);
+  assert.throws(() => s.reserve('a', 11, 100), /INSUFFICIENT_STOCK/);
+});
+test('reservation expires at exactly created + ttl', () => {
+  const { c, s } = timed();
+  const id = s.reserve('a', 4, 100);
+  c.t = 1099;
+  assert.strictEqual(s.getAvailable('a'), 6);
+  c.t = 1100;
+  assert.strictEqual(s.getAvailable('a'), 10);
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+});
+test('confirm converts reservation into sale once', () => {
+  const { s } = timed();
+  const id = s.reserve('a', 4, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('a'), 6);
+  assert.strictEqual(s.getAvailable('a'), 6);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+  assert.throws(() => s.confirm('nope'), /RESERVATION_NOT_FOUND/);
+});
+test('release is idempotent and frees stock', () => {
+  const { s } = timed();
+  const id = s.reserve('a', 4, 100);
+  s.release(id);
+  s.release(id);
+  s.release('nope');
+  assert.strictEqual(s.getAvailable('a'), 10);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('removeItem cannot remove reserved stock', () => {
+  const { c, s } = timed();
+  s.reserve('a', 4, 100);
+  assert.throws(() => s.removeItem('a', 7), /INSUFFICIENT_STOCK/);
+  s.removeItem('a', 6);
+  assert.strictEqual(s.getStock('a'), 4);
+  c.t = 2000;
+  s.removeItem('a', 4);
+});
