diff --git a/src/store.js b/src/store.js
index 77755be..ec9def7 100644
--- a/src/store.js
+++ b/src/store.js
@@ -1,25 +1,66 @@
 // In-memory inventory. `clock` is injectable so tests can control time.
 function createStore({ clock = Date.now } = {}) {
   const stock = new Map();
+  // id -> { sku, qty, expiresAt }. Entries are removed on confirm/release;
+  // expired ones are kept so confirm() can report RESERVATION_EXPIRED.
+  const reservations = new Map();
+  let nextId = 1;
 
   function assertQty(qty) {
     if (!Number.isInteger(qty) || qty <= 0) throw new Error('INVALID_QTY');
   }
 
+  function isExpired(r, now) {
+    return now >= r.expiresAt;
+  }
+
+  function reserved(sku) {
+    const now = clock();
+    let total = 0;
+    for (const r of reservations.values()) {
+      if (r.sku === sku && !isExpired(r, now)) total += r.qty;
+    }
+    return total;
+  }
+
+  function getStock(sku) {
+    return stock.get(sku) || 0;
+  }
+
+  function getAvailable(sku) {
+    return getStock(sku) - reserved(sku);
+  }
+
   return {
     clock,
     addItem(sku, qty) {
       assertQty(qty);
-      stock.set(sku, (stock.get(sku) || 0) + qty);
+      stock.set(sku, getStock(sku) + qty);
     },
     removeItem(sku, qty) {
       assertQty(qty);
-      const current = stock.get(sku) || 0;
-      if (qty > current) throw new Error('INSUFFICIENT_STOCK');
-      stock.set(sku, current - qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      stock.set(sku, getStock(sku) - qty);
+    },
+    getStock,
+    getAvailable,
+    reserve(sku, qty, ttlMs) {
+      assertQty(qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      const id = `res-${nextId++}`;
+      reservations.set(id, { sku, qty, expiresAt: clock() + ttlMs });
+      return id;
+    },
+    confirm(id) {
+      const r = reservations.get(id);
+      if (!r) throw new Error('RESERVATION_NOT_FOUND');
+      if (isExpired(r, clock())) throw new Error('RESERVATION_EXPIRED');
+      reservations.delete(id);
+      stock.set(r.sku, getStock(r.sku) - r.qty);
+      return { sku: r.sku, stock: getStock(r.sku) };
     },
-    getStock(sku) {
-      return stock.get(sku) || 0;
+    release(id) {
+      reservations.delete(id);
     },
   };
 }
diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..a18341d
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,150 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function fakeClock(start = 1000) {
+  let now = start;
+  const clock = () => now;
+  clock.advance = (ms) => { now += ms; };
+  return clock;
+}
+
+function setup(qty = 10) {
+  const clock = fakeClock();
+  const s = createStore({ clock });
+  s.addItem('A', qty);
+  return { s, clock };
+}
+
+test('reserve reduces available but not physical stock', () => {
+  const { s } = setup();
+  s.reserve('A', 3, 1000);
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('A'), 7);
+});
+test('reserve returns unique string ids', () => {
+  const { s } = setup();
+  const a = s.reserve('A', 1, 1000);
+  const b = s.reserve('A', 1, 1000);
+  assert.strictEqual(typeof a, 'string');
+  assert.notStrictEqual(a, b);
+});
+test('reserve validates qty', () => {
+  const { s } = setup();
+  for (const q of [0, -1, 1.5, '2', undefined]) assert.throws(() => s.reserve('A', q, 1000), /INVALID_QTY/);
+});
+test('reserve rejects more than available', () => {
+  const { s } = setup(5);
+  s.reserve('A', 4, 1000);
+  assert.throws(() => s.reserve('A', 2, 1000), /INSUFFICIENT_STOCK/);
+  s.reserve('A', 1, 1000);
+  assert.strictEqual(s.getAvailable('A'), 0);
+  assert.throws(() => s.reserve('nope', 1, 1000), /INSUFFICIENT_STOCK/);
+});
+test('reservation expires exactly at creation + ttl', () => {
+  const { s, clock } = setup();
+  s.reserve('A', 4, 100);
+  clock.advance(99);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  clock.advance(1);
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('expired reservations free stock for new reservations', () => {
+  const { s, clock } = setup(5);
+  s.reserve('A', 5, 100);
+  clock.advance(100);
+  s.reserve('A', 5, 100);
+  assert.strictEqual(s.getAvailable('A'), 0);
+});
+test('confirm sells the reserved stock', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 3, 1000);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 7);
+  assert.strictEqual(s.getAvailable('A'), 7);
+});
+test('confirm twice, after release, or unknown id is NOT_FOUND', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 3, 1000);
+  s.confirm(id);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+  const id2 = s.reserve('A', 1, 1000);
+  s.release(id2);
+  assert.throws(() => s.confirm(id2), /RESERVATION_NOT_FOUND/);
+  assert.throws(() => s.confirm('bogus'), /RESERVATION_NOT_FOUND/);
+  assert.strictEqual(s.getStock('A'), 7);
+});
+test('confirm of expired reservation throws EXPIRED and leaves stock', () => {
+  const { s, clock } = setup();
+  const id = s.reserve('A', 3, 100);
+  clock.advance(100);
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('release frees stock and is idempotent', () => {
+  const { s } = setup();
+  const id = s.reserve('A', 3, 1000);
+  s.release(id);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  s.release(id);
+  s.release('bogus');
+  assert.strictEqual(s.getAvailable('A'), 10);
+  assert.strictEqual(s.getStock('A'), 10);
+});
+test('removeItem cannot take reserved stock', () => {
+  const { s, clock } = setup();
+  s.reserve('A', 6, 100);
+  assert.throws(() => s.removeItem('A', 5), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 4);
+  assert.strictEqual(s.getStock('A'), 6);
+  assert.strictEqual(s.getAvailable('A'), 0);
+  clock.advance(100);
+  s.removeItem('A', 6);
+  assert.strictEqual(s.getStock('A'), 0);
+});
+test('reservations are per sku', () => {
+  const { s } = setup();
+  s.addItem('B', 2);
+  s.reserve('A', 10, 1000);
+  assert.strictEqual(s.getAvailable('B'), 2);
+});
+
+// API
+function apiSetup() {
+  const clock = fakeClock();
+  const api = createApi(createStore({ clock }));
+  api({ method: 'POST', path: '/stock', body: { sku: 'A', qty: 10 } });
+  return { api, clock };
+}
+
+test('GET /stock includes available', () => {
+  const { api } = apiSetup();
+  api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 4, ttlMs: 1000 } });
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }), { status: 200, body: { sku: 'A', stock: 10, available: 6 } });
+});
+test('POST /reservations status codes', () => {
+  const { api } = apiSetup();
+  const ok = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 4, ttlMs: 1000 } });
+  assert.strictEqual(ok.status, 201);
+  assert.strictEqual(typeof ok.body.id, 'string');
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 7, ttlMs: 1000 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 1000 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+});
+test('POST /reservations/:id/confirm status codes', () => {
+  const { api, clock } = apiSetup();
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 4, ttlMs: 1000 } }).body;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'A', stock: 6 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+  const { id: id2 } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 1, ttlMs: 50 } }).body;
+  clock.advance(50);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id2}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('DELETE /reservations/:id returns 204 and releases', () => {
+  const { api } = apiSetup();
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 4, ttlMs: 1000 } }).body;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'GET', path: '/stock/A' }).body.available, 10);
+});
