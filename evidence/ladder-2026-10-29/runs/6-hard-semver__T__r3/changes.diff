+const assert = require('assert');
+const { satisfies } = require('../src/semver');
+
+function check(range, yes, no) {
+  test(`satisfies(_, ${JSON.stringify(range)})`, () => {
+    for (const v of yes) assert.strictEqual(satisfies(v, range), true, `${v} should satisfy ${range}`);
+    for (const v of no) assert.strictEqual(satisfies(v, range), false, `${v} should not satisfy ${range}`);
+  });
+}
+
+// Versions
+check('1.2.3', ['1.2.3', 'v1.2.3', '  1.2.3  ', '1.2.3+build.5'], ['1.2.4', '1.2.3-alpha']);
+check('*', ['0.0.0', '1.2.3', '99999999999999999999.0.0'], ['1.2.3-alpha', '01.2.3', '1.2', '1.2.3.4', 'x.1.2', '1.2.3-', '1.2.3-a..b', 'V1.2.3']);
+check('=1.2.3+abc', ['1.2.3', '1.2.3+other'], ['1.2.4']);
+check('>=v1.2.3', ['1.2.3'], ['1.2.2']);
+
+// Ordering, via comparators
+check('>1.0.0-alpha <1.0.0', ['1.0.0-alpha.1', '1.0.0-alpha.beta', '1.0.0-beta', '1.0.0-beta.2', '1.0.0-beta.11', '1.0.0-rc.1'], ['1.0.0-alpha', '1.0.0', '1.0.0-0']);
+check('>1.0.0-beta.2', ['1.0.0-beta.11', '1.0.0-beta.x', '1.0.0-beta.2.0', '1.0.0'], ['1.0.0-beta.2', '1.0.0-beta.1', '1.0.0-beta']);
+check('<1.0.0-alpha', ['0.9.9', '1.0.0-1', '1.0.0-Zeta'], ['1.0.0-alpha', '1.0.0-alpha.0', '1.0.0']);
+check('<2.0.0', ['1.99.99', '1.10.0'], ['2.0.0', '10.0.0']);
+check('>99999999999999999998.0.0', ['99999999999999999999.0.0'], ['99999999999999999998.0.0']);
+
+// Operators, whitespace
+check('>= 1.2.3 < 2', ['1.2.3', '1.9.9'], ['1.2.2', '2.0.0']);
+check('<=1.2.3', ['1.2.3', '0.0.0'], ['1.2.4']);
+check('>1.2.3', ['1.2.4'], ['1.2.3']);
+check('<1.2.3', ['1.2.2'], ['1.2.3']);
+
+// X-ranges
+check('', ['0.0.0', '5.5.5'], ['1.0.0-beta']);
+check('   ', ['1.2.3'], []);
+check('1', ['1.0.0', '1.9.9'], ['0.9.9', '2.0.0']);
+check('1.x', ['1.0.0', '1.9.9'], ['2.0.0']);
+check('1.X.*', ['1.5.0'], ['2.0.0']);
+check('1.2', ['1.2.0', '1.2.99'], ['1.3.0', '1.1.9']);
+check('1.2.x', ['1.2.0'], ['1.3.0']);
+check('x', ['3.2.1'], []);
+check('>1', ['2.0.0'], ['1.9.9', '2.0.0-alpha']);
+check('>1.2', ['1.3.0'], ['1.2.9']);
+check('>1.x', ['2.0.0'], ['1.9.9']);
+check('>=1', ['1.0.0'], ['0.9.9']);
+check('>=1.2', ['1.2.0'], ['1.1.9']);
+check('<1', ['0.9.9'], ['1.0.0']);
+check('<1.2', ['1.1.9'], ['1.2.0']);
+check('<=1', ['1.9.9'], ['2.0.0']);
+check('<=1.2', ['1.2.9'], ['1.3.0']);
+check('=1', ['1.0.0', '1.9.9'], ['2.0.0']);
+check('=1.2', ['1.2.5'], ['1.3.0']);
+check('>*', [], ['0.0.0', '1.2.3']);
+check('<*', [], ['0.0.0']);
+check('>=*', ['0.0.0'], []);
+check('<=*', ['1.0.0'], []);
+
+// Tilde
+check('~1.2.3', ['1.2.3', '1.2.9'], ['1.2.2', '1.3.0', '1.3.0-beta']);
+check('~1.2', ['1.2.0', '1.2.9'], ['1.3.0']);
+check('~1', ['1.0.0', '1.9.9'], ['2.0.0']);
+check('~1.2.3-beta.2', ['1.2.3-beta.2', '1.2.3-beta.10', '1.2.3', '1.2.9'], ['1.2.3-beta.1', '1.2.4-beta.3', '1.3.0']);
+check('~*', ['0.1.0'], []);
+
+// Caret
+check('^1.2.3', ['1.2.3', '1.9.9'], ['1.2.2', '2.0.0', '1.2.4-beta']);
+check('^0.2.3', ['0.2.3', '0.2.9'], ['0.2.2', '0.3.0']);
+check('^0.0.3', ['0.0.3'], ['0.0.2', '0.0.4']);
+check('^0.0.0', ['0.0.0'], ['0.0.1']);
+check('^1.2', ['1.2.0', '1.9.0'], ['1.1.9', '2.0.0']);
+check('^1', ['1.0.0', '1.9.9'], ['0.9.9', '2.0.0']);
+check('^0.2', ['0.2.0', '0.2.9'], ['0.3.0']);
+check('^0.0', ['0.0.0', '0.0.9'], ['0.1.0']);
+check('^0', ['0.0.0', '0.9.9'], ['1.0.0']);
+check('^0.x', ['0.5.0'], ['1.0.0']);
+check('^1.2.3-beta.2', ['1.2.3-beta.2', '1.2.3-beta.4', '1.2.3', '1.9.9'], ['1.2.3-beta.1', '1.2.4-beta.2', '2.0.0']);
+
+// Hyphen ranges
+check('1.2.3 - 2.3.4', ['1.2.3', '2.3.4'], ['1.2.2', '2.3.5']);
+check('1.2 - 2.3.4', ['1.2.0'], ['1.1.9', '2.3.5']);
+check('1.2.3 - 2.3', ['2.3.9'], ['2.4.0', '1.2.2']);
+check('1.2.3 - 2', ['2.9.9'], ['3.0.0']);
+check('1.2.3-beta - 2', ['1.2.3-beta', '1.2.3'], ['1.2.3-alpha', '2.0.0-beta']);
+
+// Union
+check('1.x || >=2.5.0 || 5.0.0 - 7.2.3', ['1.2.3', '2.5.0', '3.0.0'], ['2.4.9', '0.1.0']);
+check('<1.0.0 || >=2.0.0', ['0.5.0', '2.0.0'], ['1.5.0']);
+check('1.x ||', ['9.9.9'], []);
+
+// Prereleases
+check('>1.2.3-alpha.3', ['1.2.3-alpha.7', '1.2.3', '3.4.5'], ['3.4.5-alpha.9', '1.2.3-alpha.3']);
+check('>=1.2.3-alpha <1.2.3 || ^2.0.0-rc.1', ['1.2.3-beta', '2.0.0-rc.2'], ['2.1.0-rc.1']);
+check('<1.2.3-beta', ['1.2.3-alpha', '1.2.2'], ['1.2.2-alpha']);
+
+// Invalid input never throws and returns false
+test('invalid input returns false', () => {
+  const bad = [
+    ['1.2.3', '>>1.2.3'], ['1.2.3', '~>1.2.3'], ['1.2.3', 'foo'], ['1.2.3', '1.x.3'], ['1.2.3', '1.2-beta'],
+    ['1.2.3', '01.2.3'], ['1.2.3', '1.2.3 -'], ['1.2.3', '1.2.3 -2.0.0'], ['1.2.3', '>='],
+    ['1.2.3', '>= 1 - 2'], ['1.2.3', '1.2.3 || foo'], ['1.2.3', null], ['1.2.3', 42], [null, '*'], [undefined, '*'],
+    [{}, '*'], ['1.2', '*'], ['1.2.x', '*'], ['', '*'], ['1.2.3', '~ 1.2.3'],
+  ];
+  for (const [v, r] of bad) assert.strictEqual(satisfies(v, r), false, `${v} / ${r}`);
+});
