+++ b/src/semver.js
@@ -1,6 +1,199 @@
 // See docs/SPEC.md.
+const NUM = /^(?:0|[1-9][0-9]*)$/;
+const IDENT = /^[0-9A-Za-z-]+$/;
+const PARTIAL = /^v?([0-9]+|[xX*])(?:\.([0-9]+|[xX*]))?(?:\.([0-9]+|[xX*]))?(?:-([0-9A-Za-z.-]+))?(?:\+([0-9A-Za-z.-]+))?$/;
+
+const isWild = (p) => p === 'x' || p === 'X' || p === '*';
+
+// Parses a possibly partial version. Returns { parts: [major, minor, patch] (BigInt | null for
+// wildcard/missing), pre: string[] | null } or null when invalid.
+function parsePartial(str) {
+  const m = PARTIAL.exec(str);
+  if (!m) return null;
+  const parts = [];
+  let wild = false;
+  for (let i = 1; i <= 3; i++) {
+    const p = m[i];
+    if (p === undefined || isWild(p)) {
+      wild = true;
+      parts.push(null);
+    } else {
+      if (wild || !NUM.test(p)) return null; // "1.x.3" or leading zeros
+      parts.push(BigInt(p));
+    }
+  }
+  let pre = null;
+  if (m[4] !== undefined || m[5] !== undefined) {
+    if (wild) return null; // prerelease/build only on full versions
+    if (m[4] !== undefined) {
+      pre = m[4].split('.');
+      if (!pre.every((id) => IDENT.test(id))) return null;
+    }
+    if (m[5] !== undefined && !m[5].split('.').every((id) => IDENT.test(id))) return null;
+  }
+  return { parts, pre };
+}
+
+function parseVersion(str) {
+  if (typeof str !== 'string') return null;
+  const p = parsePartial(str.trim());
+  if (!p || p.parts[2] === null) return null;
+  return { major: p.parts[0], minor: p.parts[1], patch: p.parts[2], pre: p.pre };
+}
+
+const mk = (major, minor, patch, pre = null) => ({ major, minor, patch, pre });
+
+function cmpId(a, b) {
+  const an = /^[0-9]+$/.test(a);
+  const bn = /^[0-9]+$/.test(b);
+  if (an && bn) {
+    const x = BigInt(a);
+    const y = BigInt(b);
+    return x < y ? -1 : x > y ? 1 : 0;
+  }
+  if (an) return -1;
+  if (bn) return 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function compare(a, b) {
+  for (const k of ['major', 'minor', 'patch']) {
+    if (a[k] !== b[k]) return a[k] < b[k] ? -1 : 1;
+  }
+  if (!a.pre && !b.pre) return 0;
+  if (!a.pre) return 1;
+  if (!b.pre) return -1;
+  const n = Math.min(a.pre.length, b.pre.length);
+  for (let i = 0; i < n; i++) {
+    const c = cmpId(a.pre[i], b.pre[i]);
+    if (c) return c;
+  }
+  return a.pre.length === b.pre.length ? 0 : a.pre.length < b.pre.length ? -1 : 1;
+}
+
+// A comparator is { op, v }; a comparator set is an array of them ([] matches any non-prerelease).
+// NEVER is a set that matches nothing.
+const NEVER = [{ op: '<', v: mk(0n, 0n, 0n) }];
+const ge = (v) => ({ op: '>=', v });
+const lt = (v) => ({ op: '<', v });
+
+// Lower bound of a partial version, zero-filled.
+function lower(p) {
+  const [a, b, c] = p.parts;
+  if (a === null) return [];
+  return [ge(mk(a, b ?? 0n, c ?? 0n, p.pre))];
+}
+
+// Exclusive upper bound that covers everything matching the partial version.
+function upper(p) {
+  const [a, b, c] = p.parts;
+  if (a === null) return [];
+  if (b === null) return [lt(mk(a + 1n, 0n, 0n))];
+  if (c === null) return [lt(mk(a, b + 1n, 0n))];
+  return null; // full version: no widening
+}
+
+function xrange(p) {
+  if (p.parts[2] !== null) return [{ op: '=', v: mk(...p.parts, p.pre) }];
+  return [...lower(p), ...(upper(p) || [])];
+}
+
+function tilde(p) {
+  const [a, b] = p.parts;
+  if (a === null) return [];
+  return [...lower(p), lt(b === null ? mk(a + 1n, 0n, 0n) : mk(a, b + 1n, 0n))];
+}
+
+function caret(p) {
+  const [a, b, c] = p.parts;
+  if (a === null) return [];
+  let hi;
+  if (a !== 0n) hi = mk(a + 1n, 0n, 0n);
+  else if (b === null) hi = mk(1n, 0n, 0n);
+  else if (b !== 0n) hi = mk(0n, b + 1n, 0n);
+  else if (c === null) hi = mk(0n, 1n, 0n);
+  else hi = mk(0n, 0n, c + 1n);
+  return [...lower(p), lt(hi)];
+}
+
+function primitive(op, p) {
+  const any = p.parts[0] === null;
+  const full = p.parts[2] !== null;
+  switch (op) {
+    case '':
+    case '=':
+      return xrange(p);
+    case '~':
+      return tilde(p);
+    case '^':
+      return caret(p);
+    case '>=':
+      return lower(p);
+    case '<':
+      return any ? NEVER : [lt(mk(p.parts[0], p.parts[1] ?? 0n, p.parts[2] ?? 0n, p.pre))];
+    case '>':
+      if (any) return NEVER;
+      if (full) return [{ op: '>', v: mk(...p.parts, p.pre) }];
+      return [ge(p.parts[1] === null ? mk(p.parts[0] + 1n, 0n, 0n) : mk(p.parts[0], p.parts[1] + 1n, 0n))];
+    case '<=':
+      if (full) return [{ op: '<=', v: mk(...p.parts, p.pre) }];
+      return upper(p) || [];
+    default:
+      return null;
+  }
+}
+
+// Returns an array of comparators, or null when the set is invalid.
+function parseSet(set) {
+  const text = set.replace(/(<=|>=|<|>|=|~|\^)\s+/g, '$1').trim();
+  if (text === '') return [];
+  const tokens = text.split(/\s+/);
+  if (tokens.includes('-')) {
+    if (tokens.length !== 3 || tokens[1] !== '-') return null;
+    const a = parsePartial(tokens[0]);
+    const b = parsePartial(tokens[2]);
+    if (!a || !b) return null;
+    return [...lower(a), ...(b.parts[2] !== null ? [{ op: '<=', v: mk(...b.parts, b.pre) }] : upper(b) || [])];
+  }
+  const out = [];
+  for (const tok of tokens) {
+    const m = /^(<=|>=|<|>|=|~|\^)?(.*)$/.exec(tok);
+    const p = parsePartial(m[2]);
+    if (!p) return null;
+    out.push(...primitive(m[1] || '', p));
+  }
+  return out;
+}
+
+function test(v, { op, v: c }) {
+  const r = compare(v, c);
+  switch (op) {
+    case '<': return r < 0;
+    case '<=': return r <= 0;
+    case '>': return r > 0;
+    case '>=': return r >= 0;
+    default: return r === 0;
+  }
+}
+
+function satisfiesSet(v, comparators) {
+  if (!comparators.every((c) => test(v, c))) return false;
+  if (!v.pre) return true;
+  return comparators.some(
+    (c) => c.v.pre && c.v.major === v.major && c.v.minor === v.minor && c.v.patch === v.patch
+  );
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    const v = parseVersion(version);
+    if (!v || typeof range !== 'string') return false;
+    const sets = range.split('||').map(parseSet);
+    if (sets.some((s) => s === null)) return false;
+    return sets.some((s) => satisfiesSet(v, s));
+  } catch (e) {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
