+  ['1.2.3-beta', '>=1.2.2 <1.2.3-rc', true], // one comparator with a same-tuple prerelease is enough
+  ['1.2.3-beta', '>=1.2.3-alpha <1.2.3-alpha.1', false], // ...but every comparator must still pass
+  ['1.2.3-beta', '>=1.2.2-alpha <1.2.4', false], // prerelease on a different tuple
+  ['1.2.3-beta', '^1.2.3 || >=1.2.3-alpha <1.2.3', true], // second set qualifies
+  ['1.2.3-beta', '1.2.3-alpha - 1.2.3', true],
+]));
