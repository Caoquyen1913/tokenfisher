@@ -0,0 +1,229 @@
+const assert = require('assert');
+const { satisfies } = require('../src/semver');
+
+// [version, range, expected]
+function check(cases) {
+  const failures = cases
+    .filter(([v, r, want]) => satisfies(v, r) !== want)
+    .map(([v, r, want]) => `satisfies(${JSON.stringify(v)}, ${JSON.stringify(r)}) should be ${want}`);
+  assert.deepStrictEqual(failures, []);
+}
+
+test('versions: parsing, leading v, whitespace, build metadata', () => check([
+  ['1.2.3', '1.2.3', true],
+  ['v1.2.3', '1.2.3', true],
+  ['  1.2.3\t', '1.2.3', true],
+  ['1.2.3+build.5', '1.2.3', true],
+  ['1.2.3', '=1.2.3+other', true],
+  ['1.2.3-alpha.1+b', '1.2.3-alpha.1', true],
+  ['1.2.4', '1.2.3', false],
+]));
+
+test('invalid versions return false', () => check([
+  ['01.2.3', '*', false],
+  ['1.02.3', '*', false],
+  ['1.2', '*', false],
+  ['1.2.3.4', '*', false],
+  ['1.2.3-', '*', false],
+  ['1.2.3-a..b', '*', false],
+  ['1.2.3+', '*', false],
+  ['1.2.3-a_b', '*', false],
+  ['x.2.3', '*', false],
+  ['', '*', false],
+  ['vv1.2.3', '*', false],
+]));
+
+test('never throws on bad input', () => {
+  for (const [v, r] of [[null, '*'], ['1.2.3', null], [undefined, undefined], [123, '*'], ['1.2.3', {}], ['1.2.3', 5]]) {
+    assert.strictEqual(satisfies(v, r), false);
+  }
+});
+
+test('invalid ranges return false', () => check([
+  ['1.2.3', 'blah', false],
+  ['1.2.3', '>=1.2.3 junk', false],
+  ['1.2.3', '1.2.3 -', false],
+  ['1.2.3', '- 1.2.3', false],
+  ['1.2.3', '1.2.3-2.0.0', false],
+  ['1.2.3', '>>1.2.3', false],
+  ['1.2.3', '01.2.3', false],
+  ['1.2.3', '1.2-beta', false],
+  ['1.2.3', '1 | 2', false],
+  ['1.2.3', '1.2.3 || bad', false],
+]));
+
+test('ordering', () => check([
+  ['1.0.0-rc.1', '<1.0.0-rc.2', true],
+  ['1.0.0-alpha', '<1.0.0-alpha.1', true],
+  ['1.0.0-alpha.1', '<1.0.0-alpha.beta', true],
+  ['1.0.0-alpha.beta', '<1.0.0-beta', true],
+  ['1.0.0-beta.2', '<1.0.0-beta.11', true],
+  ['1.0.0-beta.11', '<1.0.0-rc.1', true],
+  ['1.0.0-rc.1', '<1.0.0', false], // prerelease rule: no comparator has a prerelease
+  ['1.0.0-rc.1', '>=1.0.0-0 <1.0.0', true],
+  ['1.0.0', '>1.0.0-rc.1', true],
+  ['1.0.0-Z', '<1.0.0-a', true], // ASCII order
+  ['1.0.0-2', '>1.0.0-10', false], // numeric, not lexical
+  ['1.10.0', '>1.9.0', true],
+  ['2.0.0', '>1.99.99', true],
+  ['99999999999999999999.0.0', '>99999999999999999998.0.0', true],
+]));
+
+test('primitive comparators', () => check([
+  ['1.2.3', '>1.2.2', true],
+  ['1.2.3', '>1.2.3', false],
+  ['1.2.3', '>=1.2.3', true],
+  ['1.2.2', '>=1.2.3', false],
+  ['1.2.2', '<1.2.3', true],
+  ['1.2.3', '<1.2.3', false],
+  ['1.2.3', '<=1.2.3', true],
+  ['1.2.4', '<=1.2.3', false],
+  ['1.2.3', '=1.2.3', true],
+  ['1.2.3', '>= 1.2.3', true],
+  ['1.2.3', '>=  v1.2.3   <  2', true],
+]));
+
+test('comparator sets and ||', () => check([
+  ['1.5.0', '>=1.2.3 <2.0.0', true],
+  ['2.0.0', '>=1.2.3 <2.0.0', false],
+  ['1.0.0', '>=1.2.3 <2.0.0', false],
+  ['3.1.0', '1.x || >=3.0.0', true],
+  ['2.1.0', '1.x || >=3.0.0', false],
+  ['2.1.0', '1.x||2.1.0', true],
+]));
+
+test('X-ranges without operator', () => check([
+  ['0.0.0', '*', true],
+  ['9.9.9', '', true],
+  ['9.9.9', '   ', true],
+  ['9.9.9', 'x', true],
+  ['1.0.0', '1', true],
+  ['1.9.9', '1.x', true],
+  ['2.0.0', '1', false],
+  ['0.9.9', '1.X', false],
+  ['1.2.0', '1.2', true],
+  ['1.2.9', '1.2.x', true],
+  ['1.2.9', '1.2.*', true],
+  ['1.3.0', '1.2', false],
+  ['1.1.9', '1.2.x', false],
+  ['1.2.0', '1.*.*', true],
+]));
+
+test('X-ranges with operators', () => check([
+  ['1.9.9', '>1', false],
+  ['2.0.0', '>1', true],
+  ['1.2.9', '>1.2', false],
+  ['1.3.0', '>1.2', true],
+  ['1.0.0', '>=1', true],
+  ['0.9.9', '>=1', false],
+  ['1.2.0', '>=1.2', true],
+  ['1.1.9', '>=1.2.x', false],
+  ['0.9.9', '<1', true],
+  ['1.0.0', '<1', false],
+  ['1.1.9', '<1.2', true],
+  ['1.2.0', '<1.2', false],
+  ['1.9.9', '<=1', true],
+  ['2.0.0', '<=1', false],
+  ['1.2.9', '<=1.2', true],
+  ['1.3.0', '<=1.2', false],
+  ['1.5.0', '=1', true],
+  ['2.0.0', '=1', false],
+  ['1.2.5', '=1.2', true],
+  ['1.3.0', '=1.2', false],
+  ['1.2.3', '>*', false],
+  ['1.2.3', '<*', false],
+  ['1.2.3', '>=*', true],
+  ['1.2.3', '<=*', true],
+]));
+
+test('tilde ranges', () => check([
+  ['1.2.3', '~1.2.3', true],
+  ['1.2.9', '~1.2.3', true],
+  ['1.2.2', '~1.2.3', false],
+  ['1.3.0', '~1.2.3', false],
+  ['1.2.0', '~1.2', true],
+  ['1.3.0', '~1.2', false],
+  ['1.0.0', '~1', true],
+  ['1.9.9', '~1', true],
+  ['2.0.0', '~1', false],
+  ['1.2.3-beta.2', '~1.2.3-beta.2', true],
+  ['1.2.3-beta.4', '~1.2.3-beta.2', true],
+  ['1.2.3-beta.1', '~1.2.3-beta.2', false],
+  ['1.2.3', '~1.2.3-beta.2', true],
+  ['1.2.9', '~1.2.3-beta.2', true],
+  ['1.3.0', '~1.2.3-beta.2', false],
+  ['1.2.4-beta.3', '~1.2.3-beta.2', false],
+  ['1.2.5', '~ 1.2.3', true],
+]));
+
+test('caret ranges', () => check([
+  ['1.2.3', '^1.2.3', true],
+  ['1.9.9', '^1.2.3', true],
+  ['1.2.2', '^1.2.3', false],
+  ['2.0.0', '^1.2.3', false],
+  ['0.2.3', '^0.2.3', true],
+  ['0.2.9', '^0.2.3', true],
+  ['0.3.0', '^0.2.3', false],
+  ['0.2.2', '^0.2.3', false],
+  ['0.0.3', '^0.0.3', true],
+  ['0.0.4', '^0.0.3', false],
+  ['0.0.2', '^0.0.3', false],
+  ['1.2.0', '^1.2', true],
+  ['1.9.0', '^1.2', true],
+  ['1.1.9', '^1.2', false],
+  ['2.0.0', '^1.2', false],
+  ['1.0.0', '^1', true],
+  ['2.0.0', '^1', false],
+  ['0.2.0', '^0.2', true],
+  ['0.3.0', '^0.2', false],
+  ['0.0.0', '^0.0', true],
+  ['0.0.9', '^0.0', true],
+  ['0.1.0', '^0.0', false],
+  ['0.0.0', '^0', true],
+  ['0.9.9', '^0', true],
+  ['1.0.0', '^0', false],
+  ['0.9.9', '^0.x', true],
+  ['1.0.0', '^0.x', false],
+  ['1.2.3-beta.2', '^1.2.3-beta.2', true],
+  ['1.2.3-beta.3', '^1.2.3-beta.2', true],
+  ['1.2.3-beta.1', '^1.2.3-beta.2', false],
+  ['1.9.0', '^1.2.3-beta.2', true],
+  ['2.0.0', '^1.2.3-beta.2', false],
+  ['1.2.4-beta', '^1.2.3-beta.2', false],
+]));
+
+test('hyphen ranges', () => check([
+  ['1.2.3', '1.2.3 - 2.3.4', true],
+  ['2.3.4', '1.2.3 - 2.3.4', true],
+  ['2.3.5', '1.2.3 - 2.3.4', false],
+  ['1.2.2', '1.2.3 - 2.3.4', false],
