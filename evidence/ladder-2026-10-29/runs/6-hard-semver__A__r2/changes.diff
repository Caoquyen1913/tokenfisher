+  ['1.7.0', '1.2.3 - 2.3.4 <1.6.0', false],
+  ['5.0.0', '1.2.3 - 2.3.4 || 5.x', true],
+]));
+
+test('prereleases', () => check([
+  ['1.2.3-alpha.7', '>1.2.3-alpha.3', true],
+  ['3.4.5-alpha.9', '>1.2.3-alpha.3', false],
