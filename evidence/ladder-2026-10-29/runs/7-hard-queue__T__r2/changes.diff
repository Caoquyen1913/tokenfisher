+// Promise job queue.
+//
+// Contract:
+// - add(fn) queues a job; fn may return a promise, a plain value, or throw.
+//   add() returns a promise that settles with the job's outcome.
+// - At most `concurrency` jobs run at the same time; jobs start in the order they were added.
+// - A failing job rejects its own promise only; the queue keeps going.
+// - onIdle() resolves once nothing is pending and nothing is running (immediately if already idle).
+// - pause() stops starting new jobs (running ones finish); resume() starts as many as there are free slots.
+// - `pending` and `running` report the current counts.
+function createQueue({ concurrency = 1 } = {}) {
+  const pending = [];
+  let running = 0;
+  let paused = false;
+  let idleWaiters = [];
+
+  function next() {
+    while (!paused && running < concurrency && pending.length > 0) {
+      const { fn, resolve, reject } = pending.shift();
+      running++;
+      // Promise.resolve().then(fn) handles sync throws and plain return values.
+      Promise.resolve()
+        .then(fn)
+        .then(resolve, reject)
+        .finally(() => {
+          running--;
+          next();
+          checkIdle();
+        });
+    }
+  }
+
+  function checkIdle() {
+    if (pending.length === 0 && running === 0) {
+      idleWaiters.forEach((wake) => wake());
+      idleWaiters = [];
+    }
+  }
+
+  return {
+    add(fn) {
+      return new Promise((resolve, reject) => {
+        pending.push({ fn, resolve, reject });
+        next();
+      });
+    },
+    onIdle() {
+      return new Promise((resolve) => {
+        idleWaiters.push(resolve);
+        checkIdle();
+      });
+    },
+    pause() {
+      paused = true;
+    },
+    resume() {
+      paused = false;
+      next();
+    },
+    get pending() {
+      return pending.length;
+    },
+    get running() {
+      return running;
+    },
+  };
+}
+
+module.exports = { createQueue };
diff --git a/test/queue.test.js b/test/queue.test.js
index be49570..63577cd 100644
--- a/test/queue.test.js
+++ b/test/queue.test.js
@@ -15,3 +15,76 @@ test('starts jobs in order with concurrency 1', async () => {
   await Promise.all(['a', 'b', 'c'].map((x) => q.add(async () => { order.push(x); await sleep(1); })));
   assert.deepStrictEqual(order, ['a', 'b', 'c']);
 });
+
+test('a rejecting job rejects only its own promise and the queue keeps going', async () => {
+  const q = createQueue();
+  const failing = q.add(async () => { await sleep(1); throw new Error('boom'); });
+  const after = q.add(async () => 'ok');
+  await assert.rejects(failing, /boom/);
+  assert.strictEqual(await after, 'ok');
+  await q.onIdle();
+  assert.strictEqual(q.running, 0);
+});
+
+test('synchronous throws and plain values are handled', async () => {
+  const q = createQueue();
+  const thrower = q.add(() => { throw new Error('sync'); });
+  const plain = q.add(() => 42);
+  await assert.rejects(thrower, /sync/);
+  assert.strictEqual(await plain, 42);
+  await q.onIdle();
+  assert.strictEqual(q.running, 0);
+  assert.strictEqual(q.pending, 0);
+});
+
+test('onIdle waits for running jobs, not just an empty pending list', async () => {
+  const q = createQueue({ concurrency: 2 });
+  let done = 0;
+  q.add(async () => { await sleep(20); done++; });
+  q.add(async () => { await sleep(30); done++; });
+  await q.onIdle();
+  assert.strictEqual(done, 2);
+  assert.strictEqual(q.running, 0);
+});
+
+test('onIdle resolves immediately when already idle', async () => {
+  const q = createQueue();
+  await q.onIdle();
+});
+
+test('resume() fills all free slots', async () => {
+  const q = createQueue({ concurrency: 4 });
+  q.pause();
+  for (let i = 0; i < 6; i++) q.add(() => sleep(20));
+  assert.strictEqual(q.running, 0);
+  assert.strictEqual(q.pending, 6);
+  q.resume();
+  assert.strictEqual(q.running, 4);
+  assert.strictEqual(q.pending, 2);
+  await q.onIdle();
+});
+
+test('pause() lets running jobs finish but starts no new ones', async () => {
+  const q = createQueue({ concurrency: 2 });
+  for (let i = 0; i < 4; i++) q.add(() => sleep(10));
+  q.pause();
+  await sleep(30);
+  assert.strictEqual(q.running, 0);
+  assert.strictEqual(q.pending, 2);
+  q.resume();
+  await q.onIdle();
+  assert.strictEqual(q.pending, 0);
+});
+
+test('never exceeds concurrency and starts jobs in order', async () => {
+  const q = createQueue({ concurrency: 3 });
+  let active = 0, max = 0;
+  const order = [];
+  await Promise.all(Array.from({ length: 10 }, (_, i) => q.add(async () => {
+    order.push(i); active++; max = Math.max(max, active);
+    await sleep(5 + (i % 3) * 3);
+    active--;
+  })));
+  assert.strictEqual(max, 3);
+  assert.deepStrictEqual(order, [...Array(10).keys()]);
+});
