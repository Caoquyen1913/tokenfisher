diff --git a/src/strings.js b/src/strings.js
index 107e994..56e0b99 100644
--- a/src/strings.js
+++ b/src/strings.js
@@ -2,8 +2,18 @@ function capitalize(text) {
   return text ? text[0].toUpperCase() + text.slice(1) : text;
 }
 
+const SLUG_MAX_LENGTH = 50;
+
 function slugify(text) {
-  throw new Error('not implemented');
+  return text
+    .toLowerCase()
+    .replace(/đ/g, 'd') // đ has no Unicode decomposition, so NFD alone won't strip it
+    .normalize('NFD')
+    .replace(/[̀-ͯ]/g, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, SLUG_MAX_LENGTH)
+    .replace(/-+$/, '');
 }
 
 module.exports = { capitalize, slugify };
diff --git a/test/strings.test.js b/test/strings.test.js
index a282d44..3fbc7f1 100644
--- a/test/strings.test.js
+++ b/test/strings.test.js
@@ -1,5 +1,31 @@
 const assert = require('assert');
-const { capitalize } = require('../src/strings');
+const { capitalize, slugify } = require('../src/strings');
 
 test('capitalize first letter', () => assert.strictEqual(capitalize('hello'), 'Hello'));
 test('capitalize empty string', () => assert.strictEqual(capitalize(''), ''));
+
+test('slugify lowercases and joins words with hyphens', () => assert.strictEqual(slugify('Hello World'), 'hello-world'));
+test('slugify removes Vietnamese diacritics', () => assert.strictEqual(slugify('Tiếng Việt có dấu'), 'tieng-viet-co-dau'));
+test('slugify maps đ and Đ to d', () => assert.strictEqual(slugify('Đường đi'), 'duong-di'));
+test('slugify removes other Latin diacritics', () => assert.strictEqual(slugify('Crème Brûlée à la Señor'), 'creme-brulee-a-la-senor'));
+test('slugify collapses runs of non-alphanumerics', () => assert.strictEqual(slugify('a  --__!!  b...c'), 'a-b-c'));
+test('slugify trims leading and trailing hyphens', () => assert.strictEqual(slugify('  --Hello!-- '), 'hello'));
+test('slugify keeps digits', () => assert.strictEqual(slugify('Version 2.0 Released'), 'version-2-0-released'));
+test('slugify of empty or symbol-only input is empty', () => {
+  assert.strictEqual(slugify(''), '');
+  assert.strictEqual(slugify('!!! ---'), '');
+});
+test('slugify caps length at 50', () => {
+  const slug = slugify('a'.repeat(80));
+  assert.strictEqual(slug, 'a'.repeat(50));
+});
+test('slugify cut at 50 does not end with a hyphen', () => {
+  // the 50th character of the full slug is a hyphen
+  const slug = slugify('a'.repeat(49) + ' bbbb');
+  assert.strictEqual(slug, 'a'.repeat(49));
+});
+test('slugify keeps exactly 50 characters when the cut falls inside a word', () => {
+  const slug = slugify('abcdefg '.repeat(10));
+  assert.strictEqual(slug, 'abcdefg-'.repeat(6) + 'ab');
+  assert.strictEqual(slug.length, 50);
+});
