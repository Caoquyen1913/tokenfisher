@@ -1,6 +1,168 @@
 // See docs/SPEC.md.
+const NUM = '0|[1-9]\\d*';
+const IDS = '[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*';
+const FULL_RE = new RegExp(`^v?(${NUM})\\.(${NUM})\\.(${NUM})(?:-(${IDS}))?(?:\\+${IDS})?$`);
+const WILD = '[xX*]';
+const PARTIAL_RE = new RegExp(
+  `^v?(${WILD}|${NUM})(?:\\.(${WILD}|${NUM})(?:\\.(${WILD}|${NUM})(?:-(${IDS}))?(?:\\+${IDS})?)?)?$`
+);
+
+function parseVersion(str) {
+  const m = FULL_RE.exec(str.trim());
+  if (!m) return null;
+  return { major: BigInt(m[1]), minor: BigInt(m[2]), patch: BigInt(m[3]), pre: m[4] ? m[4].split('.') : [] };
+}
+
+function cmpNum(a, b) {
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function comparePre(a, b) {
+  if (!a.length && !b.length) return 0;
+  if (!a.length) return 1;
+  if (!b.length) return -1;
+  for (let i = 0; i < Math.min(a.length, b.length); i++) {
+    const x = a[i];
+    const y = b[i];
+    const xn = /^\d+$/.test(x);
+    const yn = /^\d+$/.test(y);
+    let c;
+    if (xn && yn) c = cmpNum(BigInt(x), BigInt(y));
+    else if (xn) c = -1;
+    else if (yn) c = 1;
+    else c = x < y ? -1 : x > y ? 1 : 0;
+    if (c) return c;
+  }
+  return cmpNum(a.length, b.length);
+}
+
+function compare(a, b) {
+  return cmpNum(a.major, b.major) || cmpNum(a.minor, b.minor) || cmpNum(a.patch, b.patch) || comparePre(a.pre, b.pre);
+}
+
+// Parses a possibly partial version; missing/wildcard positions become null.
+function parsePartial(str) {
+  const m = PARTIAL_RE.exec(str);
+  if (!m) return null;
+  const parts = [m[1], m[2], m[3]].map((p) => (p === undefined || /^[xX*]$/.test(p) ? null : BigInt(p)));
+  // A concrete position may not follow a wildcard (e.g. 1.x.3).
+  for (let i = 1; i < 3; i++) if (parts[i] !== null && parts[i - 1] === null) return null;
+  const pre = m[4] ? m[4].split('.') : [];
+  if (pre.length && parts[2] === null) return null;
+  return { major: parts[0], minor: parts[1], patch: parts[2], pre };
+}
+
+const v = (major, minor, patch, pre = []) => ({ major, minor, patch, pre });
+const ANY = [];
+const NONE = null; // unsatisfiable comparator set
+
+// Comparator sets are arrays of [op, version].
+function expandPrimitive(op, p) {
+  const { major: M, minor: m, patch: pt, pre } = p;
+  if (M === null) {
+    return op === '' || op === '=' || op === '>=' || op === '<=' ? ANY : NONE;
+  }
+  if (op === '' || op === '=') {
+    if (m === null) return [['>=', v(M, 0n, 0n)], ['<', v(M + 1n, 0n, 0n)]];
+    if (pt === null) return [['>=', v(M, m, 0n)], ['<', v(M, m + 1n, 0n)]];
+    return [['=', v(M, m, pt, pre)]];
+  }
+  if (op === '>') {
+    if (m === null) return [['>=', v(M + 1n, 0n, 0n)]];
+    if (pt === null) return [['>=', v(M, m + 1n, 0n)]];
+    return [['>', v(M, m, pt, pre)]];
+  }
+  if (op === '>=') return [['>=', v(M, m ?? 0n, pt ?? 0n, pre)]];
+  if (op === '<') return [['<', v(M, m ?? 0n, pt ?? 0n, pre)]];
+  // '<='
+  if (m === null) return [['<', v(M + 1n, 0n, 0n)]];
+  if (pt === null) return [['<', v(M, m + 1n, 0n)]];
+  return [['<=', v(M, m, pt, pre)]];
+}
+
+function expandTilde(p) {
+  const { major: M, minor: m, patch: pt, pre } = p;
+  if (M === null) return ANY;
+  if (m === null) return [['>=', v(M, 0n, 0n)], ['<', v(M + 1n, 0n, 0n)]];
+  return [['>=', v(M, m, pt ?? 0n, pre)], ['<', v(M, m + 1n, 0n)]];
+}
+
+function expandCaret(p) {
+  const { major: M, minor: m, patch: pt, pre } = p;
+  if (M === null) return ANY;
+  const lower = ['>=', v(M, m ?? 0n, pt ?? 0n, pre)];
+  let upper;
+  if (M > 0n) upper = v(M + 1n, 0n, 0n);
+  else if (m === null) upper = v(1n, 0n, 0n);
+  else if (m > 0n || pt === null) upper = v(0n, m + 1n, 0n);
+  else upper = v(0n, 0n, pt + 1n);
+  return [lower, ['<', upper]];
+}
+
+function expandHyphen(aStr, bStr) {
+  const a = parsePartial(aStr);
+  const b = parsePartial(bStr);
+  if (!a || !b) return undefined;
+  const set = [];
+  if (a.major !== null) set.push(['>=', v(a.major, a.minor ?? 0n, a.patch ?? 0n, a.pre)]);
+  if (b.major !== null) {
+    if (b.minor === null) set.push(['<', v(b.major + 1n, 0n, 0n)]);
+    else if (b.patch === null) set.push(['<', v(b.major, b.minor + 1n, 0n)]);
+    else set.push(['<=', v(b.major, b.minor, b.patch, b.pre)]);
+  }
+  return set;
+}
+
+// Returns an array of comparators, NONE (unsatisfiable), or undefined (invalid).
+function parseSet(str) {
+  str = str.trim();
+  const hy = str.split(/\s+-\s+/);
+  if (hy.length > 2) return undefined;
+  if (hy.length === 2) return expandHyphen(hy[0], hy[1]);
+
+  const tokens = str.replace(/(<=|>=|<|>|=|~|\^)\s+/g, '$1').split(/\s+/).filter(Boolean);
+  const set = [];
+  for (const tok of tokens) {
+    const m = /^(<=|>=|<|>|=|~|\^)?(.*)$/.exec(tok);
+    const p = parsePartial(m[2]);
+    if (!p) return undefined;
+    const op = m[1] || '';
+    const exp = op === '~' ? expandTilde(p) : op === '^' ? expandCaret(p) : expandPrimitive(op, p);
+    if (exp === NONE) return NONE;
+    set.push(...exp);
+  }
+  return set;
+}
+
+function test(c, ver) {
+  const r = compare(ver, c[1]);
+  switch (c[0]) {
+    case '<': return r < 0;
+    case '<=': return r <= 0;
+    case '>': return r > 0;
+    case '>=': return r >= 0;
+    default: return r === 0;
+  }
+}
+
+function setMatches(set, ver) {
+  if (set === NONE) return false;
+  if (!set.every((c) => test(c, ver))) return false;
+  if (!ver.pre.length) return true;
+  return set.some(([, cv]) => cv.pre.length && cv.major === ver.major && cv.minor === ver.minor && cv.patch === ver.patch);
+}
+
 function satisfies(version, range) {
-  throw new Error('not implemented');
+  try {
+    if (typeof version !== 'string' || typeof range !== 'string') return false;
+    const ver = parseVersion(version);
+    if (!ver) return false;
+    const sets = range.split('||').map(parseSet);
+    if (sets.some((s) => s === undefined)) return false;
+    return sets.some((s) => setMatches(s, ver));
+  } catch (e) {
+    return false;
+  }
 }
 
 module.exports = { satisfies };
