+  ['1.2.9', '~1.2.3'], ['1.2.5', '~1.2'], ['1.9.0', '~1'], ['1.2.3-beta.4', '~1.2.3-beta.2'],
+  ['1.9.0', '^1.2.3'], ['0.2.9', '^0.2.3'], ['0.0.3', '^0.0.3'], ['1.5.0', '^1.2'], ['1.5.0', '^1'],
+  ['0.2.5', '^0.2'], ['0.0.9', '^0.0'], ['0.9.0', '^0'], ['0.9.0', '^0.x'], ['1.2.3-beta.2', '^1.2.3-beta.2'],
+  ['1.2.3-beta.5', '^1.2.3-beta.2'], ['1.9.0', '^1.2.3-beta.2'],
+  ['1.2.3', '1.2.3 - 2.3.4'], ['2.3.4', '1.2.3 - 2.3.4'], ['1.2.0', '1.2 - 2.3.4'], ['2.3.9', '1.2.3 - 2.3'],
+  ['2.9.9', '1.2.3 - 2'], ['3.0.0', '1.0.0 || 3.0.0'], ['1.0.0', '2.0.0 || 1.x'],
+  ['1.2.3-alpha.7', '>1.2.3-alpha.3'], ['1.0.0', '>1.0.0-rc.1'], ['1.0.0-alpha.1', '>1.0.0-alpha'],
+  ['1.0.0-alpha.beta', '>1.0.0-alpha.1'], ['1.0.0-b', '>1.0.0-a'], ['1.0.0-2', '>1.0.0-1'],
