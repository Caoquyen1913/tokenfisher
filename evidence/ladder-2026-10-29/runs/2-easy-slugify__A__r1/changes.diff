diff --git a/src/strings.js b/src/strings.js
index 107e994..62e77c2 100644
--- a/src/strings.js
+++ b/src/strings.js
@@ -2,8 +2,20 @@ function capitalize(text) {
   return text ? text[0].toUpperCase() + text.slice(1) : text;
 }
 
+// Latin letters that NFD does not split into a base letter plus a combining mark.
+const LATIN_EXTRA = { 'đ': 'd', 'ð': 'd', 'ø': 'o', 'ł': 'l', 'ß': 'ss', 'æ': 'ae', 'œ': 'oe', 'þ': 'th', 'ı': 'i' };
+const SLUG_MAX_LENGTH = 50;
+
 function slugify(text) {
-  throw new Error('not implemented');
+  return String(text)
+    .toLowerCase()
+    .normalize('NFD')
+    .replace(/[̀-ͯ]/g, '')
+    .replace(/[đðøłßæœþı]/g, (ch) => LATIN_EXTRA[ch])
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, SLUG_MAX_LENGTH)
+    .replace(/-+$/, '');
 }
 
 module.exports = { capitalize, slugify };
diff --git a/test/strings.test.js b/test/strings.test.js
index a282d44..ef1f0f0 100644
--- a/test/strings.test.js
+++ b/test/strings.test.js
@@ -3,3 +3,31 @@ const { capitalize } = require('../src/strings');
 
 test('capitalize first letter', () => assert.strictEqual(capitalize('hello'), 'Hello'));
 test('capitalize empty string', () => assert.strictEqual(capitalize(''), ''));
+
+const { slugify } = require('../src/strings');
+
+test('slugify lowercases and hyphenates words', () => assert.strictEqual(slugify('Hello World'), 'hello-world'));
+test('slugify strips Vietnamese diacritics', () =>
+  assert.strictEqual(slugify('Tiếng Việt có dấu'), 'tieng-viet-co-dau'));
+test('slugify maps đ and Đ to d', () => assert.strictEqual(slugify('Đường đi'), 'duong-di'));
+test('slugify strips other Latin diacritics', () =>
+  assert.strictEqual(slugify('Crème Brûlée à la Señor Müller'), 'creme-brulee-a-la-senor-muller'));
+test('slugify collapses runs of non-alphanumerics', () =>
+  assert.strictEqual(slugify('a  --  b__c!!!d'), 'a-b-c-d'));
+test('slugify keeps digits', () => assert.strictEqual(slugify('Top 10 of 2024'), 'top-10-of-2024'));
+test('slugify trims leading and trailing hyphens', () => assert.strictEqual(slugify('  --Hello!--  '), 'hello'));
+test('slugify returns empty string for no usable characters', () => {
+  assert.strictEqual(slugify(''), '');
+  assert.strictEqual(slugify('!!! ---'), '');
+});
+test('slugify caps length at 50', () => assert.strictEqual(slugify('a'.repeat(80)), 'a'.repeat(50)));
+test('slugify cut at 50 does not end with a hyphen', () => {
+  // The 50th character of the full slug is a hyphen.
+  const slug = slugify(`${'a'.repeat(49)} bbb`);
+  assert.strictEqual(slug, 'a'.repeat(49));
+});
+test('slugify cut at 50 keeps a full 50 chars when possible', () => {
+  const slug = slugify(`${'a'.repeat(45)} ${'b'.repeat(10)}`);
+  assert.strictEqual(slug, `${'a'.repeat(45)}-bbbb`);
+  assert.strictEqual(slug.length, 50);
+});
