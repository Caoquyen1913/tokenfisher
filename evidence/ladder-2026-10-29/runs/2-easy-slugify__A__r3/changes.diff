diff --git a/src/strings.js b/src/strings.js
index 107e994..9692751 100644
--- a/src/strings.js
+++ b/src/strings.js
@@ -2,8 +2,21 @@ function capitalize(text) {
   return text ? text[0].toUpperCase() + text.slice(1) : text;
 }
 
+const SLUG_MAX_LENGTH = 50;
+
+// Latin letters that NFD does not decompose into base letter + combining mark.
+const LATIN_SPECIAL = { đ: 'd', ð: 'd', ł: 'l', ø: 'o', æ: 'ae', œ: 'oe', ß: 'ss', þ: 'th', ı: 'i' };
+
 function slugify(text) {
-  throw new Error('not implemented');
+  return text
+    .toLowerCase()
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[đðłøæœßþı]/g, (ch) => LATIN_SPECIAL[ch])
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, SLUG_MAX_LENGTH)
+    .replace(/-+$/, '');
 }
 
 module.exports = { capitalize, slugify };
diff --git a/test/strings.test.js b/test/strings.test.js
index a282d44..c8be059 100644
--- a/test/strings.test.js
+++ b/test/strings.test.js
@@ -1,5 +1,30 @@
 const assert = require('assert');
-const { capitalize } = require('../src/strings');
+const { capitalize, slugify } = require('../src/strings');
 
 test('capitalize first letter', () => assert.strictEqual(capitalize('hello'), 'Hello'));
 test('capitalize empty string', () => assert.strictEqual(capitalize(''), ''));
+
+test('slugify lowercases and hyphenates', () => assert.strictEqual(slugify('Hello World'), 'hello-world'));
+test('slugify strips Vietnamese diacritics', () => assert.strictEqual(slugify('Tiếng Việt có dấu'), 'tieng-viet-co-dau'));
+test('slugify maps đ/Đ to d', () => assert.strictEqual(slugify('Đường đi'), 'duong-di'));
+test('slugify strips other Latin diacritics', () => assert.strictEqual(slugify('Crème Brûlée à São Paulo'), 'creme-brulee-a-sao-paulo'));
+test('slugify collapses runs of non-alphanumerics', () => assert.strictEqual(slugify('a  --__!!b...c'), 'a-b-c'));
+test('slugify trims leading and trailing hyphens', () => assert.strictEqual(slugify('  --Hello!--  '), 'hello'));
+test('slugify keeps digits', () => assert.strictEqual(slugify('Top 10 of 2024'), 'top-10-of-2024'));
+test('slugify empty and symbol-only input', () => {
+  assert.strictEqual(slugify(''), '');
+  assert.strictEqual(slugify('!@#$%'), '');
+});
+test('slugify caps length at 50', () => {
+  const slug = slugify('a'.repeat(80));
+  assert.strictEqual(slug, 'a'.repeat(50));
+});
+test('slugify cut at 50 does not end with a hyphen', () => {
+  // The 50th character would be the hyphen between the two words.
+  const slug = slugify(`${'a'.repeat(49)} bbbb`);
+  assert.strictEqual(slug, 'a'.repeat(49));
+});
+test('slugify exactly 50 characters is kept whole', () => {
+  const input = `${'a'.repeat(24)} ${'b'.repeat(25)}`;
+  assert.strictEqual(slugify(input), `${'a'.repeat(24)}-${'b'.repeat(25)}`);
+});
