diff --git a/test/fixtures/report-reference.js b/test/fixtures/report-reference.js
new file mode 100644
index 0000000..8c9a241
--- /dev/null
+++ b/test/fixtures/report-reference.js
@@ -0,0 +1,40 @@
+// Frozen copy of the original (pre-optimization) summarize(), used as a reference oracle by
+// test/report-equivalence.test.js. Do not modify: it defines the expected output.
+// orders: [{ id, customerId, status, amountCents, currency: 'USD' | 'EUR', createdAt: ISO-8601 string }]
+const EUR_TO_USD = 1.08;
+
+function byRank(a, b) {
+  if (a.spendCents !== b.spendCents) return b.spendCents - a.spendCents;
+  if (a.firstOrderAt !== b.firstOrderAt) return a.firstOrderAt < b.firstOrderAt ? -1 : 1;
+  return a.customerId < b.customerId ? -1 : a.customerId > b.customerId ? 1 : 0;
+}
+
+function summarize(orders, limit = 10) {
+  const seen = [];
+  const groups = [];
+  for (const order of orders) {
+    // Upstream retries can deliver the same order twice.
+    if (seen.includes(order.id)) continue;
+    seen.push(order.id);
+    if (order.status === 'refunded') continue;
+
+    let group = groups.find((g) => g.customerId === order.customerId);
+    if (!group) {
+      group = { customerId: order.customerId, spendCents: 0, orderCount: 0, firstOrderAt: order.createdAt };
+      groups.push(group);
+    }
+    group.orderCount++;
+    if (order.createdAt < group.firstOrderAt) group.firstOrderAt = order.createdAt;
+    if (order.status === 'paid') {
+      group.spendCents += order.currency === 'EUR' ? Math.round(order.amountCents * EUR_TO_USD) : order.amountCents;
+    }
+    // Keep the leaderboard sorted as we go.
+    groups.sort(byRank);
+  }
+  return groups
+    .filter((g) => g.spendCents > 0)
+    .slice(0, limit)
+    .map((g, i) => ({ rank: i + 1, ...g }));
+}
+
+module.exports = { summarize };
diff --git a/test/report-equivalence.test.js b/test/report-equivalence.test.js
new file mode 100644
index 0000000..9a70eb1
--- /dev/null
+++ b/test/report-equivalence.test.js
@@ -0,0 +1,82 @@
+const assert = require('assert');
+const { summarize } = require('../src/report');
+const { summarize: reference } = require('./fixtures/report-reference');
+
+// Deterministic PRNG so failures are reproducible.
+function rng(seed) {
+  return () => {
+    seed = (seed + 0x6d2b79f5) | 0;
+    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+// Small value pools force collisions: duplicate ids, spend ties, firstOrderAt ties, refunds, EUR rounding.
+function randomOrders(rand, n, { customers, ids, amounts, times }) {
+  const pick = (xs) => xs[Math.floor(rand() * xs.length)];
+  const statuses = ['paid', 'paid', 'paid', 'pending', 'refunded', 'failed'];
+  return Array.from({ length: n }, () => ({
+    id: `o${Math.floor(rand() * ids)}`,
+    customerId: `cus_${Math.floor(rand() * customers)}`,
+    status: pick(statuses),
+    amountCents: pick(amounts),
+    currency: rand() < 0.3 ? 'EUR' : 'USD',
+    createdAt: `2026-10-01T${String(Math.floor(rand() * times)).padStart(2, '0')}:00:00Z`,
+  }));
+}
+
+test('matches the original implementation exactly on randomized orders', () => {
+  const rand = rng(12345);
+  for (let i = 0; i < 300; i++) {
+    const n = Math.floor(rand() * 120);
+    const orders = randomOrders(rand, n, {
+      customers: 1 + Math.floor(rand() * 25),
+      ids: 1 + Math.floor(rand() * 150),
+      amounts: [0, 1, 5, 25, 50, 100, 101, 999, 1000],
+      times: 1 + Math.floor(rand() * 5),
+    });
+    const limit = [undefined, 0, 1, 3, 10, 50][i % 6];
+    assert.deepStrictEqual(summarize(orders, limit), reference(orders, limit), `case ${i}`);
+  }
+});
+
+test('matches the original on tie-breaks, duplicates, refunds and EUR rounding', () => {
+  const o = (id, customerId, status, amountCents, createdAt, currency = 'USD') => ({ id, customerId, status, amountCents, currency, createdAt });
+  const orders = [
+    o('o1', 'cus_b', 'paid', 1000, '2026-10-01T10:00:00Z'),
+    o('o2', 'cus_a', 'paid', 1000, '2026-10-01T10:00:00Z'), // same spend + time as cus_b -> id order
+    o('o3', 'cus_c', 'paid', 1000, '2026-10-01T09:00:00Z'), // same spend, earlier -> ahead
+    o('o3', 'cus_c', 'paid', 1000, '2026-10-01T09:00:00Z'), // duplicate delivery, ignored
+    o('o4', 'cus_d', 'refunded', 5000, '2026-10-01T08:00:00Z'),
+    o('o4', 'cus_d', 'paid', 5000, '2026-10-01T08:00:00Z'), // dup id of a refunded order, ignored
+    o('o5', 'cus_e', 'paid', 925, '2026-10-01T11:00:00Z', 'EUR'), // 999 after rounding
+    o('o6', 'cus_f', 'pending', 7000, '2026-10-01T07:00:00Z'), // no spend -> filtered out
+    o('o7', 'cus_e', 'pending', 1, '2026-10-01T06:00:00Z'), // moves cus_e firstOrderAt earlier
+  ];
+  const expected = reference(orders);
+  assert.deepStrictEqual(summarize(orders), expected);
+  assert.deepStrictEqual(expected.map((r) => r.customerId), ['cus_c', 'cus_a', 'cus_b', 'cus_e']);
+});
+
+test('matches the original on malformed input (NaN / mixed-type ids, missing fields)', () => {
+  const o = (id, customerId, status, amountCents, createdAt) => ({ id, customerId, status, amountCents, currency: 'USD', createdAt });
+  const cases = [
+    [o(1, NaN, 'paid', 5, 'a'), o(2, NaN, 'paid', 5, 'a'), o(3, 'x', 'paid', 5, 'a')],
+    [o(1, 1, 'paid', 5, 'a'), o(2, '1', 'paid', 5, 'a'), o(3, 2, 'paid', 9, 'a'), o(4, 1, 'paid', 4, 'a')],
+    [o(1, 'a', 'paid', 5), o(2, 'b', 'paid', 5, 'x'), o(3, 'c', 'paid', 5)],
+    [o(1, 'a', 'paid', undefined, 'x'), o(2, 'b', 'paid', 3, 'x'), o(3, 'c', 'paid', 'oops', 'x')],
+    [o(NaN, 'a', 'paid', 5, 'x'), o(NaN, 'b', 'paid', 5, 'x'), o(0, 'c', 'paid', 1, 'x'), o(-0, 'd', 'paid', 1, 'x')],
+  ];
+  for (const [i, orders] of cases.entries()) assert.deepStrictEqual(summarize(orders), reference(orders), `case ${i}`);
+});
+
+test('summarizes 200,000 orders in well under a second', () => {
+  const rand = rng(42);
+  const orders = randomOrders(rand, 200000, { customers: 50000, ids: 190000, amounts: [100, 250, 999, 1500, 4200], times: 24 });
+  const start = process.hrtime.bigint();
+  const report = summarize(orders);
+  const ms = Number(process.hrtime.bigint() - start) / 1e6;
+  assert.strictEqual(report.length, 10);
+  assert.ok(ms < 1000, `took ${ms.toFixed(0)} ms`);
+});
