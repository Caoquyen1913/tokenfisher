@@ -15,19 +15,20 @@ function createQueue({ concurrency = 1 } = {}) {
   let idleWaiters = [];
 
   function next() {
-    if (paused || running >= concurrency || pending.length === 0) return;
-    const { fn, resolve, reject } = pending.shift();
-    running++;
-    fn().then((value) => {
-      running--;
