+    while (!paused && running < concurrency && pending.length > 0) {
+      const { fn, resolve, reject } = pending.shift();
+      running++;
+      // new Promise(...) turns a synchronous throw or a plain return value into a promise.
+      new Promise((r) => r(fn())).then(resolve, reject).finally(() => {
+        running--;
+        next();
+        checkIdle();
+      });
+    }
   }
 
