diff --git a/src/strings.js b/src/strings.js
index 107e994..125832a 100644
--- a/src/strings.js
+++ b/src/strings.js
@@ -3,7 +3,16 @@ function capitalize(text) {
 }
 
 function slugify(text) {
-  throw new Error('not implemented');
+  return String(text)
+    .replace(/đ/g, 'd')
+    .replace(/Đ/g, 'D')
+    .normalize('NFD')
+    .replace(/[̀-ͯ]/g, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+/, '')
+    .slice(0, 50)
+    .replace(/-+$/, '');
 }
 
 module.exports = { capitalize, slugify };
diff --git a/test/strings.test.js b/test/strings.test.js
index a282d44..3f81b1f 100644
--- a/test/strings.test.js
+++ b/test/strings.test.js
@@ -1,5 +1,20 @@
 const assert = require('assert');
-const { capitalize } = require('../src/strings');
+const { capitalize, slugify } = require('../src/strings');
 
 test('capitalize first letter', () => assert.strictEqual(capitalize('hello'), 'Hello'));
 test('capitalize empty string', () => assert.strictEqual(capitalize(''), ''));
+
+test('slugify basic', () => assert.strictEqual(slugify('Hello World'), 'hello-world'));
+test('slugify Vietnamese diacritics and đ', () => assert.strictEqual(slugify('Đường Nguyễn Huệ, Hà Nội'), 'duong-nguyen-hue-ha-noi'));
+test('slugify other Latin diacritics', () => assert.strictEqual(slugify('Crème Brûlée'), 'creme-brulee'));
+test('slugify collapses runs of symbols', () => assert.strictEqual(slugify('a  --  b!!!c'), 'a-b-c'));
+test('slugify trims hyphens', () => assert.strictEqual(slugify('  --Hello!  '), 'hello'));
+test('slugify empty/symbol-only', () => assert.strictEqual(slugify('!!!'), ''));
+test('slugify truncates to 50', () => assert.strictEqual(slugify('a'.repeat(80)), 'a'.repeat(50)));
+test('slugify cut at 50 does not end with hyphen', () => {
+  const s = slugify('a'.repeat(49) + ' bbb');
+  assert.strictEqual(s, 'a'.repeat(49));
+  const t = slugify('a'.repeat(48) + ' bbb');
+  assert.strictEqual(t, 'a'.repeat(48) + '-b');
+  assert.ok(t.length <= 50);
+});
