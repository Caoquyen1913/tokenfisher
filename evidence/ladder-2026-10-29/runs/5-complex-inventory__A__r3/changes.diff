--- a/src/store.js
+++ b/src/store.js
@@ -1,11 +1,27 @@
 // In-memory inventory. `clock` is injectable so tests can control time.
 function createStore({ clock = Date.now } = {}) {
   const stock = new Map();
+  // id -> { sku, qty, expiresAt }. Expired entries are kept so confirm() can
+  // report RESERVATION_EXPIRED; they simply stop counting against availability.
+  const reservations = new Map();
+  let nextId = 1;
 
   function assertQty(qty) {
     if (!Number.isInteger(qty) || qty <= 0) throw new Error('INVALID_QTY');
   }
 
+  function isExpired(r, now) {
+    return now >= r.expiresAt;
+  }
+
+  function available(sku, now) {
+    let reserved = 0;
+    for (const r of reservations.values()) {
+      if (r.sku === sku && !isExpired(r, now)) reserved += r.qty;
+    }
+    return (stock.get(sku) || 0) - reserved;
+  }
+
   return {
     clock,
     addItem(sku, qty) {
@@ -14,13 +30,35 @@ function createStore({ clock = Date.now } = {}) {
     },
     removeItem(sku, qty) {
       assertQty(qty);
-      const current = stock.get(sku) || 0;
-      if (qty > current) throw new Error('INSUFFICIENT_STOCK');
-      stock.set(sku, current - qty);
+      if (qty > available(sku, clock())) throw new Error('INSUFFICIENT_STOCK');
+      stock.set(sku, (stock.get(sku) || 0) - qty);
     },
     getStock(sku) {
       return stock.get(sku) || 0;
     },
+    getAvailable(sku) {
+      return available(sku, clock());
+    },
+    reserve(sku, qty, ttlMs) {
+      assertQty(qty);
+      if (typeof ttlMs !== 'number' || !Number.isFinite(ttlMs) || ttlMs <= 0) throw new Error('INVALID_TTL');
+      const now = clock();
+      if (qty > available(sku, now)) throw new Error('INSUFFICIENT_STOCK');
+      const id = `res-${nextId++}`;
+      reservations.set(id, { sku, qty, expiresAt: now + ttlMs });
+      return id;
+    },
+    confirm(id) {
+      const r = reservations.get(id);
+      if (!r) throw new Error('RESERVATION_NOT_FOUND');
+      if (isExpired(r, clock())) throw new Error('RESERVATION_EXPIRED');
+      reservations.delete(id);
+      stock.set(r.sku, (stock.get(r.sku) || 0) - r.qty);
+      return { sku: r.sku, stock: stock.get(r.sku) };
+    },
+    release(id) {
+      reservations.delete(id);
+    },
   };
 }
 
diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..7d2bc9c
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,156 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+// A store whose clock only moves when the test says so.
+function fakeClock(start = 1000) {
+  const c = { now: start };
+  c.fn = () => c.now;
+  return c;
+}
+
+function setup(qty = 10) {
+  const clock = fakeClock();
+  const s = createStore({ clock: clock.fn });
+  s.addItem('A', qty);
+  return { s, clock };
+}
+
+test('reserve returns unique string ids', () => {
+  const { s } = setup();
+  const a = s.reserve('A', 1, 100);
+  const b = s.reserve('A', 1, 100);
+  assert.strictEqual(typeof a, 'string');
+  assert.notStrictEqual(a, b);
+});
+test('reserve validates qty', () => {
+  const { s } = setup();
+  for (const qty of [0, -1, 1.5, '2', undefined]) {
+    assert.throws(() => s.reserve('A', qty, 100), /INVALID_QTY/);
+  }
+});
+test('reserve rejects invalid ttl', () => {
+  const { s } = setup();
+  for (const ttl of [undefined, 0, -5, NaN, Infinity, '100']) {
+    assert.throws(() => s.reserve('A', 1, ttl), /INVALID_TTL/);
+  }
+});
+test('reserve cannot exceed available stock', () => {
+  const { s } = setup(5);
+  s.reserve('A', 3, 100);
+  assert.throws(() => s.reserve('A', 3, 100), /INSUFFICIENT_STOCK/);
+  s.reserve('A', 2, 100);
+  assert.throws(() => s.reserve('nope', 1, 100), /INSUFFICIENT_STOCK/);
+});
+test('reservations reduce available but not physical stock', () => {
+  const { s } = setup(10);
+  s.reserve('A', 4, 100);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('nope'), 0);
+});
+test('reservation expires exactly at creation + ttl', () => {
+  const { s, clock } = setup(10);
+  s.reserve('A', 4, 100);
+  clock.now += 99;
+  assert.strictEqual(s.getAvailable('A'), 6);
+  clock.now += 1;
+  assert.strictEqual(s.getAvailable('A'), 10);
+  s.reserve('A', 10, 100); // freed stock can be reserved again
+});
+test('confirm sells reserved stock', () => {
+  const { s } = setup(10);
+  const id = s.reserve('A', 4, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 6);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm just before expiry succeeds', () => {
+  const { s, clock } = setup(10);
+  const id = s.reserve('A', 4, 100);
+  clock.now += 99;
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 6);
+});
+test('confirm of expired reservation throws and leaves stock alone', () => {
+  const { s, clock } = setup(10);
+  const id = s.reserve('A', 4, 100);
+  clock.now += 100;
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+});
+test('confirm of unknown or released id throws NOT_FOUND', () => {
+  const { s } = setup();
+  assert.throws(() => s.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const id = s.reserve('A', 1, 100);
+  s.release(id);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('release frees stock and is idempotent', () => {
+  const { s } = setup(10);
+  const id = s.reserve('A', 4, 100);
+  s.release(id);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  s.release(id);
+  s.release('nope');
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('removeItem cannot take reserved stock', () => {
+  const { s, clock } = setup(10);
+  s.reserve('A', 4, 100);
+  assert.throws(() => s.removeItem('A', 7), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 6);
+  assert.strictEqual(s.getStock('A'), 4);
+  assert.strictEqual(s.getAvailable('A'), 0);
+  clock.now += 100;
+  s.removeItem('A', 4); // reservation expired, stock is free again
+  assert.strictEqual(s.getStock('A'), 0);
+});
+test('reservations are per sku', () => {
+  const { s } = setup(5);
+  s.addItem('B', 5);
+  s.reserve('A', 5, 100);
+  assert.strictEqual(s.getAvailable('B'), 5);
+});
+
+// API
+function apiSetup(qty = 10) {
+  const clock = fakeClock();
+  const api = createApi(createStore({ clock: clock.fn }));
+  api({ method: 'POST', path: '/stock', body: { sku: 'A', qty } });
+  return { api, clock };
+}
+
+test('GET /stock includes available', () => {
+  const { api } = apiSetup(10);
+  api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } });
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }), { status: 200, body: { sku: 'A', stock: 10, available: 7 } });
+});
+test('POST /reservations status codes', () => {
+  const { api } = apiSetup(10);
+  const ok = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } });
+  assert.strictEqual(ok.status, 201);
+  assert.strictEqual(typeof ok.body.id, 'string');
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 8, ttlMs: 100 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 0, ttlMs: 100 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 1 } }), { status: 400, body: { error: 'INVALID_TTL' } });
+});
+test('POST /reservations/:id/confirm', () => {
+  const { api, clock } = apiSetup(10);
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } }).body;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'A', stock: 7 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+  const { id: id2 } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } }).body;
+  clock.now += 100;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id2}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('DELETE /reservations/:id', () => {
+  const { api } = apiSetup(10);
+  const { id } = api({ method: 'POST', path: '/reservations', body: { sku: 'A', qty: 3, ttlMs: 100 } }).body;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'GET', path: '/stock/A' }).body.available, 10);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+});
