@@ -0,0 +1,189 @@
+const assert = require('assert');
+const { satisfies } = require('../src/semver');
+
+// Each case: [version, range, expected].
+function check(cases) {
+  for (const [version, range, expected] of cases) {
+    assert.strictEqual(satisfies(version, range), expected, `satisfies(${JSON.stringify(version)}, ${JSON.stringify(range)})`);
+  }
+}
+
+test('exact versions, v prefix, whitespace and build metadata', () => check([
+  ['1.2.3', '1.2.3', true],
+  ['1.2.3', '=1.2.3', true],
+  ['v1.2.3', '1.2.3', true],
+  ['  1.2.3  ', 'v1.2.3', true],
+  ['1.2.3+build.5', '1.2.3', true],
+  ['1.2.3', '=1.2.3+other', true],
+  ['1.2.4', '1.2.3', false],
+  ['1.2.3-rc.1', '1.2.3', false],
+  ['1.2.3-rc.1', '1.2.3-rc.1', true],
+]));
+
+test('invalid versions return false', () => check([
+  ['01.2.3', '*', false],
+  ['1.02.3', '*', false],
+  ['1.2', '*', false],
+  ['1.2.3.4', '*', false],
+  ['1.2.3-', '*', false],
+  ['1.2.3-a..b', '*', false],
+  ['1.2.3+', '*', false],
+  ['1.2.3-a_b', '*', false],
+  ['vv1.2.3', '*', false],
+  ['', '*', false],
+  [null, '*', false],
+  [123, '*', false],
+]));
+
+test('invalid ranges return false', () => check([
+  ['1.2.3', '>=', false],
+  ['1.2.3', '1.2.3 >', false],
+  ['1.2.3', 'abc', false],
+  ['1.2.3', '>=01.2.3', false],
+  ['1.2.3', '>>1.2.3', false],
+  ['1.2.3', '1.2.3 -', false],
+  ['1.2.3', '1.2.3 || garbage', false],
+  ['1.2.3', '1.x.3', false],
+  ['1.2.3', '1.2-beta', false],
+  ['1.2.3', undefined, false],
+]));
+
+test('primitive comparators, with optional whitespace after the operator', () => check([
+  ['1.2.3', '>1.2.2', true],
+  ['1.2.3', '>1.2.3', false],
+  ['1.2.3', '>=1.2.3', true],
+  ['1.2.3', '>= 1.2.3', true],
+  ['1.2.3', '<1.2.4', true],
+  ['1.2.3', '< 1.2.3', false],
+  ['1.2.3', '<=1.2.3', true],
+  ['1.2.3', '>=1.0.0 <2.0.0', true],
+  ['2.0.0', '>=1.0.0 <2.0.0', false],
+  ['10.0.0', '>9.0.0', true],
+  ['99999999999999999999.0.0', '>99999999999999999998.0.0', true],
+]));
+
+test('|| unions comparator sets', () => check([
+  ['1.2.3', '<1.0.0 || >=1.2.0', true],
+  ['1.1.0', '<1.0.0 || >=1.2.0', false],
+  ['0.5.0', '<1.0.0||>=1.2.0', true],
+]));
+
+test('x-ranges without an operator', () => check([
+  ['0.0.0', '*', true],
+  ['9.9.9', '', true],
+  ['9.9.9', '  ', true],
+  ['1.0.0', '1', true],
+  ['1.9.9', '1.x', true],
+  ['2.0.0', '1.X', false],
+  ['0.9.9', '1.*', false],
+  ['1.2.0', '1.2', true],
+  ['1.2.9', '1.2.x', true],
+  ['1.3.0', '1.2.x', false],
+  ['1.1.9', '1.2', false],
+  ['1.2.9', 'x.x.x', true],
+  ['1.2.9', '=1.2', true],
+  ['1.3.0', '=1', true],
+]));
+
+test('x-ranges with an operator', () => check([
+  ['1.9.9', '>1', false],
+  ['2.0.0', '>1', true],
+  ['1.2.9', '>1.2', false],
+  ['1.3.0', '>1.2', true],
+  ['1.0.0', '>=1', true],
+  ['0.9.9', '>=1', false],
+  ['1.2.0', '>=1.2', true],
+  ['1.1.9', '>=1.2.x', false],
+  ['0.9.9', '<1', true],
+  ['1.0.0', '<1', false],
+  ['1.1.9', '<1.2', true],
+  ['1.2.0', '<1.2', false],
+  ['1.9.9', '<=1', true],
+  ['2.0.0', '<=1', false],
+  ['1.2.9', '<=1.2', true],
+  ['1.3.0', '<=1.2', false],
+  ['1.0.0', '>*', false],
+  ['0.0.0', '<*', false],
+  ['1.0.0', '>=*', true],
+  ['1.0.0', '<=*', true],
+]));
+
+test('tilde ranges', () => check([
+  ['1.2.3', '~1.2.3', true],
+  ['1.2.9', '~1.2.3', true],
+  ['1.3.0', '~1.2.3', false],
+  ['1.2.2', '~1.2.3', false],
+  ['1.2.0', '~1.2', true],
+  ['1.3.0', '~1.2', false],
+  ['1.9.0', '~1', true],
+  ['2.0.0', '~1', false],
+  ['1.2.3-beta.2', '~1.2.3-beta.2', true],
+  ['1.2.3-beta.10', '~1.2.3-beta.2', true],
+  ['1.2.3-beta.1', '~1.2.3-beta.2', false],
+  ['1.2.3', '~1.2.3-beta.2', true],
+  ['1.2.4-beta.3', '~1.2.3-beta.2', false],
+]));
+
+test('caret ranges', () => check([
+  ['1.2.3', '^1.2.3', true],
+  ['1.9.9', '^1.2.3', true],
+  ['2.0.0', '^1.2.3', false],
+  ['1.2.2', '^1.2.3', false],
+  ['0.2.9', '^0.2.3', true],
+  ['0.3.0', '^0.2.3', false],
+  ['0.0.3', '^0.0.3', true],
+  ['0.0.4', '^0.0.3', false],
+  ['1.2.0', '^1.2', true],
+  ['1.1.9', '^1.2', false],
+  ['1.9.9', '^1', true],
+  ['2.0.0', '^1', false],
+  ['0.2.9', '^0.2', true],
+  ['0.3.0', '^0.2', false],
+  ['0.0.9', '^0.0', true],
+  ['0.1.0', '^0.0', false],
+  ['0.9.9', '^0', true],
+  ['1.0.0', '^0.x', false],
+  ['1.2.3-beta.4', '^1.2.3-beta.2', true],
+  ['1.5.0', '^1.2.3-beta.2', true],
+  ['1.2.3-beta.1', '^1.2.3-beta.2', false],
+  ['2.0.0', '^1.2.3-beta.2', false],
+]));
+
+test('hyphen ranges', () => check([
+  ['1.2.3', '1.2.3 - 2.3.4', true],
+  ['2.3.4', '1.2.3 - 2.3.4', true],
+  ['2.3.5', '1.2.3 - 2.3.4', false],
+  ['1.2.2', '1.2.3 - 2.3.4', false],
+  ['1.2.0', '1.2 - 2.3.4', true],
+  ['1.1.9', '1.2 - 2.3.4', false],
+  ['2.3.9', '1.2.3 - 2.3', true],
+  ['2.4.0', '1.2.3 - 2.3', false],
+  ['2.9.9', '1.2.3 - 2', true],
+  ['3.0.0', '1.2.3 - 2', false],
+  ['1.2.3', '1.2.3-2.3.4', false],
+]));
+
+test('prerelease ordering', () => check([
+  ['1.0.0-rc.1', '<1.0.0-rc.2', true],
+  ['1.0.0-alpha', '<1.0.0-alpha.1', true],
+  ['1.0.0-alpha.1', '<1.0.0-alpha.beta', true],
+  ['1.0.0-alpha.beta', '<1.0.0-beta', true],
+  ['1.0.0-beta.2', '<1.0.0-beta.11', true],
+  ['1.0.0-beta.11', '<1.0.0-rc.1', true],
+  ['1.0.0-Z', '<1.0.0-a', true],
+  ['1.0.0-rc.1', '>1.0.0-rc.1', false],
+  ['1.0.0', '>1.0.0-rc.1', true],
+]));
+
+test('prereleases only match comparators with a prerelease on the same tuple', () => check([
+  ['1.2.3-alpha.7', '>1.2.3-alpha.3', true],
+  ['3.4.5-alpha.9', '>1.2.3-alpha.3', false],
+  ['3.4.5', '>1.2.3-alpha.3', true],
+  ['1.2.4-beta', '^1.2.3', false],
+  ['1.2.3-beta', '*', false],
+  ['1.2.3-beta', '', false],
+  ['1.0.0-rc.1', '<1.0.0', false],
+  ['1.2.3-beta', '>=1.2.3-alpha <1.2.4', true],
+  ['1.2.3-beta', '>=1.0.0 <1.2.4 || =1.2.3-beta', true],
+  ['3.4.5-alpha.9', '>1.2.3-alpha.3 || >=3.4.5-alpha.1', true],
+]));
