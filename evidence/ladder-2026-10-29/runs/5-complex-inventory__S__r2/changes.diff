diff --git a/src/store.js b/src/store.js
index 77755be..bb03a06 100644
--- a/src/store.js
+++ b/src/store.js
@@ -1,11 +1,25 @@
 // In-memory inventory. `clock` is injectable so tests can control time.
 function createStore({ clock = Date.now } = {}) {
   const stock = new Map();
+  const reservations = new Map(); // id -> { sku, qty, expiresAt }
+  let nextId = 1;
 
   function assertQty(qty) {
     if (!Number.isInteger(qty) || qty <= 0) throw new Error('INVALID_QTY');
   }
 
+  function isExpired(r) {
+    return clock() >= r.expiresAt;
+  }
+
+  function available(sku) {
+    let reserved = 0;
+    for (const r of reservations.values()) {
+      if (r.sku === sku && !isExpired(r)) reserved += r.qty;
+    }
+    return (stock.get(sku) || 0) - reserved;
+  }
+
   return {
     clock,
     addItem(sku, qty) {
@@ -14,13 +28,34 @@ function createStore({ clock = Date.now } = {}) {
     },
     removeItem(sku, qty) {
       assertQty(qty);
-      const current = stock.get(sku) || 0;
-      if (qty > current) throw new Error('INSUFFICIENT_STOCK');
-      stock.set(sku, current - qty);
+      if (qty > available(sku)) throw new Error('INSUFFICIENT_STOCK');
+      stock.set(sku, (stock.get(sku) || 0) - qty);
     },
     getStock(sku) {
       return stock.get(sku) || 0;
     },
+    getAvailable(sku) {
+      return available(sku);
+    },
+    reserve(sku, qty, ttlMs) {
+      assertQty(qty);
+      if (qty > available(sku)) throw new Error('INSUFFICIENT_STOCK');
+      const id = `res-${nextId++}`;
+      reservations.set(id, { sku, qty, expiresAt: clock() + ttlMs });
+      return id;
+    },
+    // Returns the sku of the confirmed reservation.
+    confirm(id) {
+      const r = reservations.get(id);
+      if (!r) throw new Error('RESERVATION_NOT_FOUND');
+      if (isExpired(r)) throw new Error('RESERVATION_EXPIRED');
+      reservations.delete(id);
+      stock.set(r.sku, (stock.get(r.sku) || 0) - r.qty);
+      return r.sku;
+    },
+    release(id) {
+      reservations.delete(id);
+    },
   };
 }
 
diff --git a/test/api.test.js b/test/api.test.js
index 3ef8a0b..3b3508e 100644
--- a/test/api.test.js
+++ b/test/api.test.js
@@ -17,3 +17,38 @@ test('POST /stock rejects bad qty', () => {
   assert.deepStrictEqual(api({ method: 'POST', path: '/stock', body: { sku: 'x', qty: -1 } }), { status: 400, body: { error: 'INVALID_QTY' } });
 });
 test('unknown route is 404', () => assert.strictEqual(createApi(createStore())({ method: 'GET', path: '/nope' }).status, 404));
+
+function reservationApi() {
+  const t = { now: 0 };
+  const api = createApi(createStore({ clock: () => t.now }));
+  api({ method: 'POST', path: '/stock', body: { sku: 'a', qty: 5 } });
+  return { t, api };
+}
+test('GET /stock includes available', () => {
+  const { api } = reservationApi();
+  const r = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 2, ttlMs: 10 } });
+  assert.strictEqual(r.status, 201);
+  assert.strictEqual(typeof r.body.id, 'string');
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/a' }).body, { sku: 'a', stock: 5, available: 3 });
+});
+test('POST /reservations errors', () => {
+  const { api } = reservationApi();
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 9, ttlMs: 10 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 0, ttlMs: 10 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+});
+test('confirm reservation: 200, 404, 410', () => {
+  const { t, api } = reservationApi();
+  const id = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 2, ttlMs: 10 } }).body.id;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'a', stock: 3 } });
+  assert.strictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }).status, 404);
+  const id2 = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 1, ttlMs: 10 } }).body.id;
+  t.now = 10;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id2}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('DELETE /reservations/:id returns 204 and frees stock', () => {
+  const { api } = reservationApi();
+  const id = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 2, ttlMs: 10 } }).body.id;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'GET', path: '/stock/a' }).body.available, 5);
+});
diff --git a/test/store.test.js b/test/store.test.js
index 8b80ad0..b5b32de 100644
--- a/test/store.test.js
+++ b/test/store.test.js
@@ -27,3 +27,62 @@ test('quantities must be positive integers', () => {
   assert.throws(() => s.addItem('A', 0), /INVALID_QTY/);
   assert.throws(() => s.addItem('A', 1.5), /INVALID_QTY/);
 });
+
+function timed() {
+  const t = { now: 1000 };
+  const s = createStore({ clock: () => t.now });
+  return { t, s };
+}
+test('reserve reduces available but not stock', () => {
+  const { s } = timed();
+  s.addItem('a', 10);
+  const id = s.reserve('a', 4, 100);
+  assert.strictEqual(typeof id, 'string');
+  assert.notStrictEqual(id, s.reserve('a', 1, 100));
+  assert.strictEqual(s.getStock('a'), 10);
+  assert.strictEqual(s.getAvailable('a'), 5);
+});
+test('reserve validates qty and availability', () => {
+  const { s } = timed();
+  s.addItem('a', 3);
+  for (const q of [0, -1, 1.5, '2', undefined]) assert.throws(() => s.reserve('a', q, 10), /INVALID_QTY/);
+  assert.throws(() => s.reserve('a', 4, 10), /INSUFFICIENT_STOCK/);
+});
+test('reservation expires at exactly created + ttl', () => {
+  const { t, s } = timed();
+  s.addItem('a', 5);
+  const id = s.reserve('a', 5, 100);
+  t.now = 1099;
+  assert.strictEqual(s.getAvailable('a'), 0);
+  t.now = 1100;
+  assert.strictEqual(s.getAvailable('a'), 5);
+  assert.throws(() => s.confirm(id), /RESERVATION_EXPIRED/);
+});
+test('confirm converts reservation to sale once', () => {
+  const { s } = timed();
+  s.addItem('a', 5);
+  const id = s.reserve('a', 2, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('a'), 3);
+  assert.strictEqual(s.getAvailable('a'), 3);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+  assert.throws(() => s.confirm('zzz'), /RESERVATION_NOT_FOUND/);
+});
+test('release is idempotent and frees stock', () => {
+  const { s } = timed();
+  s.addItem('a', 5);
+  const id = s.reserve('a', 2, 100);
+  s.release(id);
+  s.release(id);
+  s.release('unknown');
+  assert.strictEqual(s.getAvailable('a'), 5);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('removeItem cannot take reserved stock', () => {
+  const { s } = timed();
+  s.addItem('a', 5);
+  s.reserve('a', 3, 100);
+  assert.throws(() => s.removeItem('a', 3), /INSUFFICIENT_STOCK/);
+  s.removeItem('a', 2);
+  assert.strictEqual(s.getStock('a'), 3);
+});
