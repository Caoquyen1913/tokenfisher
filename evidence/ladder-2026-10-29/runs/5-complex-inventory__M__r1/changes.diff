diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..2926671
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,101 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function setup() {
+  const t = { now: 1000 };
+  const s = createStore({ clock: () => t.now });
+  s.addItem('a', 10);
+  return { t, s };
+}
+const throwsMsg = (fn, msg) => assert.throws(fn, (e) => e.message === msg);
+
+test('reserve reduces available but not stock', () => {
+  const { s } = setup();
+  const id = s.reserve('a', 4, 100);
+  assert.strictEqual(typeof id, 'string');
+  assert.strictEqual(s.getStock('a'), 10);
+  assert.strictEqual(s.getAvailable('a'), 6);
+  assert.notStrictEqual(s.reserve('a', 1, 100), id);
+});
+
+test('reserve validates qty and availability', () => {
+  const { s } = setup();
+  for (const q of [0, -1, 1.5, '2', undefined]) throwsMsg(() => s.reserve('a', q, 100), 'INVALID_QTY');
+  throwsMsg(() => s.reserve('a', 11, 100), 'INSUFFICIENT_STOCK');
+  s.reserve('a', 10, 100);
+  throwsMsg(() => s.reserve('a', 1, 100), 'INSUFFICIENT_STOCK');
+});
+
+test('reservation expires at exactly created + ttl', () => {
+  const { t, s } = setup();
+  const id = s.reserve('a', 4, 100);
+  t.now = 1099;
+  assert.strictEqual(s.getAvailable('a'), 6);
+  t.now = 1100;
+  assert.strictEqual(s.getAvailable('a'), 10);
+  throwsMsg(() => s.confirm(id), 'RESERVATION_EXPIRED');
+  assert.strictEqual(s.getStock('a'), 10);
+});
+
+test('confirm turns reservation into a sale once', () => {
+  const { s } = setup();
+  const id = s.reserve('a', 4, 100);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('a'), 6);
+  assert.strictEqual(s.getAvailable('a'), 6);
+  throwsMsg(() => s.confirm(id), 'RESERVATION_NOT_FOUND');
+  throwsMsg(() => s.confirm('nope'), 'RESERVATION_NOT_FOUND');
+});
+
+test('release cancels and is idempotent', () => {
+  const { s } = setup();
+  const id = s.reserve('a', 4, 100);
+  s.release(id);
+  s.release(id);
+  s.release('nope');
+  assert.strictEqual(s.getAvailable('a'), 10);
+  throwsMsg(() => s.confirm(id), 'RESERVATION_NOT_FOUND');
+});
+
+test('removeItem cannot take reserved stock', () => {
+  const { t, s } = setup();
+  s.reserve('a', 4, 100);
+  throwsMsg(() => s.removeItem('a', 7), 'INSUFFICIENT_STOCK');
+  s.removeItem('a', 6);
+  assert.strictEqual(s.getStock('a'), 4);
+  t.now = 1100;
+  s.removeItem('a', 4);
+  assert.strictEqual(s.getStock('a'), 0);
+});
+
+test('reservations are per sku', () => {
+  const { s } = setup();
+  s.addItem('b', 5);
+  s.reserve('a', 10, 100);
+  assert.strictEqual(s.getAvailable('b'), 5);
+});
+
+test('API reservation flow', () => {
+  const { t, s } = setup();
+  const api = createApi(s);
+  const r = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 4, ttlMs: 100 } });
+  assert.strictEqual(r.status, 201);
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/a' }).body, { sku: 'a', stock: 10, available: 6 });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 7, ttlMs: 100 } }), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 0, ttlMs: 100 } }), { status: 400, body: { error: 'INVALID_QTY' } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${r.body.id}/confirm` }), { status: 200, body: { sku: 'a', stock: 6 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${r.body.id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+  const r2 = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 1, ttlMs: 100 } });
+  t.now += 100;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${r2.body.id}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+
+test('API DELETE reservation returns 204', () => {
+  const { s } = setup();
+  const api = createApi(s);
+  const r = api({ method: 'POST', path: '/reservations', body: { sku: 'a', qty: 4, ttlMs: 100 } });
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${r.body.id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${r.body.id}` }).status, 204);
+  assert.strictEqual(s.getAvailable('a'), 10);
+});
