+
+test('satisfies: matching versions', () => {
+  for (const [ver, range] of yes) assert.strictEqual(satisfies(ver, range), true, `${ver} should satisfy "${range}"`);
+});
+
+test('satisfies: non-matching versions', () => {
+  for (const [ver, range] of no) assert.strictEqual(satisfies(ver, range), false, `${ver} should not satisfy "${range}"`);
+});
+
+test('satisfies: invalid input returns false and never throws', () => {
+  for (const [ver, range] of invalid) assert.strictEqual(satisfies(ver, range), false, `${ver} / "${range}"`);
+});
