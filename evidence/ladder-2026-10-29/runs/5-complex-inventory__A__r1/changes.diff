 // In-memory inventory. `clock` is injectable so tests can control time.
 function createStore({ clock = Date.now } = {}) {
   const stock = new Map();
+  // Reservations are kept after expiry so confirm() can report RESERVATION_EXPIRED;
+  // they are dropped on confirm or release.
+  const reservations = new Map();
+  let nextId = 1;
 
   function assertQty(qty) {
     if (!Number.isInteger(qty) || qty <= 0) throw new Error('INVALID_QTY');
   }
 
+  function isExpired(r, now) {
+    return now >= r.createdAt + r.ttlMs;
+  }
+
+  function reservedQty(sku) {
+    const now = clock();
+    let total = 0;
+    for (const r of reservations.values()) {
+      if (r.sku === sku && !isExpired(r, now)) total += r.qty;
+    }
+    return total;
+  }
+
+  function getAvailable(sku) {
+    return (stock.get(sku) || 0) - reservedQty(sku);
+  }
+
   return {
     clock,
     addItem(sku, qty) {
@@ -14,13 +35,31 @@ function createStore({ clock = Date.now } = {}) {
     },
     removeItem(sku, qty) {
       assertQty(qty);
-      const current = stock.get(sku) || 0;
-      if (qty > current) throw new Error('INSUFFICIENT_STOCK');
-      stock.set(sku, current - qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      stock.set(sku, (stock.get(sku) || 0) - qty);
     },
     getStock(sku) {
       return stock.get(sku) || 0;
     },
+    getAvailable,
+    reserve(sku, qty, ttlMs) {
+      assertQty(qty);
+      if (qty > getAvailable(sku)) throw new Error('INSUFFICIENT_STOCK');
+      const id = `res-${nextId++}`;
+      reservations.set(id, { sku, qty, ttlMs, createdAt: clock() });
+      return id;
+    },
+    confirm(id) {
+      const r = reservations.get(id);
+      if (!r) throw new Error('RESERVATION_NOT_FOUND');
+      if (isExpired(r, clock())) throw new Error('RESERVATION_EXPIRED');
+      reservations.delete(id);
+      stock.set(r.sku, (stock.get(r.sku) || 0) - r.qty);
+      return { sku: r.sku, stock: stock.get(r.sku) };
+    },
+    release(id) {
+      reservations.delete(id);
+    },
   };
 }
 
diff --git a/test/reservations.test.js b/test/reservations.test.js
new file mode 100644
index 0000000..2cb5e0c
--- /dev/null
+++ b/test/reservations.test.js
@@ -0,0 +1,129 @@
+const assert = require('assert');
+const { createStore } = require('../src/store');
+const { createApi } = require('../src/api');
+
+function fakeClock(start = 1000) {
+  let now = start;
+  const clock = () => now;
+  clock.advance = (ms) => { now += ms; };
+  return clock;
+}
+
+function setup(qty = 10) {
+  const clock = fakeClock();
+  const s = createStore({ clock });
+  s.addItem('A', qty);
+  return { s, clock };
+}
+
+test('reserve returns unique string ids', () => {
+  const { s } = setup();
+  const a = s.reserve('A', 1, 1000);
+  const b = s.reserve('A', 1, 1000);
+  assert.strictEqual(typeof a, 'string');
+  assert.notStrictEqual(a, b);
+});
+test('reserve validates qty', () => {
+  const { s } = setup();
+  for (const q of [0, -1, 1.5, '2', undefined]) assert.throws(() => s.reserve('A', q, 1000), /INVALID_QTY/);
+});
+test('reserve rejects more than available', () => {
+  const { s } = setup(5);
+  s.reserve('A', 3, 1000);
+  assert.throws(() => s.reserve('A', 3, 1000), /INSUFFICIENT_STOCK/);
+  assert.throws(() => s.reserve('B', 1, 1000), /INSUFFICIENT_STOCK/);
+  s.reserve('A', 2, 1000);
+  assert.strictEqual(s.getAvailable('A'), 0);
+});
+test('getAvailable subtracts active reservations; getStock stays physical', () => {
+  const { s } = setup(10);
+  s.reserve('A', 4, 1000);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.strictEqual(s.getStock('A'), 10);
+  assert.strictEqual(s.getAvailable('nope'), 0);
+});
+test('reservation expires exactly at creation time + ttlMs', () => {
+  const { s, clock } = setup(10);
+  s.reserve('A', 4, 1000);
+  clock.advance(999);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  clock.advance(1);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  s.reserve('A', 10, 1000);
+  assert.strictEqual(s.getAvailable('A'), 0);
+});
+test('confirm turns a reservation into a sale', () => {
+  const { s } = setup(10);
+  const id = s.reserve('A', 4, 1000);
+  s.confirm(id);
+  assert.strictEqual(s.getStock('A'), 6);
+  assert.strictEqual(s.getAvailable('A'), 6);
+  assert.throws(() => s.confirm(id), /RESERVATION_NOT_FOUND/);
+});
+test('confirm errors: unknown, released, expired', () => {
+  const { s, clock } = setup(10);
+  assert.throws(() => s.confirm('nope'), /RESERVATION_NOT_FOUND/);
+  const released = s.reserve('A', 1, 1000);
+  s.release(released);
+  assert.throws(() => s.confirm(released), /RESERVATION_NOT_FOUND/);
+  const expired = s.reserve('A', 1, 1000);
+  clock.advance(1000);
+  assert.throws(() => s.confirm(expired), /RESERVATION_EXPIRED/);
+  assert.strictEqual(s.getStock('A'), 10);
+});
+test('release frees stock and is idempotent', () => {
+  const { s } = setup(10);
+  const id = s.reserve('A', 4, 1000);
+  s.release(id);
+  assert.strictEqual(s.getAvailable('A'), 10);
+  s.release(id);
+  s.release('nope');
+  assert.strictEqual(s.getAvailable('A'), 10);
+});
+test('removeItem cannot remove reserved stock', () => {
+  const { s, clock } = setup(10);
+  s.reserve('A', 7, 1000);
+  assert.throws(() => s.removeItem('A', 4), /INSUFFICIENT_STOCK/);
+  s.removeItem('A', 3);
+  assert.strictEqual(s.getStock('A'), 7);
+  clock.advance(1000);
+  s.removeItem('A', 7);
+  assert.strictEqual(s.getStock('A'), 0);
+});
+
+function apiSetup() {
+  const { s, clock } = setup(10);
+  return { api: createApi(s), clock };
+}
+const reserveReq = (qty) => ({ method: 'POST', path: '/reservations', body: { sku: 'A', qty, ttlMs: 1000 } });
+
+test('GET /stock includes available', () => {
+  const { api } = apiSetup();
+  api(reserveReq(3));
+  assert.deepStrictEqual(api({ method: 'GET', path: '/stock/A' }), { status: 200, body: { sku: 'A', stock: 10, available: 7 } });
+});
+test('POST /reservations status codes', () => {
+  const { api } = apiSetup();
+  const ok = api(reserveReq(3));
+  assert.strictEqual(ok.status, 201);
+  assert.strictEqual(typeof ok.body.id, 'string');
+  assert.deepStrictEqual(api(reserveReq(8)), { status: 409, body: { error: 'INSUFFICIENT_STOCK' } });
+  assert.deepStrictEqual(api(reserveReq(0)), { status: 400, body: { error: 'INVALID_QTY' } });
+});
+test('POST /reservations/:id/confirm status codes', () => {
+  const { api, clock } = apiSetup();
+  const { id } = api(reserveReq(3)).body;
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 200, body: { sku: 'A', stock: 7 } });
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id}/confirm` }), { status: 404, body: { error: 'RESERVATION_NOT_FOUND' } });
+  const { id: id2 } = api(reserveReq(1)).body;
+  clock.advance(1000);
+  assert.deepStrictEqual(api({ method: 'POST', path: `/reservations/${id2}/confirm` }), { status: 410, body: { error: 'RESERVATION_EXPIRED' } });
+});
+test('DELETE /reservations/:id returns 204 and frees stock', () => {
+  const { api } = apiSetup();
+  const { id } = api(reserveReq(3)).body;
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: `/reservations/${id}` }).status, 204);
+  assert.strictEqual(api({ method: 'DELETE', path: '/reservations/nope' }).status, 204);
+  assert.strictEqual(api({ method: 'GET', path: '/stock/A' }).body.available, 10);
+});
