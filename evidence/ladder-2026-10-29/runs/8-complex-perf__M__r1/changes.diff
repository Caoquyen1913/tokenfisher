diff --git a/test/report.test.js b/test/report.test.js
index 9353f4d..0122d6b 100644
--- a/test/report.test.js
+++ b/test/report.test.js
@@ -17,3 +17,56 @@ test('respects the limit', () => {
   assert.strictEqual(summarize(orders).length, 10);
   assert.strictEqual(summarize(orders, 3).length, 3);
 });
+
+// Reference implementation: the original (slow, obviously-correct) algorithm.
+function referenceSummarize(orders, limit = 10) {
+  const seen = [];
+  const groups = [];
+  const byRank = (a, b) => {
+    if (a.spendCents !== b.spendCents) return b.spendCents - a.spendCents;
+    if (a.firstOrderAt !== b.firstOrderAt) return a.firstOrderAt < b.firstOrderAt ? -1 : 1;
+    return a.customerId < b.customerId ? -1 : a.customerId > b.customerId ? 1 : 0;
+  };
+  for (const o of orders) {
+    if (seen.includes(o.id)) continue;
+    seen.push(o.id);
+    if (o.status === 'refunded') continue;
+    let g = groups.find((x) => x.customerId === o.customerId);
+    if (!g) { g = { customerId: o.customerId, spendCents: 0, orderCount: 0, firstOrderAt: o.createdAt }; groups.push(g); }
+    g.orderCount++;
+    if (o.createdAt < g.firstOrderAt) g.firstOrderAt = o.createdAt;
+    if (o.status === 'paid') g.spendCents += o.currency === 'EUR' ? Math.round(o.amountCents * 1.08) : o.amountCents;
+    groups.sort(byRank);
+  }
+  return groups.filter((g) => g.spendCents > 0).slice(0, limit).map((g, i) => ({ rank: i + 1, ...g }));
+}
+
+function randomOrders(n, customers, seed) {
+  let s = seed;
+  const rnd = (k) => { s = (s * 1664525 + 1013904223) >>> 0; return s % k; };
+  const statuses = ['paid', 'paid', 'pending', 'refunded'];
+  return Array.from({ length: n }, (_, i) => order(
+    `o${rnd(Math.max(1, n - n / 10))}`, // some duplicate ids
+    `cus_${rnd(customers)}`,
+    statuses[rnd(4)],
+    rnd(5000),
+    `2026-10-01T${String(rnd(24)).padStart(2, '0')}:${String(rnd(60)).padStart(2, '0')}:00Z`,
+    rnd(2) ? 'EUR' : 'USD',
+  ));
+}
+
+test('matches the reference implementation exactly (ties, dups, refunds, EUR)', () => {
+  for (let seed = 1; seed <= 30; seed++) {
+    const orders = randomOrders(300, seed % 2 ? 8 : 60, seed);
+    for (const limit of [1, 10, 1000]) {
+      assert.deepStrictEqual(summarize(orders, limit), referenceSummarize(orders, limit));
+    }
+  }
+});
+
+test('handles 200,000 orders quickly', () => {
+  const orders = randomOrders(200000, 50000, 7);
+  const t = Date.now();
+  summarize(orders);
+  assert.ok(Date.now() - t < 1000, `took ${Date.now() - t} ms`);
+});
