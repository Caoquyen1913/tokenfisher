+function toReport(groups, limit) {
+  return groups
+    .filter((g) => g.spendCents > 0)
+    .slice(0, limit)
+    .map((g, i) => ({ rank: i + 1, ...g }));
+}
+
+// byRank is a strict total order (so one final sort gives the same result as
+// re-sorting after every order) only when customer ids are distinct strings,
+// first-order dates are strings and spend is a real number.
